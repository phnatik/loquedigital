,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Button, Field } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius } from '../../src/theme/theme';\n\nconst brandWhiteLogo = require('../../assets/brand-white.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n      // AuthGate handles redirect on success.\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView contentContainerStyle={styles.scroll} keyboardShouldPersistTaps=\"handled\">\n          <View style={styles.brandWrap}>\n            <Image source={brandWhiteLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.brand}>SENTURI</Text>\n            <Text style={styles.tagline}>Managed protection, in your pocket.</Text>\n          </View>\n\n          <View style={styles.formCard}>\n            {/* Security badge — mirrors web portal's \"Secure Login\" pill */}\n            <View style={styles.badgeRow}>\n              <View style={styles.badge}>\n                <View style={styles.badgeDot} />\n                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n              </View>\n            </View>\n\n            <Text style={styles.formTitle}>Welcome Back</Text>\n            <Text style={styles.formSubtitle}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            <Field\n              label=\"Email\"\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n            />\n            <Field\n              label=\"Password\"\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"••••••••\"\n              secureTextEntry\n              autoComplete=\"password\"\n              textContentType=\"password\"\n            />\n\n            {error ? <Text style={styles.error}>{error}</Text> : null}\n\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.gradientBtn}\n            >\n              <Button\n                title=\"Sign in\"\n                onPress={onSubmit}\n                loading={loading}\n                style={styles.signInBtn}\n                textStyle={styles.signInBtnText}\n              />\n            </LinearGradient>\n\n            <Text style={styles.helperText}>\n              Accounts are provisioned by Senturi. Contact your administrator if you\n              can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: colors.ink },\n  scroll: { flexGrow: 1, justifyContent: 'center', padding: spacing.xl },\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxl },\n  logo: { width: 64, height: 64, marginBottom: spacing.md },\n  brand: {\n    fontSize: 34,\n    fontWeight: '800',\n    color: colors.textInverse,\n    letterSpacing: 6,\n  },\n  tagline: {\n    ...typography.label,\n    color: '#9fc6d6',\n    marginTop: spacing.sm,\n    letterSpacing: 0.5,\n  },\n  formCard: {\n    backgroundColor: colors.surface,\n    borderRadius: 20,\n    padding: spacing.xl,\n    shadowColor: '#000',\n    shadowOpacity: 0.08,\n    shadowRadius: 20,\n    shadowOffset: { width: 0, height: 10 },\n    elevation: 4,\n    borderWidth: 1,\n    borderColor: 'rgba(226, 232, 240, 0.6)',\n  },\n  badgeRow: { alignItems: 'center', marginBottom: spacing.lg },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(38, 144, 188, 0.2)',\n    borderRadius: 20,\n    paddingVertical: 6,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.secondary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '600',\n    color: colors.secondary,\n    letterSpacing: 1,\n  },\n  formTitle: {\n    fontSize: 28,\n    fontWeight: '800',\n    color: colors.text,\n    textAlign: 'center',\n    letterSpacing: -0.5,\n  },\n  formSubtitle: {\n    fontSize: 15,\n    color: '#64748b',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xl,\n    lineHeight: 22,\n  },\n  error: { color: colors.danger, marginBottom: spacing.md },\n  gradientBtn: { borderRadius: radius.md, marginTop: spacing.xs },\n  signInBtn: { backgroundColor: 'transparent' },\n  signInBtnText: { color: colors.textInverse, fontWeight: '600', fontSize: 16 },\n  helperText: {\n    ...typography.caption,\n    textAlign: 'center',\n    marginTop: spacing.lg,\n    lineHeight: 18,\n  },\n});"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
