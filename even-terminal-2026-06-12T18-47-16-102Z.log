sed .nav-link {\n74\t    padding: 0.85rem;\n75\t}\n76\t\n77\t/* Label transition */\n78\t.link-label {\n79\t    margin-left: 12px;\n80\t    white-space: nowrap;\n81\t    overflow: hidden;\n82\t    opacity: 1;\n83\t    transition: margin 0.15s ease, opacity 0.15s ease;\n84\t}\n85\t\n86\t/* When collapsed: fade + compress label */\n87\t.sidebar.collapsed .link-label {\n88\t    position: absolute;\n89\t    width: 0;\n90\t    height: 0;\n91\t    overflow: hidden;\n92\t    opacity: 0;\n93\t    margin: 0;\n94\t    padding: 0;\n95\t    pointer-events: none; \n96\t}\n97\t\n98\t.hover-label {\n99\t    position: absolute;\n100\t    left: 100%;\n101\t    top: 50%;\n102\t    transform: translateY(-50%);\n103\t    background-color: var(--btn-medium);\n104\t    color: white;\n105\t    padding: 6px 12px;\n106\t    border-radius: var(--border-radius);\n107\t    white-space: nowrap;\n108\t    opacity: 0;\n109\t    transition: opacity 0.2s ease;\n110\t    font-size: 0.85rem;\n111\t    margin-left: 0.5rem;\n112\t    z-index: 9999;\n113\t    pointer-events: none;\n114\t}\n115\t\n116\t.nav-link:hover .hover-label {\n117\t    opacity: 1; }\n118\t\n119\t/* Optional: icon sizing insurance */\n120\t.nav-link svg {\n121\t    flex-shrink: 0;\n122\t}\n123\t\n124\t/* Toggle button */\n125\t.toggle {\n126\t    background: var(--primary-color);\n127\t    color: #fff;\n128\t    border: none;\n129\t    width: 20px;\n130\t    height: 20px;\n131\t    text-align: center;\n132\t    align-items: center;\n133\t    justify-content: center;\n134\t    display: flex;\n135\t    flex-direction: column;\n136\t    border-radius: 50%;\n137\t    cursor: pointer;\n138\t    font-size: 5px!important;\n139\t    transition: var(--tran-02);\n140\t\n141\t    position: absolute;\n142\t    top: 20px;\n143\t    right: -11px;\n144\t    /* pushes toggle to \"hover\" outside the sidebar edge */\n145\t    z-index: 1100;\n146\t}\n147\t\n148\t.toggle:hover {\n149\t    background: var(--primary-color);\n150\t    color: var(--white);\n151\t}\n152\t\n153\t/* Overlay behind sidebar on mobile */\n154\t.sidebar-overlay {\n155\t    display: none;\n156\t}\n157\t\n158\t@media (max-width: 768px) {\n159\t    /* Expanded: overlay on top of content */\n160\t    .sidebar {\n161\t        width: 200px;\n162\t    }\n163\t\n164\t    /* Collapsed: show icon strip with centered icons */\n165\t    .sidebar.collapsed {\n166\t        width: 60px;\n167\t        padding: 0;\n168\t    }\n169\t\n170\t    .sidebar.collapsed .nav-link {\n171\t        justify-content: center;\n172\t        padding: 0.85rem 0;\n173\t    }\n174\t\n175\t    .sidebar.collapsed .logo {\n176\t        justify-content: center;\n177\t    }\n178\t\n179\t    .sidebar-overlay {\n180\t        display: block;\n181\t        position: fixed;\n182\t        inset: 0;\n183\t        background: rgba(0, 0, 0, 0.4);\n184\t        z-index: 999;\n185\t    }\n186\t}\n187\t\n188\t"}]},"parent_tool_use_id":"toolu_01BJpUKftMt6VmsNsdKLeEez","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"02137454-c74c-48e7-8621-3b3a98d0503c","timestamp":"2026-06-12T23:57:28.773Z"}
