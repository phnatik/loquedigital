[2026-06-14 16:13:35] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PdY5oXiiY1RKNacaTkGXqi","type":"tool_result","content":"The file /Users/andrewprice/senturi/core/core-backend/domains/integrations/superops/superopsService.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"de849d4f-dc95-44db-bdb1-9ee38f291bd1","timestamp":"2026-06-14T21:13:35.649Z","tool_use_result":{"filePath":"/Users/andrewprice/senturi/core/core-backend/domains/integrations/superops/superopsService.js","oldString":"const createTicket = async (ticketData) => {\n    try {\n        const variables = {\n            input: {\n                \"subject\": ticketData.machineName + \" - \" + ticketData.subject,\n                \"ticketType\": ticketData.ticketType,\n                \"source\": ticketData.source,\n                \"client\":{\n                    \"accountId\": ticketData.accountId\n                },\n                \"status\": ticketData.status,\n                \"description\": ticketData.description,\n                \"addAssets\": {\n                    \"assetId\": ticketData.assetId\n                }\n            }\n        }\n        console.log(variables);\n        const res = await superOpsClient.rawRequest(CREATE_TICKET, variables);\n        return res.data;\n    } catch (err) {\n        console.error(\"Error creating ticket for account id \");\n        err.statusCode = 500;\n        throw err;\n    }\n}","newString":"const createTicket = async (ticketData) => {\n    try {\n        const subject = ticketData.machineName\n            ? ticketData.machineName + \" - \" + ticketData.subject\n            : ticketData.subject;\n\n        const input = {\n            \"subject\": subject,\n            \"ticketType\": ticketData.ticketType,\n            \"source\": ticketData.source,\n            \"client\":{\n                \"accountId\": ticketData.accountId\n            },\n            \"status\": ticketData.status,\n            \"description\": ticketData.description,\n        };\n\n        // Only attach the asset when one is provided (account-level tickets\n        // from the mobile app may not have an asset).\n        if (ticketData.assetId) {\n            input.addAssets = { \"assetId\": ticketData.assetId };\n        }\n\n        const variables = { input };\n        console.log(variables);\n        const res = await superOpsClient.rawRequest(CREATE_TICKET, variables);\n        return res.data;\n    } catch (err) {\n        console.error(\"Error creating ticket for account id \");\n        err.statusCode = 500;\n        throw err;\n    }\n}","originalFile":"// domains/superops/superopsService.js\nconst { resolveRequestDocument } = require(\"graphql-request\");\nconst superOpsClient = require(\"./superopsClient\");\nconst { \n    GET_CLIENT_LIST, \n    GET_CLIENT_BY_ACCOUNT_ID, \n    CREATE_CLIENT,\n    CREATE_CLIENT_CONTACT,\n    UPDATE_PRIMARY_CONTACT,\n    GET_CLIENT_SITE,\n    UPDATE_CLIENT_CUSTOM_FIELDS,\n    GET_ASSET_LIST,\n    GET_ASSET_SUMMARY,\n    GET_ASSET,\n    GET_ASSET_PATCH_DETAILS,\n    CREATE_TICKET,\n    GET_TICKETS_BY_ACCOUNT_ID\n} = require(\"./superopsQueries\");\n\n// Get a list of all superops clients\nconst getClientList = async (page = 1, pageSize = 10) => {\n    try {\n        const variables = {\n            input: { \n                page, \n                pageSize \n            }\n        };\n\n        const res = await superOpsClient.request(GET_CLIENT_LIST, variables);\n        console.log(res);\n        return res.getClientList.clients;\n    } catch (err) {\n            err.statusCode = 502;\n            throw err;\n    }\n};\n\n// Get client by superops client (account) id\nconst getClientByAccountId = async (accountId) => {\n    try {\n        const variables = {\n            input : { accountId }\n        }\n        const res = await superOpsClient.request(GET_CLIENT_BY_ACCOUNT_ID, variables);\n        console.log(res.getClient);\n        return res.getClient;\n    } catch (err) {\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst createClient = async (name, stage, status, primaryContact) => {\n    try {\n        const variables = {\n            input: {\n                name,\n                stage,\n                status,\n                primaryContact,\n                hqSite : {\n                    name: \"Primary\",\n                    working24x7: false,\n                    timezoneCode: \"America/Chicago\"\n                }\n            }\n        };\n\n        const res = await superOpsClient.request(CREATE_CLIENT, variables);\n        return res.createClientV2;\n    } catch (err) {\n        console.error('GraphQL Error:', err.response?.errors || err);\n        err.statusCode = 502;\n        throw err;\n    }\n};\n\nconst createClientContact = async (firstName, lastName, emailAddress, contactNumber, role, accountId, siteId) => {\n    try {\n        const variables = {\n            input: {\n                firstName,\n                lastName,\n                email: emailAddress,\n                contactNumber,\n                role: {roleId: role || \"4\"},\n                addAssociations: {\n                    client: {accountId: accountId},\n                    site: {id: siteId}\n                }\n            }\n        };\n        const res = await superOpsClient.request(CREATE_CLIENT_CONTACT, variables);\n        return res.createClientUser;\n    } catch (err) {\n        console.log(err.response?.errors || err);\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst updateClientPrimaryContact = async (accountId, primaryContactId) => {\n    try {\n        const variables = {\n            input:{\n                accountId,\n                primaryContact: { userId: primaryContactId }\n            }\n        }\n        const res = await superOpsClient.request(UPDATE_PRIMARY_CONTACT, variables);\n        return res.updateClient;\n    } catch (err) {\n        console.log(err.response?.errors || err);\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst getClientSite = async (clientSiteId) => {\n    try {\n        const variables = {\n            input : {\n                id: clientSiteId\n            }\n        }\n        const res = await superOpsClient.request(GET_CLIENT_SITE, variables);\n        return res.getClientSite;\n    } catch (err) {\n        console.log(err.response?.errors || err);\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst sendBitDefenderInstallLinksToSuperOps = async (\n  clientId,\n  installLinkWindows,\n  installLinkMac,\n  installLinkMacArm,\n  installLinkLinux,\n  installLinkMacDownloader,\n  customerEmail,\n) => {\n  try {\n    const variables = {\n      input: {\n        accountId: clientId,\n        customFields: {\n          udf1text: installLinkWindows,\n          udf2text: installLinkMac,\n          udf4text: installLinkMacArm,\n          udf5text: installLinkMacDownloader,\n          udf6text: installLinkLinux,\n          udf7text: customerEmail          \n        }\n      }\n    };\n\n    const res = await superOpsClient.request(UPDATE_CLIENT_CUSTOM_FIELDS, variables);\n    return res.updateClient;\n  } catch (err) {\n    console.error(\"Error sending BitDefender install links to SuperOps:\", err.response?.errors || err);\n    err.statusCode = 502;\n    throw err;\n  }\n};\n\nconst updateSuperOpsCustomFields = async (clientId, senturiClientId) => {\n    try {\n        const variables = {\n            input: {\n                accountId: clientId,\n                customFields: {\n                    udf8num: senturiClientId\n                }\n            }\n        };\n\n        const res = await superOpsClient.request(UPDATE_CLIENT_CUSTOM_FIELDS, variables);\n        return res.updateClient;\n    } catch (err) {\n        console.error(\"Error sending BitDefender install links to SuperOps:\", err.response?.errors || err);\n        err.statusCode = 502;\n        throw err;\n    }\n\n\n}\n\nconst getAssetListById = async (accountId) => {\n    try {\n        const variables = {\n            input: {\n                condition: {\n                    attribute:\"client.accountId\",\n                    operator: \"includes\",\n                    value: accountId\n                }\n            }\n        }\n\n        const res = await superOpsClient.request(GET_ASSET_LIST, variables);\n        return res;\n    } catch (err) {\n        console.error(\"Error fetching asset list for account id: \" + accountId);\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst getAssetSummary = async (assetId) => {\n    try {\n        const variables = {\n            input: {\n                assetId: assetId\n            }\n        }\n        const res = await superOpsClient.request(GET_ASSET_SUMMARY, variables);\n        return res;\n        \n    } catch (err) {\n        console.error(\"Error fetching asset summary for asset id: \" + assetId);\n        err.statusCode = 502;\n        throw err;\n    }\n}\n\nconst getAsset = async (assetId) => {\n    try {\n        const variables = {\n            input: {\n                assetId: assetId\n            }\n        }\n        const res = await superOpsClient.request(GET_ASSET, variables);\n        return res;\n    } catch (err) {\n        console.error(\"Error fetching asset at id: \" + assetId);\n        err.statusCode = 500;\n        throw err;\n    }\n}\n\nconst getAssetPatchDetails = async (assetId) => {\n    try {\n        const variables = {\n            input: {\n                assetId: assetId,\n                \"listInfo\":{\n                    \"page\":1,\n                    \"pageSize\":100,\n                    \"sort\": {\"attribute\":\"installationTime\", \"order\":\"DESC\"}\n                }\n            }\n        }\n        const res = await superOpsClient.rawRequest(GET_ASSET_PATCH_DETAILS, variables);\n        return res.data.getAssetPatchDetails.assetPatches;\n    } catch (err) {\n        console.error(\"Error fetching asset's patch details for asset id \" + assetId);\n        err.statusCode = 500;\n        throw err;\n    }\n}\n\nconst createTicket = async (ticketData) => {\n    try {\n        const variables = {\n            input: {\n                \"subject\": ticketData.machineName + \" - \" + ticketData.subject,\n                \"ticketType\": ticketData.ticketType,\n                \"source\": ticketData.source,\n                \"client\":{\n                    \"accountId\": ticketData.accountId\n                },\n                \"status\": ticketData.status,\n                \"description\": ticketData.description,\n                \"addAssets\": {\n                    \"assetId\": ticketData.assetId\n                }\n            }\n        }\n        console.log(variables);\n        const res = await superOpsClient.rawRequest(CREATE_TICKET, variables);\n        return res.data;\n    } catch (err) {\n        console.error(\"Error creating ticket for account id \");\n        err.statusCode = 500;\n        throw err;\n    }\n}\n\nconst getTicketsByAccount = async (accountId) => {\n    try {\n        const variables = {\n            input: {\n                \"page\": 1,\n                \"pageSize\": 100,\n                \"condition\": {\n                    \"attribute\": \"client.accountId\",\n                    \"operator\": \"includes\",\n                    \"value\": accountId\n                }\n            }\n        }\n        const res = await superOpsClient.rawRequest(GET_TICKETS_BY_ACCOUNT_ID, variables);\n        return res.data.getTicketList;\n    } catch (err) {\n        console.error(\"Error fetching tickets\");\n        err.statusCode = 500;\n        throw err;\n    }\n}\n\nmodule.exports = {\n  getClientList,\n  getClientByAccountId,\n  createClient,\n  createClientContact,\n  updateClientPrimaryContact,\n  getClientSite,\n  sendBitDefenderInstallLinksToSuperOps,\n  getAssetListById,\n  getAssetSummary,\n  getAsset,\n  getAssetPatchDetails,\n  createTicket,\n  getTicketsByAccount,\n  updateSuperOpsCustomFields\n};","structuredPatch":[{"oldStart":265,"oldLines":21,"newStart":265,"newLines":28,"lines":[" "," const createTicket = async (ticketData) => {","     try {","-        const variables = {","-            input: {","-                \"subject\": ticketData.machineName + \" - \" + ticketData.subject,","-                \"ticketType\": ticketData.ticketType,","-                \"source\": ticketData.source,","-                \"client\":{","-                    \"accountId\": ticketData.accountId","-                },","-                \"status\": ticketData.status,","-                \"description\": ticketData.description,","-                \"addAssets\": {","-                    \"assetId\": ticketData.assetId","-                }","-            }","+        const subject = ticketData.machineName","+            ? ticketData.machineName + \" - \" + ticketData.subject","+            : ticketData.subject;","+","+        const input = {","+            \"subject\": subject,","+            \"ticketType\": ticketData.ticketType,","+            \"source\": ticketData.source,","+            \"client\":{","+                \"accountId\": ticketData.accountId","+            },","+            \"status\": ticketData.status,","+            \"description\": ticketData.description,","+        };","+","+        // Only attach the asset when one is provided (account-level tickets","+        // from the mobile app may not have an asset).","+        if (ticketData.assetId) {","+            input.addAssets = { \"assetId\": ticketData.assetId };","         }","+","+        const variables = { input };","         console.log(variables);","         const res = await superOpsClient.rawRequest(CREATE_TICKET, variables);","         return res.data;"]}],"userModified":false,"replaceAll":false}}
