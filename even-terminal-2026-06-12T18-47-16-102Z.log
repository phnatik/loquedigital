zeMode=\"contain\" />\n52\t            <Text style={styles.tagline}>Managed protection, in your pocket.</Text>\n53\t          </View>\n54\t\n55\t          <View style={styles.formCard}>\n56\t            {/* Secure-login badge — matches portal */}\n57\t            <View style={styles.badgeRow}>\n58\t              <View style={styles.badge}>\n59\t                <View style={styles.badgeDot} />\n60\t                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n61\t              </View>\n62\t            </View>\n63\t\n64\t            <Text style={styles.formTitle}>Welcome Back</Text>\n65\t            <Text style={styles.formSubtitle}>\n66\t              Sign in to your Senturi dashboard\n67\t            </Text>\n68\t\n69\t            <Field\n70\t              label=\"Email\"\n71\t              value={email}\n72\t              onChangeText={setEmail}\n73\t              placeholder=\"you@company.com\"\n74\t              autoCapitalize=\"none\"\n75\t              keyboardType=\"email-address\"\n76\t              autoComplete=\"email\"\n77\t              textContentType=\"emailAddress\"\n78\t            />\n79\t            <Field\n80\t              label=\"Password\"\n81\t              value={password}\n82\t              onChangeText={setPassword}\n83\t              placeholder=\"••••••••\"\n84\t              secureTextEntry\n85\t              autoComplete=\"password\"\n86\t              textContentType=\"password\"\n87\t            />\n88\t\n89\t            {error ? <Text style={styles.error}>{error}</Text> : null}\n90\t\n91\t            <Button title=\"Sign in\" onPress={onSubmit} loading={loading} />\n92\t\n93\t            <Text style={styles.helperText}>\n94\t              Accounts are provisioned by Senturi. Contact your administrator if\n95\t              you can't sign in.\n96\t            </Text>\n97\t          </View>\n98\t        </ScrollView>\n99\t      </KeyboardAvoidingView>\n100\t    </SafeAreaView>\n101\t  );\n102\t}\n103\t\n104\tconst styles = StyleSheet.create({\n105\t  safe: { flex: 1, backgroundColor: colors.ink },\n106\t  scroll: { flexGrow: 1, justifyContent: 'center', padding: spacing.xl },\n107\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xxl },\n108\t  logo: { width: 120, height: 120, marginBottom: spacing.md },\n109\t  tagline: {\n110\t    fontSize: 14,\n111\t    fontWeight: '500',\n112\t    color: '#9fc6d6',\n113\t    letterSpacing: 0.5,\n114\t  },\n115\t  formCard: {\n116\t    backgroundColor: colors.surface,\n117\t    borderRadius: radius.xl,\n118\t    padding: spacing.xl,\n119\t    paddingTop: spacing.xxl,\n120\t    paddingBottom: spacing.xxl,\n121\t    borderWidth: 1,\n122\t    borderColor: 'rgba(226, 232, 240, 0.6)',\n123\t    ...shadow.elevated,\n124\t  },\n125\t  badgeRow: { alignItems: 'center', marginBottom: spacing.lg },\n126\t  badge: {\n127\t    flexDirection: 'row',\n128\t    alignItems: 'center',\n129\t    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n130\t    borderWidth: 1,\n131\t    borderColor: 'rgba(38, 144, 188, 0.2)',\n132\t    borderRadius: radius.xl,\n133\t    paddingVertical: 6,\n134\t    paddingHorizontal: 14,\n135\t  },\n136\t  badgeDot: {\n137\t    width: 6,\n138\t    height: 6,\n139\t    borderRadius: 3,\n140\t    backgroundColor: colors.secondary,\n141\t    marginRight: spacing.sm,\n142\t  },\n143\t  badgeText: {\n144\t    fontSize: 11,\n145\t    fontWeight: '600',\n146\t    color: colors.secondary,\n147\t    letterSpacing: 1,\n148\t  },\n149\t  formTitle: {\n150\t    fontSize: 28,\n151\t    fontWeight: '800',\n152\t    color: colors.textDark,\n153\t    textAlign: 'center',\n154\t    letterSpacing: -0.5,\n155\t  },\n156\t  formSubtitle: {\n157\t    fontSize: 15,\n158\t    color: '#64748b',\n159\t    textAlign: 'center',\n160\t    marginTop: spacing.xs,\n161\t    marginBottom: spacing.xl,\n162\t    lineHeight: 22,\n163\t  },\n164\t  error: { color: colors.danger, marginBottom: spacing.md, fontSize: 14 },\n165\t  helperText: {\n166\t    ...typography.caption,\n167\t    textAlign: 'center',\n168\t    marginTop: spacing.lg,\n169\t    lineHeight: 18,\n170\t  },\n171\t});\n172\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"39c67936-33e8-4aaa-a16b-58341253f76b","timestamp":"2026-06-14T21:08:42.184Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Button, Field } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nconst brandWhiteLogo = require('../../assets/brand-white.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView contentContainerStyle={styles.scroll} keyboardShouldPersistTaps=\"handled\">\n          <View style={styles.brandWrap}>\n            <Image source={brandWhiteLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.tagline}>Managed protection, in your pocket.</Text>\n          </View>\n\n          <View style={styles.formCard}>\n            {/* Secure-login badge — matches portal */}\n            <View style={styles.badgeRow}>\n              <View style={styles.badge}>\n                <View style={styles.badgeDot} />\n                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n              </View>\n            </View>\n\n            <Text style={styles.formTitle}>Welcome Back</Text>\n            <Text style={styles.formSubtitle}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            <Field\n              label=\"Email\"\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n            />\n            <Field\n              label=\"Password\"\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"••••••••\"\n              secureTextEntry\n              autoComplete=\"password\"\n              textContentType=\"password\"\n            />\n\n            {error ? <Text style={styles.error}>{error}</Text> : null}\n\n            <Button title=\"Sign in\" onPress={onSubmit} loading={loading} />\n\n            <Text style={styles.helperText}>\n              Accounts are provisioned by Senturi. Contact your administrator if\n              you can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: colors.ink },\n  scroll: { flexGrow: 1, justifyContent: 'center', padding: spacing.xl },\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxl },\n  logo: { width: 120, height: 120, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: '#9fc6d6',\n    letterSpacing: 0.5,\n  },\n  formCard: {\n    backgroundColor: colors.surface,\n    borderRadius: radius.xl,\n    padding: spacing.xl,\n    paddingTop: spacing.xxl,\n    paddingBottom: spacing.xxl,\n    borderWidth: 1,\n    borderColor: 'rgba(226, 232, 240, 0.6)',\n    ...shadow.elevated,\n  },\n  badgeRow: { alignItems: 'center', marginBottom: spacing.lg },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(38, 144, 188, 0.2)',\n    borderRadius: radius.xl,\n    paddingVertical: 6,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.secondary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '600',\n    color: colors.secondary,\n    letterSpacing: 1,\n  },\n  formTitle: {\n    fontSize: 28,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.5,\n  },\n  formSubtitle: {\n    fontSize: 15,\n    color: '#64748b',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xl,\n    lineHeight: 22,\n  },\n  error: { color: colors.danger, marginBottom: spacing.md, fontSize: 14 },\n  helperText: {\n    ...typography.caption,\n    textAlign: 'center',\n    marginTop: spacing.lg,\n    lineHeight: 18,\n  },\n});\n","numLines":172,"startLine":1,"totalLines":172}}}
