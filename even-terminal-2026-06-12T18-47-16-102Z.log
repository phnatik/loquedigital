4775479d8b163c49a67ebceb%40thread.v2/messages/1781696255121\",\"messageType\":\"message\",\"eventDetail\":null,\"subject\":null,\"summary\":null,\"from\":\"Jasetin McPherson\",\"createdDateTime\":\"2026-06-17T11:37:35.121Z\",\"importance\":\"normal\",\"webUrl\":null,\"bodyPreview\":\"<p>their website going to need a blog with good educational content. i cant find anything on their website right now</p>\"}\n{\"id\":\"1781695931497\",\"uri\":\"teams:///chats/19%3A822ca2b24775479d8b163c49a67ebceb%40thread.v2/messages/1781695931497\",\"messageType\":\"message\",\"eventDetail\":null,\"subject\":null,\"summary\":null,\"from\":\"Jasetin McPherson\",\"createdDateTime\":\"2026-06-17T11:32:11.497Z\",\"importance\":\"normal\",\"webUrl\":null,\"bodyPreview\":\"<p>or they get another ein</p>\"}\n{\"id\":\"1781695918213\",\"uri\":\"teams:///chats/19%3A822ca2b24775479d8b163c49a67ebceb%40thread.v2/messages/1781695918213\",\"messageType\":\"message\",\"eventDetail\":null,\"subject\":null,\"summary\":null,\"from\":\"Jasetin McPherson\",\"createdDateTime\":\"2026-06-17T11:31:58.213Z\",\"importance\":\"normal\",\"webUrl\":null,\"bodyPreview\":\"<p>so they wouldn't even be able to advertise smith an vinson if they tried without it being released from the account lol</p>\"}\n{\"id\":\"1781695861001\",\"uri\":\"teams:///chats/19%3A822ca2b24775479d8b163c49a67ebceb%40thread.v2/messages/1781695861001\",\"messageType\":\"message\",\"eventDetail\":null,\"subject\":null,\"summary\":null,\"from\":\"Jasetin McPherson\",\"createdDateTime\":\"2026-06-17T11:31:01.001Z\",\"importance\":\"normal\",\"webUrl\":null,\"bodyPreview\":\"<p>One, the fact they even think they will get past the first approval gate- which I can guarantee they wont. Two,, if they did have a developer account with enough credentials and history to get an approval, they would then get disapproved because we already registered the busin...\"}\n{\"id\":\"1781695655935\",\"uri\":\"teams:///chats/19%3A822ca2b24775479d8b163c49a67ebceb%