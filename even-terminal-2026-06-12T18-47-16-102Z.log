\n289\t        throw err;\n290\t    }\n291\t}\n292\t\n293\tconst getTicketsByAccount = async (accountId) => {\n294\t    try {\n295\t        const variables = {\n296\t            input: {\n297\t                \"page\": 1,\n298\t                \"pageSize\": 100,\n299\t                \"condition\": {\n300\t                    \"attribute\": \"client.accountId\",\n301\t                    \"operator\": \"includes\",\n302\t                    \"value\": accountId\n303\t                }\n304\t            }\n305\t        }\n306\t        const res = await superOpsClient.rawRequest(GET_TICKETS_BY_ACCOUNT_ID, variables);\n307\t        return res.data.getTicketList;\n308\t    } catch (err) {\n309\t        console.error(\"Error fetching tickets\");\n310\t        err.statusCode = 500;\n311\t        throw err;\n312\t    }\n313\t}\n314\t\n315\tmodule.exports = {\n316\t  getClientList,\n317\t  getClientByAccountId,\n318\t  createClient,\n319\t  createClientContact,\n320\t  updateClientPrimaryContact,\n321\t  getClientSite,\n322\t  sendBitDefenderInstallLinksToSuperOps,\n323\t  getAssetListById,"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"71122975-0605-4387-b8ab-b10d43633ecd","timestamp":"2026-06-14T21:12:39.888Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/core-backend/domains/integrations/superops/superopsService.js","content":"\nconst getAssetPatchDetails = async (assetId) => {\n    try {\n        const variables = {\n            input: {\n                assetId: assetId,\n                \"listInfo\":{\n                    \"page\":1,\n                    \"pageSize\":100,\n                    \"sort\": {\"attribute\":\"installationTime\", \"order\":\"DESC\"}\n                }\n            }\n        }\n        const res = await superOpsClient.rawRequest(GET_ASSET_PATCH_DETAILS, variables);\n        return res.data.getAssetPatchDetails.assetPatches;\n    } catch (err) {\n        console.