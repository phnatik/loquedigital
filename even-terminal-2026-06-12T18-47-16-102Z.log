turi.{'\\n'}Contact your\n206\t              administrator if you can't sign in.\n207\t            </Text>\n208\t          </View>\n209\t        </ScrollView>\n210\t      </KeyboardAvoidingView>\n211\t    </View>\n212\t  );\n213\t}\n214\t\n215\tconst FORM_RADIUS = 28;\n216\t\n217\tconst styles = StyleSheet.create({\n218\t  root: { flex: 1, backgroundColor: '#ffffff' },\n219\t  scroll: { flexGrow: 1 },\n220\t\n221\t  /* ── Hero (video) section ── */\n222\t  heroSection: {\n223\t    minHeight: SCREEN_H * 0.42,\n224\t    justifyContent: 'flex-end',\n225\t    overflow: 'hidden',\n226\t  },\n227\t  bgVideo: {\n228\t    ...StyleSheet.absoluteFillObject,\n229\t  },\n230\t  heroContent: {\n231\t    paddingHorizontal: spacing.xxl,\n232\t    paddingBottom: spacing.xxl + FORM_RADIUS,\n233\t  },\n234\t\n235\t  /* Brand */\n236\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n237\t  logo: { width: 80, height: 80, marginBottom: spacing.md },\n238\t  tagline: {\n239\t    fontSize: 14,\n240\t    fontWeight: '500',\n241\t    color: 'rgba(255,255,255,0.6)',\n242\t    letterSpacing: 0.3,\n243\t  },\n244\t\n245\t  /* Badge */\n246\t  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n247\t  badge: {\n248\t    flexDirection: 'row',\n249\t    alignItems: 'center',\n250\t    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n251\t    borderWidth: 1,\n252\t    borderColor: 'rgba(55, 170, 122, 0.3)',\n253\t    borderRadius: radius.pill,\n254\t    paddingVertical: 5,\n255\t    paddingHorizontal: 14,\n256\t  },\n257\t  badgeDot: {\n258\t    width: 6,\n259\t    height: 6,\n260\t    borderRadius: 3,\n261\t    backgroundColor: colors.primary,\n262\t    marginRight: spacing.sm,\n263\t  },\n264\t  badgeText: {\n265\t    fontSize: 11,\n266\t    fontWeight: '700',\n267\t    color: colors.primary,\n268\t    letterSpacing: 1.2,\n269\t  },\n270\t\n271\t  /* Headings */\n272\t  title: {\n273\t    fontSize: 30,\n274\t    fontWeight: '800',\n275\t    color: colors.textDark,\n276\t    textAlign: 'center',\n277\t    letterSpacing: -0.8,\n278\t  },\n279\t  subtitle: {\n280\t    fontSize: 15,\n281\t    color: '#94a3b8',\n282\t    textAlign: 'center',\n283\t    marginTop: spacing.xs,\n284\t    marginBottom: spacing.xxl,\n285\t    lineHeight: 22,\n286\t  },\n287\t\n288\t  /* ── Form section (white card) ── */\n289\t  formSection: {\n290\t    backgroundColor: '#ffffff',\n291\t    borderTopLeftRadius: FORM_RADIUS,\n292\t    borderTopRightRadius: FORM_RADIUS,\n293\t    marginTop: -FORM_RADIUS,\n294\t    paddingTop: spacing.xxl,\n295\t    paddingHorizontal: spacing.xxl,\n296\t    paddingBottom: spacing.xxxl,\n297\t    flex: 1,\n298\t  },\n299\t\n300\t  /* Inputs */\n301\t  label: {\n302\t    fontSize: 13,\n303\t    fontWeight: '600',\n304\t    color: colors.textDark,\n305\t    marginBottom: spacing.sm,\n306\t    letterSpacing: 0.2,\n307\t  },\n308\t  inputWrap: {\n309\t    flexDirection: 'row',\n310\t    alignItems: 'center',\n311\t    borderWidth: 1.5,\n312\t    borderColor: '#e2e8f0',\n313\t    borderRadius: radius.md,\n314\t    paddingHorizontal: spacing.lg,\n315\t    height: 52,\n316\t    backgroundColor: '#f8fafc',\n317\t    marginBottom: spacing.lg,\n318\t  },\n319\t  inputIcon: { marginRight: spacing.md },\n320\t  textInput: {\n321\t    flex: 1,\n322\t    fontSize: 15,\n323\t    color: colors.textDark,\n324\t    height: '100%',\n325\t  },\n326\t\n327\t  /* Error */\n328\t  errorRow: {\n329\t    flexDirection: 'row',\n330\t    alignItems: 'center',\n331\t    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n332\t    borderRadius: radius.sm,\n333\t    padding: spacing.md,\n334\t    marginBottom: spacing.lg,\n335\t  },\n336\t  errorText: {\n337\t    fontSize: 13,\n338\t    color: colors.danger,\n339\t    marginLeft: spacing.sm,\n340\t    flex: 1,\n341\t  },\n342\t\n343\t  /* Button */\n344\t  btnGradient: {\n345\t    borderRadius: radius.md,\n346\t    ...shadow.button,\n347\t  },\n348\t  btn: {\n349\t    height: 54,\n350\t    alignItems: 'center',\n351\t    justifyContent: 'center',\n352\t  },\n353\t  btnText: {\n354\t    fontSize: 16,\n355\t    fontWeight: '700',\n356\t    color: '#ffffff',\n357\t    letterSpacing: 0.3,\n358\t  },\n359\t\n360\t  /* Helper */\n361\t  helper: {\n362\t    fontSize: 12,\n363\t    color: '#94a3b8',\n364\t    textAlign: 'center',\n365\t    marginTop: spacing.xl,\n366\t    lineHeight: 18,\n367\t  },\n368\t});\n369\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"7375ef26-9b6c-4787-9df1-8623fbe85f09","timestamp":"2026-06-14T22:00:43.457Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx — split login: video hero top + white form bottom.\nimport { useState, useRef } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n  Dimensions,\n} from 'react-native';\nimport { Video, ResizeMode } from 'expo-av';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandWhite = require('../../assets/brand-white.png');\nconst bgVideo = require('../../assets/login-bg-3.mp4');\n\nconst { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n  const videoRef = useRef(null);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <View style={styles.root}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n          bounces={false}\n        >\n          {/* ── Top: Video hero ── */}\n          <View style={styles.heroSection}>\n            {/* Video */}\n            <Video\n              ref={videoRef}\n              source={bgVideo}\n              style={styles.bgVideo}\n              resizeMode={ResizeMode.COVER}\n              shouldPlay\n              isLooping\n              isMuted\n              rate={0.8}\n            />\n\n            {/* Dark overlay */}\n            <LinearGradient\n              colors={[\n                'rgba(12, 29, 39, 0.96)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.88)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.96)',\n              ]}\n              locations={[0, 0.25, 0.5, 0.75, 1]}\n              start={{ x: 0.2, y: 0 }}\n              end={{ x: 0.8, y: 1 }}\n              style={StyleSheet.absoluteFill}\n            />\n\n            {/* Hero content */}\n            <SafeAreaView style={styles.heroContent} edges={['top']}>\n              {/* Brand */}\n              <View style={styles.brandWrap}>\n                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n                <Text style={styles.tagline}>\n                  Managed protection, in your pocket.\n                </Text>\n              </View>\n\n              {/* Badge */}\n              <View style={styles.badgeRow}>\n                <View style={styles.badge}>\n                  <View style={styles.badgeDot} />\n                  <Text style={styles.badgeText}>SECURE LOGIN</Text>\n                </View>\n              </View>\n\n            </SafeAreaView>\n          </View>\n\n          {/* ── Bottom: White form card ── */}\n          <View style={styles.formSection}>\n            <Text style={styles.title}>Welcome Back</Text>\n            <Text style={styles.subtitle}>\n              Sign in to your Senturi dashboard\n            </Text>\n            {/* Email field */}\n            <Text style={styles.label}>Email</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={email}\n                onChangeText={setEmail}\n                placeholder=\"you@company.com\"\n                placeholderTextColor=\"#94a3b8\"\n                autoCapitalize=\"none\"\n                keyboardType=\"email-address\"\n                autoComplete=\"email\"\n                textContentType=\"emailAddress\"\n                style={styles.textInput}\n              />\n            </View>\n\n            {/* Password field */}\n            <Text style={styles.label}>Password</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"lock-closed-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={password}\n                onChangeText={setPassword}\n                placeholder=\"Enter your password\"\n                placeholderTextColor=\"#94a3b8\"\n                secureTextEntry={secureEntry}\n                autoComplete=\"password\"\n                textContentType=\"password\"\n                style={styles.textInput}\n              />\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"#94a3b8\"\n                />\n              </Pressable>\n            </View>\n\n            {/* Error */}\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n                <Text style={styles.errorText}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Sign in button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <Text style={styles.btnText}>Sign in</Text>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            <Text style={styles.helper}>\n              Accounts are provisioned by Senturi.{'\\n'}Contact your\n              administrator if you can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </View>\n  );\n}\n\nconst FORM_RADIUS = 28;\n\nconst styles = StyleSheet.create({\n  root: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: { flexGrow: 1 },\n\n  /* ── Hero (video) section ── */\n  heroSection: {\n    minHeight: SCREEN_H * 0.42,\n    justifyContent: 'flex-end',\n    overflow: 'hidden',\n  },\n  bgVideo: {\n    ...StyleSheet.absoluteFillObject,\n  },\n  heroContent: {\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxl + FORM_RADIUS,\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n  logo: { width: 80, height: 80, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: 'rgba(255,255,255,0.6)',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.3)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* ── Form section (white card) ── */\n  formSection: {\n    backgroundColor: '#ffffff',\n    borderTopLeftRadius: FORM_RADIUS,\n    borderTopRightRadius: FORM_RADIUS,\n    marginTop: -FORM_RADIUS,\n    paddingTop: spacing.xxl,\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxxl,\n    flex: 1,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    f