\n53\t\n54\t  const latestBackupJob = useMemo(() => {\n55\t    if (!backupJobs.length) return undefined;\n56\t    if (sort === \"desc\") return backupJobs[0];\n57\t    return backupJobs.reduce(\n58\t      (m, j) => (j?.StartTime > (m?.StartTime ?? 0) ? j : m),\n59\t      backupJobs[0]\n60\t    );\n61\t  }, [backupJobs, sort]);\n62\t\n63\t  return {\n64\t    backupJobs,\n65\t    backupLoading,\n66\t    backupError,\n67\t    latestBackupJob,\n68\t    refetchBackupJobs,\n69\t  };\n70\t}"}]},"parent_tool_use_id":"toolu_01P1zxWVsMcX6MjEAkYa3TM7","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"6ad5250b-d10f-42f8-a57b-3d7c4b06f2ea","timestamp":"2026-06-14T21:15:26.472Z"}
