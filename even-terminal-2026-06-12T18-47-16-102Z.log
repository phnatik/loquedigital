[2026-06-14 17:08:22] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011GYjVLksEv6tyscA8ZcSSj","type":"tool_result","content":"1\t// app/(auth)/login.jsx — split login: video hero top + white form bottom.\n2\t// Uses Plus Jakarta Sans (login page font from web portal) + Montserrat for accents.\n3\timport { useState, useRef, useCallback } from 'react';\n4\timport {\n5\t  View,\n6\t  Text,\n7\t  Image,\n8\t  TextInput,\n9\t  StyleSheet,\n10\t  KeyboardAvoidingView,\n11\t  Platform,\n12\t  ScrollView,\n13\t  Pressable,\n14\t  ActivityIndicator,\n15\t  Dimensions,\n16\t} from 'react-native';\n17\timport { Video, ResizeMode } from 'expo-av';\n18\timport { LinearGradient } from 'expo-linear-gradient';\n19\timport { SafeAreaView } from 'react-native-safe-area-context';\n20\timport { Ionicons } from '@expo/vector-icons';\n21\timport { useFonts } from 'expo-font';\n22\timport {\n23\t  PlusJakartaSans_400Regular,\n24\t  PlusJakartaSans_500Medium,\n25\t  PlusJakartaSans_600SemiBold,\n26\t  PlusJakartaSans_700Bold,\n27\t  PlusJakartaSans_800ExtraBold,\n28\t} from '@expo-google-fonts/plus-jakarta-sans';\n29\timport {\n30\t  Montserrat_400Regular,\n31\t  Montserrat_900Black,\n32\t} from '@expo-google-fonts/montserrat';\n33\timport { useAuth } from '../../src/features/auth/AuthProvider';\n34\timport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n35\t\n36\tconst brandWhite = require('../../assets/brand-white.png');\n37\tconst bgVideo = require('../../assets/login-bg-3.mp4');\n38\t\n39\tconst { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');\n40\t\n41\texport default function Login() {\n42\t  const { login } = useAuth();\n43\t  const [email, setEmail] = useState('');\n44\t  const [password, setPassword] = useState('');\n45\t  const [error, setError] = useState(null);\n46\t  const [loading, setLoading] = useState(false);\n47\t  const [secureEntry, setSecureEntry] = useState(true);\n48\t  const videoRef = useRef(null);\n49\t\n50\t  const [fontsLoaded] = useFonts({\n51\t    PlusJakartaSans_400Regular,\n52\t    PlusJakartaSans_500Medium,\n53\t    PlusJakartaSans_600SemiBold,\n54\t    PlusJakartaSans_700Bold,\n55\t    PlusJakartaSans_800ExtraBold,\n56\t    Montserrat_400Regular,\n57\t    Montserrat_900Black,\n58\t  });\n59\t\n60\t  const onSubmit = async () => {\n61\t    setError(null);\n62\t    if (!email || !password) {\n63\t      setError('Enter your email and password.');\n64\t      return;\n65\t    }\n66\t    setLoading(true);\n67\t    try {\n68\t      await login(email.trim(), password);\n69\t    } catch (err) {\n70\t      setError(err?.message || 'Login failed. Check your credentials.');\n71\t    } finally {\n72\t      setLoading(false);\n73\t    }\n74\t  };\n75\t\n76\t  // Font-aware text styles (fallback gracefully if fonts haven't loaded yet)\n77\t  const f = fontsLoaded ? {\n78\t    extraBold: { fontFamily: 'PlusJakartaSans_800ExtraBold' },\n79\t    bold: { fontFamily: 'PlusJakartaSans_700Bold' },\n80\t    semiBold: { fontFamily: 'PlusJakartaSans_600SemiBold' },\n81\t    medium: { fontFamily: 'PlusJakartaSans_500Medium' },\n82\t    regular: { fontFamily: 'PlusJakartaSans_400Regular' },\n83\t    montBold: { fontFamily: 'Montserrat_900Black' },\n84\t  } : {\n85\t    extraBold: { fontWeight: '800' },\n86\t    bold: { fontWeight: '700' },\n87\t    semiBold: { fontWeight: '600' },\n88\t    medium: { fontWeight: '500' },\n89\t    regular: { fontWeight: '400' },\n90\t    montBold: { fontWeight: '900' },\n91\t  };\n92\t\n93\t  return (\n94\t    <View style={styles.root}>\n95\t      <KeyboardAvoidingView\n96\t        style={{ flex: 1 }}\n97\t        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n98\t      >\n99\t        <ScrollView\n100\t          contentContainerStyle={styles.scroll}\n101\t          keyboardShouldPersistTaps=\"handled\"\n102\t          bounces={false}\n103\t        >\n104\t          {/* ── Top: Video hero ── */}\n105\t          <View style={styles.heroSection}>\n106\t            {/* Video */}\n107\t            <Video\n108\t              ref={videoRef}\n109\t              source={bgVideo}\n110\t              style={styles.bgVideo}\n111\t              resizeMode={ResizeMode.COVER}\n112\t              shouldPlay\n113\t              isLooping\n114\t              isMuted\n115\t              rate={0.8}\n116\t            />\n117\t\n118\t            {/* Dark overlay */}\n119\t            <LinearGradient\n120\t              colors={[\n121\t                'rgba(12, 29, 39, 0.96)',\n122\t                'rgba(12, 29, 39, 0.92)',\n123\t                'rgba(12, 29, 39, 0.88)',\n124\t                'rgba(12, 29, 39, 0.92)',\n125\t                'rgba(12, 29, 39, 0.96)',\n126\t              ]}\n127\t              locations={[0, 0.25, 0.5, 0.75, 1]}\n128\t              start={{ x: 0.2, y: 0 }}\n129\t              end={{ x: 0.8, y: 1 }}\n130\t              style={StyleSheet.absoluteFill}\n131\t            />\n132\t\n133\t            {/* Hero content */}\n134\t            <SafeAreaView style={styles.heroContent} edges={['top']}>\n135\t              {/* Brand */}\n136\t              <View style={styles.brandWrap}>\n137\t                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n138\t                <Text style={[styles.tagline, f.medium]}>\n139\t                  Managed protection, in your pocket.\n140\t                </Text>\n141\t              </View>\n142\t\n143\t              {/* Badge */}\n144\t              <View style={styles.badgeRow}>\n145\t                <View style={styles.badge}>\n146\t                  <View style={styles.badgeDot} />\n147\t                  <Text style={[styles.badgeText, f.bold]}>SECURE LOGIN</Text>\n148\t                </View>\n149\t              </View>\n150\t\n151\t            </SafeAreaView>\n152\t          </View>\n153\t\n154\t          {/* ── Bottom: White form card ── */}\n155\t          <View style={styles.formSection}>\n156\t            <Text style={[styles.title, f.extraBold]}>Welcome Back</Text>\n157\t            <Text style={[styles.subtitle, f.regular]}>\n158\t              Sign in to your Senturi dashboard\n159\t            </Text>\n160\t\n161\t            {/* Email field */}\n162\t            <Text style={[styles.label, f.semiBold]}>Email</Text>\n163\t            <View style={styles.inputWrap}>\n164\t              <Ionicons\n165\t                name=\"mail-outline\"\n166\t                size={18}\n167\t                color=\"#94a3b8\"\n168\t                style={styles.inputIcon}\n169\t              />\n170\t              <TextInput\n171\t                value={email}\n172\t                onChangeText={setEmail}\n173\t                placeholder=\"you@company.com\"\n174\t                placeholderTextColor=\"#94a3b8\"\n175\t                autoCapitalize=\"none\"\n176\t                keyboardType=\"email-address\"\n177\t                autoComplete=\"email\"\n178\t                textContentType=\"emailAddress\"\n179\t                style={[styles.textInput, f.regular]}\n180\t              />\n181\t            </View>\n182\t\n183\t            {/* Password field */}\n184\t            <Text style={[styles.label, f.semiBold]}>Password</Text>\n185\t            <View style={styles.inputWrap}>\n186\t              <Ionicons\n187\t                name=\"lock-closed-outline\"\n188\t                size={18}\n189\t                color=\"#94a3b8\"\n190\t                style={styles.inputIcon}\n191\t              />\n192\t              <TextInput\n193\t                value={password}\n194\t                onChangeText={setPassword}\n195\t                placeholder=\"Enter your password\"\n196\t                placeholderTextColor=\"#94a3b8\"\n197\t                secureTextEntry={secureEntry}\n198\t                autoComplete=\"password\"\n199\t                textContentType=\"password\"\n200\t                style={[styles.textInput, f.regular]}\n201\t              />\n202\t              <Pressable\n203\t                onPress={() => setSecureEntry(!secureEntry)}\n204\t                hitSlop={8}\n205\t              >\n206\t                <Ionicons\n207\t                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n208\t                  size={20}\n209\t                  color=\"#94a3b8\"\n210\t                />\n211\t              </Pressable>\n212\t            </View>\n213\t\n214\t            {/* Error */}\n215\t            {error ? (\n216\t              <View style={styles.errorRow}>\n217\t                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n218\t                <Text style={[styles.errorText, f.medium]}>{error}</Text>\n219\t              </View>\n220\t            ) : null}\n221\t\n222\t            {/* Sign in button */}\n223\t            <LinearGradient\n224\t              colors={gradients.brand}\n225\t              start={{ x: 0, y: 0 }}\n226\t              end={{ x: 1, y: 0 }}\n227\t              style={styles.btnGradient}\n228\t            >\n229\t              <Pressable\n230\t                onPress={onSubmit}\n231\t                disabled={loading}\n232\t                style={({ pressed }) => [\n233\t                  styles.btn,\n234\t                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n235\t                ]}\n236\t              >\n237\t                {loading ? (\n238\t                  <ActivityIndicator color=\"#fff\" />\n239\t                ) : (\n240\t                  <Text style={[styles.btnText, f.bold]}>Sign in</Text>\n241\t                )}\n242\t              </Pressable>\n243\t            </LinearGradient>\n244\t\n245\t            <Text style={[styles.helper, f.regular]}>\n246\t              Accounts are provisioned by Senturi.{'\\n'}Contact your\n247\t              administrator if you can't sign in.\n248\t            </Text>\n249\t          </View>\n250\t        </ScrollView>\n251\t      </KeyboardAvoidingView>\n252\t    </View>\n253\t  );\n254\t}\n255\t\n256\tconst FORM_RADIUS = 0;\n257\t\n258\tconst styles = StyleSheet.create({\n259\t  root: { flex: 1, backgroundColor: '#ffffff' },\n260\t  scroll: { flexGrow: 1 },\n261\t\n262\t  /* ── Hero (video) section ── */\n263\t  heroSection: {\n264\t    minHeight: SCREEN_H * 0.48,\n265\t    justifyContent: 'center',\n266\t    overflow: 'hidden',\n267\t  },\n268\t  bgVideo: {\n269\t    ...StyleSheet.absoluteFillObject,\n270\t  },\n271\t  heroContent: {\n272\t    paddingHorizontal: spacing.xxl,\n273\t    paddingBottom: spacing.xxl + FORM_RADIUS,\n274\t  },\n275\t\n276\t  /* Brand */\n277\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n278\t  logo: { width: 100, height: 100, marginBottom: spacing.md },\n279\t  tagline: {\n280\t    fontSize: 14,\n281\t    color: 'rgba(255,255,255,0.6)',\n282\t    letterSpacing: 0.3,\n283\t  },\n284\t\n285\t  /* Badge */\n286\t  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n287\t  badge: {\n288\t    flexDirection: 'row',\n289\t    alignItems: 'center',\n290\t    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n291\t    borderWidth: 1,\n292\t    borderColor: 'rgba(55, 170, 122, 0.3)',\n293\t    borderRadius: radius.pill,\n294\t    paddingVertical: 5,\n295\t    paddingHorizontal: 14,\n296\t  },\n297\t  badgeDot: {\n298\t    width: 6,\n299\t    height: 6,\n300\t    borderRadius: 3,\n301\t    backgroundColor: colors.primary,\n302\t    marginRight: spacing.sm,\n303\t  },\n304\t  badgeText: {\n305\t    fontSize: 11,\n306\t    color: colors.primary,\n307\t    letterSpacing: 1.2,\n308\t  },\n309\t\n310\t  /* Headings */\n311\t  title: {\n312\t    fontSize: 30,\n313\t    color: colors.textDark,\n314\t    textAlign: 'center',\n315\t    letterSpacing: -0.8,\n316\t  },\n317\t  subtitle: {\n318\t    fontSize: 15,\n319\t    color: '#94a3b8',\n320\t    textAlign: 'center',\n321\t    marginTop: spacing.xs,\n322\t    marginBottom: spacing.xxl,\n323\t    lineHeight: 22,\n324\t  },\n325\t\n326\t  /* ── Form section (white card) ── */\n327\t  formSection: {\n328\t    backgroundColor: '#ffffff',\n329\t    borderTopLeftRadius: FORM_RADIUS,\n330\t    borderTopRightRadius: FORM_RADIUS,\n331\t    marginTop: -FORM_RADIUS,\n332\t    paddingTop: spacing.xxl,\n333\t    paddingHorizontal: spacing.xxl,\n334\t    paddingBottom: spacing.xxxl,\n335\t    flex: 1,\n336\t  },\n337\t\n338\t  /* Inputs */\n339\t  label: {\n340\t    fontSize: 13,\n341\t    color: colors.textDark,\n342\t    marginBottom: spacing.sm,\n343\t    letterSpacing: 0.2,\n344\t  },\n345\t  inputWrap: {\n346\t    flexDirection: 'row',\n347\t    alignItems: 'center',\n348\t    borderWidth: 1.5,\n349\t    borderColor: '#e2e8f0',\n350\t    borderRadius: radius.md,\n351\t    paddingHorizontal: spacing.lg,\n352\t    height: 52,\n353\t    backgroundColor: '#f8fafc',\n354\t    marginBottom: spacing.lg,\n355\t  },\n356\t  inputIcon: { marginRight: spacing.md },\n357\t  textInput: {\n358\t    flex: 1,\n359\t    fontSize: 15,\n360\t    color: colors.textDark,\n361\t    height: '100%',\n362\t  },\n363\t\n364\t  /* Error */\n365\t  errorRow: {\n366\t    flexDirection: 'row',\n367\t    alignItems: 'center',\n368\t    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n369\t    borderRadius: radius.sm,\n370\t    padding: spacing.md,\n371\t    marginBottom: spacing.lg,\n372\t  },\n373\t  errorText: {\n374\t    fontSize: 13,\n375\t    color: colors.danger,\n376\t    marginLeft: spacing.sm,\n377\t    flex: 1,\n378\t  },\n379\t\n380\t  /* Button */\n381\t  btnGradient: {\n382\t    borderRadius: radius.md,\n383\t    ...shadow.button,\n384\t  },\n385\t  btn: {\n386\t    height: 54,\n387\t    alignItems: 'center',\n388\t    justifyContent: 'center',\n389\t  },\n390\t  btnText: {\n391\t    fontSize: 16,\n392\t    color: '#ffffff',\n393\t    letterSpacing: 0.3,\n394\t  },\n395\t\n396\t  /* Helper */\n397\t  helper: {\n398\t    fontSize: 12,\n399\t    color: '#94a3b8',\n400\t    textAlign: 'center',\n401\t    marginTop: spacing.xl,\n402\t    lineHeight: 18,\n403\t  },\n404\t});\n405\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"20fd9502-77ae-4096-bad1-5afda82787a5","timestamp":"2026-06-14T22:08:22.340Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx — split login: video hero top + white form bottom.\n// Uses Plus Jakarta Sans (login page font from web portal) + Montserrat for accents.\nimport { useState, useRef, useCallback } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n  Dimensions,\n} from 'react-native';\nimport { Video, ResizeMode } from 'expo-av';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useFonts } from 'expo-font';\nimport {\n  PlusJakartaSans_400Regular,\n  PlusJakartaSans_500Medium,\n  PlusJakartaSans_600SemiBold,\n  PlusJakartaSans_700Bold,\n  PlusJakartaSans_800ExtraBold,\n} from '@expo-google-fonts/plus-jakarta-sans';\nimport {\n  Montserrat_400Regular,\n  Montserrat_900Black,\n} from '@expo-google-fonts/montserrat';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandWhite = require('../../assets/brand-white.png');\nconst bgVideo = require('../../assets/login-bg-3.mp4');\n\nconst { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n  const videoRef = useRef(null);\n\n  const [fontsLoaded] = useFonts({\n    PlusJakartaSans_400Regular,\n    PlusJakartaSans_500Medium,\n    PlusJakartaSans_600SemiBold,\n    PlusJakartaSans_700Bold,\n    PlusJakartaSans_800ExtraBold,\n    Montserrat_400Regular,\n    Montserrat_900Black,\n  });\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  // Font-aware text styles (fallback gracefully if fonts haven't loaded yet)\n  const f = fontsLoaded ? {\n    extraBold: { fontFamily: 'PlusJakartaSans_800ExtraBold' },\n    bold: { fontFamily: 'PlusJakartaSans_700Bold' },\n    semiBold: { fontFamily: 'PlusJakartaSans_600SemiBold' },\n    medium: { fontFamily: 'PlusJakartaSans_500Medium' },\n    regular: { fontFamily: 'PlusJakartaSans_400Regular' },\n    montBold: { fontFamily: 'Montserrat_900Black' },\n  } : {\n    extraBold: { fontWeight: '800' },\n    bold: { fontWeight: '700' },\n    semiBold: { fontWeight: '600' },\n    medium: { fontWeight: '500' },\n    regular: { fontWeight: '400' },\n    montBold: { fontWeight: '900' },\n  };\n\n  return (\n    <View style={styles.root}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n          bounces={false}\n        >\n          {/* ── Top: Video hero ── */}\n          <View style={styles.heroSection}>\n            {/* Video */}\n            <Video\n              ref={videoRef}\n              source={bgVideo}\n              style={styles.bgVideo}\n              resizeMode={ResizeMode.COVER}\n              shouldPlay\n              isLooping\n              isMuted\n              rate={0.8}\n            />\n\n            {/* Dark overlay */}\n            <LinearGradient\n              colors={[\n                'rgba(12, 29, 39, 0.96)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.88)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.96)',\n              ]}\n              locations={[0, 0.25, 0.5, 0.75, 1]}\n              start={{ x: 0.2, y: 0 }}\n              end={{ x: 0.8, y: 1 }}\n              style={StyleSheet.absoluteFill}\n            />\n\n            {/* Hero content */}\n            <SafeAreaView style={styles.heroContent} edges={['top']}>\n              {/* Brand */}\n              <View style={styles.brandWrap}>\n                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n                <Text style={[styles.tagline, f.medium]}>\n                  Managed protection, in your pocket.\n                </Text>\n              </View>\n\n              {/* Badge */}\n              <View style={styles.badgeRow}>\n                <View style={styles.badge}>\n                  <View style={styles.badgeDot} />\n                  <Text style={[styles.badgeText, f.bold]}>SECURE LOGIN</Text>\n                </View>\n              </View>\n\n            </SafeAreaView>\n          </View>\n\n          {/* ── Bottom: White form card ── */}\n          <View style={styles.formSection}>\n            <Text style={[styles.title, f.extraBold]}>Welcome Back</Text>\n            <Text style={[styles.subtitle, f.regular]}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            {/* Email field */}\n            <Text style={[styles.label, f.semiBold]}>Email</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={email}\n                onChangeText={setEmail}\n                placeholder=\"you@company.com\"\n                placeholderTextColor=\"#94a3b8\"\n                autoCapitalize=\"none\"\n                keyboardType=\"email-address\"\n                autoComplete=\"email\"\n                textContentType=\"emailAddress\"\n                style={[styles.textInput, f.regular]}\n              />\n            </View>\n\n            {/* Password field */}\n            <Text style={[styles.label, f.semiBold]}>Password</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"lock-closed-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={password}\n                onChangeText={setPassword}\n                placeholder=\"Enter your password\"\n                placeholderTextColor=\"#94a3b8\"\n                secureTextEntry={secureEntry}\n                autoComplete=\"password\"\n                textContentType=\"password\"\n                style={[styles.textInput, f.regular]}\n              />\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"#94a3b8\"\n                />\n              </Pressable>\n            </View>\n\n            {/* Error */}\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n                <Text style={[styles.errorText, f.medium]}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Sign in button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <Text style={[styles.btnText, f.bold]}>Sign in</Text>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            <Text style={[styles.helper, f.regular]}>\n              Accounts are provisioned by Senturi.{'\\n'}Contact your\n              administrator if you can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </View>\n  );\n}\n\nconst FORM_RADIUS = 0;\n\nconst styles = StyleSheet.create({\n  root: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: { flexGrow: 1 },\n\n  /* ── Hero (video) section ── */\n  heroSection: {\n    minHeight: SCREEN_H * 0.48,\n    justifyContent: 'center',\n    overflow: 'hidden',\n  },\n  bgVideo: {\n    ...StyleSheet.absoluteFillObject,\n  },\n  heroContent: {\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxl + FORM_RADIUS,\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    color: 'rgba(255,255,255,0.6)',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.3)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* ── Form section (white card) ── */\n  formSection: {\n    backgroundColor: '#ffffff',\n    borderTopLeftRadius: FORM_RADIUS,\n    borderTopRightRadius: FORM_RADIUS,\n    marginTop: -FORM_RADIUS,\n    paddingTop: spacing.xxl,\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxxl,\n    flex: 1,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n","numLines":405,"startLine":1,"totalLines":405}}}
