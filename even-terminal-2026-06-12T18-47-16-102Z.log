 \"@/utils/utils\";\n51\timport \"./Asset.css\";\n52\t\n53\t// --- Fallback date formatter (only used if external function missing) ---\n54\tconst fallbackFormatDate = (d) => {\n55\t  try {\n56\t    if (!d) return \"—\";\n57\t    const date = new Date(d);\n58\t    if (Number.isNaN(date.getTime())) return \"—\";\n59\t    return date.toLocaleString();\n60\t  } catch {\n61\t    return \"—\";\n62\t  }\n63\t};\n64\tconst formatDateString = externalFormatDateString || fallbackFormatDate;\n65\t\n66\t// --- Small helpers ---\n67\tconst get = (obj, path, def = undefined) =>\n68\t  path.split(\".\").reduce((o, k) => (o && o[k] !== undefined ? o[k] : def), obj);\n69\t\n70\tconst statusPill = (status) => {\n71\t  const s = (status || \"\").toString().toUpperCase();\n72\t  let colorClass = \"gray\";\n73\t  if (s === \"INSTALLED\" || s === \"ONLINE\" || s === \"ACTIVE\") colorClass = \"green\";\n74\t  else if (s === \"PENDING\") colorClass = \"orange\";\n75\t  else if (s === \"FAILED\" || s === \"OFFLINE\") colorClass = \"red\";\n76\t\n77\t  return (\n78\t    <div className=\"status-container\">\n79\t      <span className={`status-icon ${colorClass}`} />\n80\t      <span>{status || \"Unknown\"}</span>\n81\t    </div>\n82\t  );\n83\t};\n84\t\n85\tconst Asset = () => {\n86\t  const navigate = useNavigate();\n87\t  const { assetId } = useParams();\n88\t\n89\t  // Getting the user account data\n90\t  const {\n91\t      membership,\n92\t      senturiUser\n93\t    } = useAuth();\n94\t    console.log(senturiUser);\n95\t\n96\t  const { loading, error, asset, assetSummary, name } = useAssetPageData(assetId);\n97\t  const {\n98\t    assetPatchDetails,\n99\t    assetPatchDetailsLoading,\n100\t    assetPatchDetailsError,\n101\t  } = useGetAssetPatchDetails(assetId);\n102\t  \n103\t  const {backupJobs, latestBackupJob} = useCometBackupJobs(senturiUser.email);\n104\t  // console.log(backupJobs);\n105\t\n106\t  // Generate scan dates\n107\t  const lastScannedDate = useMemo(() => {\n108\t    const yesterday = new Date();\n109\t    yesterday.setDate(yesterday.getDate() - 1);\n110\t    yesterday.setHours(8);\n111\t    yesterday.setMinutes(Math.floor(Math.random() * 31)); // 0-30 minutes\n112\t    yesterday.setSeconds(0);\n113\t\n114\t    const month = String(yesterday.getMonth() + 1).padStart(2, '0');\n115\t    const day = String(yesterday.getDate()).padStart(2, '0');\n116\t    const year = yesterday.getFullYear();\n117\t    let hours = yesterday.getHours();\n118\t    const minutes = String(yesterday.getMinutes()).padStart(2, '0');\n119\t    const ampm = hours >= 12 ? 'PM' : 'AM';\n120\t    hours = hours % 12 || 12;\n121\t\n122\t    return `${month}/${day}/${year} | ${hours}:${minutes} ${ampm}`;\n123\t  }, []);\n124\t\n125\t  const nextScanDate = useMemo(() => {\n126\t    const tomorrow = new Date();\n127\t    tomorrow.setDate(tomorrow.getDate() + 1);\n128\t    tomorrow.setHours(8);\n129\t    tomorrow.setMinutes(0);\n130\t    tomorrow.setSeconds(0);\n131\t\n132\t    const month = String(tomorrow.getMonth() + 1).padStart(2, '0');\n133\t    const day = String(tomorrow.getDate()).padStart(2, '0');\n134\t    const year = tomorrow.getFullYear();\n135\t    let hours = tomorrow.getHours();\n136\t    const minutes = String(tomorrow.getMinutes()).padStart(2, '0');\n137\t    const ampm = hours >= 12 ? 'PM' : 'AM';\n138\t    hours = hours % 12 || 12;\n139\t\n140\t    return `${month}/${day}/${year} | ${hours}:${minutes} ${ampm}`;\n141\t  }, []);\n142\t\n143\t  const a = asset?.getAsset || {};\n144\t  const summary = assetSummary?.getAssetSummary || {};\n145\t  const disk = summary?.disk || {};\n146\t  const memory = summary?.memory || {};\n147\t  const cpu = summary?.cpu || {};\n148\t\n149\t  console.log(a);\n150\t\n151\t  const patches =\n152\t    assetPatchDetails?.assetPatches ||\n153\t    assetPatchDetails ||\n154\t    [];\n155\t\n156\t  const [notify, setNotify] = useState({\n157\t    open: false,\n158\t    type: 'info',   // 'success' | 'error' | 'warning' | 'info' | 'dark' | 'light'\n159\t    message: ''\n160\t  }); \n161\t\n162\t  // Overlay state\n163\t  const [assetHealthOverlay, setAssetHealthOverlay] = useState(true);\n164\t  \n165\t\n166\t\n167\t  // Search + sort\n168\t  const [searchTerm, setSearchTerm] = useState(\"\");\n169\t  const [sortConfig, setSortConfig] = useState({ key: null, direction: \"asc\" });\n170\t\n171\t  const handleSearch = (e) => setSearchTerm(e.target.value);\n172\t  const handleSort = (key) =>\n173\t    setSortConfig((prev) => ({\n174\t      key,\n175\t      direction: prev.key === key && prev.direction === \"asc\" ? \"desc\" : \"asc\",\n176\t    }));\n177\t\n178\t  const sortedPatches = useMemo(() => {\n179\t    const items = Array.isArray(patches) ? [...patches] : [];\n180\t    if (!sortConfig.key) return items;\n181\t    return items.sort((a, b) => {\n182\t      const va = get(a, sortConfig.key, \"\");\n183\t      const vb = get(b, sortConfig.key, \"\");\n184\t      if (va < vb) return sortConfig.direction === \"asc\" ? -1 : 1;\n185\t      if (va > vb) return sortConfig.direction === \"asc\" ? 1 : -1;\n186\t      return 0;\n187\t    });\n188\t  }, [patches, sortConfig]);\n189\t\n190\t  const filteredPatches = useMemo(() => {\n191\t    const q = searchTerm.trim().toLowerCase();\n192\t    if (!q) return sortedPatches;\n193\t    return sortedPatches.filter((p) =>\n194\t      (p?.patchDetail?.title || \"\").toLowerCase().includes(q)\n195\t    );\n196\t  }, [sortedPatches, searchTerm]);\n197\t\n198\t  // Health score (naive example)\n199\t  const cpuUse = cpu?.cpuUsage?.value ?? null;\n200\t  const memUse = memory?.memoryUsage?.value ?? null;\n201\t  const diskUse = disk?.disks?.[0]?.driveUsage?.value ?? null;\n202\t\n203\t  const utilizations = [cpuUse, memUse, diskUse].filter(\n204\t    (v) => typeof v === \"number\" && !Number.isNaN(v)\n205\t  );\n206\t  const avgUtil = utilizations.length\n207\t    ? utilizations.reduce((s, v) => s + v, 0) / utilizations.length\n208\t    : null;\n209\t  const healthScore =\n210\t    avgUtil != null ? Math.max(0, Math.min(100, Math.round(100 - avgUtil))) : 76;\n211\t\n212\t  /// TICKET CREATION\n213\t  const [formData, setFormData] = useState({\n214\t    subject: \"\",\n215\t    description: \"\",\n216\t    assetId: \"\",\n217\t    machineName: \"\",\n218\t    accountId: \"\",\n219\t  });\n220\t\n221\t  useEffect(() => {\n222\t  setFormData(prev => ({\n223\t    ...prev,\n224\t    assetId: assetId || \"\",\n225\t    machineName: a?.name || \"\",\n226\t    accountId: membership.data.superops_account_id\n227\t  }));\n228\t}, [assetId, a?.name]);\n229\t\n230\t  const handleChange = (e) => {\n231\t    const { name, value } = e.target;\n232\t    setFormData((prev) => ({\n233\t      ...prev,\n234\t      [name]: value,\n235\t    }));\n236\t  };\n237\t\n238\t  // Create Ticket Submission\n239\t  const handleSubmit = async (e, closeModal) => {\n240\t  e.preventDefault();\n241\t  try {\n242\t    const resp = await createTicket(formData);\n243\t    if (resp?.success) {\n244\t      setNotify({ open: true, type: 'success', message: 'Ticket Created Successfully' });\n245\t      closeModal();\n246\t    } else {\n247\t      setNotify({ open: true, type: 'error', message: 'Error creating ticket. Please use chat in lower right hand corner.' });\n248\t    }\n249\t  } catch (err) {\n250\t    setNotify({ open: true, type: 'error', message: 'Unexpected error creating ticket.' });\n251\t  }\n252\t};\n253\t\n254\t  if (loading) {\n255\t    return (\n256\t      <MainLayout title={name || \"Loading...\"} viewClass='asset-view'>\n257\t        <p>Loading asset…</p>\n258\t      </MainLayout>\n259\t    );\n260\t  }\n261\t\n262\t  if (error) {\n263\t    return (\n264\t      <MainLayout title={name || \"Error\"} viewClass='asset-view'>\n265\t        <p>Error loading asset.</p>\n266\t      </MainLayout>\n267\t    );\n268\t  }\n269\t\n270\t  if (assetPatchDetailsLoading) {\n271\t    return (\n272\t      <MainLayout title={a?.name || name || \"Asset\"} viewClass='asset-view'>\n273\t        <p>Loading patches…</p>\n274\t      </MainLayout>\n275\t    );\n276\t  }\n277\t\n278\t  if (assetPatchDetailsError) {\n279\t    return (\n280\t      <MainLayout title={a?.name || name || \"Asset\"} viewClass='asset-view'>\n281\t        <p>Error loading patches.</p>\n282\t      </MainLayout>\n283\t    );\n284\t  }\n285\t\n286\t\n287\t  return (\n288\t    <MainLayout title={a?.name || name || \"Asset\"} viewClass=\"asset-view\">\n289\t      <div className=\"asset\">\n290\t        <div className=\"asset-header\">\n291\t          <div className=\"online-status\">{statusPill(a?.status)}</div>\n292\t\n293\t          <div className=\"asset-status\">\n294\t            <i className=\"bx bx-time-five\" />\n295\t            <strong>\n296\t              <Clock size={18} /> Last Check In:&nbsp;\n297\t            </strong>\n298\t            <span>{formatDateString(a?.lastCommunicatedTime)}</span>\n299\t          </div>\n300\t\n301\t          <div className=\"asset-status\">\n302\t            <i className=\"bx bx-hdd\" />\n303\t            <strong>\n304\t              <FolderLock size={20} /> Last Backup:&nbsp;\n305\t            </strong>\n306\t            <span>{formatEpoch(latestBackupJob?.StartTime)}</span>\n307\t          </div>\n308\t\n309\t          <div className=\"asset-actions\">\n310\t            {/* <button className=\"view-btn\" onClick={() => navigate(\"/backups\")}>\n311\t              View Backups\n312\t            </button> */}\n313\t\n314\t            <SlideOut buttonText=\"View Backups\" buttonClassName=\"view-btn\">\n315\t              <h2>Asset Backup History</h2>\n316\t              <br />\n317\t              <table className=\"backup-table\">\n318\t                <colgroup>\n319\t                  <col style={{ width: \"40%\" }} /> {/* Date/Time */}\n320\t                  <col style={{ width: \"25%\" }} /> {/* File Size */}\n321\t                  <col style={{ width: \"25%\" }} /> {/* File Count */}\n322\t                  <col style={{ width: \"25%\" }} /> {/* File Count */}\n323\t                </colgroup>\n324\t\n325\t                <thead>\n326\t                  <tr>\n327\t                    <th>Date/Time</th>\n328\t                    <th>File Size</th>\n329\t                    <th>File Count</th>\n330\t                    <th>Status</th>\n331\t                  </tr>\n332\t                </thead>\n333\t\n334\t                <tbody>\n335\t                  {backupJobs &&\n336\t                    backupJobs.map((job) => (\n337\t                      <tr key={job.GUID || job.SnapshotID}>\n338\t                        <td>{formatEpoch(job.StartTime)}</td>\n339\t                        <td>{convertFileSize(job.TotalSize)}</td>\n340\t                        <td>{job.TotalFiles}</td>\n341\t                        <td>{cometStatus(job.Status)}</td>\n342\t                      </tr>\n343\t                    ))}\n344\t                </tbody>\n345\t              </table>\n346\t            </SlideOut>\n347\t\n348\t            <SlideOut\n349\t              buttonText=\"View Device Details\"\n350\t              buttonClassName=\"view-btn\"\n351\t            >\n352\t              <h2>Device Details</h2>\n353\t              <br />\n354\t              <table className=\"asset-table\">\n355\t                <tbody>\n356\t                  <tr>\n357\t                    <td>ID#:</td>\n358\t                    <td>{a?.assetId || \"—\"}</td>\n359\t                  </tr>\n360\t                  <tr>\n361\t                    <td>Logged in as:</td>\n362\t                    <td>{a?.loggedInUser || \"—\"}</td>\n363\t                  </tr>\n364\t                  <tr>\n365\t                    <td>Device Model:</td>\n366\t                    <td>{a?.model || \"—\"}</td>\n367\t                  </tr>\n368\t                  <tr>\n369\t                    <td>OS Version:</td>\n370\t                    <td>{a?.platformVersion || \"—\"}</td>\n371\t                  </tr>\n372\t                  <tr>\n373\t                    <td>IP Address:</td>\n374\t                    <td>{a?.publicIp || \"—\"}</td>\n375\t                  </tr>\n376\t                  <tr>\n377\t                    <td>Serial Number:</td>\n378\t                    <td>{a?.serialNumber || \"—\"}</td>\n379\t                  </tr>\n380\t                  <tr>\n381\t                    <td>Status:</td>\n382\t                    <td>{a?.status || \"—\"}</td>\n383\t                  </tr>\n384\t                  <tr>\n385\t                    <td>CPU Arch:</td>\n386\t                    <td>{cpu?.architecture || \"—\"}</td>\n387\t                  </tr>\n388\t                  <tr>\n389\t                    <td>Hard Drive:</td>\n390\t                    <td>\n391\t                      {disk?.disks?.[0]?.size?.value}{\" \"}\n392\t                      {disk?.disks?.[0]?.size?.unit}\n393\t                    </td>\n394\t                  </tr>\n395\t                  <tr>\n396\t                    <td>RAM:</td>\n397\t                    <td>\n398\t                      {memory?.totalMemory?.value} {memory?.totalMemory?.unit}\n399\t                    </td>\n400\t                  </tr>\n401\t                </tbody>\n402\t              </table>\n403\t            </SlideOut>\n404\t\n405\t            <Modal\n406\t              triggerElement=\"Button\"\n407\t              triggerText=\"Create Ticket\"\n408\t              className=\"action-btn\"\n409\t            >\n410\t              {({ closeModal }) => (\n411\t                <div>\n412\t                  <h3>Create New Ticket</h3>\n413\t                  <p>\n414\t                    If chat can’t resolve it or you need screen-share, submit a\n415\t                    ticket.\n416\t                  </p>\n417\t                  <form\n418\t                    className=\"create-ticket-form\"\n419\t                    onSubmit={(e) => handleSubmit(e, closeModal)}\n420\t                  >\n421\t                    {/* <label htmlFor=\"subject\">Subject:</label> */}\n422\t                    <input\n423\t                      name=\"subject\"\n424\t                      placeholder=\"Subject\"\n425\t                      value={formData.subject}\n426\t                      onChange={handleChange}\n427\t                      maxLength={100}\n428\t                    />\n429\t                    <textarea\n430\t                      name=\"description\"\n431\t                      rows=\"10\"\n432\t                      placeholder=\"Description\"\n433\t                      value={formData.description}\n434\t                      onChange={handleChange}\n435\t                      maxLength={500}\n436\t                    />\n437\t                    <input\n438\t                      type=\"text\"\n439\t                      name=\"assetId\"\n440\t                      hidden\n441\t                      placeholder=\"Asset Id\"\n442\t                      value={formData.assetId}\n443\t                      onChange={handleChange}\n444\t                    />\n445\t                    <input\n446\t                      type=\"text\"\n447\t                      name=\"machineName\"\n448\t                      hidden\n449\t                      placeholder=\"Machine Name\"\n450\t                      value={formData.machineName}\n451\t                      onChange={handleChange}\n452\t                    />\n453\t                    <input\n454\t                      type=\"text\"\n455\t                      name=\"accountId\"\n456\t                      hidden\n457\t                      placeholder=\"Account Id\"\n458\t                      value={formData.accountId}\n459\t                      onChange={handleChange}\n460\t                    />\n461\t                    <input\n462\t                      type=\"submit\"\n463\t                      className=\"action-btn\"\n464\t                      value=\"Create Ticket\"\n465\t                    />\n466\t                  </form>\n467\t                </div>\n468\t              )}\n469\t            </Modal>\n470\t          </div>\n471\t        </div>\n472\t\n473\t        <div className=\"content-area\">\n474\t          <div className=\"asset-details\">\n475\t            <div className=\"asset-details-left\">\n476\t              <div className=\"asset-details-container\">\n477\t                <div className=\"asset-info\">\n478\t                  <div className=\"asset-health\">\n479\t                    {assetHealthOverlay && <div className=\"card-overlay\"></div>}\n480\t\n481\t                    <HeartbeatMonitor />\n482\t                    <div className=\"health-title\">Current Health:</div>\n483\t                    {healthScore > 70 ? (\n484\t                      <div className=\"security-status-indicator security-status-good\"></div>\n485\t                    ) : (\n486\t                      <div className=\"security-status-indicator security-status-bad\"></div>\n487\t                    )}\n488\t                    <div className=\"health-score\">\n489\t                      {healthScore}\n490\t                      <sup\n491\t                        style={{\n492\t                          fontSize: \"40px\",\n493\t                          marginLeft: 0,\n494\t                          position: \"relative\",\n495\t                          top: \"-2px\",\n496\t                          display: \"inline-block\",\n497\t                        }}\n498\t                      >\n499\t                        %\n500\t                      </sup>\n501\t                    </div>\n502\t                  </div>\n503\t\n504\t                  <div className=\"asset-meta\">\n505\t                    <p>Device Health is calculated daily from:</p>\n506\t                    <ul>\n507\t                      <li>- Hard Drive</li>\n508\t                      <li>- RAM usage</li>\n509\t                      <li>- Application open time</li>\n510\t                      <li>- Network Connectivity</li>\n511\t                      <li>- Battery/Power</li>\n512\t                    </ul>\n513\t                    <a href=\"#\">Learn More</a>\n514\t                  </div>\n515\t                </div>\n516\t\n517\t                <div className=\"asset-details-graph\">\n518\t                  {assetHealthOverlay && (\n519\t                    <div className=\"card-overlay\">\n520\t                      <p>\n521\t                        Monitoring in progress ... <br />\n522\t                        Insights available after 30 days\n523\t                      </p>\n524\t                    </div>\n525\t                  )}\n526\t                  <div className=\"asset-details-graph-header\">\n527\t                    <div>\n528\t                      <h3>\n529\t                        <HeartPulse size={30} /> Device Health Score:\n530\t                      </h3>\n531\t                      <p>\n532\t                        The graph displays your computer’s health over time.\n533\t                        Contact <a href=\"#\">support</a> if needed.\n534\t                      </p>\n535\t                    </div>\n536\t                    <RangeSelect />\n537\t                  </div>\n538\t\n539\t                  <SimpleAreaChart />\n540\t                </div>\n541\t              </div>\n542\t\n543\t              <div className=\"tombstone-cards\">\n544\t                <div className=\"tombstone\">\n545\t                  <div className=\"ts-header\">\n546\t                    <div className=\"ts-icon\">\n547\t                      <TriangleAlert size={17} />\n548\t                    </div>\n549\t                    <p className=\"tombstone-title\">Alerts</p>\n550\t                    <span className=\"ts-indicator\"></span>\n551\t                  </div>\n552\t                  <p className=\"tombstone-data\">0</p>\n553\t                  <a className=\"ts-link\" href=\"\">\n554\t                    View all alerts\n555\t                  </a>\n556\t                </div>\n557\t\n558\t                <div className=\"tombstone\">\n559\t                  <div className=\"ts-header\">\n560\t                    <div className=\"ts-icon\">\n561\t                      <Tags size={17} />\n562\t                    </div>\n563\t                    <p className=\"tombstone-title\">Tickets</p>\n564\t                    <span className=\"ts-indicator\"></span>\n565\t                  </div>\n566\t                  <p className=\"tombstone-data\">0</p>\n567\t                  <a className=\"ts-link\" href=\"\">\n568\t                    View all tickets\n569\t                  </a>\n570\t                </div>\n571\t\n572\t                <div className=\"tombstone\">\n573\t                  <div className=\"ts-header\">\n574\t                    <div className=\"ts-icon\">\n575\t                      <Swords size={17} />\n576\t                    </div>\n577\t                    <p className=\"tombstone-title\">Protection Status</p>\n578\t                    <span className=\"ts-indicator\"></span>\n579\t                  </div>\n580\t                  <p className=\"tombstone-data text\">Secure</p>\n581\t                </div>\n582\t\n583\t                <div className=\"tombstone\">\n584\t                  <div className=\"ts-header\">\n585\t                    <div className=\"ts-icon\">\n586\t                      <Bandage size={17} />\n587\t                    </div>\n588\t                    <p className=\"tombstone-title\">Patch Status</p>\n589\t                    <span className=\"ts-indicator\"></span>\n590\t                  </div>\n591\t                  <p className=\"tombstone-data text\">Current</p>\n592\t                </div>\n593\t              </div>\n594\t\n595\t              <div className=\"asset-details-table\">\n596\t                <div className=\"asset-details-table-header\">\n597\t                  <h3 style={{ marginTop: \"0px\" }}>\n598\t                    <SquareAsterisk size={30} /> Recent Activity\n599\t                  </h3>\n600\t                  <input\n601\t                    type=\"text\"\n602\t                    placeholder=\"Search…\"\n603\t                    value={searchTerm}\n604\t                    onChange={handleSearch}\n605\t                    style={{\n606\t                      marginBottom: \"10px\",\n607\t                      padding: \"10px 15px\",\n608\t                      width: \"30%\",\n609\t                      border: \"1px solid #e4e7ec\",\n610\t                      borderRadius: \"5px\",\n611\t                    }}\n612\t                  />\n613\t                </div>\n614\t\n615\t                <TableContainer\n616\t                  component={Paper}\n617\t                  sx={{\n618\t                    boxShadow: \"none\",\n619\t                    borderRadius: \"8px\",\n620\t                    fontFamily: \"Poppins, sans-serif\",\n621\t                    maxHeight: \"400px\",\n622\t                    overflow: \"scroll\",\n623\t                  }}\n624\t                >\n625\t                  <Table>\n626\t                    <TableHead>\n627\t                      <TableRow>\n628\t                        <TableCell\n629\t                          sx={{\n630\t                            fontFamily: \"Poppins, sans-serif\",\n631\t                            fontSize: 16,\n632\t                            fontWeight: 500,\n633\t                            color: \"#2f5064\",\n634\t                            cursor: \"pointer\",\n635\t                          }}\n636\t                          onClick={() => handleSort(\"patchDetail.title\")}\n637\t                        >\n638\t                          Item\n639\t                        </TableCell>\n640\t                        <TableCell\n641\t                          sx={{\n642\t                            fontFamily: \"Poppins, sans-serif\",\n643\t                            fontSize: 16,\n644\t                            fontWeight: 500,\n645\t                            color: \"#2f5064\",\n646\t                            cursor: \"pointer\",\n647\t                          }}\n648\t                          onClick={() => handleSort(\"installationStatus\")}\n649\t                        >\n650\t                          Status\n651\t                        </TableCell>\n652\t                        <TableCell\n653\t                          sx={{\n654\t                            fontFamily: \"Poppins, sans-serif\",\n655\t                            fontSize: 16,\n656\t                            fontWeight: 500,\n657\t                            color: \"#2f5064\",\n658\t                            cursor: \"pointer\",\n659\t                          }}\n660\t                          onClick={() => handleSort(\"installationTime\")}\n661\t                        >\n662\t                          Date\n663\t                        </TableCell>\n664\t                        <TableCell\n665\t                          sx={{\n666\t                            fontFamily: \"Poppins, sans-serif\",\n667\t                            fontSize: 16,\n668\t                            fontWeight: 500,\n669\t                            color: \"#2f5064\",\n670\t                            cursor: \"pointer\",\n671\t                          }}\n672\t                          onClick={() => handleSort(\"patchDetail.severity\")}\n673\t                        >\n674\t                          Disposition\n675\t                        </TableCell>\n676\t                      </TableRow>\n677\t                    </TableHead>\n678\t\n679\t                    <TableBody>\n680\t                      {filteredPatches.map((patch, idx) => (\n681\t                        <TableRow key={idx}>\n682\t                          <TableCell\n683\t                            sx={{\n684\t                              fontFamily: \"Poppins, sans-serif\",\n685\t                              fontSize: 14,\n686\t                            }}\n687\t                          >\n688\t                            {patch?.patchDetail?.title || \"—\"}\n689\t                          </TableCell>\n690\t                          <TableCell\n691\t                            sx={{\n692\t                              fontFamily: \"Poppins, sans-serif\",\n693\t                              fontSize: 14,\n694\t                            }}\n695\t                          >\n696\t                            {statusPill(patch?.installationStatus)}\n697\t                          </TableCell>\n698\t                          <TableCell\n699\t                            sx={{\n700\t                              fontFamily: \"Poppins, sans-serif\",\n701\t                              fontSize: 14,\n702\t                            }}\n703\t                          >\n704\t                            {formatDateString(patch?.installationTime)}\n705\t                          </TableCell>\n706\t                          <TableCell\n707\t                            sx={{\n708\t                              fontFamily: \"Poppins, sans-serif\",\n709\t                              fontSize: 14,\n710\t                            }}\n711\t                          >\n712\t                            {patch?.patchDetail?.severity || \"—\"}\n713\t                          </TableCell>\n714\t                        </TableRow>\n715\t                      ))}\n716\t                      {!filteredPatches?.length && (\n717\t                        <TableRow>\n718\t                          <TableCell\n719\t                            colSpan={4}\n720\t                            sx={{\n721\t                              fontFamily: \"Poppins, sans-serif\",\n722\t                              fontSize: 14,\n723\t                            }}\n724\t                          >\n725\t                            No patches found.\n726\t                          </TableCell>\n727\t                        </TableRow>\n728\t                      )}\n729\t                    </TableBody>\n730\t                  </Table>\n731\t                </TableContainer>\n732\t              </div>\n733\t            </div>\n734\t\n735\t            <div className=\"asset-details-right\">\n736\t              <div className=\"asset-resources\">\n737\t                <h3>\n738\t                  <ChartCandlestick size={30} /> Asset Resources:\n739\t                </h3>\n740\t                <div className=\"resource-item\">\n741\t                  <LinearProgressBar\n742\t                    title=\"Hard Drive:\"\n743\t                    value={disk?.disks?.[0]?.driveUsage?.value}\n744\t                  />\n745\t                  <LinearProgressBar\n746\t                    title=\"Memory (RAM):\"\n747\t                    value={memory?.memoryUsage?.value}\n748\t                  />\n749\t                  <LinearProgressBar\n750\t                    title=\"CPU:\"\n751\t                    value={cpu?.cpuUsage?.value}\n752\t                  />\n753\t                </div>\n754\t              </div>\n755\t\n756\t              <div className=\"asset-security\">\n757\t                <div\n758\t                  style={{\n759\t                    display: \"flex\",\n760\t                    justifyContent: \"space-between\",\n761\t                    alignItems: \"center\",\n762\t                  }}\n763\t                >\n764\t                  <h3>\n765\t                    <ShieldCheck size={30} /> Security:\n766\t                  </h3>\n767\t                  <span>\n768\t                    <i\n769\t                      className=\"bx bx-info-circle\"\n770\t                      style={{ position: \"relative\", top: \"2px\" }}\n771\t                    />\n772\t                    &nbsp;\n773\t                    <Modal\n774\t                      triggerElement=\"Link\"\n775\t                      triggerText=\"Scan Device Now\"\n776\t                      className=\"action-link\"\n777\t                    >\n778\t                      {({ closeModal }) => (\n779\t                        <div>\n780\t                          <h3>Scan Scheduled</h3>\n781\t                          <p>\n782\t                            Your new scan has been queued for processing. This will run in the background on your computer and will take up to 30 minutes.\n783\t                          </p>\n784\t                        </div>\n785\t                      )}\n786\t                    </Modal>\n787\t                  </span>\n788\t                </div>\n789\t                <div className=\"security-item\">\n790\t                  <div className=\"security-title\">Antivirus Status:</div>\n791\t                  <div className=\"security-content\">Active</div>\n792\t                </div>\n793\t\n794\t                <div className=\"security-item\">\n795\t                  <div className=\"security-title\">Threat Posture:</div>\n796\t                  <div className=\"security-content\">Protected</div>\n797\t                </div>\n798\t                <div className=\"security-item\">\n799\t                  <div className=\"security-title\">Last Scanned:</div>\n800\t                  <div className=\"security-content\">{lastScannedDate}</div>\n801\t                </div>\n802\t                <div className=\"security-item\">\n803\t                  <div className=\"security-title\">Malware Detected:</div>\n804\t                  <div className=\"security-content\">False</div>\n805\t                </div>\n806\t                <div className=\"security-item\">\n807\t                  <div className=\"security-title\">Next Scan:</div>\n808\t                  <div className=\"security-content\">{nextScanDate}</div>\n809\t                </div>\n810\t              </div>\n811\t            </div>\n812\t          </div>\n813\t        </div>\n814\t      </div>\n815\t      <IntercomChat assetId={assetId} customerName={senturiUser?.first_name} />\n816\t      {notify.open && (\n817\t        <Notify\n818\t          notifyMessage={notify.message}\n819\t          notifyType={notify.type} // <-- 'success', not 'notify-success'\n820\t          onClose={() => setNotify((n) => ({ ...n, open: false }))}\n821\t        />\n822\t      )}\n823\t    </MainLayout>\n824\t  );\n825\t};\n826\t\n827\texport default Asset;"}]},"parent_tool_use_id":"toolu_01P1zxWVsMcX6MjEAkYa3TM7","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"b80301e7-dbce-484b-8f44-bb7b7f49c14e","timestamp":"2026-06-14T21:15:35.489Z"}
[2026-06-14 16:15:35] [SSE-ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d]: {"type":"tool_end","name":"Read","toolId":"toolu_016JjvnKPkk1xG1VTqs6rUc7","summary":"Read Asset.jsx","detail":{"input":{"file_path":"/Users/andrewprice/senturi/core/core-frontend/src/features/Asset/Asset.jsx"},"output":"1\timport React, { useEffect, useMemo, useState } from \"react\";\n2\timport { useParams, useNavigate } from \"react-router-dom\";\n3\timport { useAuth } from \"@/features/auth/AuthProvider\";\n4\timport { createTicket } from \"@/services/superopsService/superopsService\";\n5\timport Notify from \"../../components/Notify/Notify\";\n6\timport { useCometBackupJobs } from \"@/hooks/useCometBackupJobs\";\n7\timport IntercomChat from \"../../components/IntercomChat/IntercomChat\";\n8\t\n9\t// NEW SYSTEM LAYOUT\n10\timport MainLayout from \"@/layouts/MainLayout\";\n11\t\n12\t// DATA HOOKS\n13\timport { useAssetPageData } from \"@/hooks/useAssetPageData\";\n14\timport { useGetAssetPatchDetails } from \"@/hooks/useGetAssetPatchDetails\";\n15\t\n16\t// MOVED COMPONENTS (now under src/components/*)\n17\timport SimpleAreaChart from \"@/components/AreaChart/AreaChart\";\n18\timport Modal from \"@/components/Modal/Modal\";\n19\timport SlideOut from \"@/components/SlideOut/SlideOut\";\n20\timport LinearProgressBar from \"@/components/LinearProgressbar/LinearProgressbar\";\n21\timport HeartbeatMonitor from \"@/components/HeartbeatMonitor/HeartbeatMonitor\";\n22\timport RangeSelect from \"@/components/RangeSelect/RangeSelect\";\n23\t\n24\timport { \n25\t  ShieldCheck,\n26\t  ChartCandlestick,\n27\t  ClockArrowDown,\n28\t  Clock,\n29\t  FolderLock,\n30\t  SquareAsterisk,\n31\t  HeartPulse,\n32\t  Swords,\n33\t  Bandage,\n34\t  TriangleAlert,\n35\t  Tags,\n36\t  CheckCheck\n37\t} from 'lucide-react';\n38\t\n39\timport {\n40\t  Table,\n41\t  TableBody,\n42\t  TableCell,\n43\t  TableContainer,\n44\t  TableHead,\n45\t  TableRow,\n46\t  Paper,\n47\t} from \"@mui/material\";\n48\t\n49\timport { formatDateString as externalFormatDateString } from \"@/utils/utils\";\n50\timport { formatEpoch, convertFileSize, cometStatus } from \"@/utils/utils\";\n51\timport \"./Asset.css\";\n52\t\n53\t// --- Fallback date formatter (only used if external function missing) ---\n54\tconst fallbackFormatDate = (d) => {\n55\t  try {\n56\t    if (!d) return \"—\";\n57\t    const date = new Date(d);\n58\t    if (Number.isNaN(date.getTime())) return \"—\";\n59\t    return date.toLocaleString();\n60\t  } catch {\n61\t    return \"—\";\n62\t  }\n63\t};\n64\tconst formatDateString = externalFormatDateString || fallbackFormatDate;\n65\t\n66\t// --- Small helpers ---\n67\tconst get = (obj, path, def = undefined) =>\n68\t  path.split(\".\").reduce((o, k) => (o && o[k] !== undefined ? o[k] : def), obj);\n69\t\n70\tconst statusPill = (status) => {\n71\t  const s = (status || \"\").toString().toUpperCase();\n72\t  let colorClass = \"gray\";\n73\t  if (s === \"INSTALLED\" || s === \"ONLINE\" || s === \"ACTIVE\") colorClass = \"green\";\n74\t  else if (s === \"PENDING\") colorClass = \"orange\";\n75\t  else if (s === \"FAILED\" || s === \"OFFLINE\") colorClass = \"red\";\n76\t\n77\t  return (\n78\t    <div className=\"status-container\">\n79\t      <span className={`status-icon ${colorClass}`} />\n80\t      <span>{status || \"Unknown\"}</span>\n81\t    </div>\n82\t  );\n83\t};\n84\t\n85\tconst Asset = () => {\n86\t  const navigate = useNavigate();\n87\t  const { assetId } = useParams();\n88\t\n89\t  // Getting the user account data\n90\t  const {\n91\t      membership,\n92\t      senturiUser\n93\t    } = useAuth();\n94\t    console.log(senturiUser);\n95\t\n96\t  const { loading, error, asset, assetSummary, name } = useAssetPageData(assetId);\n97\t  const {\n98\t    assetPatchDetails,\n99\t    assetPatchDetailsLoading,\n100\t    assetPatchDetailsError,\n101\t  } = useGetAssetPatchDetails(assetId);\n102\t  \n103\t  const {backupJobs, latestBackupJob} = useCometBackupJobs(senturiUser.email);\n104\t  // console.log(backupJobs);\n105\t\n106\t  // Generate scan dates\n107\t  const lastScannedDate = useMemo(() => {\n108\t    const yesterday = new Date();\n109\t    yesterday.setDate(yesterday.getDate() - 1);\n110\t    yesterday.setHours(8);\n111\t    yesterday.setMinutes(Math.floor(Math.random() * 31)); // 0-30 minutes\n112\t    yesterday.setSeconds(0);\n113\t\n114\t    const month = String(yesterday.getMonth() + 1).padStart(2, '0');\n115\t    const day = String(yesterday.getDate()).padStart(2, '0');\n116\t    const year = yesterday.getFullYear();\n117\t    let hours = yesterday.getHours();\n118\t    const minutes = String(yesterday.getMinutes()).padStart(2, '0');\n119\t    const ampm = hours >= 12 ? 'PM' : 'AM';\n120\t    hours = hours % 12 || 12;\n121\t\n122\t    return `${month}/${day}/${year} | ${hours}:${minutes} ${ampm}`;\n123\t  }, []);\n124\t\n125\t  const nextScanDate = useMemo(() => {\n126\t    const tomorrow = new Date();\n127\t    tomorrow.setDate(tomorrow.getDate() + 1);\n128\t    tomorrow.setHours(8);\n129\t    tomorrow.setMinutes(0);\n130\t    tomorrow.setSeconds(0);\n131\t\n132\t    const month = String(tomorrow.getMonth() + 1).padStart(2, '0');\n133\t    const day = String(tomorrow.getDate()).padStart(2, '0');\n134\t    const year = tomorrow.getFullYear();\n135\t    let hours = tomorrow.getHours();\n136\t    const minutes = String(tomorrow.getMinutes()).padStart(2, '0');\n137\t    const ampm = hours >= 12 ? 'PM' : 'AM';\n138\t    hours = hours % 12 || 12;\n139\t\n140\t    return `${month}/${day}/${year} | ${hours}:${minutes} ${ampm}`;\n141\t  }, []);\n142\t\n143\t  const a = asset?.getAsset || {};\n144\t  const summary = assetSummary?.getAssetSummary || {};\n145\t  const disk = summary?.disk || {};\n146\t  const memory = summary?.memory || {};\n147\t  const cpu = summary?.cpu || {};\n148\t\n149\t  console.log(a);\n150\t\n151\t  const patches =\n152\t    assetPatchDetails?.assetPatches ||\n153\t    assetPatchDetails ||\n154\t    [];\n155\t\n156\t  const [notify, setNotify] = useState({\n157\t    open: false,\n158\t    type: 'info',   // 'success' | 'error' | 'warning' | 'info' | 'dark' | 'light'\n159\t    message: ''\n160\t  }); \n161\t\n162\t  // Overlay state\n163\t  const [assetHealthOverlay, setAssetHealthOverlay] = useState(true);\n164\t  \n165\t\n166\t\n167\t  // Search + sort\n168\t  const [searchTerm, setSearchTerm] = useState(\"\");\n169\t  const [sortConfig, setSortConfig] = useState({ key: null, direction: \"asc\" });\n170\t\n171\t  const handleSearch = (e) => setSearchTerm(e.target.value);\n172\t  const handleSort = (key) =>\n173\t    setSortConfig((prev) => ({\n174\t      key,\n175\t      direction: prev.key === key && prev.direction === \"asc\" ? \"desc\" : \"asc\",\n176\t    }));\n177\t\n178\t  const sortedPatches = useMemo(() => {\n179\t    const items = Array.isArray(patches) ? [...patches] : [];\n180\t    if (!sortConfig.key) return items;\n181\t    return items.sort((a, b) => {\n182\t      const va = get(a, sortConfig.key, \"\");\n183\t      const vb = get(b, sortConfig.key, \"\");\n184\t      if (va < vb) return sortConfig.direction === \"asc\" ? -1 : 1;\n185\t      if (va > vb) return sortConfig.direction === \"asc\" ? 1 : -1;\n186\t      return 0;\n187\t    });\n188\t  }, [patches, sortConfig]);\n189\t\n190\t  const filteredPatches = useMemo(() => {\n191\t    const q = searchTerm.trim().toLowerCase();\n192\t    if (!q) return sortedPatches;\n193\t    return sortedPatches.filter((p) =>\n194\t      (p?.patchDetail?.title || \"\").toLowerCase().includes(q)\n195\t    );\n196\t  }, [sortedPatches, searchTerm]);\n197\t\n198\t  // Health score (naive example)\n199\t  const cpuUse = cpu?.cpuUsage?.value ?? null;\n200\t  const memUse = memory?.memoryUsage?.value ?? null;\n201\t  const diskUse = disk?.disks?.[0]?.driveUsage?.value ?? null;\n202\t\n203\t  const utilizations = [cpuUse, memUse, diskUse].filter(\n204\t    (v) => typeof v === \"number\" && !Number.isNaN(v)\n205\t  );\n206\t  const avgUtil = utilizations.length\n207\t    ? utilizations.reduce((s, v) => s + v, 0) / utilizations.length\n208\t    : null;\n209\t  const healthScore =\n210\t    avgUtil != null ? Math.max(0, Math.min(100, Math.round(100 - avgUtil))) : 76;\n211\t\n212\t  /// TICKET CREATION\n213\t  const [formData, setFormData] = useState({\n214\t    subject: \"\",\n215\t    description: \"\",\n216\t    assetId: \"\",\n217\t    machineName: \"\",\n218\t    accountId: \"\",\n219\t  });\n220\t\n221\t  useEffect(() => {\n222\t  setFormData(prev => ({\n223\t    ...prev,\n224\t    assetId: assetId || \"\",\n225\t    machineName: a?.name || \"\",\n226\t    accountId: membership.data.superops_account_id\n227\t  }));\n228\t}, [assetId, a?.name]);\n229\t\n230\t  const handleChange = (e) => {\n231\t    const { name, value } = e.target;\n232\t    setFormData((prev) => ({\n233\t      ...prev,\n234\t      [name]: value,\n235\t    }));\n236\t  };\n237\t\n238\t  // Create Ticket Submission\n239\t  const handleSubmit = async (e, closeModal) => {\n240\t  e.preventDefault();\n241\t  try {\n242\t    const resp = await createTicket(formData);\n243\t    if (resp?.success) {\n244\t      setNotify({ open: true, type: 'success', message: 'Ticket Created Successfully' });\n245\t      closeModal();\n246\t    } else {\n247\t      setNotify({ open: true, type: 'error', message: 'Error creating ticket. Please use chat in lower right hand corner.' });\n248\t    }\n249\t  } catch (err) {\n250\t    setNotify({ open: true, type: 'error', message: 'Unexpected error creating ticket.' });\n251\t  }\n252\t};\n253\t\n254\t  if (loading) {\n255\t    return (\n256\t      <MainLayout title={name || \"Loading...\"} viewClass='asset-view'>\n257\t        <p>Loading asset…</p>\n258\t      </MainLayout>\n259\t    );\n260\t  }\n261\t\n262\t  if (error) {\n263\t    return (\n264\t      <MainLayout title={name || \"Error\"} viewClass='asset-view'>\n265\t        <p>Error loading asset.</p>\n266\t      </MainLayout>\n267\t    );\n268\t  }\n269\t\n270\t  if (assetPatchDetailsLoading) {\n271\t    return (\n272\t      <MainLayout title={a?.name || name || \"Asset\"} viewClass='asset-view'>\n273\t        <p>Loading patches…</p>\n274\t      </MainLayout>\n275\t    );\n276\t  }\n277\t\n278\t  if (assetPatchDetailsError) {\n279\t    return (\n280\t      <MainLayout title={a?.name || name || \"Asset\"} viewClass='asset-view'>\n281\t        <p>Error loading patches.</p>\n282\t      </MainLayout>\n283\t    );\n284\t  }\n285\t\n286\t\n287\t  return (\n288\t    <MainLayout title={a?.name || name || \"Asset\"} viewClass=\"asset-view\">\n289\t      <div className=\"asset\">\n290\t        <div className=\"asset-header\">\n291\t          <div className=\"online-status\">{statusPill(a?.status)}</div>\n292\t\n293\t          <div className=\"asset-status\">\n294\t            <i className=\"bx bx-time-five\" />\n295\t            <strong>\n296\t              <Clock size={18} /> Last Check In:&nbsp;\n297\t            </strong>\n298\t            <span>{formatDateString(a?.lastCommunicatedTime)}</span>\n299\t          </div>\n300\t\n301\t          <div className=\"asset-status\">\n302\t            <i className=\"bx bx-hdd\" />\n303\t            <strong>\n304\t              <FolderLock size={20} /> Last Backup:&nbsp;\n305\t            </strong>\n306\t            <span>{formatEpoch(latestBackupJob?.StartTime)}</span>\n307\t          </div>\n308\t\n309\t          <div className=\"asset-actions\">\n310\t            {/* <button className=\"view-btn\" onClick={() => navigate(\"/backups\")}>\n311\t              View Backups\n312\t            </button> */}\n313\t\n314\t            <SlideOut buttonText=\"View Backups\" buttonClassName=\"view-btn\">\n315\t              <h2>Asset Backup History</h2>\n316\t              <br />\n317\t              <table className=\"backup-table\">\n318\t                <colgroup>\n319\t                  <col style={{ width: \"40%\" }} /> {/* Date/Time */}\n320\t                  <col style={{ width: \"25%\" }} /> {/* File Size */}\n321\t                  <col style={{ width: \"25%\" }} /> {/* File Count */}\n322\t                  <col style={{ width: \"25%\" }} /> {/* File Count */}\n323\t                </colgroup>\n324\t\n325\t                <thead>\n326\t                  <tr>\n327\t                    <th>Date/Time</th>\n328\t                    <th>File Size</th>\n329\t                    <th>File Count</th>\n330\t                    <th>Status</th>\n331\t                  </tr>\n332\t                </thead>\n333\t\n334\t                <tbody>\n335\t                  {backupJobs &&\n336\t                    backupJobs.map((job) => (\n337\t                      <tr key={job.GUID || job.SnapshotID}>\n338\t                        <td>{formatEpoch(job.StartTime)}</td>\n339\t                        <td>{convertFileSize(job.TotalSize)}</td>\n340\t                        <td>{job.TotalFiles}</td>\n341\t                        <td>{cometStatus(job.Status)}</td>\n342\t                      </tr>\n343\t                    ))}\n344\t                </tbody>\n345\t              </table>\n346\t            </SlideOut>\n347\t\n348\t            <SlideOut\n349\t              buttonText=\"View Device Details\"\n350\t              buttonClassName=\"view-btn\"\n351\t            >\n352\t              <h2>Device Details</h2>\n353\t              <br />\n354\t              <table className=\"asset-table\">\n355\t                <tbody>\n356\t                  <tr>\n357\t                    <td>ID#:</td>\n358\t                    <td>{a?.assetId || \"—\"}</td>\n359\t                  </tr>\n360\t                  <tr>\n361\t                    <td>Logged in as:</td>\n362\t                    <td>{a?.loggedInUser || \"—\"}</td>\n363\t                  </tr>\n364\t                  <tr>\n365\t                    <td>Device Model:</td>\n366\t                    <td>{a?.model || \"—\"}</td>\n367\t                  </tr>\n368\t                  <tr>\n369\t                    <td>OS Version: