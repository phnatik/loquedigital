\t              <View style={styles.badgeRow}>\n105\t                <View style={styles.badge}>\n106\t                  <View style={styles.badgeDot} />\n107\t                  <Text style={styles.badgeText}>SECURE LOGIN</Text>\n108\t                </View>\n109\t              </View>\n110\t\n111\t            </SafeAreaView>\n112\t          </View>\n113\t\n114\t          {/* ── Bottom: White form card ── */}\n115\t          <View style={styles.formSection}>\n116\t            <Text style={styles.title}>Welcome Back</Text>\n117\t            <Text style={styles.subtitle}>\n118\t              Sign in to your Senturi dashboard\n119\t            </Text>\n120\t            {/* Email field */}\n121\t            <Text style={styles.label}>Email</Text>\n122\t            <View style={styles.inputWrap}>\n123\t              <Ionicons\n124\t                name=\"mail-outline\"\n125\t                size={18}\n126\t                color=\"#94a3b8\"\n127\t                style={styles.inputIcon}\n128\t              />\n129\t              <TextInput\n130\t                value={email}\n131\t                onChangeText={setEmail}\n132\t                placeholder=\"you@company.com\"\n133\t                placeholderTextColor=\"#94a3b8\"\n134\t                autoCapitalize=\"none\"\n135\t                keyboardType=\"email-address\"\n136\t                autoComplete=\"email\"\n137\t                textContentType=\"emailAddress\"\n138\t                style={styles.textInput}\n139\t              />\n140\t            </View>\n141\t\n142\t            {/* Password field */}\n143\t            <Text style={styles.label}>Password</Text>\n144\t            <View style={styles.inputWrap}>\n145\t              <Ionicons\n146\t                name=\"lock-closed-outline\"\n147\t                size={18}\n148\t                color=\"#94a3b8\"\n149\t                style={styles.inputIcon}\n150\t              />\n151\t              <TextInput\n152\t                value={password}\n153\t      