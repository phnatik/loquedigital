ule-head\">\n          <div>\n            <span class=\"label\">`king · powered by your scheduling plugin</span>\n            <h4>All upcoming classes</h4>\n          </div>\n          <div class=\"actions\">\n            <div class=\"schedule-tabs\">\n              <button class=\"schedule-tab active\" data-filter=\"all\">All</button>\n              <button class=\"schedule-tab\" data-filter=\"level1\">Level 1 / 2</button>\n              <button class=\"schedule-tab\" data-filter=\"bsdr\">BAR Repair</button>\n              <button class=\"schedule-tab\" data-filter=\"update\">Update</button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"schedule-list\" id=\"schedule-list\">\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">JUN 14<small>Sat · 8a–4p</small></div>\n            <div class=\"info\"><h5>UT079 · Transmission Diagnosis</h5><div class=\"sub\">Repair Tech Update · 12 hrs over 2 sessions</div></div>\n            <div class=\"mode\">Online + Lab</div>\n            <div class=\"seats low\">3 SEATS LEFT</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">JUN 28<small>Sat · 9a–5p</small></div>\n            <div class=\"info\"><h5>Inspector Update · IS-Q2 2026</h5><div class=\"sub\">8 hrs · EIS firmware + procedural changes</div></div>\n            <div class=\"mode\">Online</div>\n            <div class=\"seats open\">14 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"level1\">\n            <div class=\"date\">JUL 07<small>Mon · 6-week</small></div>\n            <div class=\"info\"><h5>Level 1 Smog Check Inspector</h5><div class=\"sub\">120 hrs · 6-week cohort · Online lecture + in-person lab</div></div>\n            <div class=\"mode\">Hybrid<