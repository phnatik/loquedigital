 = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n  const videoRef = useRef(null);\n\n  const [fontsLoaded] = useFonts({\n    PlusJakartaSans_400Regular,\n    PlusJakartaSans_500Medium,\n    PlusJakartaSans_600SemiBold,\n    PlusJakartaSans_700Bold,\n    PlusJakartaSans_800ExtraBold,\n    Montserrat_400Regular,\n    Montserrat_900Black,\n  });\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const f = fontsLoaded ? {\n    extraBold: { fontFamily: 'PlusJakartaSans_800ExtraBold' },\n    bold: { fontFamily: 'PlusJakartaSans_700Bold' },\n    semiBold: { fontFamily: 'PlusJakartaSans_600SemiBold' },\n    medium: { fontFamily: 'PlusJakartaSans_500Medium' },\n    regular: { fontFamily: 'PlusJakartaSans_400Regular' },\n    montBold: { fontFamily: 'Montserrat_900Black' },\n  } : {\n    extraBold: { fontWeight: '800' },\n    bold: { fontWeight: '700' },\n    semiBold: { fontWeight: '600' },\n    medium: { fontWeight: '500' },\n    regular: { fontWeight: '400' },\n    montBold: { fontWeight: '900' },\n  };\n\n  return (\n    <View style={styles.root}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n          bounces={false}\n        >\n          {/* ── Top: Video hero ── */}\n          <View style={styles.heroSection}>\n            <Video\n              ref={videoRef}\n              source={bgVideo}\n              style={styles.bgVideo}\n              resizeMode={ResizeMode.COVER}\n              shouldPlay\n              isLooping\n              isMuted\n              rate={0.8}\n            />\n\n            {/* Dark overlay */}\n            <LinearGradient\n              colors={[\n                'rgba(12, 29, 39, 0.96)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.88)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.96)',\n              ]}\n              locations={[0, 0.25, 0.5, 0.75, 1]}\n              start={{ x: 0.2, y: 0 }}\n              end={{ x: 0.8, y: 1 }}\n              style={StyleSheet.absoluteFill}\n            />\n\n            {/* Hero content */}\n            <SafeAreaView style={styles.heroContent} edges={['top']}>\n              <View style={styles.brandWrap}>\n                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n                <Text style={[styles.tagline, f.medium]}>\n                  Managed protection, in your pocket.\n                </Text>\n              </View>\n\n              {/* Secure badge with shield */}\n              <View style={styles.badgeRow}>\n                <View style={styles.badge}>\n                  <Ionicons name=\"shield-checkmark\" size={13} color={colors.primary} style={{ marginRight: 6 }} />\n                  <Text style={[styles.badgeText, f.bold]}>SECURE LOGIN</Text>\n                </View>\n              </View>\n            </SafeAreaView>\n          </View>\n\n          {/* ── Gradient accent line ── */}\n          <LinearGradient\n            colors={gradients.brand}\n            start={{ x: 0, y: 0 }}\n            end={{ x: 1, y: 0 }}\n            style={styles.accentLine}\n          />\n\n          {/* ── Bottom: White form card ── */}\n          <View style={styles.formSection}>\n            {/* Heading with lock icon */}\n            <View style={styles.headingRow}>\n              <View style={styles.headingIconWrap}>\n                <Ionicons name=\"lock-closed\" size={16} color={colors.secondary} />\n              </View>\n              <View>\n                <Text style={[styles.title, f.extraBold]}>Welcome Back</Text>\n                <Text style={[styles.subtitle, f.regular]}>\n                  Sign in to your Senturi dashboard\n                </Text>\n              </View>\n            </View>\n\n            {/* Email field */}\n            <Text style={[styles.label, f.semiBold]}>EMAIL ADDRESS</Text>\n            <View style={styles.inputWrap}>\n              <View style={styles.inputIconWrap}>\n                <Ionicons name=\"mail-outline\" size={16} color={colors.secondary} />\n              </View>\n              <TextInput\n                value={email}\n                onChangeText={setEmail}\n                placeholder=\"you@company.com\"\n                placeholderTextColor=\"#b0bec5\"\n                autoCapitalize=\"none\"\n                keyboardType=\"email-address\"\n                autoComplete=\"email\"\n                textContentType=\"emailAddress\"\n                style={[styles.textInput, f.regular]}\n              />\n            </View>\n\n            {/* Password field */}\n            <Text style={[styles.label, f.semiBold]}>PASSWORD</Text>\n            <View style={styles.inputWrap}>\n              <View style={styles.inputIconWrap}>\n                <Ionicons name=\"lock-closed-outline\" size={16} color={colors.secondary} />\n              </View>\n              <TextInput\n                value={password}\n                onChangeText={setPassword}\n                placeholder=\"Enter your password\"\n                placeholderTextColor=\"#b0bec5\"\n                secureTextEntry={secureEntry}\n                autoComplete=\"password\"\n                textContentType=\"password\"\n                style={[styles.textInput, f.regular]}\n              />\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"#94a3b8\"\n                />\n              </Pressable>\n            </View>\n\n            {/* Error */}\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n                <Text style={[styles.errorText, f.medium]}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Sign in button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <>\n                    <Ionicons name=\"log-in-outline\" size={20} color=\"#fff\" style={{ marginRight: 8 }} />\n                    <Text style={[styles.btnText, f.bold]}>Sign in</Text>\n                  </>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            {/* Footer */}\n            <View style={styles.footerWrap}>\n              <View style={styles.footerDivider}>\n                <View style={styles.dividerLine} />\n                <Ionicons name=\"shield-half-outline\" size={14} color=\"#d0d6dc\" style={{ marginHorizontal: 12 }} />\n                <View style={styles.dividerLine} />\n              </View>\n              <Text style={[styles.helper, f.regular]}>\n                Accounts are provisioned by Senturi.{'\\n'}Contact your\n                administrator if you can't sign in.\n              </Text>\n              <Text style={[styles.footerBrand, f.semiBold]}>\n                SENTURI\n              </Text>\n            </View>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  root: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: { flexGrow: 1 },\n\n  /* ── Hero (video) section ── */\n  heroSection: {\n    minHeight: SCREEN_H * 0.40,\n    justifyContent: 'center',\n    overflow: 'hidden',\n  },\n  bgVideo: {\n    ...StyleSheet.absoluteFillObject,\n  },\n  heroContent: {\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xl,\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    color: 'rgba(255,255,255,0.6)',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center' },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.12)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.25)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeText: {\n    fontSize: 10,\n    color: colors.primary,\n    letterSpacing: 1.5,\n  },\n\n  /* ── Gradient accent line ── */\n  accentLine: {\n    height: 3,\n  },\n\n  /* ── Form section (white card) ── */\n  formSection: {\n    backgroundColor: '#ffffff',\n    paddingTop: spacing.xl,\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxxl,\n    flex: 1,\n  },\n\n  /* Heading */\n  headingRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.xxl,\n  },\n  headingIconWrap: {\n    width: 40,\n    height: 40,\n    borderRadius: 20,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  title: {\n    fontSize: 24,\n    color: colors.textDark,\n    letterSpacing: -0.5,\n  },\n  subtitle: {\n    fontSize: 13,\n    color: '#94a3b8',\n    marginTop: 2,\n    lineHeight: 18,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 11,\n    color: '#8c9ea9',\n    marginBottom: spacing.sm,\n    letterSpacing: 1.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.md,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIconWrap: {\n    width: 32,\n    height: 32,\n    borderRadius: radius.sm,\n    backgroundColor: 'rgba(38, 144, 188, 0.06)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderWidth: 1,\n    borderColor: 'rgba(225, 64, 110, 0.12)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Footer */\n  footerWrap: {\n    marginTop: spacing.xxl,\n    alignItems: 'center',\n  },\n  footerDivider: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    width: '100%',\n    marginBottom: spacing.lg,\n  },\n  dividerLine: {\n    flex: 1,\n    height: 1,\n    backgroundColor: '#e8ecf0',\n  },\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    lineHeight: 18,\n  },\n  footerBrand: {\n    fontSize: 10,\n    color: '#c8d0d8',\n    letterSpacing: 3,\n    marginTop: spacing.md,\n  },\n});\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" // app/(auth)/login.jsx — split login: video hero top + white form bottom."," // Uses Plus Jakarta Sans (login page font from web portal) + Montserrat for accents.","-import { useState, useRef, useCallback } from 'react';","+import { useState, useRef } from 'react';"," import {","   View,","   Text,"]},{"oldStart":73,"oldLines":7,"newStart":73,"newLines":6,"lines":["     }","   };"," ","-  // Font-aware text styles (fallback gracefully if fonts haven't loaded yet)","   const f = fontsLoaded ? {","     extraBold: { fontFamily: 'PlusJakartaSans_800ExtraBold' },","     bold: { fontFamily: 'PlusJakartaSans_700Bold' },"]},{"oldStart":103,"oldLines":7,"newStart":102,"newLines":6,"lines":["         >","           {/* ── Top: Video hero ── */}","           <View style={styles.heroSection}>","-            {/* Video */}","             <Video","               ref={videoRef}","               source={bgVideo}"]},{"oldStart":132,"oldLines":7,"newStart":130,"newLines":6,"lines":[" ","             {/* Hero content */}","             <SafeAreaView style={styles.heroContent} edges={['top']}>","-              {/* Brand */}","               <View style={styles.brandWrap}>","                 <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />","                 <Text style={[styles.tagline, f.medium]}>"]},{"oldStart":140,"oldLines":38,"newStart":137,"newLines":50,"lines":["                 </Text>","               </View>"," ","-              {/* Badge */}","+              {/* Secure badge with shield */}","               <View style={s