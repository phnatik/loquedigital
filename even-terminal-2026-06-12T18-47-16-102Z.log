* Forgot password removed but keeping for future use */\n68\t.forgot-pw-link{\n69\t    text-decoration: none!important;\n70\t    color: #64748b!important;\n71\t    transition: color 0.2s ease;\n72\t    font-size: 14px;\n73\t}\n74\t\n75\t.forgot-pw-link:hover {\n76\t    color: var(--secondary-color)!important;\n77\t    text-decoration: underline!important;\n78\t}\n79\t\n80\t.input-wrapper {\n81\t    position: relative;\n82\t    margin-bottom: 1.25rem;\n83\t}\n84\t\n85\t.input-wrapper label {\n86\t    display: block;\n87\t    font-size: 14px;\n88\t    margin-bottom: 8px;\n89\t    color: #1a2332;\n90\t    font-weight: 600;\n91\t    font-family: 'Plus Jakarta Sans', sans-serif;\n92\t}\n93\t\n94\t.input-wrapper input {\n95\t    width: 100%;\n96\t    padding: 13px 0.75rem 13px 48px;\n97\t    border-radius: 10px;\n98\t    border: 1.5px solid #e8eaed;\n99\t    font-size: 15px;\n100\t    box-sizing: border-box;\n101\t    background-color: #fff;\n102\t    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n103\t    color: #1a2332;\n104\t}\n105\t\n106\t.input-wrapper input::placeholder {\n107\t    color: #9ca3af;\n108\t}\n109\t\n110\t.input-wrapper input:focus {\n111\t    outline: none;\n112\t    border-color: var(--secondary-color);\n113\t    box-shadow: 0 0 0 3px rgba(38, 144, 188, 0.1);\n114\t    background-color: #ffffff;\n115\t}\n116\t\n117\t.input-icon {\n118\t    position: absolute;\n119\t    top: 35px;\n120\t    left: 12px;\n121\t    background: rgba(38, 144, 188, 0.08);\n122\t    padding: 7px;\n123\t    border-radius: 8px;\n124\t    display: flex;\n125\t    align-items: center;\n126\t    justify-content: center;\n127\t    z-index: 1;\n128\t}\n129\t\n130\t.input-icon svg {\n131\t    color: var(--secondary-color);\n132\t    width: 18px;\n133\t    height: 18px;\n134\t}\n135\t\n136\tinput:-webkit-autofill {\n137\t    -webkit-box-shadow: 0 0 0px 1000px white inset !important;\n138\t    box-shadow: 0 0 0px 1000px white inset !important;\n139\t    -webkit-text-fill-color: #2F5064 !important;\n140\t}\n141\t\n142\t/* .gradient-box {\n143\t    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));\n144\t    border-radius: 24px;\n145\t    padding: 3rem;\n146\t    width: 100%;\n147\t    height: 100%;\n148\t    display: flex;\n149\t    align-items: flex-end;\n150\t    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);\n151\t\n152\t    transform: translateX(-100%);\n153\t    animation: slideInLeft 0.5s ease-out forwards;\n154\t} */\n155\t\n156\t.gradient-box {\n157\t    background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));\n158\t    border-radius: 24px;\n159\t    padding: 3rem;\n160\t    width: 100%;\n161\t    height: 100%;\n162\t    display: flex;\n163\t    align-items: flex-end;\n164\t    box-shadow: 0 20px 40px -9.6px rgba(38, 144, 188, 0.25);\n165\t    transform: translateX(-100%);\n166\t    animation: slideInLeft 0.5s ease-out forwards;\n167\t}\n168\t\n169\t.branding {\n170\t    color: #fff;\n171\t}\n172\t\n173\t.branding h1 {\n174\t    font-weight: 900;\n175\t    font-size: 110px;\n176\t    font-family: 'Montserrat', sans-serif;\n177\t    /* line-height: 88px; */\n178\t    line-height: 92px;\n179\t    margin: 0;\n180\t    text-transform: uppercase;\n181\t    position: relative;\n182\t    top: -242px;\n183\t    letter-spacing: -2px;\n184\t}\n185\t\n186\t.simple, .safe, .secure{\n187\t    /* font-weight: 900;\n188\t    font-size: 126px;\n189\t    font-family: 'Montserrat', sans-serif;\n190\t    line-height: 104px; */\n191\t\n192\t    font-weight: 900;\n193\t    font-size: 105px;\n194\t    font-family: 'Montserrat', sans-serif;\n195\t    line-height: 85px;\n196\t}\n197\t\n198\t.simple{\n199\t    opacity: 25%;\n200\t}\n201\t\n202\t.safe{\n203\t    opacity: 55%;\n204\t    margin-left: 40px;\n205\t}\n206\t\n207\t.secure{\n208\t    opacity: 90%;\n209\t}\n210\t\n211\t/* Emphasis styles for different pages */\n212\t.simple-emphasis {\n213\t    opacity: 100% !important;\n214\t}\n215\t\n216\t.secure-emphasis {\n217\t    opacity: 100% !important;\n218\t}\n219\t\n220\t.branding p {\n221\t    font-weight: 400;\n222\t    font-size: 1rem;\n223\t    margin-top: 1.5rem;\n224\t    position: relative;\n225\t    top: -241px;\n226\t    font-size: 20px;\n227\t    line-height: 26px;\n228\t}\n229\t\n230\t.login-right {\n231\t    width: 100%;\n232\t    max-width: 480px;\n233\t    display: flex;\n234\t    align-items: center;\n235\t    justify-content: center;\n236\t}\n237\t\n238\t/* change here */\n239\t/* .login-right::before {\n240\t    content: '';\n241\t    position: absolute;\n242\t    top: 0;\n243\t    right: -490px;\n244\t    width: 300px;\n245\t    height: 100%;\n246\t    background: var(--secondary-color);\n247\t    filter: blur(280px);\n248\t    z-index: 0; \n249\t} */\n250\t\n251\t.login-left::before{\n252\t \n253\t    content: '';\n254\t    position: absolute;\n255\t    top: 0;\n256\t    left: 0px;\n257\t    width: 200px;\n258\t    height: 100%;\n259\t    /* background: var(--primary-color); */\n260\t        filter: blur(280px);\n261\t    z-index: 0; \n262\t}\n263\t\n264\t\n265\t/* .login-right::before {\n266\t    content: '';\n267\t    position: absolute;\n268\t    top: 0;\n269\t    right: 490px;\n270\t    width: 300px;\n271\t    height: 100%;\n272\t    background: var(--primary-color);\n273\t    filter: blur(280px);\n274\t    z-index: 0; \n275\t} */\n276\t\n277\t.login-form {\n278\t    width: 100%;\n279\t    display: flex;\n280\t    flex-direction: column;\n281\t    gap: 1rem;\n282\t    position: relative;\n283\t    background: #ffffff;\n284\t    padding: 48px 40px;\n285\t    border-radius: 20px;\n286\t    box-shadow: 0 20px 40px -9.6px rgba(0, 0, 0, 0.08);\n287\t    border: 1px solid rgba(226, 232, 240, 0.6);\n288\t}\n289\t\n290\t.login-logo {\n291\t    max-width: 200px;\n292\t    display: block;\n293\t    margin: 0 auto 1.5rem auto;\n294\t}\n295\t\n296\t.login-brand {\n297\t    /* max-width: 50px; */\n298\t    max-width: 60px;\n299\t    display: block;\n300\t    margin: 0 auto 1.5rem auto;\n301\t}\n302\t\n303\t.auth-badge {\n304\t    display: inline-flex;\n305\t    align-items: center;\n306\t    gap: 8px;\n307\t    font-family: 'Plus Jakarta Sans', sans-serif;\n308\t    font-size: 12px;\n309\t    font-weight: 600;\n310\t    letter-spacing: 0.05em;\n311\t    text-transform: uppercase;\n312\t    color: var(--secondary-color);\n313\t    margin: 0 auto 16px auto;\n314\t    padding: 6px 14px;\n315\t    background: rgba(38, 144, 188, 0.08);\n316\t    border-radius: 20px;\n317\t    border: 1px solid rgba(38, 144, 188, 0.2);\n318\t}\n319\t\n320\t.auth-badge-dot {\n321\t    width: 6px;\n322\t    height: 6px;\n323\t    background: var(--secondary-color);\n324\t    border-radius: 50%;\n325\t    animation: pulse 2s infinite;\n326\t}\n327\t\n328\t.auth-badge-text {\n329\t    line-height: 1;\n330\t}\n331\t\n332\t.login-form label {\n333\t    font-size: 0.9rem;\n334\t}\n335\t\n336\t.login-form input {\n337\t    padding: 0.75rem 20px 0.75rem 50px;\n338\t    border-radius: 6px;\n339\t    border: 1px solid #ccc;\n340\t    font-size: 1rem;\n341\t    color: #2F5064;\n342\t}\n343\t\n344\t.login-form button {\n345\t    padding: 18px;\n346\t    border-radius: 10px;\n347\t    border: none;\n348\t    background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));\n349\t    color: #fff;\n350\t    font-family: 'Plus Jakarta Sans', sans-serif;\n351\t    font-size: 16px;\n352\t    font-weight: 600;\n353\t    cursor: pointer;\n354\t    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n355\t    box-shadow: 0 3.2px 11.2px 0 rgba(38, 144, 188, 0.3);\n356\t    position: relative;\n357\t    overflow: hidden;\n358\t    isolation: isolate;\n359\t}\n360\t\n361\t.login-form button::before {\n362\t    content: '';\n363\t    position: absolute;\n364\t    top: 0;\n365\t    left: 0;\n366\t    right: 0;\n367\t    bottom: 0;\n368\t    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));\n369\t    opacity: 0;\n370\t    transition: opacity 0.3s ease;\n371\t    z-index: -1;\n372\t}\n373\t\n374\t.login-form button:hover::before {\n375\t    opacity: 1;\n376\t}\n377\t\n378\t.login-form button:hover {\n379\t    color: var(--white) !important;\n380\t    transform: translateY(-2px);\n381\t    box-shadow: 0 6.4px 19.2px 0 rgba(38, 144, 188, 0.5);\n382\t}\n383\t\n384\t.login-form button > * {\n385\t    position: relative;\n386\t    z-index: 1;\n387\t    color: var(--white) !important;\n388\t}\n389\t\n390\t.login-form button:disabled {\n391\t    opacity: 0.6;\n392\t    cursor: not-allowed;\n393\t    transform: none;\n394\t}\n395\t\n396\t.login-footer {\n397\t    display: flex;\n398\t    justify-content: center;\n399\t    font-size: 0.9rem;\n400\t    margin-top: 16px;\n401\t    color: #64748b;\n402\t    text-align: center;\n403\t}\n404\t\n405\t.login-footer a {\n406\t    color: #666;\n407\t    text-decoration: none;\n408\t}\n409\t\n410\t.logout-message {\n411\t    background: rgba(55, 170, 122, 0.08);\n412\t    width: 100%;\n413\t    padding: 14px 20px;\n414\t    text-align: center;\n415\t    border-radius: 10px;\n416\t    margin-bottom: 20px;\n417\t    color: #1a2332;\n418\t    font-size: 0.9rem;\n419\t    border: 1px solid rgba(55, 170, 122, 0.2);\n420\t}\n421\t\n422\t/* Terms checkbox */\n423\t.terms-checkbox {\n424\t    display: flex;\n425\t    align-items: flex-start;\n426\t    gap: 10px;\n427\t    cursor: pointer;\n428\t    font-size: 14px;\n429\t    color: #64748b;\n430\t    position: relative;\n431\t    user-select: none;\n432\t}\n433\t\n434\t.terms-checkbox input[type=\"checkbox\"] {\n435\t    position: absolute;\n436\t    opacity: 0;\n437\t    width: 0;\n438\t    height: 0;\n439\t    pointer-events: none;\n440\t}\n441\t\n442\t.terms-checkmark {\n443\t    width: 20px;\n444\t    height: 20px;\n445\t    min-width: 20px;\n446\t    border-radius: 5px;\n447\t    border: 1.5px solid #e8eaed;\n448\t    background: #fff;\n449\t    display: flex;\n450\t    align-items: center;\n451\t    justify-content: center;\n452\t    transition: all 0.2s ease;\n453\t    position: relative;\n454\t    top: 1px;\n455\t}\n456\t\n457\t.terms-checkmark::after {\n458\t    content: '';\n459\t    display: none;\n460\t    width: 5px;\n461\t    height: 9px;\n462\t    border: solid #fff;\n463\t    border-width: 0 2px 2px 0;\n464\t    transform: rotate(45deg);\n465\t    position: relative;\n466\t    top: -1px;\n467\t}\n468\t\n469\t.terms-checkbox input[type=\"checkbox\"]:checked ~ .terms-checkmark {\n470\t    background: var(--primary-color);\n471\t    border-color: var(--primary-color);\n472\t}\n473\t\n474\t.terms-checkbox input[type=\"checkbox\"]:checked ~ .terms-checkmark::after {\n475\t    display: block;\n476\t}\n477\t\n478\t.terms-text {\n479\t    line-height: 22px;\n480\t}\n481\t\n482\t.terms-text a {\n483\t    color: var(--secondary-color) !important;\n484\t    font-weight: 600;\n485\t    text-decoration: none !important;\n486\t    transition: color 0.2s ease;\n487\t}\n488\t\n489\t.terms-text a:hover {\n490\t    color: var(--primary-color) !important;\n491\t    text-decoration: underline !important;\n492\t}\n493\t\n494\t.login-policy {\n495\t    display: flex;\n496\t    justify-content: center;\n497\t    font-size: 0.9rem;\n498\t    margin-top: 16px;\n499\t    color: #64748b;\n500\t    text-align: center;\n501\t}\n502\t\n503\t.login-policy a {\n504\t    color: #666;\n505\t    text-decoration: none;\n506\t}\n507\t\n508\t\n509\t\n510\t/* Floating Cards */\n511\t.auth-float-card {\n512\t    position: absolute;\n513\t    background: rgba(255, 255, 255, 0.95);\n514\t    backdrop-filter: blur(10px);\n515\t    border-radius: 12px;\n516\t    padding: 16px;\n517\t    display: flex;\n518\t    align-items: center;\n519\t    gap: 12px;\n520\t    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);\n521\t    border: 1px solid rgba(255, 255, 255, 0.8);\n522\t    z-index: 10;\n523\t    min-width: 180px;\n524\t}\n525\t\n526\t.auth-float-card-1 {\n527\t    top: 25%;\n528\t    right: -90px;\n529\t    animation: floatCard1 3s ease-in-out infinite;\n530\t}\n531\t\n532\t.auth-float-card-2 {\n533\t    bottom: 30%;\n534\t    right: -90px;\n535\t    animation: floatCard2 3.5s ease-in-out infinite;\n536\t}\n537\t\n538\t.float-card-icon {\n539\t    width: 42px;\n540\t    height: 42px;\n541\t    border-radius: 10px;\n542\t    display: flex;\n543\t    align-items: center;\n544\t    justify-content: center;\n545\t    flex-shrink: 0;\n546\t}\n547\t\n548\t.float-card-icon.green {\n549\t    background: rgba(55, 170, 122, 0.15);\n550\t    color: var(--primary-color);\n551\t}\n552\t\n553\t.float-card-icon.blue {\n554\t    background: rgba(38, 144, 188, 0.15);\n555\t    color: var(--secondary-color);\n556\t}\n557\t\n558\t.float-card-content h4 {\n559\t    font-family: 'Plus Jakarta Sans', sans-serif;\n560\t    font-size: 14px;\n561\t    font-weight: 600;\n562\t    color: #1a2332;\n563\t    margin: 0 0 2px 0;\n564\t}\n565\t\n566\t.float-card-content p {\n567\t    font-size: 12px;\n568\t    color: #64748b;\n569\t    margin: 0;\n570\t}\n571\t\n572\t@keyframes floatCard1 {\n573\t    0%, 100% {\n574\t        transform: translateY(0px);\n575\t    }\n576\t    50% {\n577\t        transform: translateY(-10px);\n578\t    }\n579\t}\n580\t\n581\t@keyframes floatCard2 {\n582\t    0%, 100% {\n583\t        transform: translateY(0px);\n584\t    }\n585\t    50% {\n586\t        transform: translateY(-15px);\n587\t    }\n588\t}\n589\t\n590\t@keyframes slideInLeft {\n591\t    from {\n592\t        transform: translateX(-100%);\n593\t        opacity: 0;\n594\t    }\n595\t\n596\t    to {\n597\t        transform: translateX(0);\n598\t        opacity: 1;\n599\t    } }\n600\t\n601\t@media (max-width: 768px) {\n602\t    .login-page {\n603\t        padding: 1rem;\n604\t    }\n605\t\n606\t    .login-form {\n607\t        padding: 32px 24px;\n608\t    }\n609\t\n610\t    .login-right {\n611\t        max-width: 100%;\n612\t    }\n613\t}"}]},"parent_tool_use_id":"toolu_01BJpUKftMt6VmsNsdKLeEez","sessi