setError(null);\n38\t    try {\n39\t      const list = await getJobsForUser(email);\n40\t      const sorted = [...list].sort(\n41\t        (a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0),\n42\t      );\n43\t      setJobs(sorted);\n44\t    } catch (err) {\n45\t      setError(err?.message || 'Could not load backup history.');\n46\t    } finally {\n47\t      setLoading(false);\n48\t      setRefreshing(false);\n49\t    }\n50\t  }, [email]);\n51\t\n52\t  useFocusEffect(\n53\t    useCallback(() => {\n54\t      load();\n55\t    }, [load]),\n56\t  );\n57\t\n58\t  const onRefresh = () => {\n59\t    setRefreshing(true);\n60\t    load();\n61\t  };\n62\t\n63\t  const latest = useMemo(() => jobs[0], [jobs]);\n64\t\n65\t  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n66\t\n67\t  const renderItem = ({ item }) => {\n68\t    const s = statusStyle(item.Status);\n69\t    return (\n70\t      <Card style={styles.jobCard}>\n71\t        <View style={[styles.statusIcon, { backgroundColor: `${s.color}14` }]}>\n72\t          <Ionicons name={s.icon} size={22} color={s.color} />\n73\t        </View>\n74\t        <View style={{ flex: 1 }}>\n75\t          <Text style={styles.jobTitle} numberOfLines={1}>\n76\t            {item.FriendlyName || 'Backup'}\n77\t          </Text>\n78\t          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n79\t          <Text style={styles.jobMeta}>\n80\t            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n81\t          </Text>\n82\t        </View>\n83\t        <View style={[styles.statusBadge, { backgroundColor: `${s.color}18` }]}>\n84\t          <Text style={[styles.jobStatus, { color: s.color }]}>\n85\t            {cometStatus(item.Status)}\n86\t          </Text>\n87\t        </View>\n88\t      </Card>\n89\t    );\n90\t  };\n91\t\n92\t  return (\n93\t    <View style={styles.container}>\n94\t      <FlatList\n95\t        data={jobs}\n96\t        keyExtractor={(item, idx) =>\n97\t          String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)\n98\t        }\n99\t        renderItem={renderItem}\n100\t        contentContainerStyle={styles.listContent}\n101\t        refreshControl={\n102\t          <RefreshControl\n103\t            refreshing={refreshing}\n104\t            onRefresh={onRefresh}\n105\t            tintColor={colors.primary}\n106\t          />\n107\t        }\n108\t        ListHeaderComponent={\n109\t          jobs.length ? (\n110\t            <View style={styles.header}>\n111\t              <Text style={styles.headerTitle}>Backup History</Text>\n112\t              <Text style={styles.headerSub}>\n113\t                {jobs.length} backup{jobs.length === 1 ? '' : 's'} · last{' '}\n114\t                {formatEpoch(latest?.StartTime)}\n115\t              </Text>\n116\t            </View>\n117\t          ) : null\n118\t        }\n119\t        ListEmptyComponent={\n120\t          error ? (\n121\t            <EmptyState title=\"Something went wrong\" subtitle={error} />\n122\t          ) : (\n123\t            <EmptyState\n124\t              title=\"No backups found\"\n125\t              subtitle=\"Backup activity will show up here.\"\n126\t            />\n127\t          )\n128\t        }\n129\t      />\n130\t    </View>\n131\t  );\n132\t}\n133\t\n134\tconst styles = StyleSheet.create({\n135\t  container: { flex: 1, backgroundColor: colors.background },\n136\t  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n137\t  header: { marginBottom: spacing.lg },\n138\t  headerTitle: { ...typography.title },\n139\t  headerSub: { ...typography.caption, marginTop: spacing.xs },\n140\t  jobCard: {\n141\t    flexDirection: 'row',\n142\t    alignItems: 'center',\n143\t    marginBottom: spacing.md,\n144\t    paddingVertical: spacing.lg,\n145\t    paddingHorizontal: spacing.lg,\n146\t  },\n147\t  statusIcon: {\n148\t    width: 44,\n149\t    height: 44,\n150\t    borderRadius: radius.md,\n151\t    alignItems: 'center',\n152\t    justifyCon