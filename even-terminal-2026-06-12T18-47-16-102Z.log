ce={brandWhiteLogo} style={styles.logo} resizeMode=\"contain\" />\n53\t            <Text style={styles.tagline}>Managed protection, in your pocket.</Text>\n54\t          </View>\n55\t\n56\t          <View style={styles.formCard}>\n57\t            {/* Security badge — mirrors web portal's \"Secure Login\" pill */}\n58\t            <View style={styles.badgeRow}>\n59\t              <View style={styles.badge}>\n60\t                <View style={styles.badgeDot} />\n61\t                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n62\t              </View>\n63\t            </View>\n64\t\n65\t            <Text style={styles.formTitle}>Welcome Back</Text>\n66\t            <Text style={styles.formSubtitle}>\n67\t              Sign in to your Senturi dashboard\n68\t            </Text>\n69\t\n70\t            <Field\n71\t              label=\"Email\"\n72\t              value={email}\n73\t              onChangeText={setEmail}\n74\t              placeholder=\"you@company.com\"\n75\t              autoCapitalize=\"none\"\n76\t              keyboardType=\"email-address\"\n77\t              autoComplete=\"email\"\n78\t              textContentType=\"emailAddress\"\n79\t            />\n80\t            <Field\n81\t              label=\"Password\"\n82\t              value={password}\n83\t              onChangeText={setPassword}\n84\t              placeholder=\"••••••••\"\n85\t              secureTextEntry\n86\t              autoComplete=\"password\"\n87\t              textContentType=\"password\"\n88\t            />\n89\t\n90\t            {error ? <Text style={styles.error}>{error}</Text> : null}\n91\t\n92\t            <LinearGradient\n93\t              colors={gradients.brand}\n94\t              start={{ x: 0, y: 0 }}\n95\t              end={{ x: 1, y: 0 }}\n96\t              style={styles.gradientBtn}\n97\t            >\n98\t              <Button\n99\t                title=\"Sign in\"\n100\t                onPress={onSubmit}\n101\t                loading={loading}\n102\t        