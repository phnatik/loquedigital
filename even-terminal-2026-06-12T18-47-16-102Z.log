[2026-06-12 18:59:54] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_015eouqnTvVUTvJjBT7KXh2a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MwkS3QGUJvgY4BR4Wkv8dn","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/src/components/ui.jsx","content":"// src/components/ui.jsx\n// Shared, themed primitives — styled to match the core-frontend portal.\nimport {\n  View,\n  Text,\n  TextInput,\n  Pressable,\n  ActivityIndicator,\n  StyleSheet,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { colors, gradients, radius, spacing, shadow, typography } from '../theme/theme';\n\n/* ─── Card ─── */\nexport function Card({ children, style }) {\n  return <View style={[styles.card, style]}>{children}</View>;\n}\n\n/* ─── Screen Title ─── */\nexport function ScreenTitle({ children, style }) {\n  return <Text style={[styles.screenTitle, style]}>{children}</Text>;\n}\n\n/* ─── Button ─── */\nexport function Button({\n  title,\n  onPress,\n  loading,\n  disabled,\n  variant = 'primary',\n  style,\n  textStyle,\n}) {\n  const isDisabled = disabled || loading;\n\n  // Ghost / danger variants keep a flat background\n  if (variant === 'ghost' || variant === 'danger') {\n    const bg = variant === 'danger' ? colors.danger : 'transparent';\n    const textColor = variant === 'ghost' ? colors.primary : colors.textInverse;\n    return (\n      <Pressable\n        onPress={onPress}\n        disabled={isDisabled}\n        style={({ pressed }) => [\n          styles.button,\n          { backgroundColor: bg, opacity: isDisabled ? 0.6 : pressed ? 0.85 : 1 },\n          variant === 'ghost' && styles.buttonGhost,\n          style,\n        ]}\n      >\n        {loading ? (\n          <ActivityIndicator color={textColor} />\n        ) : (\n          <Text style={[styles.buttonText, { color: textColor }, textStyle]}>{title}</Text>\n        )}\n      </Pressable>\n    );\n  }\n\n  // Primary / secondary use the brand gradient\n  const gradientColors =\n    variant === 'secondary'\n      ? [colors.secondary, colors.secondary]\n      : gradients.brand;\n\n  return (\n    <LinearGradient\n      colors={gradientColors}\n      start={{ x: 0, y: 0 }}\n      end={{ x: 1, y: 0 }}\n      style={[styles.gradientWrap, style]}\n    >\n      <Pressable\n        onPress={onPress}\n        disabled={isDisabled}\n        style={({ pressed }) => [\n          styles.button,\n          styles.buttonTransparent,\n          { opacity: isDisabled ? 0.6 : pressed ? 0.85 : 1 },\n        ]}\n      >\n        {loading ? (\n          <ActivityIndicator color={colors.textInverse} />\n        ) : (\n          <Text style={[styles.buttonText, { color: colors.textInverse }, textStyle]}>\n            {title}\n          </Text>\n        )}\n      </Pressable>\n    </LinearGradient>\n  );\n}\n\n/* ─── Field ─── */\nexport function Field({ label, error, style: inputStyleOverride, ...inputProps }) {\n  return (\n    <View style={styles.field}>\n      {label ? <Text style={styles.fieldLabel}>{label}</Text> : null}\n      <TextInput\n        placeholderTextColor=\"#9ca3af\"\n        style={[styles.input, error && styles.inputError, inputStyleOverride]}\n        {...inputProps}\n      />\n      {error ? <Text style={styles.fieldError}>{error}</Text> : null}\n    </View>\n  );\n}\n\n/* ─── Status Pill ─── */\nexport function StatusPill({ online, label }) {\n  const color = online ? colors.online : colors.offline;\n  return (\n    <View style={styles.pill}>\n      <View style={[styles.pillDot, { backgroundColor: color }]} />\n      <Text style={[styles.pillText, { color }]}>\n        {label || (online ? 'ONLINE' : 'OFFLINE')}\n      </Text>\n    </View>\n  );\n}\n\n/* ─── Loader ─── */\nexport function Loader({ label }) {\n  return (\n    <View style={styles.loader}>\n      <ActivityIndicator size=\"large\" color={colors.primary} />\n      {label ? <Text style={styles.loaderText}>{label}</Text> : null}\n    </View>\n  );\n}\n\n/* ─── Empty State ─── */\nexport function EmptyState({ title, subtitle }) {\n  return (\n    <View style={styles.empty}>\n      <Text style={styles.emptyTitle}>{title}</Text>\n      {subtitle ? <Text style={styles.emptySubtitle}>{subtitle}</Text> : null}\n    </View>\n  );\n}\n\n/* ─── Styles ─── */\nconst styles = StyleSheet.create({\n  /* Card */\n  card: {\n    backgroundColor: colors.surface,\n    borderRadius: radius.sm,\n    padding: spacing.xl,\n    borderWidth: 1,\n    borderColor: colors.border,\n    ...shadow.card,\n  },\n\n  /* Screen Title */\n  screenTitle: { ...typography.title, marginBottom: spacing.lg },\n\n  /* Button */\n  gradientWrap: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  button: {\n    height: 52,\n    borderRadius: radius.md,\n    alignItems: 'center',\n    justifyContent: 'center',\n    paddingHorizontal: spacing.lg,\n  },\n  buttonTransparent: { backgroundColor: 'transparent' },\n  buttonGhost: { borderWidth: 1.5, borderColor: colors.borderInput },\n  buttonText: { fontSize: 16, fontWeight: '600' },\n\n  /* Field */\n  field: { marginBottom: spacing.lg },\n  fieldLabel: {\n    fontSize: 14,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n  },\n  input: {\n    height: 50,\n    borderWidth: 1.5,\n    borderColor: colors.borderInput,\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    fontSize: 16,\n    color: colors.textDark,\n    backgroundColor: colors.surface,\n  },\n  inputError: { borderColor: colors.danger },\n  fieldError: { color: colors.danger, fontSize: 12, marginTop: spacing.xs },\n\n  /* Status Pill */\n  pill: { flexDirection: 'row', alignItems: 'center' },\n  pillDot: { width: 8, height: 8, borderRadius: 4, marginRight: spacing.xs },\n  pillText: { fontSize: 12, fontWeight: '700', letterSpacing: 0.5 },\n\n  /* Loader */\n  loader: { flex: 1, alignItems: 'center', justifyContent: 'center', padding: spacing.xl },\n  loaderText: { ...typography.label, marginTop: spacing.md },\n\n  /* Empty State */\n  empty: {\n    alignItems: 'center',\n    justifyContent: 'center',\n    padding: spacing.xxxl,\n    borderWidth: 2,\n    borderStyle: 'dashed',\n    borderColor: '#dbe0e8',\n    borderRadius: radius.sm,\n  },\n  emptyTitle: { ...typography.heading, marginBottom: spacing.xs },\n  emptySubtitle: { ...typography.caption, textAlign: 'center', lineHeight: 20 },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2017,"cache_read_input_tokens":63098,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2017},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"9fdbebb1-b193-4443-81af-8fd05a630f3d"}
