[2026-06-12 19:00:46] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_019pWidMAsCRmJJ1PQvXXUk7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015R1WfdL8kZDH21C6vUJ4z9","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/dashboard.jsx","content":"// app/(app)/dashboard.jsx — device/asset list.\n// Mirrors core-frontend Dashboard: uses the membership's superops_account_id to\n// fetch the asset list from the backend SuperOps integration.\nimport { useCallback, useState } from 'react';\nimport {\n  View,\n  Text,\n  FlatList,\n  Pressable,\n  RefreshControl,\n  StyleSheet,\n} from 'react-native';\nimport { useRouter } from 'expo-router';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getAssetList } from '../../src/services/superopsService';\nimport { Card, StatusPill, Loader, EmptyState } from '../../src/components/ui';\nimport { colors, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\n// Defensive unwrap of the SuperOps response shape used by the web app:\n// res.data.getAssetList.assets\nfunction extractAssets(payload) {\n  return (\n    payload?.data?.getAssetList?.assets ??\n    payload?.getAssetList?.assets ??\n    payload?.assets ??\n    []\n  );\n}\n\nexport default function Dashboard() {\n  const { superopsAccountId, membership, loadingMembership } = useAuth();\n  const router = useRouter();\n\n  const [assets, setAssets] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!superopsAccountId) {\n      setAssets([]);\n      setLoading(false);\n      return;\n    }\n    setError(null);\n    try {\n      const res = await getAssetList(superopsAccountId);\n      setAssets(extractAssets(res));\n    } catch (err) {\n      setError(err?.message || 'Could not load your devices.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [superopsAccountId]);\n\n  useFocusEffect(\n    useCallback(() => {\n      load();\n    }, [load]),\n  );\n\n  const onRefresh = () => {\n    setRefreshing(true);\n    load();\n  };\n\n  if ((loading || loadingMembership) && !refreshing)\n    return <Loader label=\"Loading devices…\" />;\n\n  const renderItem = ({ item }) => {\n    const online =\n      (item.status ?? 'online').toString().toLowerCase() !== 'offline';\n    return (\n      <Pressable\n        onPress={() => router.push(`/asset/${item.assetId ?? item.id}`)}\n        style={({ pressed }) => [{ opacity: pressed ? 0.7 : 1 }]}\n      >\n        <Card style={styles.assetCard}>\n          <View style={styles.assetIcon}>\n            <Ionicons name=\"desktop-outline\" size={20} color={colors.secondary} />\n          </View>\n          <View style={{ flex: 1 }}>\n            <Text style={styles.assetName} numberOfLines={1}>\n              {item.name || 'Unnamed device'}\n            </Text>\n            <StatusPill online={online} />\n          </View>\n          <Ionicons name=\"chevron-forward\" size={18} color={colors.textMuted} />\n        </Card>\n      </Pressable>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={assets}\n        keyExtractor={(item, idx) => String(item.assetId ?? item.id ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={colors.primary}\n          />\n        }\n        ListHeaderComponent={\n          <View style={styles.header}>\n            <Text style={styles.clientName}>\n              {membership?.client_name || 'Your devices'}\n            </Text>\n            <Text style={styles.subtle}>\n              {assets.length} device{assets.length === 1 ? '' : 's'}\n            </Text>\n          </View>\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState\n              title=\"No devices yet\"\n              subtitle=\"Installed devices will appear here.\"\n            />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  header: { marginBottom: spacing.lg },\n  clientName: { ...typography.title },\n  subtle: { ...typography.caption, marginTop: spacing.xs },\n  assetCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  assetIcon: {\n    width: 44,\n    height: 44,\n    borderRadius: radius.md,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  assetName: { ...typography.heading, fontSize: 16, marginBottom: spacing.xs },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":842,"cache_read_input_tokens":68879,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":842},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"e0a6ed70-7098-43c5-97a5-928fd73ceb9c"}
