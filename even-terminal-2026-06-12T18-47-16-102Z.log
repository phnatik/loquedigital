line\" label=\"Status\" value={senturiUser?.status} />\n38\t        <Row icon=\"call-outline\" label=\"Phone\" value={senturiUser?.phone} />\n39\t      </Card>\n40\t\n41\t      <Card style={{ marginTop: spacing.lg }}>\n42\t        <Text style={styles.cardTitle}>Technical</Text>\n43\t        <Row icon=\"key-outline\" label=\"SuperOps acct\" value={membership?.superops_account_id} />\n44\t        <Row icon=\"finger-print-outline\" label=\"Appwrite ID\" value={user?.$id} />\n45\t      </Card>\n46\t\n47\t      <Button\n48\t        title=\"Log out\"\n49\t        variant=\"danger\"\n50\t        onPress={logout}\n51\t        style={{ marginTop: spacing.xl }}\n52\t      />\n53\t    </ScrollView>\n54\t  );\n55\t}\n56\t\n57\tconst styles = StyleSheet.create({\n58\t  container: { flex: 1, backgroundColor: colors.background },\n59\t  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n60\t  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n61\t  avatar: {\n62\t    width: 80, height: 80, borderRadius: 40,\n63\t    backgroundColor: colors.primary,\n64\t    alignItems: 'center', justifyContent: 'center', marginBottom: spacing.md,\n65\t  },\n66\t  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n67\t  name: { ...typography.title },\n68\t  email: { ...typography.caption, marginTop: 2 },\n69\t  cardTitle: { ...typography.label, textTransform: 'uppercase', marginBottom: spacing.md },\n70\t  row: { flexDirection: 'row', alignItems: 'center', paddingVertical: spacing.sm },\n71\t  rowLabel: { ...typography.body, color: colors.textMuted, width: 110 },\n72\t  rowValue: { ...typography.body, flex: 1, textAlign: 'right', fontWeight: '600' },\n73\t});\n74\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"e8450d1c-17e0-471f-a268-89f3c1081865","timestamp":"2026-06-12T23:58:45.512Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/profile.