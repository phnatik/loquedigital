ext style={styles.name}>{fullName || 'Senturi user'}</Text>\n49\t        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n50\t      </View>\n51\t\n52\t      <Card>\n53\t        <Text style={styles.cardTitle}>Account</Text>\n54\t        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n55\t        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n56\t        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n57\t      </Card>\n58\t\n59\t      <Button\n60\t        title=\"Log out\"\n61\t        variant=\"danger\"\n62\t        onPress={logout}\n63\t        style={{ marginTop: spacing.xl }}\n64\t      />\n65\t    </ScrollView>\n66\t  );\n67\t}\n68\t\n69\tconst styles = StyleSheet.create({\n70\t  container: { flex: 1, backgroundColor: colors.background },\n71\t  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n72\t  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n73\t  avatar: {\n74\t    width: 80,\n75\t    height: 80,\n76\t    borderRadius: 40,\n77\t    alignItems: 'center',\n78\t    justifyContent: 'center',\n79\t    marginBottom: spacing.md,\n80\t    ...shadow.button,\n81\t  },\n82\t  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n83\t  name: { ...typography.title },\n84\t  email: { ...typography.caption, marginTop: spacing.xs },\n85\t  cardTitle: {\n86\t    ...typography.label,\n87\t    textTransform: 'uppercase',\n88\t    letterSpacing: 0.5,\n89\t    marginBottom: spacing.lg,\n90\t  },\n91\t  row: {\n92\t    flexDirection: 'row',\n93\t    alignItems: 'center',\n94\t    paddingVertical: spacing.md,\n95\t    borderBottomWidth: 1,\n96\t    borderBottomColor: colors.border,\n97\t  },\n98\t  rowIconWrap: {\n99\t    width: 32,\n100\t    height: 32,\n101\t    borderRadius: radius.sm,\n102\t    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n103\t    alignItems: 'center',\n104\t    justifyContent: 'center',\n105\t    marginRight: spacing.md,\n106\t  },\n107\t  rowLabel: { ...typography.body, color: colors.textMuted, flex: 1 },\n108\t  rowValue: {\n109\t    ...typography.body,\n110\t    fontWeight: '600',\n111\t    flex: 1,\n112\t    textAlign: 'right',\n113\t  },\n114\t});\n115\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"8940c2b1-7fc4-4e1b-b248-eaecf4ebdc69","timestamp":"2026-06-14T21:25:58.898Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/profile.jsx","content":"// app/(app)/profile.jsx — account details + logout.\n// Styled to match portal's profile / settings page.\nimport { View, Text, ScrollView, StyleSheet } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Card, Button } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nfunction Row({ icon, label, value }) {\n  return (\n    <View style={styles.row}>\n      <View style={styles.rowIconWrap}>\n        <Ionicons name={icon} size={16} color={colors.secondary} />\n      </View>\n      <Text style={styles.rowLabel}>{label}</Text>\n      <Text style={styles.rowValue} numberOfLines={1}>\n        {value || '—'}\n      </Text>\n    </View>\n  );\n}\n\nexport default function Profile() {\n  const { user, senturiUser, membership, logout } = useAuth();\n\n  const fullName = [senturiUser?.first_name, senturiUser?.last_name]\n    .filter(Boolean)\n    .join(' ');\n  const initials = (fullName || senturiUser?.email || 'S')\n    .split(' ')\n    .map((p) => p[0])\n    .join('')\n    .slice(0, 2)\n    .toUpperCase();\n\n  return (\n    <ScrollView style={styles.container} contentContainerStyle={styles.content}>\n      <View style={styles.avatarWrap}>\n        <LinearGradient\n          colors={gradients.brand}\n          start={{ x: 0, y: 0 }}\n          end={{ x: 1, y: 1 }}\n          style={styles.avatar}\n        >\n          <Text style={styles.avatarText}>{initials}</Text>\n        </LinearGradient>\n        <Text style={styles.name}>{fullName || 'Senturi user'}</Text>\n        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n      </View>\n\n      <Card>\n        <Text style={styles.cardTitle}>Account</Text>\n        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n      </Card>\n\n      <Button\n        title=\"Log out\"\n        variant=\"danger\"\n        onPress={logout}\n        style={{ marginTop: spacing.xl }}\n      />\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n  avatar: {\n    width: 80,\n    height: 80,\n    borderRadius: 40,\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginBottom: spacing.md,\n    ...shadow.button,\n  },\n  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n  name: { ...typography.title },\n  email: { ...typography.caption, marginTop: spacing.xs },\n  cardTitle: {\n    ...typography.label,\n    textTransform: 'uppercase',\n    letterSpacing: 0.5,\n    marginBottom: spacing.lg,\n  },\n  row: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    paddingVertical: spacing.md,\n    borderBottomWidth: 1,\n    borderBottomColor: colors.border,\n  },\n  rowIconWrap: {\n    width: 32,\n    height: 32,\n    borderRadius: radius.sm,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  rowLabel: { ...typography.body, color: colors.textMuted, flex: 1 },\n  rowValue: {\n    ...typography.body,\n    fontWeight: '600',\n    flex: 1,\n    textAlign: 'right',\n  },\n});\n","numLines":115,"startLine":1,"totalLines":115}}}
