        data: newContact\n50\t    });\n51\t\n52\t});\n53\t\n54\tconst updateClientPrimaryContact = catchAsync(async (req, res, next) => {\n55\t    const {\n56\t        accountId,\n57\t        primaryContactId\n58\t    } = req.body;\n59\t\n60\t    const updatePrimaryContact = await superopsService.updateClientPrimaryContact(accountId, primaryContactId);\n61\t    res.status(200).json({\n62\t        success: true,\n63\t        data: updatePrimaryContact\n64\t    });\n65\t});\n66\t\n67\t// get the client data. This also maintains account level information.\n68\tconst getClientSite = catchAsync(async (req, res, next) => {\n69\t    const {\n70\t        clientSiteId\n71\t    } = req.body;\n72\t    const clientSite = await superopsService.getClientSite(clientSiteId);\n73\t    res.status(200).json({\n74\t        success: true,\n75\t        data: clientSite\n76\t    });\n77\t});\n78\t\n79\tconst getAssetListById = catchAsync(async (req, res, next) => {\n80\t    const { accountId } = req.body;\n81\t    const assetList = await superopsService.getAssetListById(accountId);\n82\t    res.status(200).json({\n83\t        success: true,\n84\t        data: assetList\n85\t    });\n86\t});\n87\t\n88\tconst getAssetSummary = catchAsync( async(req,res,next) => {\n89\t    const { assetId } = req.body;\n90\t    const assetSummary = await superopsService.getAssetSummary(assetId);\n91\t    res.status(200).json({\n92\t        success: true,\n93\t        data: assetSummary\n94\t    })\n95\t});\n96\t\n97\tconst getAsset = catchAsync( async(req,res,next) => {\n98\t    const { assetId } = req.body;\n99\t    const assetDetails = await superopsService.getAsset(assetId);\n100\t    res.status(200).json({\n101\t        success: true,\n102\t        data: assetDetails\n103\t    })\n104\t});\n105\t\n106\tconst getAssetPatchDetails = catchAsync( async(req,res,next) => {\n107\t    const { assetId } = req.body;\n108\t    const patchDetails = await superopsService.getAssetPatchDetails(assetId);\n109\t    res.status(200).json({\n110\t        success: true,\n111\t        data: patchDetails\n112\t    });\n113\t});\n114\t\n115\tconst createTicket = catchAsync( async(req, res, next) => {\n116\t    const ticketData = {\n117\t        subject: req.body.subject,\n118\t        ticketType: \"SERVICE_REQUEST\",\n119\t        source: \"FORM\",\n120\t        assetId: req.body.assetId,\n121\t        machineName: req.body.machineName,\n122\t        accountId: req.body.accountId,\n123\t        status: \"OPEN\",\n124\t        description: req.body.description,\n125\t        assetId: req.body.assetId\n126\t        // priority: req.body.priority,\n127\t        // impact: req.body.impact,\n128\t        // urgency: req.body.urgency\n129\t    }\n130\t\n131\t    const ticketDetails = await superopsService.createTicket(ticketData);\n132\t    res.status(200).json({\n133\t        success: true,\n134\t        data: ticketDetails\n135\t    });\n136\t});\n137\t\n138\tconst getTicketsByAccount = catchAsync( async(req, res, next) => {\n139\t    const { accountId } = req.body;\n140\t    const tickets = await superopsService.getTicketsByAccount(accountId);\n141\t    res.status(200).json({\n142\t        success: true,\n143\t        data: tickets\n144\t    });\n145\t})\n146\t\n147\tmodule.exports = {\n148\t  getAllClients,\n149\t  getClientByAccountId,\n150\t  createClient,\n151\t  createClientContact,\n152\t  updateClientPrimaryContact,\n153\t  getClientSite,\n154\t  getAssetListById,\n155\t  getAssetSummary,\n156\t  getAsset,\n157\t  getAssetPatchDetails,\n158\t  createTicket,\n159\t  getTicketsByAccount\n160\t};"}]},"parent_tool_use_id":"toolu_01NRFcJY7tURBywvjYYGTJ8f","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"5390c682-7987-45cd-b671-a245690ff66f","timestamp":"2026-06-13T00:09:27.899Z"}
