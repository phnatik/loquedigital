  meta: { ...typography.caption },","-  statusBadge: { paddingHorizontal: spacing.md, paddingVertical: spacing.xs, borderRadius: radius.pill, marginLeft: spacing.md },","+  statusBadge: {","+    paddingHorizontal: spacing.md,","+    paddingVertical: spacing.xs,","+    borderRadius: radius.pill,","+    marginLeft: spacing.md,","+  },","   statusText: { color: colors.textInverse, fontSize: 11, fontWeight: '700' },","   fab: {","-    position: 'absolute', right: spacing.lg, bottom: spacing.lg,","-    width: 56, height: 56, borderRadius: 28,","+    position: 'absolute',","+    right: spacing.xl,","+    bottom: spacing.xl,","+    width: 56,","+    height: 56,","+    borderRadius: 28,","     backgroundColor: colors.primary,","-    alignItems: 'center', justifyContent: 'center',","-    shadowColor: '#000', shadowOpacity: 0.25, shadowRadius: 6, shadowOffset: { width: 0, height: 3 }, elevation: 5,","+    alignItems: 'center',","+    justifyContent: 'center',","+    ...shadow.fab,","   },","-  modalBackdrop: { flex: 1, backgroundColor: 'rgba(0,0,0,0.4)', justifyContent: 'flex-end' },","+  modalBackdrop: {","+    flex: 1,","+    backgroundColor: colors.overlay,","+    justifyContent: 'flex-end',","+  },","   modalSheet: {","     backgroundColor: colors.surface,","-    borderTopLeftRadius: 20, borderTopRightRadius: 20,","-    padding: spacing.xl, paddingBottom: spacing.xxl,","+    borderTopLeftRadius: radius.xl,","+    borderTopRightRadius: radius.xl,","+    padding: spacing.xl,","+    paddingBottom: spacing.xxxl,","   },","-  modalHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: spacing.lg },","+  modalHandle: {","+    width: 36,","+    height: 4,","+    borderRadius: 2,","+    backgroundColor: colors.borderInput,","+    alignSelf: 'center',","+    marginBottom: spacing.lg,","+  },","+  modalHeader: {","+    flexDirection: 'row',","+    justifyContent: 'space-between',","+    alignItems: 'center',","+    marginBottom: spacing.lg,","+  },","   modalTitle: { ...typography.title },","   multiline: { height: 110, textAlignVertical: 'top', paddingTop: spacing.md },","   error: { color: colors.danger, marginBottom: spacing.md },"]}],"originalFile":"// app/(app)/tickets.jsx — list support tickets and create new ones.\n// Mirrors core-frontend Tickets + superopsService get/createTicket.\nimport { useCallback, useState } from 'react';\nimport {\n  View,\n  Text,\n  FlatList,\n  RefreshControl,\n  StyleSheet,\n  Modal,\n  KeyboardAvoidingView,\n  Platform,\n  Pressable,\n} from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getTickets, createTicket } from '../../src/services/superopsService';\nimport { Card, Button, Field, Loader, EmptyState } from '../../src/components/ui';\nimport { colors, spacing, typography, radius } from '../../src/theme/theme';\n\nfunction statusColor(status) {\n  const s = (status || '').toString().toLowerCase();\n  if (s.includes('close') || s.includes('resolved')) return colors.textMuted;\n  if (s.includes('progress') || s.includes('open')) return colors.secondary;\n  return colors.primary;\n}\n\nexport default function Tickets() {\n  const { superopsAccountId } = useAuth();\n  const [tickets, setTickets] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const [modalOpen, setModalOpen] = useState(false);\n  const [subject, setSubject] = useState('');\n  const [description, setDescription] = useState('');\n  const [submitting, setSubmitting] = useState(false);\n  const [formError, setFormError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!superopsAccountId) { setTickets([]); setLoading(false); return; }\n    setError(null);\n    try {\n      const list = await getTickets(superopsAccountId);\n      setTickets(Array.isArray(list) ? list : []);\n    } catch (err) {\n      setError(err?.message || 'Could not load tickets.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [superopsAccountId]);\n\n  useFocusEffect(useCallback(() => { load(); }, [load]));\n\n  const onRefresh = () => { setRefreshing(true); load(); };\n\n  const submitTicket = async () => {\n    setFormError(null);\n    if (!subject.trim()) { setFormError('A subject is required.'); return; }\n    setSubmitting(true);\n    try {\n      await createTicket({\n        subject: subject.trim(),\n        description: description.trim(),\n        accountId: superopsAccountId,\n        // Account-level ticket — asset specifics are optional here.\n        assetId: null,\n        machineName: null,\n      });\n      setSubject('');\n      setDescription('');\n      setModalOpen(false);\n      onRefresh();\n    } catch (err) {\n      setFormError(err?.message || 'Could not create the ticket.');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  if (loading && !refreshing) return <Loader label=\"Loading tickets…\" />;\n\n  const renderItem = ({ item }) => (\n    <Card style={styles.ticketCard}>\n      <View style={{ flex: 1 }}>\n        <Text style={styles.subject} numberOfLines={2}>\n          {item.subject || item.displayId || 'Ticket'}\n        </Text>\n        {item.displayId ? <Text style={styles.meta}>#{item.displayId}</Text> : null}\n      </View>\n      <View style={[styles.statusBadge, { backgroundColor: statusColor(item.status?.name ?? item.status) }]}>\n        <Text style={styles.statusText}>\n          {(item.status?.name ?? item.status ?? 'Open').toString()}\n        </Text>\n      </View>\n    </Card>\n  );\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={tickets}\n        keyExtractor={(item, idx) => String(item.ticketId ?? item.id ?? item.displayId ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n        ListEmptyComponent={\n          error\n            ? <EmptyState title=\"Something went wrong\" subtitle={error} />\n            : <EmptyState title=\"No tickets\" subtitle=\"Tap + to raise a support request.\" />\n        }\n      />\n\n      <Pressable style={styles.fab} onPress={() => setModalOpen(true)}>\n        <Ionicons name=\"add\" size={28} color={colors.textInverse} />\n      </Pressable>\n\n      <Modal visible={modalOpen} animationType=\"slide\" transparent onRequestClose={() => setModalOpen(false)}>\n        <KeyboardAvoidingView\n          style={styles.modalBackdrop}\n          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n        >\n          <View style={styles.modalSheet}>\n            <View style={styles.modalHeader}>\n              <Text style={styles.modalTitle}>New ticket</Text>\n              <Pressable onPress={() => setModalOpen(false)} hitSlop={10}>\n                <Ionicons name=\"close\" size={24} color={colors.textMuted} />\n              </Pressable>\n            </View>\n\n            <Field\n              label=\"Subject\"\n              value={subject}\n              onChangeText={setSubject}\n              placeholder=\"Briefly describe the issue\"\n            />\n            <Field\n              label=\"Description\"\n              value={description}\n              onChangeText={setDescription}\n              placeholder=\"Add any details that will help us help you\"\n              multiline\n              numberOfLines={4}\n              style={styles.multiline}\n            />\n            {formError ? <Text style={styles.error}>{formError}</Text> : null}\n            <Button title=\"Submit ticket\" onPress={submitTicket} loading={submitting} />\n          </View>\n        </KeyboardAvoidingView>\n      </Modal>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: 96 },\n  ticketCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md },\n  subject: { ...typography.heading, marginBottom: 2 },\n  meta: { ...typography.caption },\n  statusBadge: { paddingHorizontal: spacing.md, paddingVertical: spacing.xs, borderRadius: radius.pill, marginLeft: spacing.md },\n  statusText: { color: colors.textInverse, fontSize: 11, fontWeight: '700' },\n  fab: {\n    position: 'absolute', right: spacing.lg, bottom: spacing.lg,\n    width: 56, height: 56, borderRadius: 28,\n    backgroundColor: colors.primary,\n    alignItems: 'center', justifyContent: 'center',\n    shadowColor: '#000', shadowOpacity: 0.25, shadowRadius: 6, shadowOffset: { width: 0, height: 3 }, elevation: 5,\n  },\n  modalBackdrop: { flex: 1, backgroundColor: 'rgba(0,0,0,0.4)', justifyContent: 'flex-end' },\n  modalSheet: {\n    backgroundColor: colors.surface,\n    borderTopLeftRadius: 20, borderTopRightRadius: 20,\n    padding: spacing.xl, paddingBottom: spacing.xxl,\n  },\n  modalHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: spacing.lg },\n  modalTitle: { ...typography.title },\n  multiline: { height: 110, textAlignVertical: 'top', paddingTop: spacing.md },\n  error: { color: colors.danger, marginBottom: spacing.md },\n});\n","userModified":false}}
[2026-06-12 19:01:16] [SSE-ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d]: {"type":"tool_end","name":"Write","toolId":"toolu_01KukVwiMnVymqbL8aJ5djrB","summary":"Write tickets.jsx (277 lines)","detail":{"input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/tickets.jsx","content":"// app/(app)/tickets.jsx — list support tickets and create new ones.\n// Mirrors core-frontend Tickets + superopsService get/createTicket.\nimport { useCallback, useState } from 'react';\nimport {\n  View,\n  Text,\n  FlatList,\n  RefreshControl,\n  StyleSheet,\n  Modal,\n  KeyboardAvoidingView,\n  Platform,\n  Pressable,\n} from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getTickets, createTicket } from '../../src/services/superopsService';\nimport { Card, Button, Field, Loader, EmptyState } from '../../src/components/ui';\nimport { colors, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nfunction statusColor(status) {\n  const s = (status || '').toString().toLowerCase();\n  if (s.includes('close') || s.includes('resolved')) return colors.textMuted;\n  if (s.includes('progress') || s.includes('open')) return colors.secondary;\n  return colors.primary;\n}\n\nexport default function Tickets() {\n  const { superopsAccountId } = useAuth();\n  const [tickets, setTickets] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const [modalOpen, setModalOpen] = useState(false);\n  const [subject, setSubject] = useState('');\n  const [description, setDescription] = useState('');\n  const [submitting, setSubmitting] = useState(false);\n  const [formError, setFormError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!superopsAccountId) {\n      setTickets([]);\n      setLoading(false);\n      return;\n    }\n    setError(null);\n    try {\n      const list = await getTickets(superopsAccountId);\n      setTickets(Array.isArray(list) ? list : []);\n    } catch (err) {\n      setError(err?.message || 'Could not load tickets.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [superopsAccountId]);\n\n  useFocusEffect(\n    useCallback(() => {\n      load();\n    }, [load]),\n  );\n\n  const onRefresh = () => {\n    setRefreshing(true);\n    load();\n  };\n\n  const submitTicket = async () => {\n    setFormError(null);\n    if (!subject.trim()) {\n      setFormError('A subject is required.');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      await createTicket({\n        subject: subject.trim(),\n        description: description.trim(),\n        accountId: superopsAccountId,\n        assetId: null,\n        machineName: null,\n      });\n      setSubject('');\n      setDescription('');\n      setModalOpen(false);\n      onRefresh();\n    } catch (err) {\n      setFormError(err?.message || 'Could not create the ticket.');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  if (loading && !refreshing) return <Loader label=\"Loading tickets…\" />;\n\n  const renderItem = ({ item }) => (\n    <Card style={styles.ticketCard}>\n      <View style={styles.ticketIcon}>\n        <Ionicons name=\"ticket-outline\" size={18} color={colors.secondary} />\n      </View>\n      <View style={{ flex: 1 }}>\n        <Text style={styles.subject} numberOfLines={2}>\n          {item.subject || item.displayId || 'Ticket'}\n        </Text>\n        {item.displayId ? (\n          <Text style={styles.meta}>#{item.displayId}</Text>\n        ) : null}\n      </View>\n      <View\n        style={[\n          styles.statusBadge,\n          { backgroundColor: statusColor(item.status?.name ?? item.status) },\n        ]}\n      >\n        <Text style={styles.statusText}>\n          {(item.status?.name ?? item.status ?? 'Open').toString()}\n        </Text>\n      </View>\n    </Card>\n  );\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={tickets}\n        keyExtractor={(item, idx) =>\n          String(item.ticketId ?? item.id ?? item.displayId ?? idx)\n        }\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={colors.primary}\n          />\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState\n              title=\"No tickets\"\n              subtitle=\"Tap + to raise a support request.\"\n            />\n          )\n        }\n      />\n\n      <Pressable\n        style={({ pressed }) => [styles.fab, { opacity: pressed ? 0.85 : 1 }]}\n        onPress={() => setModalOpen(true)}\n      >\n        <Ionicons name=\"add\" size={28} color={colors.textInverse} />\n      </Pressable>\n\n      <Modal\n        visible={modalOpen}\n        animationType=\"slide\"\n        transparent\n        onRequestClose={() => setModalOpen(false)}\n      >\n        <KeyboardAvoidingView\n          style={styles.modalBackdrop}\n          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n        >\n          <View style={styles.modalSheet}>\n            <View style={styles.modalHandle} />\n            <View style={styles.modalHeader}>\n              <Text style={styles.modalTitle}>New ticket</Text>\n              <Pressable onPress={() => setModalOpen(false)} hitSlop={10}>\n                <Ionicons name=\"close\" size={24} color={colors.textMuted} />\n              </Pressable>\n            </View>\n\n            <Field\n              label=\"Subject\"\n              value={subject}\n              onChangeText={setSubject}\n              placeholder=\"Briefly describe the issue\"\n            />\n            <Field\n              label=\"Description\"\n              value={description}\n              onChangeText={setDescription}\n              placeholder=\"Add any details that will help us help you\"\n              multiline\n              numberOfLines={4}\n              style={styles.multiline}\n            />\n            {formError ? <Text style={styles.error}>{formError}</Text> : null}\n            <Button\n              title=\"Submit ticket\"\n              onPress={submitTicket}\n              loading={submitting}\n            />\n          </View>\n        </KeyboardAvoidingView>\n      </Modal>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: 96 },\n  ticketCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  ticketIcon: {\n    width: 40,\n    height: 40,\n    borderRadius: radius.md,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  subject: { ...typography.heading, fontSize: 15, marginBottom: 2 },\n  meta: { ...typography.caption },\n  statusBadge: {\n    paddingHorizontal: spacing.md,\n    paddingVertical: spacing.xs,\n    borderRadius: radius.pill,\n    marginLeft: spacing.md,\n  },\n  statusText: { color: colors.textInverse, fontSize: 11, fontWeight: '700' },\n  fab: {\n    position: 'absolute',\n    right: spacing.xl,\n    bottom: spacing.xl,\n    width: 56,\n    height: 56,\n    borderRadius: 28,\n    backgroundColor: colors.primary,\n    alignItems: 'center',\n    justifyContent: 'center',\n    ...shadow.fab,\n  },\n  modalBackdrop: {\n    flex: 1,\n    backgroundColor: colors.overlay,\n    justifyContent: 'flex-end',\n  },\n  modalSheet: {\n    backgroundColor: colors.surface,\n    borderTopLeftRadius: radius.xl,\n    borderTopRightRadius: radius.xl,\n    padding: spacing.xl,\n    paddingBottom: spacing.xxxl,\n  },\n  modalHandle: {\n    width: 36,\n    height: 4,\n    borderRadius: 2,\n    backgroundColor: colors.borderInput,\n    alignSelf: 'center',\n    marginBottom: spacing.lg,\n  },\n  modalHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginBottom: spacing.lg,\n  },\n  modalTitle: { ...typography.title },\n  multiline: { height: 110, textAlignVertical: 'top', paddingTop: spacing.md },\n  error: { color: colors.danger, marginBottom: spacing.md },\n});\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(app)/tickets.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
