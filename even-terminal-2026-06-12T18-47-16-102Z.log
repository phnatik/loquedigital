w style={styles.formCard}>\n53\t            <Text style={styles.formTitle}>Sign in</Text>\n54\t\n55\t            <Field\n56\t              label=\"Email\"\n57\t              value={email}\n58\t              onChangeText={setEmail}\n59\t              placeholder=\"you@company.com\"\n60\t              autoCapitalize=\"none\"\n61\t              keyboardType=\"email-address\"\n62\t              autoComplete=\"email\"\n63\t              textContentType=\"emailAddress\"\n64\t            />\n65\t            <Field\n66\t              label=\"Password\"\n67\t              value={password}\n68\t              onChangeText={setPassword}\n69\t              placeholder=\"••••••••\"\n70\t              secureTextEntry\n71\t              autoComplete=\"password\"\n72\t              textContentType=\"password\"\n73\t            />\n74\t\n75\t            {error ? <Text style={styles.error}>{error}</Text> : null}\n76\t\n77\t            <Button title=\"Sign in\" onPress={onSubmit} loading={loading} />\n78\t\n79\t            <Text style={styles.helperText}>\n80\t              Accounts are provisioned by Senturi. Contact your administrator if you\n81\t              can't sign in.\n82\t            </Text>\n83\t          </View>\n84\t        </ScrollView>\n85\t      </KeyboardAvoidingView>\n86\t    </SafeAreaView>\n87\t  );\n88\t}\n89\t\n90\tconst styles = StyleSheet.create({\n91\t  safe: { flex: 1, backgroundColor: colors.ink },\n92\t  scroll: { flexGrow: 1, justifyContent: 'center', padding: spacing.xl },\n93\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xxl },\n94\t  brand: { fontSize: 40, fontWeight: '800', color: colors.textInverse, letterSpacing: 1 },\n95\t  tagline: { ...typography.label, color: '#9fc6d6', marginTop: spacing.xs },\n96\t  formCard: {\n97\t    backgroundColor: colors.surface,\n98\t    borderRadius: 18,\n99\t    padding: spacing.xl,\n100\t  },\n101\t  formTitle: { ...typography.title, marginBottom: spacing.lg },\n102\t  error: { color: colors.danger, marginBottom: spacing.md },\n103\t  helperText: { ...typography.caption, textAlign: 'center', marginTop: spacing.lg, lineHeight: 18 },\n104\t});\n105\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"dec810fa-eb60-4e15-a9f2-debfbc80e921","timestamp":"2026-06-12T23:51:03.441Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n} from 'react-native';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Button, Field } from '../../src/components/ui';\nimport { colors, spacing, typography } from '../../src/theme/theme';\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n      // AuthGate handles redirect on success.\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView contentContainerStyle={styles.scroll} keyboardShouldPersistTaps=\"handled\">\n          <View style={styles.brandWrap}>\n            <Text style={styles.brand}>Senturi</Text>\n            <Text style={styles.tagline}>Managed protection, in your pocket.</Text>\n          </View>\n\n          <View style={styles.formCard}>\n            <Text style={styles.formTitle}>Sign in</Text>\n\n            <Field\n              label=\"Email\"\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n            />\n            <Field\n              label=\"Password\"\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"••••••••\"\n              secureTextEntry\n              autoComplete=\"password\"\n              textContentType=\"password\"\n            />\n\n            {error ? <Text style={styles.error}>{error}</Text> : null}\n\n            <Button title=\"Sign in\" onPress={onSubmit} loading={loading} />\n\n            <Text style={styles.helperText}>\n              Accounts are provisioned by Senturi. Contact your administrator if you\n              can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: colors.ink },\n  scroll: { flexGrow: 1, justifyContent: 'center', padding: spacing.xl },\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxl },\n  brand: { fontSize: 40, fontWeight: '800', color: colors.textInverse, letterSpacing: 1 },\n  tagline: { ...typography.label, color: '#9fc6d6', marginTop: spacing.xs },\n  formCard: {\n    backgroundColor: colors.surface,\n    borderRadius: 18,\n    padding: spacing.xl,\n  },\n  formTitle: { ...typography.title, marginBottom: spacing.lg },\n  error: { color: colors.danger, marginBottom: spacing.md },\n  helperText: { ...typography.caption, textAlign: 'center', marginTop: spacing.lg, lineHeight: 18 },\n});\n","numLines":105,"startLine":1,"totalLines":105}}}
