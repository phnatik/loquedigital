ne\" label=\"SuperOps acct\" value={membership?.superops_account_id} />\n        <Row icon=\"finger-print-outline\" label=\"Appwrite ID\" value={user?.$id} />\n      </Card>\n\n      <Button\n        title=\"Log out\"\n        variant=\"danger\"\n        onPress={logout}\n        style={{ marginTop: spacing.xl }}\n      />\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n  avatar: {\n    width: 80, height: 80, borderRadius: 40,\n    backgroundColor: colors.primary,\n    alignItems: 'center', justifyContent: 'center', marginBottom: spacing.md,\n  },\n  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n  name: { ...typography.title },\n  email: { ...typography.caption, marginTop: 2 },\n  cardTitle: { ...typography.label, textTransform: 'uppercase', marginBottom: spacing.md },\n  row: { flexDirection: 'row', alignItems: 'center', paddingVertical: spacing.sm },\n  rowLabel: { ...typography.body, color: colors.textMuted, width: 110 },\n  rowValue: { ...typography.body, flex: 1, textAlign: 'right', fontWeight: '600' },\n});\n","numLines":74,"startLine":1,"totalLines":74}}}
