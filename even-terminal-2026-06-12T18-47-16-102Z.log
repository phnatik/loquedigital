[2026-06-17 13:21:52] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWHWXnmhfFC2xpchdnTsm3","type":"tool_result","content":"1\t/* ============================================\n2\t   F.A.S.T. SMOG TRAINING — DESIGN SYSTEM\n3\t   ============================================ */\n4\t\n5\t:root {\n6\t  /* Palette */\n7\t  --navy: #0B1B33;\n8\t  --navy-700: #122A4D;\n9\t  --navy-600: #1A3A6B;\n10\t  --steel: #2563C8;\n11\t  --steel-light: #4A86E0;\n12\t  --red: #D8232A;\n13\t  --red-dark: #B01820;\n14\t  --paper: #F4F1EB;\n15\t  --paper-2: #ECE7DC;\n16\t  --ink: #0B1B33;\n17\t  --ink-2: #4B5871;\n18\t  --line: rgba(11,27,51,.12);\n19\t  --line-strong: rgba(11,27,51,.22);\n20\t\n21\t  /* Primary (tweakable) */\n22\t  --primary: var(--navy);\n23\t  --primary-fg: #fff;\n24\t  --accent: var(--red);\n25\t\n26\t  /* Type (tweakable) */\n27\t  --font-display: \"Anton\", \"Oswald\", \"Impact\", sans-serif;\n28\t  --font-body: \"Manrope\", \"Helvetica Neue\", Arial, sans-serif;\n29\t  --font-mono: \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", monospace;\n30\t\n31\t  /* Scale */\n32\t  --container: 1280px;\n33\t  --gutter: clamp(20px, 4vw, 56px);\n34\t  --radius: 4px;\n35\t}\n36\t\n37\t/* Font-pairing presets */\n38\t[data-fontset=\"industrial\"] {\n39\t  --font-display: \"Anton\", sans-serif;\n40\t  --font-body: \"Manrope\", sans-serif;\n41\t  --font-mono: \"JetBrains Mono\", monospace;\n42\t}\n43\t[data-fontset=\"editorial\"] {\n44\t  --font-display: \"Archivo Black\", sans-serif;\n45\t  --font-body: \"IBM Plex Sans\", sans-serif;\n46\t  --font-mono: \"IBM Plex Mono\", monospace;\n47\t}\n48\t[data-fontset=\"utility\"] {\n49\t  --font-display: \"Oswald\", sans-serif;\n50\t  --font-body: \"DM Sans\", sans-serif;\n51\t  --font-mono: \"DM Mono\", monospace;\n52\t}\n53\t\n54\t/* ============================================\n55\t   RESET / BASE\n56\t   ============================================ */\n57\t*, *::before, *::after { box-sizing: border-box; }\n58\thtml { scroll-behavior: smooth; }\n59\tbody {\n60\t  margin: 0;\n61\t  font-family: var(--font-body);\n62\t  font-size: 16px;\n63\t  line-height: 1.55;\n64\t  color: var(--ink);\n65\t  background: var(--paper);\n66\t  -webkit-font-smoothing: antialiased;\n67\t  text-rendering: optimizeLegibility;\n68\t}\n69\timg, svg { display: block; max-width: 100%; }\n70\ta { color: inherit; text-decoration: none; }\n71\tbutton { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }\n72\th1, h2, h3, h4, h5 { margin: 0; font-family: var(--font-display); font-weight: 400; letter-spacing: .01em; line-height: 1; text-transform: uppercase; }\n73\tp { margin: 0; }\n74\t\n75\t.container {\n76\t  max-width: var(--container);\n77\t  margin: 0 auto;\n78\t  padding-inline: var(--gutter);\n79\t}\n80\t\n81\t/* ============================================\n82\t   UTILITY\n83\t   ============================================ */\n84\t.mono { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }\n85\t.eyebrow {\n86\t  display: inline-flex; align-items: center; gap: 10px;\n87\t  font-family: var(--font-mono);\n88\t  font-size: .72rem;\n89\t  letter-spacing: .18em;\n90\t  text-transform: uppercase;\n91\t  color: var(--ink-2);\n92\t}\n93\t.eyebrow::before {\n94\t  content: \"\";\n95\t  width: 28px; height: 2px;\n96\t  background: var(--accent);\n97\t}\n98\t.eyebrow.on-dark { color: rgba(255,255,255,.7); }\n99\t.eyebrow.on-dark::before { background: var(--accent); }\n100\t\n101\t.btn {\n102\t  display: inline-flex; align-items: center; gap: 10px;\n103\t  padding: 16px 24px;\n104\t  font-family: var(--font-display);\n105\t  font-size: 1rem;\n106\t  letter-spacing: .06em;\n107\t  text-transform: uppercase;\n108\t  border-radius: var(--radius);\n109\t  transition: transform .15s ease, background .15s ease, color .15s ease;\n110\t}\n111\t.btn:active { transform: translateY(1px); }\n112\t.btn-primary { background: var(--accent); color: #fff; }\n113\t.btn-primary:hover { background: var(--red-dark); }\n114\t.btn-ghost {\n115\t  background: transparent; color: inherit;\n116\t  box-shadow: inset 0 0 0 1.5px currentColor;\n117\t}\n118\t.btn-ghost:hover { background: currentColor; color: var(--paper); }\n119\t.btn-ghost:hover * { color: var(--paper); }\n120\t.btn .arrow { width: 18px; height: 10px; }\n121\t\n122\t.tag {\n123\t  display: inline-flex; align-items: center;\n124\t  padding: 4px 10px;\n125\t  font-family: var(--font-mono);\n126\t  font-size: .68rem;\n127\t  letter-spacing: .12em;\n128\t  text-transform: uppercase;\n129\t  background: var(--paper-2);\n130\t  color: var(--ink-2);\n131\t  border-radius: 2px;\n132\t}\n133\t.tag.red { background: var(--accent); color: #fff; }\n134\t.tag.steel { background: var(--steel); color: #fff; }\n135\t.tag.outline { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }\n136\t\n137\t/* Diagonal stripe motif (automotive caution-tape) */\n138\t.stripe-band {\n139\t  height: 14px;\n140\t  background: repeating-linear-gradient(\n141\t    -45deg,\n142\t    var(--accent) 0 14px,\n143\t    #1a1a1a 14px 28px\n144\t  );\n145\t}\n146\t\n147\t/* ============================================\n148\t   NAV\n149\t   ============================================ */\n150\t.topbar {\n151\t  background: var(--navy);\n152\t  color: #fff;\n153\t  font-size: .82rem;\n154\t  border-bottom: 1px solid rgba(255,255,255,.08);\n155\t}\n156\t.topbar .inner {\n157\t  display: flex; align-items: center; justify-content: space-between;\n158\t  padding: 8px 0;\n159\t}\n160\t.topbar .left, .topbar .right { display: flex; gap: 24px; align-items: center; }\n161\t.topbar .right a:hover { color: var(--steel-light); }\n162\t.topbar .dot { width: 6px; height: 6px; background: #3ad778; border-radius: 50%; display: inline-block; margin-right: 8px; box-shadow: 0 0 0 3px rgba(58,215,120,.18); }\n163\t\n164\t.nav {\n165\t  position: sticky; top: 0; z-index: 100;\n166\t  background: var(--paper);\n167\t  border-bottom: 1px solid var(--line);\n168\t  backdrop-filter: blur(8px);\n169\t}\n170\t.nav .inner {\n171\t  display: flex; align-items: center; gap: 32px;\n172\t  padding: 14px 0;\n173\t}\n174\t.logo {\n175\t  display: flex; align-items: center; gap: 12px;\n176\t  font-family: var(--font-display);\n177\t  font-size: 1.4rem;\n178\t  letter-spacing: .02em;\n179\t  text-transform: uppercase;\n180\t  color: var(--navy);\n181\t}\n182\t.logo .logo-img {\n183\t  height: 80px;\n184\t  width: auto;\n185\t  display: block;\n186\t}\n187\t.logo .mark {\n188\t  position: relative;\n189\t  width: 44px; height: 44px;\n190\t  background: var(--accent);\n191\t  border-radius: var(--radius);\n192\t  display: grid; place-items: center;\n193\t  color: #fff;\n194\t  font-family: var(--font-display);\n195\t  font-size: 1.1rem;\n196\t  letter-spacing: 0;\n197\t  overflow: hidden;\n198\t}\n199\t.logo .mark::after {\n200\t  content: \"\";\n201\t  position: absolute; inset: 0;\n202\t  background: repeating-linear-gradient(-45deg, transparent 0 6px, rgba(0,0,0,.12) 6px 7px);\n203\t  pointer-events: none;\n204\t}\n205\t.logo .sub { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; color: var(--ink-2); display: block; margin-top: 2px; text-transform: uppercase;}\n206\t.logo .name { line-height: 1; }\n207\t.nav ul.nav-list {\n208\t  display: flex; gap: 22px;\n209\t  list-style: none; margin: 0; padding: 0;\n210\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n211\t  margin-left: auto;\n212\t  align-items: center;\n213\t}\n214\t.nav ul.nav-list a, .more-btn { color: var(--navy); position: relative; padding: 4px 0; display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: inherit; letter-spacing: inherit; text-transform: inherit; }\n215\t.nav ul.nav-list a:hover, .more-btn:hover { color: var(--accent); }\n216\t.nav ul.nav-list a.active::after, .more-btn.active::after {\n217\t  content: \"\"; position: absolute; left: 0; right: 0; bottom: -6px;\n218\t  height: 2px; background: var(--accent);\n219\t}\n220\t/* More dropdown */\n221\t.more-wrap { position: relative; }\n222\t.more-menu {\n223\t  position: absolute;\n224\t  right: 0; top: calc(100% + 14px);\n225\t  min-width: 200px;\n226\t  background: var(--steel);\n227\t  color: #fff;\n228\t  padding: 14px 0;\n229\t  border-radius: 2px;\n230\t  box-shadow: 0 24px 48px rgba(11,27,51,.25);\n231\t  opacity: 0; transform: translateY(-6px); pointer-events: none;\n232\t  transition: opacity .15s ease, transform .15s ease;\n233\t  z-index: 200;\n234\t}\n235\t.more-menu.open { opacity: 1; transform: translateY(0); pointer-events: auto; }\n236\t.nav ul.nav-list .more-menu a {\n237\t  display: block;\n238\t  width: 100%;\n239\t  padding: 10px 22px;\n240\t  color: #fff;\n241\t  white-space: nowrap;\n242\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n243\t}\n244\t.nav ul.nav-list .more-menu a:hover { background: rgba(255,255,255,.1); color: #fff; }\n245\t.nav ul.nav-list .more-menu a.active { background: rgba(255,255,255,.15); }\n246\t\n247\t.nav .nav-cta { display: flex; gap: 12px; align-items: center; }\n248\t.nav-call { font-family: var(--font-mono); font-size: .85rem; letter-spacing: .04em; color: var(--navy); }\n249\t.nav-call strong { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .04em; display: block; }\n250\t.mobile-nav-toggle { display: none; padding: 10px; color: var(--navy); }\n251\t\n252\t/* ============================================\n253\t   HERO\n254\t   ============================================ */\n255\t.hero {\n256\t  background: var(--navy);\n257\t  color: #fff;\n258\t  position: relative;\n259\t  overflow: hidden;\n260\t}\n261\t/* Full-bleed hero background image */\n262\t.hero::before {\n263\t  content: \"\";\n264\t  position: absolute; inset: 0;\n265\t  background-image:\n266\t    /* dark overlay so the white/red text stays readable on any photo */\n267\t    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.75) 45%, rgba(11,27,51,.55) 100%),\n268\t    url(\"hero.jpg\");\n269\t  background-size: cover;\n270\t  background-position: center;\n271\t  pointer-events: none;\n272\t}\n273\t.hero-grid {\n274\t  position: relative;\n275\t  display: grid;\n276\t  grid-template-columns: 1fr;\n277\t  gap: 64px;\n278\t  align-items: center;\n279\t  padding: 96px 0 104px;\n280\t}\n281\t.hero-text { max-width: 880px; }\n282\t.hero h1 {\n283\t  font-size: clamp(56px, 8.5vw, 128px);\n284\t  line-height: .9;\n285\t  letter-spacing: -.005em;\n286\t}\n287\t.hero h1 .accent { color: var(--accent); }\n288\t.hero h1 .outline {\n289\t  -webkit-text-stroke: 2px #fff;\n290\t  color: transparent;\n291\t}\n292\t.hero .lede {\n293\t  margin-top: 28px;\n294\t  font-size: clamp(1.05rem, 1.4vw, 1.2rem);\n295\t  line-height: 1.5;\n296\t  color: rgba(255,255,255,.78);\n297\t  max-width: 52ch;\n298\t}\n299\t.hero .cta-row { margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }\n300\t.hero .quick-fact { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.55); padding-left: 16px; border-left: 2px solid var(--accent); }\n301\t\n302\t.hero-card {\n303\t  position: relative;\n304\t  border-radius: var(--radius);\n305\t  background: #fff;\n306\t  color: var(--navy);\n307\t  overflow: hidden;\n308\t  box-shadow: 0 30px 80px rgba(0,0,0,.45);\n309\t}\n310\t.hero-card .photo {\n311\t  aspect-ratio: 4/3;\n312\t  background:\n313\t    repeating-linear-gradient(135deg, rgba(11,27,51,.04) 0 14px, rgba(11,27,51,.08) 14px 28px),\n314\t    var(--paper-2);\n315\t  position: relative;\n316\t  display: grid; place-items: center;\n317\t}\n318\t.hero-card .photo .ph-label {\n319\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .15em;\n320\t  background: rgba(255,255,255,.85); padding: 6px 10px; border-radius: 2px;\n321\t  color: var(--ink-2);\n322\t}\n323\t.hero-card .meta { padding: 22px 24px; border-top: 1px solid var(--line); }\n324\t.hero-card .meta .row { display: flex; justify-content: space-between; align-items: baseline; }\n325\t.hero-card .meta .row + .row { margin-top: 8px; }\n326\t.hero-card .meta .label { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n327\t.hero-card .meta .val { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .02em; text-transform: uppercase; }\n328\t\n329\t/* Hero stats strip */\n330\t.stats {\n331\t  position: relative;\n332\t  display: grid;\n333\t  grid-template-columns: repeat(4, 1fr);\n334\t  gap: 0;\n335\t  border-top: 1px solid rgba(255,255,255,.12);\n336\t}\n337\t.stat {\n338\t  padding: 28px 24px;\n339\t  border-right: 1px solid rgba(255,255,255,.12);\n340\t}\n341\t.stat:last-child { border-right: 0; }\n342\t.stat .num { font-family: var(--font-display); font-size: clamp(2.2rem, 3.6vw, 3.4rem); line-height: 1; color: #fff; }\n343\t.stat .num small { font-size: .6em; color: var(--accent); margin-left: 4px; }\n344\t.stat .lbl { margin-top: 8px; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }\n345\t\n346\t/* Hero variant: FULL-BLEED */\n347\t.hero[data-variant=\"bleed\"] .hero-grid {\n348\t  grid-template-columns: 1fr;\n349\t  min-height: 640px;\n350\t  padding: 0;\n351\t  align-items: stretch;\n352\t}\n353\t.hero[data-variant=\"bleed\"] .hero-grid .hero-card { display: none; }\n354\t.hero[data-variant=\"bleed\"] .hero-text {\n355\t  padding: 120px 0 100px;\n356\t  position: relative;\n357\t  z-index: 2;\n358\t}\n359\t.hero[data-variant=\"bleed\"]::after {\n360\t  content: \"\";\n361\t  position: absolute;\n362\t  inset: 0;\n363\t  background:\n364\t    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.7) 50%, rgba(11,27,51,.4) 100%),\n365\t    repeating-linear-gradient(135deg, rgba(255,255,255,.04) 0 18px, rgba(255,255,255,.07) 18px 36px),\n366\t    var(--navy-700);\n367\t  pointer-events: none;\n368\t}\n369\t.hero[data-variant=\"bleed\"] .hero-text { padding-block: 120px; }\n370\t\n371\t/* Hero variant: TYPE — massive type, no card */\n372\t.hero[data-variant=\"type\"] .hero-grid {\n373\t  grid-template-columns: 1fr;\n374\t  padding: 100px 0 60px;\n375\t}\n376\t.hero[data-variant=\"type\"] h1 {\n377\t  font-size: clamp(72px, 14vw, 240px);\n378\t  line-height: .85;\n379\t}\n380\t.hero[data-variant=\"type\"] .hero-card { display: none; }\n381\t.hero[data-variant=\"type\"] .hero-text { max-width: none; }\n382\t.hero[data-variant=\"type\"] .lede { max-width: 44ch; }\n383\t.hero[data-variant=\"type\"] .marquee-row {\n384\t  display: grid; grid-template-columns: 2fr 1fr; gap: 64px; align-items: end;\n385\t  margin-top: 24px;\n386\t}\n387\t\n388\t/* ============================================\n389\t   CREDENTIALS STRIP\n390\t   ============================================ */\n391\t.creds {\n392\t  background: #fff;\n393\t  border-bottom: 1px solid var(--line);\n394\t}\n395\t.creds .inner {\n396\t  display: grid;\n397\t  grid-template-columns: 1.4fr repeat(4, 1fr);\n398\t  gap: 32px;\n399\t  padding: 28px 0;\n400\t  align-items: center;\n401\t}\n402\t.creds-label {\n403\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2);\n404\t}\n405\t.creds-label strong { display: block; font-family: var(--font-display); font-size: 1rem; color: var(--navy); margin-top: 4px; letter-spacing: .03em; }\n406\t.cred-item {\n407\t  display: flex; flex-direction: column; gap: 4px;\n408\t  padding-left: 16px;\n409\t  border-left: 2px solid var(--line);\n410\t}\n411\t.cred-item .k { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n412\t.cred-item .v { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: .02em; text-transform: uppercase; }\n413\t\n414\t/* ============================================\n415\t   SECTION\n416\t   ============================================ */\n417\t.section { padding: 96px 0; position: relative; }\n418\t.section.dark { background: var(--navy); color: #fff; }\n419\t.section.alt { background: var(--paper-2); }\n420\t\n421\t.section-head {\n422\t  display: grid;\n423\t  grid-template-columns: 1fr 1fr;\n424\t  gap: 48px;\n425\t  align-items: end;\n426\t  margin-bottom: 56px;\n427\t}\n428\t.section-head h2 {\n429\t  font-size: clamp(40px, 6vw, 84px);\n430\t  line-height: .92;\n431\t}\n432\t.section-head .lead { color: var(--ink-2); font-size: 1.05rem; max-width: 50ch; }\n433\t.section.dark .section-head .lead { color: rgba(255,255,255,.7); }\n434\t\n435\t/* ============================================\n436\t   COURSES — spec sheet cards\n437\t   ============================================ */\n438\t.course-grid {\n439\t  display: grid;\n440\t  grid-template-columns: repeat(2, 1fr);\n441\t  gap: 24px;\n442\t}\n443\t.course {\n444\t  background: #fff;\n445\t  border: 1px solid var(--line);\n446\t  border-radius: var(--radius);\n447\t  padding: 28px;\n448\t  display: flex; flex-direction: column;\n449\t  gap: 20px;\n450\t  position: relative;\n451\t  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n452\t}\n453\t.course:hover { transform: translateY(-3px); box-shadow: 0 24px 50px -20px rgba(11,27,51,.25); border-color: var(--line-strong); }\n454\t.course.featured { grid-column: 1 / -1; background: var(--navy); color: #fff; border-color: var(--navy); }\n455\t.course.featured .course-foot a { color: #fff; }\n456\t.course.featured .course-spec { border-color: rgba(255,255,255,.18); }\n457\t.course.featured .course-spec .k { color: rgba(255,255,255,.6); }\n458\t.course .course-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }\n459\t.course .code { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n460\t.course.featured .code { color: rgba(255,255,255,.65); }\n461\t.course h3 {\n462\t  font-size: clamp(1.6rem, 2.4vw, 2rem);\n463\t  line-height: 1.02;\n464\t  letter-spacing: .01em;\n465\t}\n466\t.course p { color: var(--ink-2); font-size: .95rem; line-height: 1.55; }\n467\t.course.featured p { color: rgba(255,255,255,.75); }\n468\t.course-specs {\n469\t  display: grid;\n470\t  grid-template-columns: repeat(3, 1fr);\n471\t  gap: 0;\n472\t  margin-top: auto;\n473\t}\n474\t.course-spec {\n475\t  padding: 14px 14px 14px 0;\n476\t  border-left: 1px solid var(--line);\n477\t  padding-left: 14px;\n478\t}\n479\t.course-spec:first-child { border-left: 0; padding-left: 0; }\n480\t.course-spec .k { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n481\t.course-spec .v { font-family: var(--font-display); font-size: 1rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 4px; }\n482\t.course-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 1px solid var(--line); }\n483\t.course.featured .course-foot { border-color: rgba(255,255,255,.16); }\n484\t.course-foot a { font-family: var(--font-display); letter-spacing: .04em; text-transform: uppercase; font-size: .95rem; display: inline-flex; align-items: center; gap: 8px; color: var(--navy); }\n485\t.course-foot a:hover { color: var(--accent); }\n486\t.course-foot a .arrow { width: 18px; height: 10px; }\n487\t.course-foot .price { font-family: var(--font-display); font-size: 1.4rem; color: var(--accent); letter-spacing: .02em; }\n488\t.course-foot .price .from { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; color: var(--ink-2); display: block; line-height: 1; }\n489\t\n490\t/* ============================================\n491\t   SCHEDULE\n492\t   ============================================ */\n493\t.schedule-wrap {\n494\t  background: #fff;\n495\t  border: 1px solid var(--line);\n496\t  border-radius: var(--radius);\n497\t  overflow: hidden;\n498\t}\n499\t.schedule-head {\n500\t  padding: 24px 28px;\n501\t  display: flex; justify-content: space-between; align-items: center;\n502\t  border-bottom: 1px solid var(--line);\n503\t  background: var(--paper);\n504\t}\n505\t.schedule-head .label { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n506\t.schedule-head h4 { font-size: 1.4rem; margin-top: 4px; }\n507\t.schedule-head .actions { display: flex; gap: 12px; align-items: center; }\n508\t.schedule-tabs { display: flex; gap: 4px; }\n509\t.schedule-tab {\n510\t  padding: 8px 14px;\n511\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n512\t  border-radius: 2px;\n513\t  color: var(--ink-2);\n514\t}\n515\t.schedule-tab.active { background: var(--navy); color: #fff; }\n516\t\n517\t.schedule-list {\n518\t  display: grid;\n519\t}\n520\t.session {\n521\t  display: grid;\n522\t  grid-template-columns: 110px 1fr auto auto auto;\n523\t  gap: 24px;\n524\t  padding: 22px 28px;\n525\t  align-items: center;\n526\t  border-top: 1px solid var(--line);\n527\t  transition: background .15s;\n528\t}\n529\t.session:first-child { border-top: 0; }\n530\t.session:hover { background: var(--paper); }\n531\t.session .date { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; line-height: 1; }\n532\t.session .date small { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; color: var(--ink-2); margin-top: 6px; }\n533\t.session .info h5 { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .03em; text-transform: uppercase; margin: 0; }\n534\t.session .info .sub { font-family: var(--font-mono); font-size: .72rem; color: var(--ink-2); letter-spacing: .08em; margin-top: 4px; }\n535\t.session .mode { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n536\t.session .seats {\n537\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n538\t  padding: 4px 10px; border-radius: 2px; background: var(--paper-2);\n539\t}\n540\t.session .seats.low { background: #FFE5D6; color: #B53E00; }\n541\t.session .seats.open { background: #E5F4EA; color: #1F6B36; }\n542\t.session .seats.waitlist { background: #F0EAFF; color: #5530A8; }\n543\t.session .reg-btn {\n544\t  padding: 10px 18px; background: var(--navy); color: #fff;\n545\t  font-family: var(--font-display); letter-spacing: .06em; text-transform: uppercase; font-size: .82rem;\n546\t  border-radius: 2px;\n547\t}\n548\t.session .reg-btn:hover { background: var(--accent); }\n549\t\n550\t.schedule-foot {\n551\t  padding: 20px 28px;\n552\t  border-top: 1px solid var(--line);\n553\t  background: var(--paper);\n554\t  display: flex; justify-content: space-between; align-items: center;\n555\t}\n556\t.schedule-foot .note { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; color: var(--ink-2); }\n557\t\n558\t/* ============================================\n559\t   WHY F.A.S.T.\n560\t   ============================================ */\n561\t.why-grid {\n562\t  display: grid;\n563\t  grid-template-columns: repeat(3, 1fr);\n564\t  gap: 1px;\n565\t  background: rgba(255,255,255,.12);\n566\t  border: 1px solid rgba(255,255,255,.12);\n567\t  border-radius: var(--radius);\n568\t  overflow: hidden;\n569\t}\n570\t.why {\n571\t  background: var(--navy);\n572\t  padding: 36px 32px;\n573\t  display: flex; flex-direction: column; gap: 14px;\n574\t  min-height: 240px;\n575\t}\n576\t.why .num { font-family: var(--font-display); font-size: 1rem; color: var(--accent); letter-spacing: .04em; }\n577\t.why h4 { font-size: 1.6rem; line-height: 1.05; letter-spacing: .01em; }\n578\t.why p { color: rgba(255,255,255,.7); font-size: .95rem; }\n579\t\n580\t/* ============================================\n581\t   INSTRUCTORS\n582\t   ============================================ */\n583\t.inst-grid {\n584\t  display: grid;\n585\t  grid-template-columns: repeat(3, 1fr);\n586\t  gap: 24px;\n587\t}\n588\t.inst {\n589\t  background: #fff;\n590\t  border: 1px solid var(--line);\n591\t  border-radius: var(--radius);\n592\t  overflow: hidden;\n593\t}\n594\t.inst .photo {\n595\t  aspect-ratio: 4/5;\n596\t  background:\n597\t    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n598\t    var(--paper-2);\n599\t  position: relative;\n600\t  display: grid; place-items: end stretch;\n601\t}\n602\t.inst .photo .ph-label {\n603\t  font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase;\n604\t  color: var(--ink-2); padding: 10px 12px;\n605\t  background: rgba(255,255,255,.85);\n606\t  align-self: end;\n607\t  border-top-right-radius: 4px;\n608\t  width: fit-content;\n609\t}\n610\t.inst .body { padding: 22px 24px; }\n611\t.inst .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n612\t.inst h4 { font-size: 1.4rem; letter-spacing: .02em; margin-top: 6px; }\n613\t.inst .bio { color: var(--ink-2); font-size: .92rem; margin-top: 10px; line-height: 1.55; }\n614\t.inst .creds { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }\n615\t\n616\t/* ============================================\n617\t   TESTIMONIALS\n618\t   ============================================ */\n619\t.test-grid {\n620\t  display: grid;\n621\t  grid-template-columns: repeat(3, 1fr);\n622\t  gap: 24px;\n623\t}\n624\t.test {\n625\t  background: #fff;\n626\t  border: 1px solid var(--line);\n627\t  border-radius: var(--radius);\n628\t  padding: 30px 28px;\n629\t  display: flex; flex-direction: column; gap: 18px;\n630\t}\n631\t.test .stars { color: var(--accent); letter-spacing: 2px; font-size: 1.1rem; }\n632\t.test blockquote { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; margin: 0; color: var(--ink); }\n633\t.test .who { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); }\n634\t.test .avatar {\n635\t  width: 40px; height: 40px; border-radius: 50%;\n636\t  background: var(--navy); color: #fff;\n637\t  display: grid; place-items: center;\n638\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .02em;\n639\t}\n640\t.test .who-text .name { font-family: var(--font-display); letter-spacing: .03em; text-transform: uppercase; font-size: .95rem; }\n641\t.test .who-text .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; color: var(--ink-2); margin-top: 2px; text-transform: uppercase; }\n642\t\n643\t/* ============================================\n644\t   FAQ\n645\t   ============================================ */\n646\t.faq-grid {\n647\t  display: grid;\n648\t  grid-template-columns: 1fr 1.4fr;\n649\t  gap: 64px;\n650\t  align-items: flex-start;\n651\t}\n652\t.faq-list {\n653\t  display: grid;\n654\t}\n655\t.faq-item {\n656\t  border-top: 1px solid var(--line-strong);\n657\t  padding: 24px 0;\n658\t}\n659\t.faq-item:last-child { border-bottom: 1px solid var(--line-strong); }\n660\t.faq-q {\n661\t  display: flex; justify-content: space-between; align-items: center;\n662\t  width: 100%; text-align: left;\n663\t  font-family: var(--font-display);\n664\t  font-size: 1.3rem;\n665\t  letter-spacing: .01em;\n666\t  text-transform: uppercase;\n667\t  color: var(--navy);\n668\t  padding: 0;\n669\t}\n670\t.faq-q .plus {\n671\t  width: 28px; height: 28px;\n672\t  border: 1.5px solid var(--navy);\n673\t  border-radius: 50%;\n674\t  display: grid; place-items: center;\n675\t  transition: transform .2s, background .2s, color .2s;\n676\t  flex-shrink: 0;\n677\t}\n678\t.faq-item[open] .faq-q .plus { background: var(--accent); border-color: var(--accent); color: #fff; transform: rotate(45deg); }\n679\t.faq-a { padding-top: 14px; color: var(--ink-2); max-width: 64ch; font-size: 1rem; line-height: 1.55; }\n680\t\n681\t/* ============================================\n682\t   CONTACT / CTA\n683\t   ============================================ */\n684\t.cta-band {\n685\t  background: var(--accent);\n686\t  color: #fff;\n687\t  padding: 80px 0;\n688\t  position: relative;\n689\t  overflow: hidden;\n690\t}\n691\t.cta-band::before {\n692\t  content: \"\";\n693\t  position: absolute; inset: 0;\n694\t  background: repeating-linear-gradient(-45deg, transparent 0 40px, rgba(0,0,0,.04) 40px 41px);\n695\t  pointer-events: none;\n696\t}\n697\t.cta-band .inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; position: relative; }\n698\t.cta-band h2 { font-size: clamp(40px, 6vw, 88px); line-height: .9; }\n699\t.cta-band .btn-primary { background: #fff; color: var(--accent); }\n700\t.cta-band .btn-primary:hover { background: var(--navy); color: #fff; }\n701\t.cta-band .btn-ghost { color: #fff; }\n702\t\n703\t.contact-grid {\n704\t  display: grid;\n705\t  grid-template-columns: 1fr 1fr;\n706\t  gap: 48px;\n707\t}\n708\t.contact-info > * + * { margin-top: 28px; }\n709\t.contact-block .label { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n710\t.contact-block .val { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 6px; }\n711\t.contact-block .sub { font-family: var(--font-body); color: var(--ink-2); margin-top: 4px; }\n712\t\n713\t.form { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }\n714\t.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n715\t.form label { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 6px; }\n716\t.form input, .form select, .form textarea {\n717\t  width: 100%; padding: 12px 14px;\n718\t  font-family: var(--font-body); font-size: .95rem;\n719\t  background: var(--paper); border: 1px solid var(--line); border-radius: 2px;\n720\t  color: var(--ink);\n721\t  transition: border-color .15s, background .15s;\n722\t}\n723\t.form input:focus, .form select:focus, .form textarea:focus { outline: 0; border-color: var(--navy); background: #fff; }\n724\t.form .field + .field { margin-top: 14px; }\n725\t.form textarea { min-height: 110px; resize: vertical; }\n726\t.form .submit { margin-top: 20px; width: 100%; justify-content: center; }\n727\t\n728\t/* ============================================\n729\t   FOOTER\n730\t   ============================================ */\n731\t.foot {\n732\t  background: #060F1F;\n733\t  color: rgba(255,255,255,.7);\n734\t  padding: 64px 0 28px;\n735\t  font-size: .9rem;\n736\t}\n737\t.foot-grid {\n738\t  display: grid;\n739\t  grid-template-columns: 1.4fr 1fr 1fr 1fr;\n740\t  gap: 48px;\n741\t  padding-bottom: 48px;\n742\t  border-bottom: 1px solid rgba(255,255,255,.08);\n743\t}\n744\t.foot h5 { font-family: var(--font-display); color: #fff; letter-spacing: .06em; font-size: .95rem; text-transform: uppercase; margin-bottom: 16px; }\n745\t.foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }\n746\t.foot ul a:hover { color: var(--accent); }\n747\t.foot .blurb { color: rgba(255,255,255,.55); max-width: 36ch; margin-top: 14px; }\n748\t.foot-bottom {\n749\t  padding-top: 24px;\n750\t  display: flex; justify-content: space-between; align-items: center;\n751\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.45);\n752\t}\n753\t.foot-bottom a:hover { color: var(--accent); }\n754\t\n755\t/* ============================================\n756\t   MARQUEE\n757\t   ============================================ */\n758\t.marquee {\n759\t  background: #0A1525;\n760\t  color: #fff;\n761\t  overflow: hidden;\n762\t  border-block: 1px solid rgba(255,255,255,.08);\n763\t  position: relative;\n764\t}\n765\t.marquee::before, .marquee::after {\n766\t  content: \"\";\n767\t  position: absolute; top: 0; bottom: 0; width: 80px;\n768\t  z-index: 2; pointer-events: none;\n769\t}\n770\t.marquee::before { left: 0; background: linear-gradient(90deg, #0A1525, transparent); }\n771\t.marquee::after { right: 0; background: linear-gradient(-90deg, #0A1525, transparent); }\n772\t.marquee-track {\n773\t  display: flex; gap: 56px; padding: 18px 0;\n774\t  animation: marquee 38s linear infinite;\n775\t  width: max-content;\n776\t}\n777\t.marquee-item {\n778\t  display: inline-flex; align-items: center; gap: 14px;\n779\t  font-family: var(--font-display);\n780\t  font-size: 1.2rem; letter-spacing: .04em; text-transform: uppercase;\n781\t  white-space: nowrap;\n782\t}\n783\t.marquee-item .bullet {\n784\t  width: 8px; height: 8px; background: var(--accent); border-radius: 50%;\n785\t}\n786\t@keyframes marquee {\n787\t  to { transform: translateX(-50%); }\n788\t}\n789\t\n790\t/* ============================================\n791\t   BLOG / RESOURCES\n792\t   ============================================ */\n793\t.posts-grid {\n794\t  display: grid;\n795\t  grid-template-columns: repeat(3, 1fr);\n796\t  gap: 24px;\n797\t}\n798\t.post {\n799\t  background: #fff;\n800\t  border: 1px solid var(--line);\n801\t  border-radius: var(--radius);\n802\t  overflow: hidden;\n803\t  display: flex; flex-direction: column;\n804\t  transition: transform .2s, box-shadow .2s;\n805\t}\n806\t.post:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -20px rgba(11,27,51,.2); }\n807\t.post .ph {\n808\t  aspect-ratio: 16/9;\n809\t  background:\n810\t    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n811\t    var(--paper-2);\n812\t  position: relative;\n813\t}\n814\t.post .ph .ph-label {\n815\t  position: absolute; inset: auto auto 12px 12px;\n816\t  font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase;\n817\t  background: rgba(255,255,255,.9); padding: 6px 10px; border-radius: 2px;\n818\t  color: var(--ink-2);\n819\t}\n820\t.post .ph .tag { position: absolute; top: 12px; left: 12px; }\n821\t.post .body { padding: 22px 24px; display: flex; flex-direction: column; flex: 1; }\n822\t.post .date { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n823\t.post h4 { font-size: 1.3rem; letter-spacing: .02em; margin-top: 8px; line-height: 1.05; }\n824\t.post .excerpt { color: var(--ink-2); font-size: .92rem; margin-top: 10px; line-height: 1.5; }\n825\t.post .read { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); font-family: var(--font-display); letter-spacing: .04em; text-transform: uppercase; font-size: .85rem; color: var(--navy); display: inline-flex; align-items: center; gap: 8px; }\n826\t\n827\t/* ============================================\n828\t   PAGE HEADER BANNER (inner pages)\n829\t   ============================================ */\n830\t.page-hd {\n831\t  background: var(--navy);\n832\t  color: #fff;\n833\t  padding: 72px 0 64px;\n834\t  position: relative;\n835\t  overflow: hidden;\n836\t}\n837\t.page-hd::before {\n838\t  content: \"\";\n839\t  position: absolute; inset: 0;\n840\t  background:\n841\t    radial-gradient(50% 80% at 90% 20%, rgba(37,99,200,.28), transparent 60%),\n842\t    radial-gradient(40% 60% at 10% 90%, rgba(216,35,42,.18), transparent 60%);\n843\t  pointer-events: none;\n844\t}\n845\t.page-hd .inner { position: relative; }\n846\t.page-hd .crumbs {\n847\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n848\t  color: rgba(255,255,255,.55);\n849\t  margin-bottom: 22px;\n850\t}\n851\t.page-hd .crumbs a:hover { color: var(--accent); }\n852\t.page-hd .crumbs span { margin: 0 8px; color: rgba(255,255,255,.3); }\n853\t.page-hd h1 {\n854\t  font-size: clamp(48px, 7vw, 96px);\n855\t  line-height: .92;\n856\t  max-width: 18ch;\n857\t}\n858\t.page-hd h1 .accent { color: var(--accent); }\n859\t.page-hd .lede {\n860\t  margin-top: 22px;\n861\t  font-size: clamp(1rem, 1.3vw, 1.15rem);\n862\t  line-height: 1.5;\n863\t  color: rgba(255,255,255,.75);\n864\t  max-width: 58ch;\n865\t}\n866\t\n867\t/* ============================================\n868\t   PROSE — long-form copy on inner pages\n869\t   ============================================ */\n870\t.prose {\n871\t  max-width: 70ch;\n872\t  font-size: 1.02rem;\n873\t  line-height: 1.65;\n874\t  color: var(--ink);\n875\t}\n876\t.prose h2 {\n877\t  font-size: clamp(28px, 3.4vw, 44px);\n878\t  margin-top: 56px; margin-bottom: 20px;\n879\t  letter-spacing: .01em;\n880\t  line-height: 1.05;\n881\t}\n882\t.prose h2:first-child { margin-top: 0; }\n883\t.prose h3 {\n884\t  font-size: clamp(22px, 2.4vw, 28px);\n885\t  margin-top: 36px; margin-bottom: 14px;\n886\t  letter-spacing: .02em;\n887\t  line-height: 1.1;\n888\t}\n889\t.prose p { margin-bottom: 16px; color: var(--ink-2); }\n890\t.prose strong { color: var(--ink); }\n891\t.prose ul, .prose ol { color: var(--ink-2); padding-left: 22px; margin: 0 0 18px; }\n892\t.prose ul li, .prose ol li { margin-bottom: 8px; }\n893\t.prose ul li::marker { color: var(--accent); }\n894\t.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }\n895\t.prose a:hover { color: var(--red-dark); }\n896\t\n897\t.prose-grid {\n898\t  display: grid;\n899\t  grid-template-columns: 280px 1fr;\n900\t  gap: 80px;\n901\t  align-items: start;\n902\t}\n903\t.prose-aside {\n904\t  position: sticky; top: 96px;\n905\t  padding: 24px;\n906\t  border: 1px solid var(--line);\n907\t  border-radius: var(--radius);\n908\t  background: var(--paper);\n909\t}\n910\t.prose-aside h5 {\n911\t  font-family: var(--font-display);\n912\t  font-size: .85rem; letter-spacing: .08em; text-transform: uppercase;\n913\t  margin-bottom: 14px;\n914\t  color: var(--navy);\n915\t}\n916\t.prose-aside ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .9rem; }\n917\t.prose-aside a { color: var(--ink-2); }\n918\t.prose-aside a:hover { color: var(--accent); }\n919\t.prose-aside a.active { color: var(--accent); font-weight: 600; }\n920\t\n921\t/* Callout / inline highlight box */\n922\t.callout {\n923\t  background: var(--navy);\n924\t  color: #fff;\n925\t  border-radius: var(--radius);\n926\t  padding: 28px 32px;\n927\t  margin: 32px 0;\n928\t}\n929\t.callout .lbl { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.6); }\n930\t.callout h4 { font-size: 1.5rem; letter-spacing: .02em; margin-top: 8px; line-height: 1.1; }\n931\t.callout p { color: rgba(255,255,255,.75); margin-top: 10px; }\n932\t\n933\t/* Spec table — used for state requirements + class details */\n934\t.spec-table {\n935\t  width: 100%;\n936\t  border-collapse: collapse;\n937\t  margin: 24px 0;\n938\t  font-size: .95rem;\n939\t}\n940\t.spec-table th, .spec-table td {\n941\t  text-align: left;\n942\t  padding: 14px 16px;\n943\t  border-bottom: 1px solid var(--line);\n944\t  vertical-align: top;\n945\t}\n946\t.spec-table th {\n947\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;\n948\t  color: var(--ink-2); background: var(--paper-2);\n949\t  border-bottom: 1px solid var(--line-strong);\n950\t}\n951\t.spec-table tr:hover td { background: var(--paper); }\n952\t.spec-table td .courseref { font-family: var(--font-display); letter-spacing: .02em; text-transform: uppercase; font-size: 1.05rem; color: var(--navy); }\n953\t\n954\t/* Pricing table */\n955\t.pricing-grid {\n956\t  display: grid;\n957\t  grid-template-columns: repeat(3, 1fr);\n958\t  gap: 24px;\n959\t  margin-bottom: 32px;\n960\t}\n961\t.price-card {\n962\t  background: #fff;\n963\t  border: 1px solid var(--line);\n964\t  border-radius: var(--radius);\n965\t  padding: 32px 28px;\n966\t  display: flex; flex-direction: column; gap: 16px;\n967\t}\n968\t.price-card.feat { background: var(--navy); color: #fff; border-color: var(--navy); }\n969\t.price-card .pname { font-family: var(--font-display); font-size: 1.3rem; letter-spacing: .02em; text-transform: uppercase; line-height: 1.1; }\n970\t.price-card .pcode { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n971\t.price-card.feat .pcode { color: rgba(255,255,255,.6); }\n972\t.price-card .pprice { font-family: var(--font-display); font-size: 3rem; letter-spacing: .01em; line-height: 1; color: var(--accent); }\n973\t.price-card .pprice small { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .12em; color: var(--ink-2); display: block; margin-top: 6px; }\n974\t.price-card.feat .pprice small { color: rgba(255,255,255,.6); }\n975\t.price-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .9rem; color: var(--ink-2); }\n976\t.price-card.feat ul { color: rgba(255,255,255,.8); }\n977\t.price-card ul li { padding-left: 22px; position: relative; }\n978\t.price-card ul li::before {\n979\t  content: \"\"; position: absolute; left: 0; top: 9px;\n980\t  width: 12px; height: 2px; background: var(--accent);\n981\t}\n982\t.price-card .btn { margin-top: auto; justify-content: center; }\n983\t\n984\t/* Numbered policy / requirement list */\n985\t.req-list { display: grid; gap: 20px; counter-reset: req; }\n986\t.req-item {\n987\t  display: grid;\n988\t  grid-template-columns: 56px 1fr;\n989\t  gap: 24px;\n990\t  padding: 24px;\n991\t  background: #fff;\n992\t  border: 1px solid var(--line);\n993\t  border-radius: var(--radius);\n994\t}\n995\t.req-item::before {\n996\t  counter-increment: req;\n997\t  content: counter(req, decimal-leading-zero);\n998\t  font-family: var(--font-display);\n999\t  font-size: 1.6rem;\n1000\t  color: var(--accent);\n1001\t  letter-spacing: .02em;\n1002\t}\n1003\t.req-item h4 { font-size: 1.15rem; letter-spacing: .02em; line-height: 1.1; margin-bottom: 8px; }\n1004\t.req-item p { color: var(--ink-2); font-size: .95rem; line-height: 1.55; }\n1005\t\n1006\t/* Map placeholder */\n1007\t.map-ph {\n1008\t  aspect-ratio: 16/9;\n1009\t  background:\n1010\t    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n1011\t    var(--paper-2);\n1012\t  position: relative;\n1013\t  border-radius: var(--radius);\n1014\t  overflow: hidden;\n1015\t  display: grid; place-items: center;\n1016\t}\n1017\t.map-ph .ph-label {\n1018\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;\n1019\t  color: var(--ink-2);\n1020\t  background: rgba(255,255,255,.85);\n1021\t  padding: 8px 14px; border-radius: 2px;\n1022\t}\n1023\t.map-ph .pin {\n1024\t  position: absolute;\n1025\t  width: 22px; height: 22px;\n1026\t  background: var(--accent);\n1027\t  border-radius: 50% 50% 50% 0;\n1028\t  transform: rotate(-45deg);\n1029\t  top: 40%; left: 55%;\n1030\t  box-shadow: 0 4px 14px rgba(216,35,42,.4);\n1031\t}\n1032\t.map-ph .pin::before {\n1033\t  content: \"\"; position: absolute; inset: 5px;\n1034\t  background: #fff; border-radius: 50%;\n1035\t}\n1036\t\n1037\t/* ============================================\n1038\t   RESPONSIVE\n1039\t   ============================================ */\n1040\t@media (max-width: 1180px) {\n1041\t  .nav ul.nav-list {\n1042\t    position: absolute;\n1043\t    top: 100%;\n1044\t    left: 0; right: 0;\n1045\t    flex-direction: column;\n1046\t    gap: 0;\n1047\t    background: var(--paper);\n1048\t    border-bottom: 1px solid var(--line);\n1049\t    box-shadow: 0 24px 40px rgba(11,27,51,.12);\n1050\t    padding: 14px 0;\n1051\t    align-items: stretch;\n1052\t    transform: translateY(-8px);\n1053\t    opacity: 0;\n1054\t    pointer-events: none;\n1055\t    transition: opacity .15s ease, transform .15s ease;\n1056\t    margin-left: 0;\n1057\t  }\n1058\t  .nav ul.nav-list.mobile-open { opacity: 1; transform: translateY(0); pointer-events: auto; }\n1059\t  .nav ul.nav-list a, .more-btn { padding: 12px 32px; width: 100%; }\n1060\t  .nav ul.nav-list a.active::after, .more-btn.active::after { display: none; }\n1061\t  .nav ul.nav-list a.active, .more-btn.active { color: var(--accent); border-left: 3px solid var(--accent); padding-left: 29px; }\n1062\t  .more-wrap { width: 100%; }\n1063\t  .more-menu { position: static; opacity: 1; transform: none; pointer-events: auto; background: transparent; color: var(--navy); box-shadow: none; padding: 0; }\n1064\t  .nav ul.nav-list .more-menu a { color: var(--navy); padding: 10px 48px; }\n1065\t  .nav ul.nav-list .more-menu a:hover { background: var(--paper-2); }\n1066\t  .mobile-nav-toggle { display: inline-grid; place-items: center; margin-left: auto; }\n1067\t  .nav-cta { margin-left: auto; }\n1068\t  .prose-grid { grid-template-columns: 1fr; gap: 40px; }\n1069\t  .prose-aside { position: static; }\n1070\t  .pricing-grid { grid-template-columns: 1fr; }\n1071\t}\n1072\t@media (max-width: 1000px) {\n1073\t  .hero-grid { grid-template-columns: 1fr; gap: 40px; padding: 64px 0; }\n1074\t  .stats { grid-template-columns: repeat(2, 1fr); }\n1075\t  .stat:nth-child(2) { border-right: 0; }\n1076\t  .creds .inner { grid-template-columns: 1fr 1fr; }\n1077\t  .course-grid, .why-grid, .inst-grid, .test-grid, .posts-grid { grid-template-columns: 1fr; }\n1078\t  .course.featured { grid-column: auto; }\n1079\t  .section-head { grid-template-columns: 1fr; }\n1080\t  .faq-grid { grid-template-columns: 1fr; gap: 32px; }\n1081\t  .contact-grid { grid-template-columns: 1fr; }\n1082\t  .cta-band .inner { grid-template-columns: 1fr; }\n1083\t  .foot-grid { grid-template-columns: 1fr 1fr; }\n1084\t  .topbar .left, .topbar .right { gap: 12px; flex-wrap: wrap; }\n1085\t  .session { grid-template-columns: 1fr; gap: 8px; }\n1086\t}\n1087\t@media (max-width: 600px) {\n1088\t  .creds .inner { grid-template-columns: 1fr; }\n1089\t  .foot-grid { grid-template-columns: 1fr; }\n1090\t  .form-row { grid-template-columns: 1fr; }\n1091\t  .nav .inner { gap: 12px; }\n1092\t  .nav-call { display: none; }\n1093\t}\n1094\t"}]},"parent_tool_use_id":"toolu_01XapxLHEyck9dX6rnuNNgoX","session_id":"888fa852-5011-4157-96f7-fbd1c868f7da","uuid":"87177c6c-ad02-41eb-a50d-9bcc06b33f96","timestamp":"2026-06-17T18:21:52.119Z"}
[2026-06-17 13:21:52] [SSE-888fa852-5011-4157-96f7-fbd1c868f7da]: {"type":"tool_end","name":"Read","toolId":"toolu_01BWHWXnmhfFC2xpchdnTsm3","summary":"Read styles.css","detail":{"input":{"file_path":"/Users/andrewprice/DEV/brad/fastsmog/public/styles.css"},"output":"1\t/* ============================================\n2\t   F.A.S.T. SMOG TRAINING — DESIGN SYSTEM\n3\t   ============================================ */\n4\t\n5\t:root {\n6\t  /* Palette */\n7\t  --navy: #0B1B33;\n8\t  --navy-700: #122A4D;\n9\t  --navy-600: #1A3A6B;\n10\t  --steel: #2563C8;\n11\t  --steel-light: #4A86E0;\n12\t  --red: #D8232A;\n13\t  --red-dark: #B01820;\n14\t  --paper: #F4F1EB;\n15\t  --paper-2: #ECE7DC;\n16\t  --ink: #0B1B33;\n17\t  --ink-2: #4B5871;\n18\t  --line: rgba(11,27,51,.12);\n19\t  --line-strong: rgba(11,27,51,.22);\n20\t\n21\t  /* Primary (tweakable) */\n22\t  --primary: var(--navy);\n23\t  --primary-fg: #fff;\n24\t  --accent: var(--red);\n25\t\n26\t  /* Type (tweakable) */\n27\t  --font-display: \"Anton\", \"Oswald\", \"Impact\", sans-serif;\n28\t  --font-body: \"Manrope\", \"Helvetica Neue\", Arial, sans-serif;\n29\t  --font-mono: \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", monospace;\n30\t\n31\t  /* Scale */\n32\t  --container: 1280px;\n33\t  --gutter: clamp(20px, 4vw, 56px);\n34\t  --radius: 4px;\n35\t}\n36\t\n37\t/* Font-pairing presets */\n38\t[data-fontset=\"industrial\"] {\n39\t  --font-display: \"Anton\", sans-serif;\n40\t  --font-body: \"Manrope\", sans-serif;\n41\t  --font-mono: \"JetBrains Mono\", monospace;\n42\t}\n43\t[data-fontset=\"editorial\"] {\n44\t  --font-display: \"Archivo Black\", sans-serif;\n45\t  --font-body: \"IBM Plex Sans\", sans-serif;\n46\t  --font-mono: \"IBM Plex Mono\", monospace;\n47\t}\n48\t[data-fontset=\"utility\"] {\n49\t  --font-display: \"Oswald\", sans-serif;\n50\t  --font-body: \"DM Sans\", sans-serif;\n51\t  --font-mono: \"DM Mono\", monospace;\n52\t}\n53\t\n54\t/* ============================================\n55\t   RESET / BASE\n56\t   ============================================ */\n57\t*, *::before, *::after { box-sizing: border-box; }\n58\thtml { scroll-behavior: smooth; }\n59\tbody {\n60\t  margin: 0;\n61\t  font-family: var(--font-body);\n62\t  font-size: 16px;\n63\t  line-height: 1.55;\n64\t  color: var(--ink);\n65\t  background: var(--paper);\n66\t  -webkit-font-smoothing: antialiased;\n67\t  text-rendering: optimizeLegibility;\n68\t}\n69\timg, svg { display: block; max-width: 100%; }\n70\ta { color: inherit; text-decoration: none; }\n71\tbutton { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }\n72\th1, h2, h3, h4, h5 { margin: 0; font-family: var(--font-display); font-weight: 400; letter-spacing: .01em; line-height: 1; text-transform: uppercase; }\n73\tp { margin: 0; }\n74\t\n75\t.container {\n76\t  max-width: var(--container);\n77\t  margin: 0 auto;\n78\t  padding-inline: var(--gutter);\n79\t}\n80\t\n81\t/* ============================================\n82\t   UTILITY\n83\t   ============================================ */\n84\t.mono { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }\n85\t.eyebrow {\n86\t  display: inline-flex; align-items: center; gap: 10px;\n87\t  font-family: var(--font-mono);\n88\t  font-size: .72rem;\n89\t  letter-spacing: .18em;\n90\t  text-transform: uppercase;\n91\t  color: var(--ink-2);\n92\t}\n93\t.eyebrow::before {\n94\t  content: \"\";\n95\t  width: 28px; height: 2px;\n96\t  background: var(--accent);\n97\t}\n98\t.eyebrow.on-dark { color: rgba(255,255,255,.7); }\n99\t.eyebrow.on-dark::before { background: var(--accent); }\n100\t\n101\t.btn {\n102\t  display: inline-flex; align-items: center; gap: 10px;\n103\t  padding: 16px 24px;\n104\t  font-family: var(--font-display);\n105\t  font-size: 1rem;\n106\t  letter-spacing: .06em;\n107\t  text-transform: uppercase;\n108\t  border-radius: var(--radius);\n109\t  transition: transform .15s ease, background .15s ease, color .15s ease;\n110\t}\n111\t.btn:active { transform: translateY(1px); }\n112\t.btn-primary { background: var(--accent); color: #fff; }\n113\t.btn-primary:hover { background: var(--red-dark); }\n114\t.btn-ghost {\n115\t  background: transparent; color: inherit;\n116\t  box-shadow: inset 0 0 0 1.5px currentColor;\n117\t}\n118\t.btn-ghost:hover { background: currentColor; color: var(--paper); }\n119\t.btn-ghost:hover * { color: var(--paper); }\n120\t.btn .arrow { width: 18px; height: 10px; }\n121\t\n122\t.tag {\n123\t  display: inline-flex; align-items: center;\n124\t  padding: 4px 10px;\n125\t  font-family: var(--font-mono);\n126\t  font-size: .68rem;\n127\t  letter-spacing: .12em;\n128\t  text-transform: uppercase;\n129\t  background: var(--paper-2);\n130\t  color: var(--ink-2);\n131\t  border-radius: 2px;\n132\t}\n133\t.tag.red { background: var(--accent); color: #fff; }\n134\t.tag.steel { background: var(--steel); color: #fff; }\n135\t.tag.outline { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }\n136\t\n137\t/* Diagonal stripe motif (automotive caution-tape) */\n138\t.stripe-band {\n139\t  height: 14px;\n140\t  background: repeating-linear-gradient(\n141\t    -45deg,\n142\t    var(--accent) 0 14px,\n143\t    #1a1a1a 14px 28px\n144\t  );\n145\t}\n146\t\n147\t/* ============================================\n148\t   NAV\n149\t   ============================================ */\n150\t.topbar {\n151\t  background: var(--navy);\n152\t  color: #fff;\n153\t  font-size: .82rem;\n154\t  border-bottom: 1px solid rgba(255,255,255,.08);\n155\t}\n156\t.topbar .inner {\n157\t  display: flex; align-items: center; justify-content: space-between;\n158\t  padding: 8px 0;\n159\t}\n160\t.topbar .left, .topbar .right { display: flex; gap: 24px; align-items: center; }\n161\t.topbar .right a:hover { color: var(--steel-light); }\n162\t.topbar .dot { width: 6px; height: 6px; background: #3ad778; border-radius: 50%; display: inline-block; margin-right: 8px; box-shadow: 0 0 0 3px rgba(58,215,120,.18); }\n163\t\n164\t.nav {\n165\t  position: sticky; top: 0; z-index: 100;\n166\t  background: var(--paper);\n167\t  border-bottom: 1px solid var(--line);\n168\t  backdrop-filter: blur(8px);\n169\t}\n170\t.nav .inner {\n171\t  display: flex; align-items: center; gap: 32px;\n172\t  padding: 14px 0;\n173\t}\n174\t.logo {\n175\t  display: flex; align-items: center; gap: 12px;\n176\t  font-family: var(--font-display);\n177\t  font-size: 1.4rem;\n178\t  letter-spacing: .02em;\n179\t  text-transform: uppercase;\n180\t  color: var(--navy);\n181\t}\n182\t.logo .logo-img {\n183\t  height: 80px;\n184\t  width: auto;\n185\t  display: block;\n186\t}\n187\t.logo .mark {\n188\t  position: relative;\n189\t  width: 44px; height: 44px;\n190\t  background: var(--accent);\n191\t  border-radius: var(--radius);\n192\t  display: grid; place-items: center;\n193\t  color: #fff;\n194\t  font-family: var(--font-display);\n195\t  font-size: 1.1rem;\n196\t  letter-spacing: 0;\n197\t  overflow: hidden;\n198\t}\n199\t.logo .mark::after {\n200\t  content: \"\";\n201\t  position: absolute; inset: 0;\n202\t  background: repeating-linear-gradient(-45deg, transparent 0 6px, rgba(0,0,0,.12) 6px 7px);\n203\t  pointer-events: none;\n204\t}\n205\t.logo .sub { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; color: var(--ink-2); display: block; margin-top: 2px; text-transform: uppercase;}\n206\t.logo .name { line-height: 1; }\n207\t.nav ul.nav-list {\n208\t  display: flex; gap: 22px;\n209\t  list-style: none; margin: 0; padding: 0;\n210\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n211\t  margin-left: auto;\n212\t  align-items: center;\n213\t}\n214\t.nav ul.nav-list a, .more-btn { color: var(--navy); position: relative; padding: 4px 0; display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: inherit; letter-spacing: inherit; text-transform: inherit; }\n215\t.nav ul.nav-list a:hover, .more-btn:hover { color: var(--accent); }\n216\t.nav ul.nav-list a.active::after, .more-btn.active::after {\n217\t  content: \"\"; position: absolute; left: 0; right: 0; bottom: -6px;\n218\t  height: 2px; background: var(--accent);\n219\t}\n220\t/* More dropdown */\n221\t.more-wrap { position: relative; }\n222\t.more-menu {\n223\t  position: absolute;\n224\t  right: 0; top: calc(100% + 14px);\n225\t  min-width: 200px;\n226\t  background: var(--steel);\n227\t  color: #fff;\n228\t  padding: 14px 0;\n229\t  border-radius: 2px;\n230\t  box-shadow: 0 24px 48px rgba(11,27,51,.25);\n231\t  opacity: 0; transform: translateY(-6px); pointer-events: none;\n232\t  transition: opacity .15s ease, transform .15s ease;\n233\t  z-index: 200;\n234\t}\n235\t.more-menu.open { opacity: 1; transform: translateY(0); pointer-events: auto; }\n236\t.nav ul.nav-list .more-menu a {\n237\t  display: block;\n238\t  width: 100%;\n239\t  padding: 10px 22px;\n240\t  color: #fff;\n241\t  white-space: nowrap;\n242\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n243\t}\n244\t.nav ul.nav-list .more-menu a:hover { background: rgba(255,255,255,.1); color: #fff; }\n245\t.nav ul.nav-list .more-menu a.active { background: rgba(255,255,255,.15); }\n246\t\n247\t.nav .nav-cta { display: flex; gap: 12px; align-items: center; }\n248\t.nav-call { font-family: var(--font-mono); font-size: .85rem; letter-spacing: .04em; color: var(--navy); }\n249\t.nav-call strong { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .04em; display: block; }\n250\t.mobile-nav-toggle { display: none; padding: 10px; color: var(--navy); }\n251\t\n252\t/* ============================================\n253\t   HERO\n254\t   ============================================ */\n255\t.hero {\n256\t  background: var(--navy);\n257\t  color: #fff;\n258\t  position: relative;\n259\t  overflow: hidden;\n260\t}\n261\t/* Full-bleed hero background image */\n262\t.hero::before {\n263\t  content: \"\";\n264\t  position: absolute; inset: 0;\n265\t  background-image:\n266\t    /* dark overlay so the white/red text stays readable on any photo */\n267\t    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.75) 45%, rgba(11,27,51,.55) 100%),\n268\t    url(\"hero.jpg\");\n269\t  background-size: cover;\n270\t  background-position: center;\n271\t  pointer-events: none;\n272\t}\n273\t.hero-grid {\n274\t  position: relative;\n275\t  display: grid;\n276\t  grid-template-columns: 1fr;\n277\t  gap: 64px;\n278\t  align-items: center;\n279\t  padding: 96px 0 104px;\n280\t}\n281\t.hero-text { max-width: 880px; }\n282\t.hero h1 {\n283\t  font-size: clamp(56px, 8.5vw, 128px);\n284\t  line-height: .9;\n285\t  letter-spacing: -.005em;\n286\t}\n287\t.hero h1 .accent { color: var(--accent); }\n288\t.hero h1 .outline {\n289\t  -webkit-text-stroke: 2px #fff;\n290\t  color: transparent;\n291\t}\n292\t.hero .lede {\n293\t  margin-top: 28px;\n294\t  font-size: clamp(1.05rem, 1.4vw, 1.2rem);\n295\t  line-height: 1.5;\n296\t  color: rgba(255,255,255,.78);\n297\t  max-width: 52ch;\n298\t}\n299\t.hero .cta-row { margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }\n300\t.hero .quick-fact { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.55); padding-left: 16px; border-left: 2px solid var(--accent); }\n301\t\n302\t.hero-card {\n303\t  position: relative;\n304\t  border-radius: var(--radius);\n305\t  background: #fff;\n306\t  color: var(--navy);\n307\t  overflow: hidden;\n308\t  box-shadow: 0 30px 80px rgba(0,0,0,.45);\n309\t}\n310\t.hero-card .photo {\n311\t  aspect-ratio: 4/3;\n312\t  background:\n313\t    repeating-linear-gradient(135deg, rgba(11,27,51,.04) 0 14px, rgba(11,27,51,.08) 14px 28px),\n314\t    var(--paper-2);\n315\t  position: relative;\n316\t  display: grid; place-items: center;\n317\t}\n318\t.hero-card .photo .ph-label {\n319\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .15em;\n320\t  background: rgba(255,255,255,.85); padding: 6px 10px; border-radius: 2px;\n321\t  color: var(--ink-2);\n322\t}\n323\t.hero-card .meta { padding: 22px 24px; border-top: 1px solid var(--line); }\n324\t.hero-card .meta .row { display: flex; justify-content: space-between; align-items: baseline; }\n325\t.hero-card .meta .row + .row { margin-top: 8px; }\n326\t.hero-card .meta .label { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n327\t.hero-card .meta .val { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .02em; text-transform: uppercase; }\n328\t\n329\t/* Hero stats strip */\n330\t.stats {\n331\t  position: relative;\n332\t  display: grid;\n333\t  grid-template-columns: repeat(4, 1fr);\n334\t  gap: 0;\n335\t  border-top: 1px solid rgba(255,255,255,.12);\n336\t}\n337\t.stat {\n338\t  padding: 28px 24px;\n339\t  border-right: 1px solid rgba(255,255,255,.12);\n340\t}\n341\t.stat:last-child { border-right: 0; }\n342\t.stat .num { font-family: var(--font-display); font-size: clamp(2.2rem, 3.6vw, 3.4rem); line-height: 1; color: #fff; }\n343\t.stat .num small { font-size: .6em; color: var(--accent); margin-left: 4px; }\n344\t.stat .lbl { margin-top: 8px; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }\n345\t\n346\t/* Hero variant: FULL-BLEED */\n347\t.hero[data-variant=\"bleed\"] .hero-grid {\n348\t  grid-template-columns: 1fr;\n349\t  min-height: 640px;\n350\t  padding: 0;\n351\t  align-items: stretch;\n352\t}\n353\t.hero[data-variant=\"bleed\"] .hero-grid .hero-card { display: none; }\n354\t.hero[data-variant=\"bleed\"] .hero-text {\n355\t  padding: 120px 0 100px;\n356\t  position: relative;\n357\t  z-index: 2;\n358\t}\n359\t.hero[data-variant=\"bleed\"]::after {\n360\t  content: \"\";\n361\t  position: absolute;\n362\t  inset: 0;\n363\t  background:\n364\t    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.7) 50%, rgba(11,27,51,.4) 100%),\n365\t    repeating-linear-gradient(135deg, rgba(255,255,255,.04) 0 18px, rgba(255,255,255,.07) 18px 36px),\n366\t    var(--navy-700);\n367\t  pointer-events: none;\n368\t}\n369\t.hero[data-variant=\"bleed\"] .hero-text { padding-block: 120px; }\n370\t\n371\t/* Hero variant: TYPE — massive type, no card */\n372\t.hero[data-variant=\"type\"] .hero-grid {\n373\t  grid-template-columns: 1fr;\n374\t  padding: 100px 0 60px;\n375\t}\n376\t.hero[data-variant=\"type\"] h1 {\n377\t  font-size: clamp(72px, 14vw, 240px);\n378\t  line-height: .85;\n379\t}\n380\t.hero[data-variant=\"type\"] .hero-card { display: none; }\n381\t.hero[data-variant=\"type\"] .hero-text { max-width: none; }\n382\t.hero[data-variant=\"type\"] .lede { max-width: 44ch; }\n383\t.hero[data-variant=\"type\"] .marquee-row {\n384\t  display: grid; grid-template-columns: 2fr 1fr; gap: 64px; align-items: end;\n385\t  margin-top: 24px;\n386\t}\n387\t\n388\t/* ============================================\n389\t   CREDENTIALS STRIP\n390\t   ============================================ */\n391\t.creds {\n392\t  background: #fff;\n393\t  border-bottom: 1px solid var(--line);\n394\t}\n395\t.creds .inner {\n396\t  display: grid;\n397\t  grid-template-columns: 1.4fr repeat(4, 1fr);\n398\t  gap: 32px;\n399\t  padding: 28px 0;\n400\t  align-items: center;\n401\t}\n402\t.creds-label {\n403\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2);\n404\t}\n405\t.creds-label strong { display: block; font-family: var(--font-display); font-size: 1rem; color: var(--navy); margin-top: 4px; letter-spacing: .03em; }\n406\t.cred-item {\n407\t  display: flex; flex-direction: column; gap: 4px;\n408\t  padding-left: 16px;\n409\t  border-left: 2px solid var(--line);\n410\t}\n411\t.cred-item .k { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n412\t.cred-item .v { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: .02em; text-transform: uppercase; }\n413\t\n414\t/* ============================================\n415\t   SECTION\n416\t   ============================================ */\n417\t.section { padding: 96px 0; position: relative; }\n418\t.section.dark { background: var(--navy); color: #fff; }\n419\t.section.alt { background: var(--paper-2); }\n420\t\n421\t.section-head {\n422\t  display: grid;\n423\t  grid-template-columns: 1fr 1fr;\n424\t  gap: 48px;\n425\t  align-items: end;\n426\t  margin-bottom: 56px;\n427\t}\n428\t.section-head h2 {\n429\t  font-size: clamp(40px, 6vw, 84px);\n430\t  line-height: .92;\n431\t}\n432\t.section-head .lead { color: var(--ink-2); font-size: 1.05rem; max-width: 50ch; }\n433\t.section.dark .section-head .lead { color: rgba(255,255,255,.7); }\n434\t\n435\t/* ============================================\n436\t   COURSES — spec sheet cards\n437\t   ============================================ */\n438\t.course-grid {\n439\t  display: grid;\n440\t  grid-template-columns: repeat(2, 1fr);\n441\t  gap: 24px;\n442\t}\n443\t.course {\n444\t  background: #fff;\n445\t  border: 1px solid var(--line);\n446\t  border-radius: var(--radius);\n447\t  padding: 28px;\n448\t  display: flex; flex-direction: column;\n449\t  gap: 20px;\n450\t  position: relative;\n451\t  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n452\t}\n453\t.course:hover { transform: translateY(-3px); box-shadow: 0 24px 50px -20px rgba(11,27,51,.25); border-color: var(--line-strong); }\n454\t.course.featured { grid-column: 1 / -1; background: var(--navy); color: #fff; border-color: var(--navy); }\n455\t.course.featured .course-foot a { color: #fff; }\n456\t.course.featured .course-spec { border-color: rgba(255,255,255,.18); }\n457\t.course.featured .course-spec .k { color: rgba(255,255,255,.6); }\n458\t.course .course-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }\n459\t.course .code { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n460\t.course.featured .code { color: rgba(255,255,255,.65); }\n461\t.course h3 {\n462\t  font-size: clamp(1.6rem, 2.4vw, 2rem);\n463\t  line-height: 1.02;\n464\t  letter-spacing: .01em;\n465\t}\n466\t.course p { color: var(--ink-2); font-size: .95rem; line-height: 1.55; }\n467\t.course.featured p { color: rgba(255,255,255,.75); }\n468\t.course-specs {\n469\t  display: grid;\n470\t  grid-template-columns: repeat(3, 1fr);\n471\t  gap: 0;\n472\t  margin-top: auto;\n473\t}\n474\t.course-spec {\n475\t  padding: 14px 14px 14px 0;\n476\t  border-left: 1px solid var(--line);\n477\t  padding-left: 14px;\n478\t}\n479\t.course-spec:first-child { border-left: 0; padding-left: 0; }\n480\t.course-spec .k { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n481\t.course-spec .v { font-family: var(--font-display); font-size: 1rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 4px; }\n482\t.course-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 1px solid var(--line); }\n483\t.course.featured .course-foot { border-color: rgba(255,255,255,.16); }\n484\t.course-foot a { font-family: var(--font-display); letter-spacing: .04em; text-transform: uppercase; font-size: .95rem; display: inline-flex; align-items: center; gap: 8px; color: var(--navy); }\n485\t.course-foot a:hover { color: var(--accent); }\n486\t.course-foot a .arrow { width: 18px; height: 10px; }\n487\t.course-foot .price { font-family: var(--font-display); font-size: 1.4rem; color: var(--accent); letter-spacing: .02em; }\n488\t.course-foot .price .from { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; color: var(--ink-2); display: block; line-height: 1; }\n489\t\n490\t/* ============================================\n491\t   SCHEDULE\n492\t   ============================================ */\n493\t.schedule-wrap {\n494\t  background: #fff;\n495\t  border: 1px solid var(--line);\n496\t  border-radius: var(--radius);\n497\t  overflow: hidden;\n498\t}\n499\t.schedule-head {\n500\t  padding: 24px 28px;\n501\t  display: flex; justify-content: space-between; align-items: center;\n502\t  border-bottom: 1px solid var(--line);\n503\t  background: var(--paper);\n504\t}\n505\t.schedule-head .label { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n506\t.schedule-head h4 { font-size: 1.4rem; margin-top: 4px; }\n507\t.schedule-head .actions { display: flex; gap: 12px; align-items: center; }\n508\t.schedule-tabs { display: flex; gap: 4px; }\n509\t.schedule-tab {\n510\t  padding: 8px 14px;\n511\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n512\t  border-radius: 2px;\n513\t  color: var(--ink-2);\n514\t}\n515\t.schedule-tab.active { background: var(--navy); color: #fff; }\n516\t\n517\t.schedule-list {\n518\t  display: grid;\n519\t}\n520\t.session {\n521\t  display: grid;\n522\t  grid-template-columns: 110px 1fr auto auto auto;\n523\t  gap: 24px;\n524\t  padding: 22px 28px;\n525\t  align-items: center;\n526\t  border-top: 1px solid var(--line);\n527\t  transition: background .15s;\n528\t}\n529\t.session:first-child { border-top: 0; }\n530\t.session:hover { background: var(--paper); }\n531\t.session .date { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; line-height: 1; }\n532\t.session .date small { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; color: var(--ink-2); margin-top: 6px; }\n533\t.session .info h5 { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .03em; text-transform: uppercase; margin: 0; }\n534\t.session .info .sub { font-family: var(--font-mono); font-size: .72rem; color: var(--ink-2); letter-spacing: .08em; margin-top: 4px; }\n535\t.session .mode { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n536\t.session .seats {\n537\t  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n538\t  padding: 4px 10px; border-radius: 2px; background: var(--paper-2);\n539\t}\n540\t.session .seats.low { background: #FFE5D6; color: #B53E00; }\n541\t.session .seats.open { background: #E5F4EA; color: #1F6B36; }\n542\t.session .seats.waitlist { background: #F0EAFF; color: #5530A8; }\n543\t.session .reg-btn {\n544\t  padding: 10px 18px; background: var(--navy); color: #fff;\n545\t  font-family: var(--font-display); letter-spacing: .06em; text-transform: uppercase; font-size: .82rem;\n546\t  border-radius: 2px;\n547\t}\n548\t.session .reg-btn:hover { background: var(--accent); }\n549\t\n550\t.schedule-foot {\n551\t  padding: 20px 28px;\n552\t  border-top: 1px solid var(--line);\n553\t  background: var(--paper);\n554\t  display: flex; justify-content: space-between; align-items: center;\n555\t}\n556\t.schedule-foot .note { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; color: var(--ink-2); }\n557\t\n558\t/* ============================================\n559\t   WHY F.A.S.T.\n560\t   ============================================ */\n561\t.why-grid {\n562\t  display: grid;\n563\t  grid-template-columns: repeat(3, 1fr);\n564\t  gap: 1px;\n565\t  background: rgba(255,255,255,.12);\n566\t  border: 1px solid rgba(255,255,255,.12);\n567\t  border-radius: var(--radius);\n568\t  overflow: hidden;\n569\t}\n570\t.why {\n571\t  background: var(--navy);\n572\t  padding: 36px 32px;\n573\t  display: flex; flex-direction: column; gap: 14px;\n574\t  min-height: 240px;\n575\t}\n576\t.why .num { font-family: var(--font-display); font-size: 1rem; color: var(--accent); letter-spacing: .04em; }\n577\t.why h4 { font-size: 1.6rem; line-height: 1.05; letter-spacing: .01em; }\n578\t.why p { color: rgba(255,255,255,.7); font-size: .95rem; }\n579\t\n580\t/* ============================================\n581\t   INSTRUCTORS\n582\t   ============================================ */\n583\t.inst-grid {\n584\t  display: grid;\n585\t  grid-template-columns: repeat(3, 1fr);\n586\t  gap: 24px;\n587\t}\n588\t.inst {\n589\t  background: #fff;\n590\t  border: 1px solid var(--line);\n591\t  border-radius: var(--radius);\n592\t  overflow: hidden;\n593\t}\n594\t.inst .photo {\n595\t  aspect-ratio: 4/5;\n596\t  background:\n597\t    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n598\t    var(--paper-2);\n599\t  position: relative;\n600\t  display: grid; place-items: end stretch;\n601\t}\n602\t.inst .photo .ph-label {\n603\t  font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase;\n604\t  color: var(--ink-2); padding: 10px 12px;\n605\t  background: rgba(255,255,255,.85);\n606\t  align-self: end;\n607\t  border-top-right-radius: 4px;\n608\t  width: fit-content;\n609\t}\n610\t.inst .body { padding: 22px 24px; }\n611\t.inst .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n612\t.inst h4 { font-size: 1.4rem; letter-spacing: .02em; margin-top: 6px; }\n613\t.inst .bio { color: var(--ink-2); font-size: .92rem; margin-top: 10px; line-height: 1.55; }\n614\t.inst .creds { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }\n615\t\n616\t/* ============================================\n617\t   TESTIMONIALS\n618\t   ============================================ */\n619\t.test-grid {\n620\t  display: grid;\n621\t  grid-template-columns: repeat(3, 1fr);\n622\t  gap: 24px;\n623\t}\n624\t.test {\n625\t  background: #fff;\n626\t  border: 1px solid var(--line);\n627\t  border-radius: var(--radius);\n628\t  padding: 30px 28px;\n629\t  display: flex; flex-direction: column; gap: 18px;\n630\t}\n631\t.test .stars { color: var(--accent); letter-spacing: 2px; font-size: 1.1rem; }\n632\t.test blockquote { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; margin: 0; color: var(--ink); }\n633\t.test .who { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); }\n634\t.test .avatar {\n635\t  width: 40px; height: 40px; border-radius: 50%;\n636\t  background: var(--navy); color: #fff;\n637\t  display: grid; place-items: center;\n638\t  font-family: var(--font-display); font-size: .9rem; letter-spacing: .02em;\n639\t}\n640\t.test .who-text .name { font-family: var(--font-display); letter-spacing: .03em; text-transform: uppercase; font-size: .95rem; }\n641\t.test .who-text .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; color: var(--ink-2); margin-top: 2px; text-transform: uppercase; }\n642\t\n643\t/* ============================================\n644\t   FAQ\n645\t   ============================================ */\n646\t.faq-grid {\n647\t  display: grid;\n648\t  grid-template-columns: 1fr 1.4fr;\n649\t  gap: 64px;\n650\t  align-items: flex-start;\n651\t}\n652\t.faq-list {\n653\t  display: grid;\n654\t}\n655\t.faq-item {\n656\t  border-top: 1px solid var(--line-strong);\n657\t  padding: 24px 0;\n658\t}\n659\t.faq-item:last-child { border-bottom: 1px solid var(--line-strong); }\n660\t.faq-q {\n661\t  display: flex; justify-content: space-between; align-items: center;\n662\t  width: 100%; text-align: left;\n663\t  font-family: var(--font-display);\n664\t  font-size: 1.3rem;\n665\t  letter-spacing: .01em;\n666\t  text-transform: uppercase;\n667\t  color: var(--navy);\n668\t  padding: 0;\n669\t}\n670\t.faq-q .plus {\n671\t  width: 28px; height: 28px;\n672\t  border: 1.5px solid var(--navy);\n673\t  border-radius: 50%;\n674\t  display: grid; place-items: center;\n675\t  transition: transform .2s, background .2s, color .2s;\n676\t  flex-shrink: 0;\n677\t}\n678\t.faq-item[open] .faq-q .plus { background: var(--accent); border-color: var(--accent); color: #fff; transform: rotate(45deg); }\n679\t.faq-a { padding-top: 14px; color: var(--ink-2); max-width: 64ch; font-size: 1rem; line-height: 1.55; }\n680\t\n681\t/* ============================================\n682\t   CONTACT / CTA\n683\t   ============================================ */\n684\t.cta-band {\n685\t  background: var(--accent);\n686\t  color: #fff;\n687\t  padding: 80px 0;\n688\t  position: relative;\n689\t  overflow: hidden;\n690\t}\n691\t.cta-band::before {\n692\t  content: \"\";\n693\t  position: absolute; inset: 0;\n694\t  background: repeating-linear-gradient(-45deg, transparent 0 40px, rgba(0,0,0,.04) 40px 41px);\n695\t  pointer-events: none;\n696\t}\n697\t.cta-band .inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; position: relative; }\n698\t.cta-band h2 { font-size: clamp(40px, 6vw, 88px); line-height: .9; }\n699\t.cta-band .btn-primary { background: #fff; color: var(--accent); }\n700\t.cta-band .btn-primary:hover { background: var(--navy); color: #fff; }\n701\t.cta-band .btn-ghost { color: #fff; }\n702\t\n703\t.contact-grid {\n704\t  display: grid;\n705\t  grid-template-columns: 1fr 1fr;\n706\t  gap: 48px;\n707\t}\n708\t.contact-info > * + * { margin-top: 28px; }\n709\t.contact-block .label { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n710\t.contact-block .val { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 6px; }\n711\t.contact-block .sub { font-family: var(--font-body); color: var(--ink-2); margin-top: 4px; }\n712\t\n713\t.form { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }\n714\t.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n715\t.form label { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 6px; }\n716\t.form input, .form select, .form textarea {\n717\t  width: 100%; padding: 12px 14px;\n718\t  font-family: var(--font-body); font-size: .95rem;\n719\t  background: var(--paper); border: 1px solid var(--line); border-radius: 2px;\n720\t  color: var(--ink);\n721\t  transition: border-color .15s, background .15s;\n722\t}\n723\t.form input:focus, .form select:focus, .form textarea:focus { outline: 0; border-color: var(--navy); background: #fff; }\n724\t.form .field + .field { margin-top: 14px; }\n725\t.form textarea { min-height: 110px; resize: vertical; }\n726\t.form .submit { margin-top: 20px; width: 100%; justify-content: center; }\n727\t\n728\t/* ============================================\n729\t   FOOTER\n730\t   ============================================ */\n731\t.foot {\n732\t  background: #060F1F;\n733\t  color: rgba(255,255,255,.7);\n734\t  padding: 64px 0 28px;\n735\t  font-size: .9rem;\n736\t}\n737\t.foot-grid {\n738\t  display: grid;\n739\t  grid-template-columns: 1.4fr 1fr 1fr 1fr;\n740\t  gap: 48px;\n741\t  padding-bottom: 48px;\n742\t  border-bottom: 1px solid rgba(255,255,255,.08);\n743\t}\n744\t.foot h5 { font-family: var(--font-display); color: #fff; letter-spacing: .06em; font-size: .95rem; text-transform: uppercase; margin-bottom: 16px; }\n745\t.foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }\n746\t.foot ul a:hover { color: var(--accent); }\n747\t.foot .blurb { color: rgba(255,255,255,.55); max-width: 36ch; margin-top: 14px; }\n748\t.foot-bottom {\n749\t  padding-top: 24px;\n750\t  display: flex; justify-content: space-between; align-items: center;\n751\t  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.45);\n752\t}\n753\t.foot-bottom a:hover { color: var(--accent); }\n754\t\n755\t/* ============================================\n756\t   MARQUEE\n757\t   ============================================ */\n758\t.marquee {\n759\t  background: #0A1525;\n760\t  color: #fff;\n761\t  overflow: hidden;\n762\t  border-block: 1px solid rgba(255,255,255,.08);\n763\t  position: relative;\n764\t}\n765\t.marquee::before, .marquee::after {\n766\t  content: \"\";\n767\t  position: absolute; top: 0; bottom: 0; width: 80px;\n768\t  z-index: 2; pointer-events: none;\n769\t}\n770\t.marquee::before { left: 0; background: linear-gradient(90deg, #0A1525, transparent); }\n771\t.marquee::after { right: 0; background: linear-gradient(-90deg, #0A1525, transparent); }\n772\t.marquee-track {\n773\t  display: flex; gap: 56px; padding: 18px 0;\n774\t  animation: marquee 38s linear infinite;\n775\t  width: max-content;\n776\t}\n777\t.marquee-item {\n778\t  display: inline-flex; align-items: center; gap: 14px;\n779\t  font-family: var(--font-display);\n780\t  font-size: 1.2rem; letter-spacing: .04em; text-transform: uppercase;\n781\t  white-space: nowrap;\n782\t}\n783\t.marquee-item .bullet {\n784\t  width: 8px; height: 8px; background: var(--accent); border-radius: 50%;\n785\t}\n786\t@keyframes marquee {\n787\t  to { transform: translateX(-50%); }\n788\t}\n789\t\n790\t/* ============================================\n791\t   BLOG / RESOURCES\n792\t   ============================================ */\n793\t.posts-grid {\n794\t  display: grid;\n795\t  grid-template-columns: repeat(3, 1fr);\n796\t  gap: 24px;\n797\t}\n798\t.post {\n799\t  background: #fff;\n800\t  border: 1px solid var(--line);\n801\t  border-radius: var(--radius);\n802\t  overflow: hidden;\n803\t  display: flex; flex-direction: column;\n804\t  transition: transform .2s, box-shadow .2s;\n805\t}\n806\t.post:hover { transform: translateY(-3px); box-shadow: 0 20px 40px