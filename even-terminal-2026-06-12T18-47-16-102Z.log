[2026-06-17 13:16:36] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YbjBkAtGUCkL4X6JEiciQa","type":"tool_result","content":"1\t---\n2\timport Layout from '../layouts/Layout.astro';\n3\t---\n4\t\n5\t<Layout\n6\t  title=\"Class Schedule — F.A.S.T. Smog Training\"\n7\t  description=\"Upcoming BAR-certified smog inspector and repair technician training classes at F.A.S.T. in Escondido, CA.\"\n8\t  page=\"schedule\"\n9\t>\n10\t  <section class=\"page-hd\">\n11\t    <div class=\"container inner\">\n12\t      <div class=\"crumbs\"><a href=\"index.html\">Home</a><span>/</span>Class Schedule</div>\n13\t      <h1>Next <span class=\"accent\">90 days</span>.<br />Reserve your seat.</h1>\n14\t      <p class=\"lede\">\n15\t        Live schedule, pulled directly from our booking system. Most sessions run hybrid — online\n16\t        lecture plus optional hands-on labs at Owens Automotive in Escondido. Seats fill fast.\n17\t      </p>\n18\t    </div>\n19\t  </section>\n20\t\n21\t  <div class=\"stripe-band\" aria-hidden=\"true\"></div>\n22\t\n23\t  <section style=\"max-width: 1168px; margin: 0 auto; margin-top: 40px\">\n24\t    <iframe id=\"CS_portal_69cfeccaf1b5380740d77eed\"\n25\t      src=\"https://site.corsizio.com/portal/69cfeccaf1b5380740d77eed?embed=noheader,nosocial,nopadding,calendar,hidestarted,grouping:month,paging:20\"\n26\t      loading=\"lazy\" width=\"100%\" height=\"900px\" frameborder=\"0\"></iframe>\n27\t  </section>\n28\t\n29\t  <section class=\"section\">\n30\t    <div class=\"container\">\n31\t\n32\t      <div class=\"schedule-wrap\">\n33\t        <div class=\"schedule-head\">\n34\t          <div>\n35\t            <span class=\"label\">`king · powered by your scheduling plugin</span>\n36\t            <h4>All upcoming classes</h4>\n37\t          </div>\n38\t          <div class=\"actions\">\n39\t            <div class=\"schedule-tabs\">\n40\t              <button class=\"schedule-tab active\" data-filter=\"all\">All</button>\n41\t              <button class=\"schedule-tab\" data-filter=\"level1\">Level 1 / 2</button>\n42\t              <button class=\"schedule-tab\" data-filter=\"bsdr\">BAR Repair</button>\n43\t              <button class=\"schedule-tab\" data-filter=\"update\">Update</button>\n44\t            </div>\n45\t          </div>\n46\t        </div>\n47\t\n48\t        <div class=\"schedule-list\" id=\"schedule-list\">\n49\t          <div class=\"session\" data-course=\"update\">\n50\t            <div class=\"date\">JUN 14<small>Sat · 8a–4p</small></div>\n51\t            <div class=\"info\"><h5>UT079 · Transmission Diagnosis</h5><div class=\"sub\">Repair Tech Update · 12 hrs over 2 sessions</div></div>\n52\t            <div class=\"mode\">Online + Lab</div>\n53\t            <div class=\"seats low\">3 SEATS LEFT</div>\n54\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n55\t          </div>\n56\t          <div class=\"session\" data-course=\"update\">\n57\t            <div class=\"date\">JUN 28<small>Sat · 9a–5p</small></div>\n58\t            <div class=\"info\"><h5>Inspector Update · IS-Q2 2026</h5><div class=\"sub\">8 hrs · EIS firmware + procedural changes</div></div>\n59\t            <div class=\"mode\">Online</div>\n60\t            <div class=\"seats open\">14 OPEN</div>\n61\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n62\t          </div>\n63\t          <div class=\"session\" data-course=\"level1\">\n64\t            <div class=\"date\">JUL 07<small>Mon · 6-week</small></div>\n65\t            <div class=\"info\"><h5>Level 1 Smog Check Inspector</h5><div class=\"sub\">120 hrs · 6-week cohort · Online lecture + in-person lab</div></div>\n66\t            <div class=\"mode\">Hybrid</div>\n67\t            <div class=\"seats open\">12 OPEN</div>\n68\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n69\t          </div>\n70\t          <div class=\"session\" data-course=\"level1\">\n71\t            <div class=\"date\">JUL 21<small>Mon · 4-week</small></div>\n72\t            <div class=\"info\"><h5>Level 2 Smog Check Procedures</h5><div class=\"sub\">40 hrs · Hands-on EIS operation · Owens Automotive</div></div>\n73\t            <div class=\"mode\">In-person</div>\n74\t            <div class=\"seats open\">8 OPEN</div>\n75\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n76\t          </div>\n77\t          <div class=\"session\" data-course=\"bsdr\">\n78\t            <div class=\"date\">AUG 04<small>Mon · 9-week</small></div>\n79\t            <div class=\"info\"><h5>BAR Specified Diagnostic &amp; Repair</h5><div class=\"sub\">72 hrs · Alternative ASE qualifying path</div></div>\n80\t            <div class=\"mode\">Hybrid</div>\n81\t            <div class=\"seats waitlist\">WAITLIST</div>\n82\t            <a class=\"reg-btn\" href=\"class-registration.html\">Join List</a>\n83\t          </div>\n84\t          <div class=\"session\" data-course=\"update\">\n85\t            <div class=\"date\">AUG 16<small>Sat · 8a–4p</small></div>\n86\t            <div class=\"info\"><h5>Inspector Update · IS-Q3 2026</h5><div class=\"sub\">8 hrs · OBD-II + EIS firmware refresh</div></div>\n87\t            <div class=\"mode\">Online</div>\n88\t            <div class=\"seats open\">20 OPEN</div>\n89\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n90\t          </div>\n91\t          <div class=\"session\" data-course=\"update\">\n92\t            <div class=\"date\">SEP 06<small>Sat · 8a–4p</small></div>\n93\t            <div class=\"info\"><h5>UT080 · Hybrid &amp; EV Drivability</h5><div class=\"sub\">Repair Tech Update · 12 hrs over 2 sessions</div></div>\n94\t            <div class=\"mode\">Online + Lab</div>\n95\t            <div class=\"seats open\">15 OPEN</div>\n96\t            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n97\t          </div>\n98\t          <div class=\"ses