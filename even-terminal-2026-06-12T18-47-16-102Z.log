              <TableCell className=\"backups-td\">\n168\t                    {convertFileSize(r.size)}\n169\t                  </TableCell>\n170\t                  <TableCell className=\"backups-td\">{r.files ?? \"—\"}</TableCell>\n171\t                  <TableCell className=\"backups-td\">\n172\t                    {cometStatus(r.status)}\n173\t                  </TableCell>\n174\t                </TableRow>\n175\t              ))}\n176\t              {!sorted.length && (\n177\t                <TableRow>\n178\t                  <TableCell className=\"backups-td\" colSpan={4}>\n179\t                    No backups found.\n180\t                  </TableCell>\n181\t                </TableRow>\n182\t              )}\n183\t            </TableBody>\n184\t          </Table>\n185\t        </TableContainer>\n186\t\n187\t        <div className=\"backups-footer\">\n188\t          <span>\n189\t            {sorted.length} backup{sorted.length === 1 ? \"\" : \"s\"}\n190\t          </span>\n191\t        </div>\n192\t      </div>\n193\t    </MainLayout>\n194\t  );\n195\t};\n196\t\n197\texport default Backups;\n198\t"}]},"parent_tool_use_id":"toolu_01P1zxWVsMcX6MjEAkYa3TM7","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"05f3d82e-1496-45ea-b2e1-26cb27cd0c09","timestamp":"2026-06-14T21:15:35.150Z"}
