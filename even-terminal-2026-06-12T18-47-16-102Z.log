rt on StartTime.\n36\t      const sorted = [...list].sort((a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0));\n37\t      setJobs(sorted);\n38\t    } catch (err) {\n39\t      setError(err?.message || 'Could not load backup history.');\n40\t    } finally {\n41\t      setLoading(false);\n42\t      setRefreshing(false);\n43\t    }\n44\t  }, [email]);\n45\t\n46\t  useFocusEffect(useCallback(() => { load(); }, [load]));\n47\t\n48\t  const onRefresh = () => { setRefreshing(true); load(); };\n49\t\n50\t  const latest = useMemo(() => jobs[0], [jobs]);\n51\t\n52\t  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n53\t\n54\t  const renderItem = ({ item }) => {\n55\t    const s = statusStyle(item.Status);\n56\t    return (\n57\t      <Card style={styles.jobCard}>\n58\t        <Ionicons name={s.icon} size={26} color={s.color} style={{ marginRight: spacing.md }} />\n59\t        <View style={{ flex: 1 }}>\n60\t          <Text style={styles.jobTitle} numberOfLines={1}>\n61\t            {item.FriendlyName || 'Backup'}\n62\t          </Text>\n63\t          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n64\t          <Text style={styles.jobMeta}>\n65\t            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n66\t          </Text>\n67\t        </View>\n68\t        <Text style={[styles.jobStatus, { color: s.color }]}>{cometStatus(item.Status)}</Text>\n69\t      </Card>\n70\t    );\n71\t  };\n72\t\n73\t  return (\n74\t    <View style={styles.container}>\n75\t      <FlatList\n76\t        data={jobs}\n77\t        keyExtractor={(item, idx) => String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)}\n78\t        renderItem={renderItem}\n79\t        contentContainerStyle={styles.listContent}\n80\t        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n81\t        ListHeaderComponent={\n82\t          jobs.length ? (\n83\t            <View style={styles.header}>\n84\t              <Text style={styles.headerTitle}>Backup History</Text>\n85\t              <Text style={styles.headerSub}>\n86\t                {jobs.length} backup{jobs.length === 1 ? '' : 's'} · last {formatEpoch(latest?.StartTime)}\n87\t              </Text>\n88\t            </View>\n89\t          ) : null\n90\t        }\n91\t        ListEmptyComponent={\n92\t          error\n93\t            ? <EmptyState title=\"Something went wrong\" subtitle={error} />\n94\t            : <EmptyState title=\"No backups found\" subtitle=\"Backup activity will show up here.\" />\n95\t        }\n96\t      />\n97\t    </View>\n98\t  );\n99\t}\n100\t\n101\tconst styles = StyleSheet.create({\n102\t  container: { flex: 1, backgroundColor: colors.background },\n103\t  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n104\t  header: { marginBottom: spacing.md },\n105\t  headerTitle: { ...typography.title },\n106\t  headerSub: { ...typography.caption, marginTop: 2 },\n107\t  jobCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md },\n108\t  jobTitle: { ...typography.heading, marginBottom: 2 },\n109\t  jobMeta: { ...typography.caption },\n110\t  jobStatus: { fontSize: 12, fontWeight: '700', marginLeft: spacing.md },\n111\t});\n112\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"8adbcfbe-dcd3-4bb0-8293-19ccdb1d2203","timestamp":"2026-06-12T23:58:44.464Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/backups.jsx","content":"// app/(app)/backups.jsx — Comet backup job history for the signed-in user.\n// Mirrors core-frontend Backups.jsx (keyed by email; rows of date/size/files/status).\nimport { useCallback, useMemo, useState } from 'react';\nimport { View, Text, FlatList, RefreshControl, StyleSheet } from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getJobsForUser } from '../../src/services/cometService';\nimport { Card, Loader, EmptyState } from '../../src/components/ui';\nimport { formatEpoch, convertFileSize, cometStatus } from '../../src/utils/format';\nimport { colors, spacing, typography } from '../../src/theme/theme';\n\nfunction statusStyle(status) {\n  const label = cometStatus(status);\n  if (label === 'Success') return { color: colors.success, icon: 'checkmark-circle' };\n  if (label === 'Failed') return { color: colors.danger, icon: 'close-circle' };\n  if (label === 'Running') return { color: colors.secondary, icon: 'sync' };\n  return { color: colors.warning, icon: 'alert-circle' };\n}\n\nexport default function Backups() {\n  const { senturiUser } = useAuth();\n  const email = senturiUser?.email;\n\n  const [jobs, setJobs] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!email) { setJobs([]); setLoading(false); return; }\n    setError(null);\n    try {\n      const list = await getJobsForUser(email);\n      // Newest first, like the web hook's default `desc` sort on StartTime.\n      const sorted = [...list].sort((a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0));\n      setJobs(sorted);\n    } catch (err) {\n      setError(err?.message || 'Could not load backup history.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [email]);\n\n  useFocusEffect(useCallback(() => { load(); }, [load]));\n\n  const onRefresh = () => { setRefreshing(true); load(); };\n\n  const latest = useMemo(() => jobs[0], [jobs]);\n\n  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n\n  const renderItem = ({ item }) => {\n    const s = statusStyle(item.Status);\n    return (\n      <Card style={styles.jobCard}>\n        <Ionicons name={s.icon} size={26} color={s.color} style={{ marginRight: spacing.md }} />\n        <View style={{ flex: 1 }}>\n          <Text style={styles.jobTitle} numberOfLines={1}>\n            {item.FriendlyName || 'Backup'}\n          </Text>\n          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n          <Text style={styles.jobMeta}>\n            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n          </Text>\n        </View>\n        <Text style={[styles.jobStatus, { color: s.color }]}>{cometStatus(item.Status)}</Text>\n      </Card>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={jobs}\n        keyExtractor={(item, idx) => String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n        ListHeaderComponent={\n          jobs.length ? (\n            <View style={styles.header}>\n              <Text style={styles.headerTitle}>Backup History</Text>\n              <Text style={styles.headerSub}>\n                {jobs.length} backup{jobs.length === 1 ? '' : 's'} · last {formatEpoch(latest?.StartTime)}\n              </Text>\n            </View>\n          ) : null\n        }\n        ListEmptyComponent={\n          error\n            ? <EmptyState title=\"Something went wrong\" subtitle={error} />\n            : <EmptyState title=\"No backups found\" subtitle=\"Backup activity will show up here.\" />\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  header: { marginBottom: spacing.md },\n  headerTitle: { ...typography.title },\n  headerSub: { ...typography.caption, marginTop: 2 },\n  jobCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md },\n  jobTitle: { ...typography.heading, marginBottom: 2 },\n  jobMeta: { ...typography.caption },\n  jobStatus: { fontSize: 12, fontWeight: '700', marginLeft: spacing.md },\n});\n","numLines":112,"startLine":1,"totalLines":112}}}
