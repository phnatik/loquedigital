[2026-06-12 19:03:30] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPWyJqP9TpV5NgvpF4MoS5","type":"tool_result","content":"1\t// app/asset/[assetId].jsx — single device detail, mirroring the portal Asset page.\n2\t// Sections: header (status / last check-in / last backup), resource usage,\n3\t// security, device details, patch activity, and create-ticket for this device.\n4\timport { useCallback, useState } from 'react';\n5\timport {\n6\t  View,\n7\t  Text,\n8\t  ScrollView,\n9\t  StyleSheet,\n10\t  RefreshControl,\n11\t  Pressable,\n12\t  Modal,\n13\t  KeyboardAvoidingView,\n14\t  Platform,\n15\t} from 'react-native';\n16\timport { Stack, useLocalSearchParams, useRouter } from 'expo-router';\n17\timport { useFocusEffect } from '@react-navigation/native';\n18\timport { Ionicons } from '@expo/vector-icons';\n19\timport { useAuth } from '../../src/features/auth/AuthProvider';\n20\timport {\n21\t  getAsset,\n22\t  getAssetSummary,\n23\t  getAssetPatchDetails,\n24\t  createTicket,\n25\t} from '../../src/services/superopsService';\n26\timport { getJobsForUser } from '../../src/services/cometService';\n27\timport { Card, StatusPill, Loader, Button, Field } from '../../src/components/ui';\n28\timport {\n29\t  formatDateString,\n30\t  formatEpoch,\n31\t  metric,\n32\t  metricValue,\n33\t  toText,\n34\t} from '../../src/utils/format';\n35\timport { colors, spacing, typography, radius } from '../../src/theme/theme';\n36\t\n37\tfunction UtilBar({ label, value }) {\n38\t  const pct = typeof value === 'number' ? Math.max(0, Math.min(100, value)) : null;\n39\t  const color = pct == null ? colors.border : pct > 85 ? colors.danger : pct > 65 ? colors.warning : colors.primary;\n40\t  return (\n41\t    <View style={styles.utilRow}>\n42\t      <View style={styles.utilHeader}>\n43\t        <Text style={styles.utilLabel}>{label}</Text>\n44\t        <Text style={styles.utilValue}>{pct == null ? '—' : `${Math.round(pct)}%`}</Text>\n45\t      </View>\n46\t      <View style={styles.utilTrack}>\n47\t        <View style={[styles.utilFill, { width: `${pct ?? 0}%`, backgroundColor: color }]} />\n48\t      </View>\n49\t    </View>\n50\t  );\n51\t}\n52\t\n53\tfunction InfoRow({ label, value }) {\n54\t  // SuperOps fields can be objects ({id,name}, {value,unit}); coerce to a string.\n55\t  const text = toText(value);\n56\t  return (\n57\t    <View style={styles.infoRow}>\n58\t      <Text style={styles.infoLabel}>{label}</Text>\n59\t      <Text style={styles.infoValue} numberOfLines={1}>{text || '—'}</Text>\n60\t    </View>\n61\t  );\n62\t}\n63\t\n64\tfunction severityColor(sev) {\n65\t  const s = (sev || '').toString().toLowerCase();\n66\t  if (s.includes('critical')) return colors.danger;\n67\t  if (s.includes('important') || s.includes('high')) return colors.warning;\n68\t  return colors.textMuted;\n69\t}\n70\t\n71\t// \"Next scan\" indicator mirrors the portal: tomorrow at 8:00 AM.\n72\tfunction nextScanLabel() {\n73\t  const t = new Date();\n74\t  t.setDate(t.getDate() + 1);\n75\t  t.setHours(8, 0, 0, 0);\n76\t  return formatDateString(t);\n77\t}\n78\t\n79\texport default function AssetDetail() {\n80\t  const { assetId } = useLocalSearchParams();\n81\t  const router = useRouter();\n82\t  const { superopsAccountId, senturiUser } = useAuth();\n83\t\n84\t  const [asset, setAsset] = useState(null);\n85\t  const [summary, setSummary] = useState(null);\n86\t  const [patches, setPatches] = useState([]);\n87\t  const [latestBackup, setLatestBackup] = useState(null);\n88\t  const [loading, setLoading] = useState(true);\n89\t  const [refreshing, setRefreshing] = useState(false);\n90\t  const [error, setError] = useState(null);\n91\t\n92\t  // Create-ticket modal\n93\t  const [modalOpen, setModalOpen] = useState(false);\n94\t  const [subject, setSubject] = useState('');\n95\t  const [description, setDescription] = useState('');\n96\t  const [submitting, setSubmitting] = useState(false);\n97\t  const [formError, setFormError] = useState(null);\n98\t  const [formSuccess, setFormSuccess] = useState(false);\n99\t\n100\t  const load = useCallback(async () => {\n101\t    if (!assetId) return;\n102\t    setError(null);\n103\t    try {\n104\t      const [assetRes, summaryRes, patchRes, backupRes] = await Promise.allSettled([\n105\t        getAsset(assetId),\n106\t        getAssetSummary(assetId),\n107\t        getAssetPatchDetails(assetId),\n108\t        senturiUser?.email ? getJobsForUser(senturiUser.email) : Promise.resolve([]),\n109\t      ]);\n110\t\n111\t      const aData = assetRes.status === 'fulfilled' ? (assetRes.value?.data ?? assetRes.value) : null;\n112\t      setAsset(aData?.getAsset ?? aData ?? null);\n113\t\n114\t      const sData = summaryRes.status === 'fulfilled' ? (summaryRes.value?.data ?? summaryRes.value) : null;\n115\t      setSummary(sData?.getAssetSummary ?? sData ?? null);\n116\t\n117\t      const pData = patchRes.status === 'fulfilled' ? (patchRes.value?.data ?? patchRes.value) : null;\n118\t      setPatches(pData?.assetPatches ?? (Array.isArray(pData) ? pData : []));\n119\t\n120\t      if (backupRes.status === 'fulfilled' && Array.isArray(backupRes.value) && backupRes.value.length) {\n121\t        const newest = [...backupRes.value].sort((a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0))[0];\n122\t        setLatestBackup(newest);\n123\t      }\n124\t\n125\t      if (assetRes.status === 'rejected') setError('Some device data could not be loaded.');\n126\t    } catch (err) {\n127\t      setError(err?.message || 'Could not load device.');\n128\t    } finally {\n129\t      setLoading(false);\n130\t      setRefreshing(false);\n131\t    }\n132\t  }, [assetId, senturiUser?.email]);\n133\t\n134\t  useFocusEffect(useCallback(() => { load(); }, [load]));\n135\t\n136\t  const onRefresh = () => { setRefreshing(true); load(); };\n137\t\n138\t  const submitTicket = async () => {\n139\t    setFormError(null);\n140\t    if (!subject.trim()) { setFormError('A subject is required.'); return; }\n141\t    setSubmitting(true);\n142\t    try {\n143\t      await createTicket({\n144\t        subject: subject.trim(),\n145\t        description: description.trim(),\n146\t        assetId,\n147\t        machineName: a.name,\n148\t        accountId: superopsAccountId,\n149\t      });\n150\t      setFormSuccess(true);\n151\t      setSubject('');\n152\t      setDescription('');\n153\t      setTimeout(() => { setModalOpen(false); setFormSuccess(false); }, 1200);\n154\t    } catch (err) {\n155\t      setFormError(err?.message || 'Could not create the ticket.');\n156\t    } finally {\n157\t      setSubmitting(false);\n158\t    }\n159\t  };\n160\t\n161\t  const a = asset || {};\n162\t  const online = (a.status ?? 'online').toString().toLowerCase() !== 'offline';\n163\t\n164\t  const cpu = summary?.cpu || {};\n165\t  const memory = summary?.memory || {};\n166\t  const disk0 = summary?.disk?.disks?.[0] || {};\n167\t\n168\t  if (loading && !refreshing) {\n169\t    return (\n170\t      <>\n171\t        <Stack.Screen options={headerOptions(a.name || 'Device', router)} />\n172\t        <Loader label=\"Loading device…\" />\n173\t      </>\n174\t    );\n175\t  }\n176\t\n177\t  return (\n178\t    <>\n179\t      <Stack.Screen options={headerOptions(a.name || 'Device', router)} />\n180\t      <ScrollView\n181\t        style={styles.container}\n182\t        contentContainerStyle={styles.content}\n183\t        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n184\t      >\n185\t        {/* Header */}\n186\t        <View style={styles.titleRow}>\n187\t          <Text style={styles.deviceName} numberOfLines={1}>{a.name || `Asset ${assetId}`}</Text>\n188\t          <StatusPill online={online} />\n189\t        </View>\n190\t        <View style={styles.headerMetaRow}>\n191\t          <Ionicons name=\"time-outline\" size={15} color={colors.textMuted} />\n192\t          <Text style={styles.headerMeta}>Last check-in: {formatDateString(a.lastCommunicatedTime)}</Text>\n193\t        </View>\n194\t        <View style={styles.headerMetaRow}>\n195\t          <Ionicons name=\"cloud-done-outline\" size={15} color={colors.textMuted} />\n196\t          <Text style={styles.headerMeta}>Last backup: {formatEpoch(latestBackup?.StartTime)}</Text>\n197\t        </View>\n198\t        {error ? <Text style={styles.warn}>{error}</Text> : null}\n199\t\n200\t        {/* Status tiles */}\n201\t        <View style={styles.tileRow}>\n202\t          <View style={styles.tile}>\n203\t            <Ionicons name=\"shield-checkmark\" size={20} color={colors.primary} />\n204\t            <Text style={styles.tileLabel}>Protection</Text>\n205\t            <Text style={styles.tileValue}>Secure</Text>\n206\t          </View>\n207\t          <View style={styles.tile}>\n208\t            <Ionicons name=\"bandage-outline\" size={20} color={colors.secondary} />\n209\t            <Text style={styles.tileLabel}>Patches</Text>\n210\t            <Text style={styles.tileValue}>{toText(a.patchStatus) || 'Current'}</Text>\n211\t          </View>\n212\t        </View>\n213\t\n214\t        {/* Resource usage */}\n215\t        <Card style={styles.section}>\n216\t          <Text style={styles.sectionTitle}>Resource usage</Text>\n217\t          <UtilBar label=\"CPU\" value={metricValue(cpu.cpuUsage)} />\n218\t          <UtilBar label=\"Memory\" value={metricValue(memory.memoryUsage)} />\n219\t          <UtilBar label=\"Disk\" value={metricValue(disk0.driveUsage)} />\n220\t        </Card>\n221\t\n222\t        {/* Security (indicative, matches portal) */}\n223\t        <Card style={styles.section}>\n224\t          <Text style={styles.sectionTitle}>Security</Text>\n225\t          <InfoRow label=\"Antivirus\" value=\"Active\" />\n226\t          <InfoRow label=\"Threat posture\" value=\"Protected\" />\n227\t          <InfoRow label=\"Malware detected\" value=\"No\" />\n228\t          <InfoRow label=\"Next scan\" value={nextScanLabel()} />\n229\t        </Card>\n230\t\n231\t        {/* Device details — real fields returned by GET_ASSET / GET_ASSET_SUMMARY */}\n232\t        <Card style={styles.section}>\n233\t          <Text style={styles.sectionTitle}>Device</Text>\n234\t          <InfoRow label=\"Status\" value={a.status} />\n235\t          <InfoRow label=\"Platform\" value={a.platform} />\n236\t          <InfoRow label=\"OS version\" value={a.platformVersion} />\n237\t          <InfoRow label=\"Category\" value={a.deviceCategory} />\n238\t          <InfoRow label=\"Public IP\" value={a.publicIp} />\n239\t          <InfoRow label=\"MAC\" value={a.primaryMac} />\n240\t          <InfoRow label=\"Domain\" value={a.domain} />\n241\t          <InfoRow label=\"CPU\" value={cpu.cpuName} />\n242\t          <InfoRow label=\"CPU arch\" value={cpu.architecture} />\n243\t          <InfoRow label=\"RAM\" value={metric(memory.totalMemory)} />\n244\t          <InfoRow label=\"Disk\" value={metric(disk0.size)} />\n245\t        </Card>\n246\t\n247\t        {/* Patch activity */}\n248\t        <Card style={styles.section}>\n249\t          <Text style={styles.sectionTitle}>\n250\t            Recent patch activity {patches.length ? `(${patches.length})` : ''}\n251\t          </Text>\n252\t          {patches.length === 0 ? (\n253\t            <Text style={styles.muted}>No patch data available.</Text>\n254\t          ) : (\n255\t            patches.slice(0, 30).map((p, idx) => (\n256\t              <View key={idx} style={styles.patchRow}>\n257\t                <View style={[styles.sevDot, { backgroundColor: severityColor(toText(p?.patchDetail?.severity)) }]} />\n258\t                <View style={{ flex: 1 }}>\n259\t                  <Text style={styles.patchTitle} numberOfLines={2}>{toText(p?.patchDetail?.title) || '—'}</Text>\n260\t                  <Text style={styles.patchMeta}>\n261\t                    {(toText(p?.installationStatus) || 'Unknown')} · {formatDateString(p?.installationTime)}\n262\t                  </Text>\n263\t                </View>\n264\t              </View>\n265\t            ))\n266\t          )}\n267\t        </Card>\n268\t\n269\t        <Button\n270\t          title=\"Create a ticket for this device\"\n271\t          variant=\"secondary\"\n272\t          onPress={() => { setFormError(null); setFormSuccess(false); setModalOpen(true); }}\n273\t          style={{ marginTop: spacing.sm }}\n274\t        />\n275\t      </ScrollView>\n276\t\n277\t      {/* Create-ticket modal, prefilled for this asset */}\n278\t      <Modal visible={modalOpen} animationType=\"slide\" transparent onRequestClose={() => setModalOpen(false)}>\n279\t        <KeyboardAvoidingView\n280\t          style={styles.modalBackdrop}\n281\t          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n282\t        >\n283\t          <View style={styles.modalSheet}>\n284\t            <View style={styles.modalHeader}>\n285\t              <Text style={styles.modalTitle}>New ticket</Text>\n286\t              <Pressable onPress={() => setModalOpen(false)} hitSlop={10}>\n287\t                <Ionicons name=\"close\" size={24} color={colors.textMuted} />\n288\t              </Pressable>\n289\t            </View>\n290\t            <Text style={styles.modalDevice}>{a.name}</Text>\n291\t\n292\t            {formSuccess ? (\n293\t              <View style={styles.successWrap}>\n294\t                <Ionicons name=\"checkmark-circle\" size={40} color={colors.success} />\n295\t                <Text style={styles.successText}>Ticket created</Text>\n296\t              </View>\n297\t            ) : (\n298\t              <>\n299\t                <Field label=\"Subject\" value={subject} onChangeText={setSubject} placeholder=\"Briefly describe the issue\" />\n300\t                <Field\n301\t                  label=\"Description\"\n302\t                  value={description}\n303\t                  onChangeText={setDescription}\n304\t                  placeholder=\"Add any details that will help us help you\"\n305\t                  multiline\n306\t                  numberOfLines={4}\n307\t                  style={styles.multiline}\n308\t                />\n309\t                {formError ? <Text style={styles.error}>{formError}</Text> : null}\n310\t                <Button title=\"Submit ticket\" onPress={submitTicket} loading={submitting} />\n311\t              </>\n312\t            )}\n313\t          </View>\n314\t        </KeyboardAvoidingView>\n315\t      </Modal>\n316\t    </>\n317\t  );\n318\t}\n319\t\n320\tfunction headerOptions(title, router) {\n321\t  return {\n322\t    headerShown: true,\n323\t    title,\n324\t    headerStyle: { backgroundColor: colors.ink },\n325\t    headerTintColor: colors.textInverse,\n326\t    headerLeft: () => (\n327\t      <Pressable onPress={() => router.back()} hitSlop={12} style={{ paddingRight: spacing.md }}>\n328\t        <Ionicons name=\"chevron-back\" size={26} color={colors.textInverse} />\n329\t      </Pressable>\n330\t    ),\n331\t  };\n332\t}\n333\t\n334\tconst styles = StyleSheet.create({\n335\t  container: { flex: 1, backgroundColor: colors.background },\n336\t  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n337\t  titleRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },\n338\t  deviceName: { ...typography.title, flex: 1, marginRight: spacing.md },\n339\t  headerMetaRow: { flexDirection: 'row', alignItems: 'center', marginTop: spacing.xs },\n340\t  headerMeta: { ...typography.caption, marginLeft: spacing.xs },\n341\t  warn: { color: colors.warning, marginTop: spacing.sm, fontSize: 13 },\n342\t  tileRow: { flexDirection: 'row', gap: spacing.md, marginTop: spacing.lg },\n343\t  tile: {\n344\t    flex: 1, backgroundColor: colors.surface, borderRadius: radius.lg,\n345\t    borderWidth: 1, borderColor: colors.border, padding: spacing.lg, alignItems: 'flex-start',\n346\t  },\n347\t  tileLabel: { ...typography.caption, textTransform: 'uppercase', marginTop: spacing.sm },\n348\t  tileValue: { ...typography.heading, marginTop: 2 },\n349\t  section: { marginTop: spacing.lg },\n350\t  sectionTitle: { ...typography.label, textTransform: 'uppercase', marginBottom: spacing.md },\n351\t  utilRow: { marginBottom: spacing.md },\n352\t  utilHeader: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: spacing.xs },\n353\t  utilLabel: { ...typography.body },\n354\t  utilValue: { ...typography.body, fontWeight: '700' },\n355\t  utilTrack: { height: 8, borderRadius: 4, backgroundColor: colors.surfaceAlt, overflow: 'hidden' },\n356\t  utilFill: { height: 8, borderRadius: 4 },\n357\t  infoRow: { flexDirection: 'row', justifyContent: 'space-between', paddingVertical: spacing.sm, borderBottomWidth: 1, borderBottomColor: colors.surfaceAlt },\n358\t  infoLabel: { ...typography.body, color: colors.textMuted },\n359\t  infoValue: { ...typography.body, fontWeight: '600', flex: 1, textAlign: 'right', marginLeft: spacing.md },\n360\t  muted: { ...typography.caption },\n361\t  patchRow: { flexDirection: 'row', alignItems: 'flex-start', paddingVertical: spacing.sm, borderBottomWidth: 1, borderBottomColor: colors.surfaceAlt },\n362\t  sevDot: { width: 8, height: 8, borderRadius: 4, marginTop: 6, marginRight: spacing.md },\n363\t  patchTitle: { ...typography.body, marginBottom: 2 },\n364\t  patchMeta: { ...typography.caption },\n365\t  modalBackdrop: { flex: 1, backgroundColor: 'rgba(0,0,0,0.4)', justifyContent: 'flex-end' },\n366\t  modalSheet: { backgroundColor: colors.surface, borderTopLeftRadius: 20, borderTopRightRadius: 20, padding: spacing.xl, paddingBottom: spacing.xxl },\n367\t  modalHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' },\n368\t  modalTitle: { ...typography.title },\n369\t  modalDevice: { ...typography.caption, marginBottom: spacing.lg },\n370\t  multiline: { height: 110, textAlignVertical: 'top', paddingTop: spacing.md },\n371\t  error: { color: colors.danger, marginBottom: spacing.md },\n372\t  successWrap: { alignItems: 'center', paddingVertical: spacing.xl },\n373\t  successText: { ...typography.heading, marginTop: spacing.sm },\n374\t});\n375\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"3134fbfa-2df8-409a-b72f-5ee8248e3a3b","timestamp":"2026-06-13T00:03:30.363Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/asset/[assetId].jsx","content":"// app/asset/[assetId].jsx — single device detail, mirroring the portal Asset page.\n// Sections: header (status / last check-in / last backup), resource usage,\n// security, device details, patch activity, and create-ticket for this device.\nimport { useCallback, useState } from 'react';\nimport {\n  View,\n  Text,\n  ScrollView,\n  StyleSheet,\n  RefreshControl,\n  Pressable,\n  Modal,\n  KeyboardAvoidingView,\n  Platform,\n} from 'react-native';\nimport { Stack, useLocalSearchParams, useRouter } from 'expo-router';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport {\n  getAsset,\n  getAssetSummary,\n  getAssetPatchDetails,\n  createTicket,\n} from '../../src/services/superopsService';\nimport { getJobsForUser } from '../../src/services/cometService';\nimport { Card, StatusPill, Loader, Button, Field } from '../../src/components/ui';\nimport {\n  formatDateString,\n  formatEpoch,\n  metric,\n  metricValue,\n  toText,\n} from '../../src/utils/format';\nimport { colors, spacing, typography, radius } from '../../src/theme/theme';\n\nfunction UtilBar({ label, value }) {\n  const pct = typeof value === 'number' ? Math.max(0, Math.min(100, value)) : null;\n  const color = pct == null ? colors.border : pct > 85 ? colors.danger : pct > 65 ? colors.warning : colors.primary;\n  return (\n    <View style={styles.utilRow}>\n      <View style={styles.utilHeader}>\n        <Text style={styles.utilLabel}>{label}</Text>\n        <Text style={styles.utilValue}>{pct == null ? '—' : `${Math.round(pct)}%`}</Text>\n      </View>\n      <View style={styles.utilTrack}>\n        <View style={[styles.utilFill, { width: `${pct ?? 0}%`, backgroundColor: color }]} />\n      </View>\n    </View>\n  );\n}\n\nfunction InfoRow({ label, value }) {\n  // SuperOps fields can be objects ({id,name}, {value,unit}); coerce to a string.\n  const text = toText(value);\n  return (\n    <View style={styles.infoRow}>\n      <Text style={styles.infoLabel}>{label}</Text>\n      <Text style={styles.infoValue} numberOfLines={1}>{text || '—'}</Text>\n    </View>\n  );\n}\n\nfunction severityColor(sev) {\n  const s = (sev || '').toString().toLowerCase();\n  if (s.includes('critical')) return colors.danger;\n  if (s.includes('important') || s.includes('high')) return colors.warning;\n  return colors.textMuted;\n}\n\n// \"Next scan\" indicator mirrors the portal: tomorrow at 8:00 AM.\nfunction nextScanLabel() {\n  const t = new Date();\n  t.setDate(t.getDate() + 1);\n  t.setHours(8, 0, 0, 0);\n  return formatDateString(t);\n}\n\nexport default function AssetDetail() {\n  const { assetId } = useLocalSearchParams();\n  const router = useRouter();\n  const { superopsAccountId, senturiUser } = useAuth();\n\n  const [asset, setAsset] = useState(null);\n  const [summary, setSummary] = useState(null);\n  const [patches, setPatches] = useState([]);\n  const [latestBackup, setLatestBackup] = useState(null);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  // Create-ticket modal\n  const [modalOpen, setModalOpen] = useState(false);\n  const [subject, setSubject] = useState('');\n  const [description, setDescription] = useState('');\n  const [submitting, setSubmitting] = useState(false);\n  const [formError, setFormError] = useState(null);\n  const [formSuccess, setFormSuccess] = useState(false);\n\n  const load = useCallback(async () => {\n    if (!assetId) return;\n    setError(null);\n    try {\n      const [assetRes, summaryRes, patchRes, backupRes] = await Promise.allSettled([\n        getAsset(assetId),\n        getAssetSummary(assetId),\n        getAssetPatchDetails(assetId),\n        senturiUser?.email ? getJobsForUser(senturiUser.email) : Promise.resolve([]),\n      ]);\n\n      const aData = assetRes.status === 'fulfilled' ? (assetRes.value?.data ?? assetRes.value) : null;\n      setAsset(aData?.getAsset ?? aData ?? null);\n\n      const sData = summaryRes.status === 'fulfilled' ? (summaryRes.value?.data ?? summaryRes.value) : null;\n      setSummary(sData?.getAssetSummary ?? sData ?? null);\n\n      const pData = patchRes.status === 'fulfilled' ? (patchRes.value?.data ?? patchRes.value) : null;\n      setPatches(pData?.assetPatches ?? (Array.isArray(pData) ? pData : []));\n\n      if (backupRes.status === 'fulfilled' && Array.isArray(backupRes.value) && backupRes.value.length) {\n        const newest = [...backupRes.value].sort((a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0))[0];\n        setLatestBackup(newest);\n      }\n\n      if (assetRes.status === 'rejected') setError('Some device data could not be loaded.');\n    } catch (err) {\n      setError(err?.message || 'Could not load device.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [assetId, senturiUser?.email]);\n\n  useFocusEffect(useCallback(() => { load(); }, [load]));\n\n  const onRefresh = () => { setRefreshing(true); load(); };\n\n  const submitTicket = async () => {\n    setFormError(null);\n    if (!subject.trim()) { setFormError('A subject is required.'); return; }\n    setSubmitting(true);\n    try {\n      await createTicket({\n        subject: subject.trim(),\n        description: description.trim(),\n        assetId,\n        machineName: a.name,\n        accountId: superopsAccountId,\n      });\n      setFormSuccess(true);\n      setSubject('');\n      setDescription('');\n      setTimeout(() => { setModalOpen(false); setFormSuccess(false); }, 1200);\n    } catch (err) {\n      setFormError(err?.message || 'Could not create the ticket.');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const a = asset || {};\n  const online = (a.status ?? 'online').toString().toLowerCase() !== 'offline';\n\n  const cpu = summary?.cpu || {};\n  const memory = summary?.memory || {};\n  const disk0 = summary?.disk?.disks?.[0] || {};\n\n  if (loading && !refreshing) {\n    return (\n      <>\n        <Stack.Screen options={headerOptions(a.name || 'Device', router)} />\n        <Loader label=\"Loading device…\" />\n      </>\n    );\n  }\n\n  return (\n    <>\n      <Stack.Screen options={headerOptions(a.name || 'Device', router)} />\n      <ScrollView\n        style={styles.container}\n        contentContainerStyle={styles.content}\n        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n      >\n        {/* Header */}\n        <View style={styles.titleRow}>\n          <Text style={styles.deviceName} numberOfLines={1}>{a.name || `Asset ${assetId}`}</Text>\n          <StatusPill online={online} />\n        </View>\n        <View style={styles.headerMetaRow}>\n          <Ionicons name=\"time-outline\" size={15} color={colors.textMuted} />\n          <Text style={styles.headerMeta}>Last check-in: {formatDateString(a.lastCommunicatedTime)}</Text>\n        </View>\n        <View style={styles.headerMetaRow}>\n          <Ionicons name=\"cloud-done-outline\" size={15} color={colors.textMuted} />\n          <Text style={styles.headerMeta}>Last backup: {formatEpoch(latestBackup?.StartTime)}</Text>\n        </View>\n        {error ? <Text style={styles.warn}>{error}</Text> : null}\n\n        {/* Status tiles */}\n        <View style={styles.tileRow}>\n          <View style={styles.tile}>\n            <Ionicons name=\"shield-checkmark\" size={20} color={colors.primary} />\n            <Text style={styles.tileLabel}>Protection</Text>\n            <Text style={styles.tileValue}>Secure</Text>\n          </View>\n          <View style={styles.tile}>\n            <Ionicons name=\"bandage-outline\" size={20} color={colors.secondary} />\n            <Text style={styles.tileLabel}>Patches</Text>\n            <Text style={styles.tileValue}>{toText(a.patchStatus) || 'Current'}</Text>\n          </View>\n        </View>\n\n        {/* Resource usage */}\n        <Card style={styles.section}>\n          <Text style={styles.sectionTitle}>Resource usage</Text>\n          <UtilBar label=\"CPU\" value={metricValue(cpu.cpuUsage)} />\n          <UtilBar label=\"Memory\" value={metricValue(memory.memoryUsage)} />\n          <UtilBar label=\"Disk\" value={metricValue(disk0.driveUsage)} />\n        </Card>\n\n        {/* Security (indicative, matches portal) */}\n        <Card style={styles.section}>\n          <Text style={styles.sectionTitle}>Security</Text>\n          <InfoRow label=\"Antivirus\" value=\"Active\" />\n          <InfoRow label=\"Threat posture\" value=\"Protected\" />\n          <InfoRow label=\"Malware detected\" value=\"No\" />\n          <InfoRow label=\"Next scan\" value={nextScanLabel()} />\n        </Card>\n\n        {/* Device details — real fields returned by GET_ASSET / GET_ASSET_SUMMARY */}\n        <Card style={styles.section}>\n          <Text style={styles.sectionTitle}>Device</Text>\n          <InfoRow label=\"Status\" value={a.status} />\n          <InfoRow label=\"Platform\" value={a.platform} />\n          <InfoRow label=\"OS version\" value={a.platformVersion} />\n          <InfoRow label=\"Category\" value={a.deviceCategory} />\n          <InfoRow label=\"Public IP\" value={a.publicIp} />\n          <InfoRow label=\"MAC\" value={a.primaryMac} />\n          <InfoRow label=\"Domain\" value={a.domain} />\n          <InfoRow label=\"CPU\" value={cpu.cpuName} />\n          <InfoRow label=\"CPU arch\" value={cpu.architecture} />\n          <InfoRow label=\"RAM\" value={metric(memory.totalMemory)} />\n          <InfoRow label=\"Disk\" value={metric(disk0.size)} />\n        </Card>\n\n        {/* Patch activity */}\n        <Card style={styles.section}>\n          <Text style={styles.sectionTitle}>\n            Recent patch activity {patches.length ? `(${patches.length})` : ''}\n          </Text>\n          {patches.length === 0 ? (\n            <Text style={styles.muted}>No patch data available.</Text>\n          ) : (\n            patches.slice(0, 30).map((p, idx) => (\n              <View key={idx} style={styles.patchRow}>\n                <View style={[styles.sevDot, { backgroundColor: severityColor(toText(p?.patchDetail?.severity)) }]} />\n                <View style={{ flex: 1 }}>\n                  <Text style={styles.patchTitle} numberOfLines={2}>{toText(p?.patchDetail?.title) || '—'}</Text>\n                  <Text style={styles.patchMeta}>\n                    {(toText(p?.installationStatus) || 'Unknown')} · {formatDateString(p?.installationTime)}\n                  </Text>\n                </View>\n              </View>\n            ))\n          )}\n        </Card>\n\n        <Button\n          title=\"Create a ticket for this device\"\n          variant=\"secondary\"\n          onPress={() => { setFormError(null); setFormSuccess(false); setModalOpen(true); }}\n          style={{ marginTop: spacing.sm }}\n        />\n      </ScrollView>\n\n      {/* Create-ticket modal, prefilled for this asset */}\n      <Modal visible={modalOpen} animationType=\"slide\" transparent onRequestClose={() => setModalOpen(false)}>\n        <KeyboardAvoidingView\n          style={styles.modalBackdrop}\n          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n        >\n          <View style={styles.modalSheet}>\n            <View style={styles.modalHeader}>\n              <Text style={styles.modalTitle}>New ticket</Text>\n              <Pressable onPress={() => setModalOpen(false)} hitSlop={10}>\n                <Ionicons name=\"close\" size={24} color={colors.textMuted} />\n              </Pressable>\n            </View>\n            <Text style={styles.modalDevice}>{a.name}</Text>\n\n            {formSuccess ? (\n              <View style={styles.successWrap}>\n                <Ionicons name=\"checkmark-circle\" size={40} color={colors.success} />\n                <Text style={styles.successText}>Ticket created</Text>\n              </View>\n            ) : (\n              <>\n                <Field label=\"Subject\" value={subject} onChangeText={setSubject} placeholder=\"Briefly describe the issue\" />\n                <Field\n                  label=\"Description\"\n                  value={description}\n                  onChangeText={setDescription}\n                  placeholder=\"Add any details that will help us help you\"\n                  multiline\n                  numberOfLines={4}\n                  style={styles.multiline}\n                />\n                {formError ? <Text style={styles.error}>{formError}</Text> : null}\n                <Button title=\"Submit ticket\" onPress={submitTicket} loading={submitting} />\n              </>\n            )}\n          </View>\n        </KeyboardAvoidingView>\n      </Modal>\n    </>\n  );\n}\n\nfunction headerOptions(title, router) {\n  return {\n    headerShown: true,\n    title,\n    headerStyle: { backgroundColor: colors.ink },\n    headerTintColor: colors.textInverse,\n    headerLeft: () => (\n      <Pressable onPress={() => router.back()} hitSlop={12} style={{ paddingRight: spacing.md }}>\n        <Ionicons name=\"chevron-back\" size={26} color={colors.textInverse} />\n      </Pressable>\n    ),\n  };\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  titleRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },\n  deviceName: { ...typography.title, flex: 1, marginRight: spacing.md },\n  headerMetaRow: { flexDirection: 'row', alignItems: 'center', marginTop: spacing.xs },\n  headerMeta: { ...typography.caption, marginLeft: spacing.xs },\n  warn: { color: colors.warning, marginTop: spacing.sm, fontSize: 13 },\n  tileRow: { flexDirection: 'row', gap: spacing.md, marginTop: spacing.lg },\n  tile: {\n    flex: 1, backgroundColor: colors.surface, borderRadius: radius.lg,\n    borderWidth: 1, borderColor: colors.border, padding: spacing.lg, alignItems: 'flex-start',\n  },\n  tileLabel: { ...typography.caption, textTransform: 'uppercase', marginTop: spacing.sm },\n  tileValue: { ...typography.heading, marginTop: 2 },\n  section: { marginTop: spacing.lg },\n  sectionTitle: { ...typography.label, textTransform: 'uppercase', marginBottom: spacing.md },\n  utilRow: { marginBottom: spacing.md },\n  utilHeader: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: spacing.xs },\n  utilLabel: { ...typography.body },\n  utilValue: { ...typography.body, fontWeight: '700' },\n  utilTrack: { height: 8, borderRadius: 4, backgroundColor: colors.surfaceAlt, overflow: 'hidden' },\n  utilFill: { height: 8, borderRadius: 4 },\n  infoRow: { flexDirection: 'row', justifyContent: 'space-between', paddingVertical: spacing.sm, borderBottomWidth: 1, borderBottomColor: colors.surfaceAlt },\n  infoLabel: { ...typography.body, color: colors.textMuted },\n  infoValue: { ...typography.body, fontWeight: '600', flex: 1, textAlign: 'right', marginLeft: spacing.md },\n  muted: { ...typography.caption },\n  patchRow: { flexDirection: 'row', alignItems: 'flex-start', paddingVertical: spacing.sm, borderBottomWidth: 1, borderBottomColor: colors.surfaceAlt },\n  sevDot: { width: 8, height: 8, borderRadius: 4, marginTop: 6, marginRight: spacing.md },\n  patchTitle: { ...typography.body, marginBottom: 2 },\n  patchMeta: { ...typography.caption },\n  modalBackdrop: { flex: 1, backgroundColor: 'rgba(0,0,0,0.4)', justifyContent: 'flex-end' },\n  modalSheet: { backgroundColor: colors.surface, borderTopLeftRadius: 20, borderTopRightRadius: 20, padding: spacing.xl, paddingBottom: spacing.xxl },\n  modalHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' },\n  modalTitle: { ...typography.title },\n  modalDevice: { ...typography.caption, marginBottom: spacing.lg },\n  multiline: { height: 110, textAlignVertical: 'top', paddingTop: spacing.md },\n  error: { color: colors.danger, marginBottom: spacing.md },\n  successWrap: { alignItems: 'center', paddingVertical: spacing.xl },\n  successText: { ...typography.heading, marginTop: spacing.sm },\n});\n","numLines":375,"startLine":1,"totalLines":375}}}
