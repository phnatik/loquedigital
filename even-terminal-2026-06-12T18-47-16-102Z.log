   justifyContent: 'center',","-    marginRight: spacing.md,","-  },","+","+  /* Hero */","+  hero: { borderRadius: radius.md, padding: spacing.xl, marginBottom: spacing.lg, ...shadow.button },","+  heroTop: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' },","+  heroTitle: { fontSize: 22, fontWeight: '800', color: '#fff', letterSpacing: -0.5 },","+  heroSubtitle: { fontSize: 13, fontWeight: '500', color: 'rgba(255,255,255,0.7)', marginTop: 2 },","+  heroBadge: { flexDirection: 'row', alignItems: 'center', backgroundColor: 'rgba(255,255,255,0.2)', borderRadius: radius.pill, paddingVertical: 4, paddingHorizontal: 10 },","+  heroBadgeText: { fontSize: 12, fontWeight: '700', color: '#fff', marginLeft: 4 },","+  statsRow: { flexDirection: 'row', alignItems: 'center', marginTop: spacing.xl, backgroundColor: 'rgba(255,255,255,0.15)', borderRadius: radius.sm, paddingVertical: spacing.md },","+  stat: { flex: 1, alignItems: 'center' },","+  statNum: { fontSize: 22, fontWeight: '800', color: '#fff' },","+  statLabel: { fontSize: 11, fontWeight: '600', color: 'rgba(255,255,255,0.8)', marginTop: 2, textTransform: 'uppercase', letterSpacing: 0.5 },","+  statDivider: { width: 1, height: 28, backgroundColor: 'rgba(255,255,255,0.25)' },","+","+  /* Cards */","+  jobCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md, paddingVertical: spacing.lg, paddingHorizontal: spacing.lg },","+  statusIcon: { width: 44, height: 44, borderRadius: radius.md, alignItems: 'center', justifyContent: 'center', marginRight: spacing.md },","   jobTitle: { ...typography.heading, fontSize: 15, marginBottom: 2 },","   jobMeta: { ...typography.caption },","-  statusBadge: {","-    paddingHorizontal: spacing.md,","-    paddingVertical: spacing.xs,","-    borderRadius: radius.pill,","-    marginLeft: spacing.md,","-  },","+  statusBadge: { paddingHorizontal: spacing.md, paddingVertical: spacing.xs, borderRadius: radius.pill, marginLeft: spacing.md },","   jobStatus: { fontSize: 12, fontWeight: '700' },"," });"]}],"originalFile":"// app/(app)/backups.jsx — Comet backup job history for the signed-in user.\n// Mirrors core-frontend Backups.jsx (keyed by email; rows of date/size/files/status).\nimport { useCallback, useMemo, useState } from 'react';\nimport { View, Text, FlatList, RefreshControl, StyleSheet } from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getJobsForUser } from '../../src/services/cometService';\nimport { Card, Loader, EmptyState } from '../../src/components/ui';\nimport { formatEpoch, convertFileSize, cometStatus } from '../../src/utils/format';\nimport { colors, spacing, typography, radius } from '../../src/theme/theme';\n\nfunction statusStyle(status) {\n  const label = cometStatus(status);\n  if (label === 'Success') return { color: colors.success, icon: 'checkmark-circle' };\n  if (label === 'Failed') return { color: colors.danger, icon: 'close-circle' };\n  if (label === 'Running') return { color: colors.secondary, icon: 'sync' };\n  if (label === 'Skipped') return { color: colors.textMuted, icon: 'remove-circle-outline' };\n  return { color: colors.warning, icon: 'alert-circle' };\n}\n\nexport default function Backups() {\n  const { senturiUser } = useAuth();\n  const email = senturiUser?.email;\n\n  const [jobs, setJobs] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!email) {\n      setJobs([]);\n      setLoading(false);\n      return;\n    }\n    setError(null);\n    try {\n      const list = await getJobsForUser(email);\n      const sorted = [...list].sort(\n        (a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0),\n      );\n      setJobs(sorted);\n    } catch (err) {\n      setError(err?.message || 'Could not load backup history.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [email]);\n\n  useFocusEffect(\n    useCallback(() => {\n      load();\n    }, [load]),\n  );\n\n  const onRefresh = () => {\n    setRefreshing(true);\n    load();\n  };\n\n  const latest = useMemo(() => jobs[0], [jobs]);\n\n  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n\n  const renderItem = ({ item }) => {\n    const s = statusStyle(item.Status);\n    return (\n      <Card style={styles.jobCard}>\n        <View style={[styles.statusIcon, { backgroundColor: `${s.color}14` }]}>\n          <Ionicons name={s.icon} size={22} color={s.color} />\n        </View>\n        <View style={{ flex: 1 }}>\n          <Text style={styles.jobTitle} numberOfLines={1}>\n            {item.FriendlyName || 'Backup'}\n          </Text>\n          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n          <Text style={styles.jobMeta}>\n            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n          </Text>\n        </View>\n        <View style={[styles.statusBadge, { backgroundColor: `${s.color}18` }]}>\n          <Text style={[styles.jobStatus, { color: s.color }]}>\n            {cometStatus(item.Status)}\n          </Text>\n        </View>\n      </Card>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={jobs}\n        keyExtractor={(item, idx) =>\n          String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)\n        }\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={colors.primary}\n          />\n        }\n        ListHeaderComponent={\n          jobs.length ? (\n            <View style={styles.header}>\n              <Text style={styles.headerTitle}>Backup History</Text>\n              <Text style={styles.headerSub}>\n                {jobs.length} backup{jobs.length === 1 ? '' : 's'} · last{' '}\n                {formatEpoch(latest?.StartTime)}\n              </Text>\n            </View>\n          ) : null\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState\n              title=\"No backups found\"\n              subtitle=\"Backup activity will show up here.\"\n            />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  header: { marginBottom: spacing.lg },\n  headerTitle: { ...typography.title },\n  headerSub: { ...typography.caption, marginTop: spacing.xs },\n  jobCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  statusIcon: {\n    width: 44,\n    height: 44,\n    borderRadius: radius.md,\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  jobTitle: { ...typography.heading, fontSize: 15, marginBottom: 2 },\n  jobMeta: { ...typography.caption },\n  statusBadge: {\n    paddingHorizontal: spacing.md,\n    paddingVertical: spacing.xs,\n    borderRadius: radius.pill,\n    marginLeft: spacing.md,\n  },\n  jobStatus: { fontSize: 12, fontWeight: '700' },\n});\n","userModified":false}}
[2026-06-14 16:29:05] [SSE-ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d]: {"type":"tool_end","name":"Write","toolId":"toolu_0114oJFqkWqRpKXPZij4P5TB","summary":"Write backups.jsx (179 lines)","detail":{"input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/backups.jsx","content":"// app/(app)/backups.jsx — Comet backup job history with hero summary card.\nimport { useCallback, useMemo, useState } from 'react';\nimport { View, Text, FlatList, RefreshControl, StyleSheet } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getJobsForUser } from '../../src/services/cometService';\nimport { Card, Loader, EmptyState } from '../../src/components/ui';\nimport { formatEpoch, convertFileSize, cometStatus } from '../../src/utils/format';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nfunction statusStyle(status) {\n  const label = cometStatus(status);\n  if (label === 'Success') return { color: colors.success, icon: 'checkmark-circle' };\n  if (label === 'Failed') return { color: colors.danger, icon: 'close-circle' };\n  if (label === 'Running') return { color: colors.secondary, icon: 'sync' };\n  if (label === 'Skipped') return { color: colors.textMuted, icon: 'remove-circle-outline' };\n  return { color: colors.warning, icon: 'alert-circle' };\n}\n\nexport default function Backups() {\n  const { senturiUser } = useAuth();\n  const email = senturiUser?.email;\n\n  const [jobs, setJobs] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!email) { setJobs([]); setLoading(false); return; }\n    setError(null);\n    try {\n      const list = await getJobsForUser(email);\n      const sorted = [...list].sort((a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0));\n      setJobs(sorted);\n    } catch (err) {\n      setError(err?.message || 'Could not load backup history.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [email]);\n\n  useFocusEffect(useCallback(() => { load(); }, [load]));\n  const onRefresh = () => { setRefreshing(true); load(); };\n\n  const latest = useMemo(() => jobs[0], [jobs]);\n  const successCount = useMemo(\n    () => jobs.filter((j) => cometStatus(j.Status) === 'Success').length,\n    [jobs],\n  );\n  const failedCount = useMemo(\n    () => jobs.filter((j) => cometStatus(j.Status) === 'Failed').length,\n    [jobs],\n  );\n\n  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n\n  const latestStatus = latest ? statusStyle(latest.Status) : null;\n\n  const renderItem = ({ item }) => {\n    const s = statusStyle(item.Status);\n    return (\n      <Card style={styles.jobCard}>\n        <View style={[styles.statusIcon, { backgroundColor: `${s.color}14` }]}>\n          <Ionicons name={s.icon} size={22} color={s.color} />\n        </View>\n        <View style={{ flex: 1 }}>\n          <Text style={styles.jobTitle} numberOfLines={1}>\n            {item.FriendlyName || 'Backup'}\n          </Text>\n          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n          <Text style={styles.jobMeta}>\n            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n          </Text>\n        </View>\n        <View style={[styles.statusBadge, { backgroundColor: `${s.color}18` }]}>\n          <Text style={[styles.jobStatus, { color: s.color }]}>\n            {cometStatus(item.Status)}\n          </Text>\n        </View>\n      </Card>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={jobs}\n        keyExtractor={(item, idx) => String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n        ListHeaderComponent={\n          jobs.length ? (\n            <>\n              {/* Hero */}\n              <LinearGradient\n                colors={['#00a4b6', colors.primary]}\n                start={{ x: 0, y: 0 }}\n                end={{ x: 1, y: 1 }}\n                style={styles.hero}\n              >\n                <View style={styles.heroTop}>\n                  <View>\n                    <Text style={styles.heroTitle}>Backup History</Text>\n                    <Text style={styles.heroSubtitle}>\n                      Last: {formatEpoch(latest?.StartTime)}\n                    </Text>\n                  </View>\n                  {latestStatus ? (\n                    <View style={styles.heroBadge}>\n                      <Ionicons name={latestStatus.icon} size={16} color=\"#fff\" />\n                      <Text style={styles.heroBadgeText}>\n                        {cometStatus(latest.Status)}\n                      </Text>\n                    </View>\n                  ) : null}\n                </View>\n                <View style={styles.statsRow}>\n                  <View style={styles.stat}>\n                    <Text style={styles.statNum}>{jobs.length}</Text>\n                    <Text style={styles.statLabel}>Total</Text>\n                  </View>\n                  <View style={styles.statDivider} />\n                  <View style={styles.stat}>\n                    <Text style={styles.statNum}>{successCount}</Text>\n                    <Text style={styles.statLabel}>Success</Text>\n                  </View>\n                  <View style={styles.statDivider} />\n                  <View style={styles.stat}>\n                    <Text style={styles.statNum}>{failedCount}</Text>\n                    <Text style={styles.statLabel}>Failed</Text>\n                  </View>\n                </View>\n              </LinearGradient>\n            </>\n          ) : null\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState title=\"No backups found\" subtitle=\"Backup activity will show up here.\" />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n\n  /* Hero */\n  hero: { borderRadius: radius.md, padding: spacing.xl, marginBottom: spacing.lg, ...shadow.button },\n  heroTop: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start' },\n  heroTitle: { fontSize: 22, fontWeight: '800', color: '#fff', letterSpacing: -0.5 },\n  heroSubtitle: { fontSize: 13, fontWeight: '500', color: 'rgba(255,255,255,0.7)', marginTop: 2 },\n  heroBadge: { flexDirection: 'row', alignItems: 'center', backgroundColor: 'rgba(255,255,255,0.2)', borderRadius: radius.pill, paddingVertical: 4, paddingHorizontal: 10 },\n  heroBadgeText: { fontSize: 12, fontWeight: '700', color: '#fff', marginLeft: 4 },\n  statsRow: { flexDirection: 'row', alignItems: 'center', marginTop: spacing.xl, backgroundColor: 'rgba(255,255,255,0.15)', borderRadius: radius.sm, paddingVertical: spacing.md },\n  stat: { flex: 1, alignItems: 'center' },\n  statNum: { fontSize: 22, fontWeight: '800', color: '#fff' },\n  statLabel: { fontSize: 11, fontWeight: '600', color: 'rgba(255,255,255,0.8)', marginTop: 2, textTransform: 'uppercase', letterSpacing: 0.5 },\n  statDivider: { width: 1, height: 28, backgroundColor: 'rgba(255,255,255,0.25)' },\n\n  /* Cards */\n  jobCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md, paddingVertical: spacing.lg, paddingHorizontal: spacing.lg },\n  statusIcon: { width: 44, height: 44, borderRadius: radius.md, alignItems: 'center', justifyContent: 'center', marginRight: spacing.md },\n  jobTitle: { ...typography.heading, fontSize: 15, marginBottom: 2 },\n  jobMeta: { ...typography.caption },\n  statusBadge: { paddingHorizontal: spacing.md, paddingVertical: spacing.xs, borderRadius: radius.pill, marginLeft: spacing.md },\n  jobStatus: { fontSize: 12, fontWeight: '700' },\n});\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(app)/backups.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
