ient(input: $input) {\n70\t      accountId\n71\t      primaryContact\n72\t    }\n73\t  }\n74\t`;\n75\t\n76\tconst GET_CLIENT_SITE = gql`\n77\t    query getClientSite($input: ClientSiteIdentifierInput!) {\n78\t    getClientSite(input: $input) {\n79\t      id\n80\t      name\n81\t      timezoneCode\n82\t      working24x7\n83\t      line1\n84\t      line2\n85\t      line3\n86\t      city\n87\t      postalCode\n88\t      countryCode\n89\t      stateCode\n90\t      contactNumber\n91\t      client\n92\t      hq\n93\t      installerInfo {\n94\t        id\n95\t        installerDownloadUrl\n96\t        installerName\n97\t        os\n98\t      }\n99\t    }\n100\t  }\n101\t`;\n102\t\n103\t// update client ... specifically for sending bitdefender install links to superops custom fields\n104\tconst UPDATE_CLIENT_CUSTOM_FIELDS = gql`\n105\t  mutation updateClient($input: UpdateClientInput!) {\n106\t    updateClient(input: $input) {\n107\t      accountId\n108\t      name\n109\t      stage\n110\t      status\n111\t      emailDomains\n112\t      accountManager\n113\t      primaryContact\n114\t      secondaryContact\n115\t      hqSite\n116\t      technicianGroups\n117\t      customFields\n118\t    }\n119\t  }\n120\t`;\n121\t\n122\tconst GET_ASSET_LIST = gql`\n123\t  query getAsseetList($input: ListInfoInput!) {\n124\t    getAssetList(input: $input) {\n125\t      assets {\n126\t        assetId\n127\t        name\n128\t        assetClass\n129\t        client\n130\t        site\n131\t      }\n132\t      listInfo{\n133\t        page\n134\t        pageSize\n135\t        condition\n136\t      }\n137\t    }\n138\t  }\n139\t`;\n140\t\n141\t\n142\tconst GET_ASSET_SUMMARY = gql`\n143\t  query getAssetSummary($input: AssetIdentifierInput!) {\n144\t      getAssetSummary(input: $input) {\n145\t        cpu {\n146\t          assetId\n147\t          cpuUsage\n148\t          cpuName\n149\t          currentSpeed\n150\t          maxSpeed\n151\t          physicalCore\n152\t          architecture\n153\t        }\n154\t        memory {\n155\t          totalMemory\n156\t          memoryUsage\n157\t        }\n158\t        disk {\n159\t          disks {\n160\t            drive\n161\t            discType\n162\t            fileSystem\n163\t            maxFileLength\n164\t            indexed\n165\t            size\n166\t            freeSize\n167\t            activeTime\n168\t            responseTime\n169\t            readSpeed\n170\t            writeSpeed\n171\t            driveUsage\n172\t          }\n173\t        }\n174\t        assetInterface {\n175\t          name\n176\t          mac\n177\t        }\n178\t      }\n179\t    }  \n180\t`;\n181\t\n182\tconst GET_ASSET = gql`\n183\t  query getAsset($input: AssetIdentifierInput!){\n184\t    getAsset(input: $input) {\n185\t        requester\n186\t        assetId\n187\t        assetClass\n188\t        site\n189\t        domain\n190\t        publicIp\n191\t        name\n192\t        platform\n193\t        primaryMac\n194\t        status\n195\t        sysUptime\n196\t        deviceCategory\n197\t        patchStatus\n198\t        platformFamily\n199\t        platformCategory\n200\t        platformVersion\n201\t        lastCommunicatedTime\n202\t        lastReportedTime\n203\t        customFields\n204\t    }\n205\t  }\n206\t`;\n207\t\n208\tconst GET_ASSET_PATCH_DETAILS = gql`\n209\t  query getAssetPatchDetails($input: AssetDetailsListInput!) {\n210\t  getAssetPatchDetails(input: $input) {\n211\t    assetPatches {      \n212\t        patchDetail{\n213\t            patchId\n214\t            title\n215\t            publishedDate\n216\t            category\n217\t            severity\n218\t            restartRequired\n219\t        }\n220\t        approvalStatus\n221\t        installationTime\n222\t        installationStatus\n223\t        failedMessage\n224\t    }\n225\t    \n226\t  }\n227\t}\n228\t`;\n229\t\n230\tconst CREATE_TICKET = gql`\n231\tmutation createTicket($input: CreateTicketInput!) {\n232\t  createTicket(input: $input) {\