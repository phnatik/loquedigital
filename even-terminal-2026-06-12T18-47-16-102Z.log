err = new Error(cometUserResponse.data.Message || 'Create user failed');\n55\t      // console.log(cometUserResponse);\n56\t      err._cometStatus400 = true;\n57\t      throw err;\n58\t    }\n59\t    return cometUserResponse.data;\n60\t  } catch (error) {\n61\t    // let controller decide 400 vs 500\n62\t    throw error;\n63\t  }\n64\t};\n65\t\n66\t// Step 2: Create CometBackup Storage Vault\n67\texports.createCometStorageVault = async (clientEmail) => {\n68\t  const form = new FormData();\n69\t  form.append('Username', process.env.COMET_UN);\n70\t  form.append('Password', process.env.COMET_PW);\n71\t  form.append('AuthType', 'Password');\n72\t  form.append('TargetUser', clientEmail);\n73\t  form.append('StorageProvider', process.env.COMET_STORAGE_VAULT_TIER_1);\n74\t  form.append('SelfAddress', process.env.COMET_URL);\n75\t\n76\t  const config = {\n77\t    method: 'post',\n78\t    url: process.env.COMET_URL + process.env.COMET_CREATE_STORAGE_VAULT,\n79\t    data: form\n80\t  };\n81\t\n82\t  try {\n83\t    const response = await axios.request(config);\n84\t    if (response.data.Status === 400) {\n85\t      return {\n86\t        error: response.data.message,\n87\t        message: 'Could not create storage vault in Comet.'\n88\t      };\n89\t    }\n90\t    return {\n91\t      message: 'Storage Vault created in Comet',\n92\t      response: response.data\n93\t    };\n94\t  } catch (error) {\n95\t    console.error('❌ Failed to create Storage Vault:', error.response?.data || error.message);\n96\t    return {\n97\t      error,\n98\t      message: 'Internal server error. Could not create storage vault in Comet.'\n99\t    };\n100\t  }\n101\t};\n102\t\n103\t// Step 3: Associate Policy ID to the User\n104\texports.associatePolicyIdToUser = async (clientEmail) => {\n105\t  try {\n106\t    let userProfile = await exports.getUserProfile(clientEmail);\n107\t    userProfile = userProfile.response;\n108\t    userProfile.PolicyID = process.env.COMET_POLICY_ID_TIER_1;\n109\t\n110\t    const form = new FormData();\n111\t    form.append('Username', process.env.COMET_UN);\n112\t    form.append('Password', process.env.COMET_PW);\n113\t    form.append('AuthType', 'Password');\n114\t    form.append('TargetUser', clientEmail);\n115\t    form.append('ProfileData', JSON.stringify(userProfile));\n116\t\n117\t    const config = {\n118\t      method: 'post',\n119\t      url: process.env.COMET_SET_USER_PROFILE,\n120\t      data: form\n121\t    };\n122\t\n123\t    const response = await axios.request(config);\n124\t    console.log('🔥 COMET: ' + response);\n125\t    if (response.data.Status !== 200) {\n126\t      return {\n127\t        error: response.data.Message || 'Unknown error',\n128\t        message: 'Could not associate storage vault to comet user.'\n129\t      };\n130\t    }\n131\t\n132\t    return {\n133\t      message: 'User successfully associated',\n134\t      response: response.data\n135\t    };\n136\t  } catch (error) {\n137\t    console.error('❌ Failed to associate Storage Vault:', error.response?.data || error.message);\n138\t    return {\n139\t      error,\n140\t      message: 'Internal server error. Could not create storage vault in Comet.'\n141\t    };\n142\t  }\n143\t};\n144\t\n145\t// Get User Profile (used by job history + associate policy)\n146\texports.getUserProfile = async (emailAddress) => {\n147\t  const data = new FormData();\n148\t  data.append('Username', `${process.env.COMET_UN}`);\n149\t  data.append('Password', `${process.env.COMET_PW}`);\n150\t  data.append('AuthType', `Password`);\n151\t  data.append('TargetUser', `${emailAddress}`);\n152\t\n153\t  const config = {\n154\t    method: 'post',\n155\t    url: process.env.COMET_GET_USER_PROFILE,\n156\t    data\n157\t  };\n158\t\n159\t  try {\n160\t    const cometUserProfile = await axios.request(config);\n161\t\n162\t    if (cometUserProfile.data.Status === 400) {\n163\t      return {\n164\t        error: cometUserProfile.data.message,\n165\t        message: 'Could not fetch User Profile.'\n166\t      };\n167\t    }\n168\t\n169\t    if (cometUserProfile.data.length === 0) {\n170\t      return {\n171\t        message: 'No User Profile Data Found',\n172\t        response: cometUserProfile.data\n173\t      };\n174\t    }\n175\t\n176\t    return {\n177\t      message: 'User Profile Fetched Successfully',\n178\t      response: cometUserProfile.data\n179\t    };\n180\t  } catch (error) {\n181\t    console.error(error);\n182\t    return {\n183\t      error: error.message || error,\n184\t      message: 'Internal server error. Could not fetch User Profile.'\n185\t    };\n186\t  }\n187\t};\n188\t\n189\t// Get User Jobs History (and enrich with FriendlyName)\n190\texports.getUserJobsHistory = async (emailAddress) => {\n191\t  const data = new FormData();\n192\t  data.append('Username', `${process.env.COMET_UN}`);\n193\t  data.append('Password', `${process.env.COMET_PW}`);\n194\t  data.append('AuthType', 'Password');\n195\t  data.append('TargetUser', `${emailAddress}`);\n196\t\n197\t  const config = {\n198\t    method: 'post',\n199\t    url: process.env.COMET_GET_JOB_HISTORY,\n200\t    data\n201\t  };\n202\t\n203\t  try {\n204\t    const cometJobHistoryResponse = await axios.request(config);\n205\t\n206\t    if (cometJobHistoryResponse.data.Status === 400) {\n207\t      return {\n208\t        _status: 400,\n209\t        error: cometJobHistoryResponse.data.message\n210\t      };\n211\t    }\n212\t\n213\t    if (cometJobHistoryResponse.data.length === 0) {\n214\t      return {\n215\t        _empty: true,\n216\t        history: cometJobHistoryResponse.data\n217\t      };\n218\t    }\n219\t\n220\t    const userProfile = await exports.getUserProfile(emailAddress);\n221\t    if (!userProfile || !userProfile.response || !userProfile.response.Devices) {\n222\t      return {\n223\t        _status: 400,\n224\t        error: 'User profile could not be retrieved',\n225\t        history: cometJobHistoryResponse.data\n226\t      };\n227\t    }\n228\t\n229\t    const deviceMap = Object.entries(userProfile.response.Devices).reduce((acc, [deviceID, deviceDetails]) => {\n230\t      acc[deviceID] = deviceDetails.FriendlyName || 'Unknown Device';\n231\t      return acc;\n232\t    }, {});\n233\t\n234\t    const enrichedHistory = cometJobHistoryResponse.data.map((job) => ({\n235\t      ...job,\n236\t      FriendlyName: deviceMap[job.DeviceID] || 'Unknown Device'\n237\t    }));\n238\t\n239\t    return {\n240\t      enrichedHistory\n241\t    };\n242\t  } catch (error) {\n243\t    throw error;\n244\t  }\n245\t};\n246\t\n247\t// Generate Session Key (user web session)\n248\texports.generateSessionKey = async (emailAddress) => {\n249\t  const data = new FormData();\n250\t  data.append('Username', `${emailAddress}`);\n251\t  data.append('Password', `${process.env.COMET_US_PW}`);\n252\t  data.append('AuthType', 'Password');\n253\t\n254\t  const config = {\n255\t    method: 'post',\n256\t    maxBodyLength: Infinity,\n257\t    url: 'https://backup.senturi.io/api/v1/user/web/session/start',\n258\t    headers: {\n259\t      ...data.getHeaders()\n260\t    },\n261\t    data\n262\t  };\n263\t\n264\t  const response = await axios.request(config);\n265\t  return response.data.SessionKey;\n266\t};\n267\t\n268\t// Create User Install Token (bash helper)\n269\texports.createUserToken = async (emailAddress, password) => {\n270\t  const data = new FormData();\n271\t  data.append('Username', process.env.COMET_UN);\n272\t  data.append('Password', process.env.COMET_PW);\n273\t  data.append('AuthType', 'Password');\n274\t  data.append('TargetUser', emailAddress);\n275\t  data.append('TargetPassword', password);\n276\t\n277\t  const config = {\n278\t    method: 'post',\n279\t    url: process.env.COMET_CREATE_USER_TOKEN,\n280\t    headers: {\n281\t      ...data.getHeaders()\n282\t    },\n283\t    data\n284\t  };\n285\t\n286\t  const response = await axios.request(config);\n287\t  return response.data.InstallToken.Token;\n288\t};\n289\t\n290\texports.getJobsForUser = async (emailAddress) => {\n291\t  const data = new FormData();\n292\t  data.append('Username', process.env.COMET_UN);\n293\t  data.append('Password', process.env.COMET_PW);\n294\t  data.append('AuthType', 'Password');\n295\t  data.append('TargetUser', emailAddress);\n296\t\n297\t  const config = {\n298\t    method: 'post',\n299\t    url: process.env.COMET_GET_JOBS_FOR_USER,\n300\t    headers: {\n301\t      ...data.getHeaders()\n302\t    },\n303\t    data\n304\t  };\n305\t\n306\t  const response = await axios.request(config);\n307\t  return response.data;\n308\t};"}}
