ext style={styles.headerMeta}>Last check-in: {formatDateString(a.lastCommunicatedTime)}</Text>","+          <Text style={styles.headerMeta}>","+            Last check-in: {formatDateString(a.lastCommunicatedTime)}","+          </Text>","         </View>","         <View style={styles.headerMetaRow}>","-          <Ionicons name=\"cloud-done-outline\" size={15} color={colors.textMuted} />","-          <Text style={styles.headerMeta}>Last backup: {formatEpoch(latestBackup?.StartTime)}</Text>","+          <Ionicons","+            name=\"cloud-done-outline\"","+            size={15}","+            color={colors.textMuted}","+          />","+          <Text style={styles.headerMeta}>","+            Last backup: {formatEpoch(latestBackup?.StartTime)}","+          </Text>","         </View>","         {error ? <Text style={styles.warn}>{error}</Text> : null}"," ","         {/* Status tiles */}","         <View style={styles.tileRow}>","           <View style={styles.tile}>","-            <Ionicons name=\"shield-checkmark\" size={20} color={colors.primary} />","+            <View style={[styles.tileIconWrap, { backgroundColor: `${colors.primary}14` }]}>","+              <Ionicons name=\"shield-checkmark\" size={20} color={colors.primary} />","+            </View>","             <Text style={styles.tileLabel}>Protection</Text>","             <Text style={styles.tileValue}>Secure</Text>","           </View>","           <View style={styles.tile}>","-            <Ionicons name=\"bandage-outline\" size={20} color={colors.secondary} />","+            <View style={[styles.tileIconWrap, { backgroundColor: `${colors.secondary}14` }]}>","+              <Ionicons name=\"bandage-outline\" size={20} color={colors.secondary} />","+            </View>","             <Text style={styles.tileLabel}>Patches</Text>","-            <Text style={styles.tileValue}>{toText(a.patchStatus) || 'Current'}</Text>","+            <Text style={styles.tileValue}>","+              {toText(a.patchStatus) || 'Current'}","+            </Text>","           </View>","         </View>"," "]},{"oldStart":219,"oldLines":7,"newStart":296,"newLines":7,"lines":["           <UtilBar label=\"Disk\" value={metricValue(disk0.driveUsage)} />","         </Card>"," ","-        {/* Security (indicative, matches portal) */}","+        {/* Security */}","         <Card style={styles.section}>","           <Text style={styles.sectionTitle}>Security</Text>","           <InfoRow label=\"Antivirus\" value=\"Active\" />"]},{"oldStart":228,"oldLines":7,"newStart":305,"newLines":7,"lines":["           <InfoRow label=\"Next scan\" value={nextScanLabel()} />","         </Card>"," ","-        {/* Device details — real fields returned by GET_ASSET / GET_ASSET_SUMMARY */}","+        {/* Device details */}","         <Card style={styles.section}>","           <Text style={styles.sectionTitle}>Device</Text>","           <InfoRow label=\"Status\" value={a.status} />"]},{"oldStart":247,"oldLines":18,"newStart":324,"newLines":31,"lines":["         {/* Patch activity */}","         <Card style={styles.section}>","           <Text style={styles.sectionTitle}>","-            Recent patch activity {patches.length ? `(${patches.length})` : ''}","+            Recent patch activity{' '}","+            {patches.length ? `(${patches.length})` : ''}","           </Text>","           {patches.length === 0 ? (","             <Text style={styles.muted}>No patch data available.</Text>","           ) : (","             patches.slice(0, 30).map((p, idx) => (","               <View key={idx} style={styles.patchRow}>","-                <View style={[styles.sevDot, { backgroundColor: severityColor(toText(p?.patchDetail?.severity)) }]} />","+                <View","+                  style={[","+                    styles.sevDot,","+                    {","+                      backgroundColor: severityColor(","+                        toText(p?.patchDetail?.severity),","+                      ),","+                    },","+                  ]}","+                />","                 <View style={{ flex: 1 }}>","-                  <Text style={styles.patchTitle} numberOfLines={2}>{toText(p?.patchDetail?.title) || '—'}</Text>","+                  <Text style={styles.patchTitle} numberOfLines={2}>","+                    {toText(p?.patchDetail?.title) || '—'}","+                  </Text>","                   <Text style={styles.patchMeta}>","-                    {(toText(p?.installationStatus) || 'Unknown')} · {formatDateString(p?.installationTime)}","+                    {toText(p?.installationStatus) || 'Unknown'} ·{' '}","+                    {formatDateString(p?.installationTime)}","                   </Text>","                 </View>","               </View>"]},{"oldStart":269,"oldLines":18,"newStart":359,"newLines":28,"lines":["         <Button","           title=\"Create a ticket for this device\"","           variant=\"secondary\"","-          onPress={() => { setFormError(null); setFormSuccess(false); setModalOpen(true); }}","-          style={{ marginTop: spacing.sm }}","+          onPress={() => {","+            setFormError(null);","+            setFormSuccess(false);","+            setModalOpen(true);","+          }}","+          style={{ marginTop: spacing.sm, marginBottom: spacing.lg }}","         />","       </ScrollView>"," ","-      {/* Create-ticket modal, prefilled for this asset */}","-      <Modal visible={modalOpen} animationType=\"slide\" transparent onRequestClose={() => setModalOpen(false)}>","+      {/* Create-ticket modal */}","+      <Modal","+        visible={modalOpen}","+        animationType=\"slide\"","+        transparent","+        onRequestClose={() => setModalOpen(false)}","+      >","         <KeyboardAvoidingView","           style={styles.modalBackdrop}","           behavior={Platform.OS === 'ios' ? 'padding' : undefined}","         >","           <View style={styles.modalSheet}>","+            <View style={styles.modalHandle} />","            