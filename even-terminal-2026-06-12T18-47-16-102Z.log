  <View style={styles.root}>\n55\t      <KeyboardAvoidingView\n56\t        style={{ flex: 1 }}\n57\t        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n58\t      >\n59\t        <ScrollView\n60\t          contentContainerStyle={styles.scroll}\n61\t          keyboardShouldPersistTaps=\"handled\"\n62\t          bounces={false}\n63\t        >\n64\t          {/* ── Top: Video hero ── */}\n65\t          <View style={styles.heroSection}>\n66\t            {/* Video */}\n67\t            <Video\n68\t              ref={videoRef}\n69\t              source={bgVideo}\n70\t              style={styles.bgVideo}\n71\t              resizeMode={ResizeMode.COVER}\n72\t              shouldPlay\n73\t              isLooping\n74\t              isMuted\n75\t              rate={0.8}\n76\t            />\n77\t\n78\t            {/* Dark overlay */}\n79\t            <LinearGradient\n80\t              colors={[\n81\t                'rgba(12, 29, 39, 0.96)',\n82\t                'rgba(12, 29, 39, 0.92)',\n83\t                'rgba(12, 29, 39, 0.88)',\n84\t                'rgba(12, 29, 39, 0.92)',\n85\t                'rgba(12, 29, 39, 0.96)',\n86\t              ]}\n87\t              locations={[0, 0.25, 0.5, 0.75, 1]}\n88\t              start={{ x: 0.2, y: 0 }}\n89\t              end={{ x: 0.8, y: 1 }}\n90\t              style={StyleSheet.absoluteFill}\n91\t            />\n92\t\n93\t            {/* Hero content */}\n94\t            <SafeAreaView style={styles.heroContent} edges={['top']}>\n95\t              {/* Brand */}\n96\t              <View style={styles.brandWrap}>\n97\t                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n98\t                <Text style={styles.tagline}>\n99\t                  Managed protection, in your pocket.\n100\t                </Text>\n101\t              </View>\n102\t\n103\t              {/* Badge */}\n104\t              <View style={styles.badgeRow}>\n105\t                <View style={styles.badge}>\n106\t           