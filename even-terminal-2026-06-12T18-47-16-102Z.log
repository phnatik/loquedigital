          </View>","+            </View>","+            <View style={styles.inputWrap}>","+              <Ionicons","+                name=\"mail-outline\"","+                size={18}","+                color=\"#94a3b8\"","+                style={styles.inputIcon}","+              />","+              <View style={{ flex: 1 }}>","+                <TextInputField","+                  value={email}","+                  onChangeText={setEmail}","+                  placeholder=\"you@company.com\"","+                  autoCapitalize=\"none\"","+                  keyboardType=\"email-address\"","+                  autoComplete=\"email\"","+                  textContentType=\"emailAddress\"","+                />","+              </View>","+            </View>"," ","-            {error ? <Text style={styles.error}>{error}</Text> : null}","+            {/* Password */}","+            <Text style={styles.label}>Password</Text>","+            <View style={styles.inputWrap}>","+              <Ionicons","+                name=\"lock-closed-outline\"","+                size={18}","+                color=\"#94a3b8\"","+                style={styles.inputIcon}","+              />","+              <View style={{ flex: 1 }}>","+                <TextInputField","+                  value={password}","+                  onChangeText={setPassword}","+                  placeholder=\"Enter your password\"","+                  secureTextEntry={secureEntry}","+                  autoComplete=\"password\"","+                  textContentType=\"password\"","+                />","+              </View>","+              <Pressable","+                onPress={() => setSecureEntry(!secureEntry)}","+                hitSlop={8}","+              >","+                <Ionicons","+                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}","+                  size={20}","+                  color=\"#94a3b8\"","+                />","+              </Pressable>","+            </View>"," ","-            <Button title=\"Sign in\" onPress={onSubmit} loading={loading} />","+            {error ? (","+              <View style={styles.errorRow}>","+                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />","+                <Text style={styles.errorText}>{error}</Text>","+              </View>","+            ) : null}"," ","-            <Text style={styles.helperText}>","-              Accounts are provisioned by Senturi. Contact your administrator if","-              you can't sign in.","+            {/* Button */}","+            <LinearGradient","+              colors={gradients.brand}","+              start={{ x: 0, y: 0 }}","+              end={{ x: 1, y: 0 }}","+              style={styles.btnGradient}","+            >","+              <Pressable","+                onPress={onSubmit}","+                disabled={loading}","+                style={({ pressed }) => [","+                  styles.btn,","+                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },","+                ]}","+              >","+                {loading ? (","+                  <ActivityIndicator color=\"#fff\" />","+                ) : (","+                  <Text style={styles.btnText}>Sign in</Text>","+                )}","+              </Pressable>","+            </LinearGradient>","+","+            <Text style={styles.helper}>","+              Accounts are provisioned by Senturi.{'\\n'}Contact your","+              administrator if you can't sign in.","             </Text>","           </View>","         </ScrollView>"]},{"oldStart":101,"oldLines":71,"newStart":184,"newLines":152,"lines":["   );"," }"," ","+/* Inline text input — avoids pulling in the shared Field component so we can","+   fully control the look inside the icon-wrapped rows. */","+function TextInputField(props) {","+  const { TextInput } = require('react-native');","+  return (","+    <TextInput","+      placeholderTextColor=\"#94a3b8\"","+      style={styles.textInput}","+   