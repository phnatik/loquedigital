[2026-06-12 19:09:29] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DbAqeEg9XNkqz4AqFSVCFU","type":"tool_result","content":"1\t// domains/superops/superopsService.js\n2\tconst { resolveRequestDocument } = require(\"graphql-request\");\n3\tconst superOpsClient = require(\"./superopsClient\");\n4\tconst { \n5\t    GET_CLIENT_LIST, \n6\t    GET_CLIENT_BY_ACCOUNT_ID, \n7\t    CREATE_CLIENT,\n8\t    CREATE_CLIENT_CONTACT,\n9\t    UPDATE_PRIMARY_CONTACT,\n10\t    GET_CLIENT_SITE,\n11\t    UPDATE_CLIENT_CUSTOM_FIELDS,\n12\t    GET_ASSET_LIST,\n13\t    GET_ASSET_SUMMARY,\n14\t    GET_ASSET,\n15\t    GET_ASSET_PATCH_DETAILS,\n16\t    CREATE_TICKET,\n17\t    GET_TICKETS_BY_ACCOUNT_ID\n18\t} = require(\"./superopsQueries\");\n19\t\n20\t// Get a list of all superops clients\n21\tconst getClientList = async (page = 1, pageSize = 10) => {\n22\t    try {\n23\t        const variables = {\n24\t            input: { \n25\t                page, \n26\t                pageSize \n27\t            }\n28\t        };\n29\t\n30\t        const res = await superOpsClient.request(GET_CLIENT_LIST, variables);\n31\t        console.log(res);\n32\t        return res.getClientList.clients;\n33\t    } catch (err) {\n34\t            err.statusCode = 502;\n35\t            throw err;\n36\t    }\n37\t};\n38\t\n39\t// Get client by superops client (account) id\n40\tconst getClientByAccountId = async (accountId) => {\n41\t    try {\n42\t        const variables = {\n43\t            input : { accountId }\n44\t        }\n45\t        const res = await superOpsClient.request(GET_CLIENT_BY_ACCOUNT_ID, variables);\n46\t        console.log(res.getClient);\n47\t        return res.getClient;\n48\t    } catch (err) {\n49\t        err.statusCode = 502;\n50\t        throw err;\n51\t    }\n52\t}\n53\t\n54\tconst createClient = async (name, stage, status, primaryContact) => {\n55\t    try {\n56\t        const variables = {\n57\t            input: {\n58\t                name,\n59\t                stage,\n60\t                status,\n61\t                primaryContact,\n62\t                hqSite : {\n63\t                    name: \"Primary\",\n64\t                    working24x7: false,\n65\t                    timezoneCode: \"America/Chicago\"\n66\t                }\n67\t            }\n68\t        };\n69\t\n70\t        const res = await superOpsClient.request(CREATE_CLIENT, variables);\n71\t        return res.createClientV2;\n72\t    } catch (err) {\n73\t        console.error('GraphQL Error:', err.response?.errors || err);\n74\t        err.statusCode = 502;\n75\t        throw err;\n76\t    }\n77\t};\n78\t\n79\tconst createClientContact = async (firstName, lastName, emailAddress, contactNumber, role, accountId, siteId) => {\n80\t    try {\n81\t        const variables = {\n82\t            input: {\n83\t                firstName,\n84\t                lastName,\n85\t                email: emailAddress,\n86\t                contactNumber,\n87\t                role: {roleId: role || \"4\"},\n88\t                addAssociations: {\n89\t                    client: {accountId: accountId},\n90\t                    site: {id: siteId}\n91\t                }\n92\t            }\n93\t        };\n94\t        const res = await superOpsClient.request(CREATE_CLIENT_CONTACT, variables);\n95\t        return res.createClientUser;\n96\t    } catch (err) {\n97\t        console.log(err.response?.errors || err);\n98\t        err.statusCode = 502;\n99\t        throw err;\n100\t    }\n101\t}\n102\t\n103\tconst updateClientPrimaryContact = async (accountId, primaryContactId) => {\n104\t    try {\n105\t        const variables = {\n106\t            input:{\n107\t                accountId,\n108\t                primaryContact: { userId: primaryContactId }\n109\t            }\n110\t        }\n111\t        const res = await superOpsClient.request(UPDATE_PRIMARY_CONTACT, variables);\n112\t        return res.updateClient;\n113\t    } catch (err) {\n114\t        console.log(err.response?.errors || err);\n115\t        err.statusCode = 502;\n116\t        throw err;\n117\t    }\n118\t}\n119\t\n120\tconst getClientSite = async (clientSiteId) => {\n121\t    try {\n122\t        const variables = {\n123\t            input : {\n124\t                id: clientSiteId\n125\t            }\n126\t        }\n127\t        const res = await superOpsClient.request(GET_CLIENT_SITE, variables);\n128\t        return res.getClientSite;\n129\t    } catch (err) {\n130\t        console.log(err.response?.errors || err);\n131\t        err.statusCode = 502;\n132\t        throw err;\n133\t    }\n134\t}\n135\t\n136\tconst sendBitDefenderInstallLinksToSuperOps = async (\n137\t  clientId,\n138\t  installLinkWindows,\n139\t  installLinkMac,\n140\t  installLinkMacArm,\n141\t  installLinkLinux,\n142\t  installLinkMacDownloader,\n143\t  customerEmail,\n144\t) => {\n145\t  try {\n146\t    const variables = {\n147\t      input: {\n148\t        accountId: clientId,\n149\t        customFields: {\n150\t          udf1text: installLinkWindows,\n151\t          udf2text: installLinkMac,\n152\t          udf4text: installLinkMacArm,\n153\t          udf5text: installLinkMacDownloader,\n154\t          udf6text: installLinkLinux,\n155\t          udf7text: customerEmail          \n156\t        }\n157\t      }\n158\t    };\n159\t\n160\t    const res = await superOpsClient.request(UPDATE_CLIENT_CUSTOM_FIELDS, variables);\n161\t    return res.updateClient;\n162\t  } catch (err) {\n163\t    console.error(\"Error sending BitDefender install links to SuperOps:\", err.response?.errors || err);\n164\t    err.statusCode = 502;\n165\t    throw err;\n166\t  }\n167\t};\n168\t\n169\tconst updateSuperOpsCustomFields = async (clientId, senturiClientId) => {\n170\t    try {\n171\t        const variables = {\n172\t            input: {\n173\t                accountId: clientId,\n174\t                customFields: {\n175\t                    udf8num: senturiClientId\n176\t                }\n177\t            }\n178\t        };\n179\t\n180\t        const res = await superOpsClient.request(UPDATE_CLIENT_CUSTOM_FIELDS, variables);\n181\t        return res.updateClient;\n182\t    } catch (err) {\n183\t        console.error(\"Error sending BitDefender install links to SuperOps:\", err.response?.errors || err);\n184\t        err.statusCode = 502;\n185\t        throw err;\n186\t    }\n187\t\n188\t\n189\t}\n190\t\n191\tconst getAssetListById = async (accountId) => {\n192\t    try {\n193\t        const variables = {\n194\t            input: {\n195\t                condition: {\n196\t                    attribute:\"client.accountId\",\n197\t                    operator: \"includes\",\n198\t                    value: accountId\n199\t                }\n200\t            }\n201\t        }\n202\t\n203\t        const res = await superOpsClient.request(GET_ASSET_LIST, variables);\n204\t        return res;\n205\t    } catch (err) {\n206\t        console.error(\"Error fetching asset list for account id: \" + accountId);\n207\t        err.statusCode = 502;\n208\t        throw err;\n209\t    }\n210\t}\n211\t\n212\tconst getAssetSummary = async (assetId) => {\n213\t    try {\n214\t        const variables = {\n215\t            input: {\n216\t                assetId: assetId\n217\t            }\n218\t        }\n219\t        const res = await superOpsClient.request(GET_ASSET_SUMMARY, variables);\n220\t        return res;\n221\t        \n222\t    } catch (err) {\n223\t        console.error(\"Error fetching asset summary for asset id: \" + assetId);\n224\t        err.statusCode = 502;\n225\t        throw err;\n226\t    }\n227\t}\n228\t\n229\tconst getAsset = async (assetId) => {\n230\t    try {\n231\t        const variables = {\n232\t            input: {\n233\t                assetId: assetId\n234\t            }\n235\t        }\n236\t        const res = await superOpsClient.request(GET_ASSET, variables);\n237\t        return res;\n238\t    } catch (err) {\n239\t        console.error(\"Error fetching asset at id: \" + assetId);\n240\t        err.statusCode = 500;\n241\t        throw err;\n242\t    }\n243\t}\n244\t\n245\tconst getAssetPatchDetails = async (assetId) => {\n246\t    try {\n247\t        const variables = {\n248\t            input: {\n249\t                assetId: assetId,\n250\t                \"listInfo\":{\n251\t                    \"page\":1,\n252\t                    \"pageSize\":100,\n253\t                    \"sort\": {\"attribute\":\"installationTime\", \"order\":\"DESC\"}\n254\t                }\n255\t            }\n256\t        }\n257\t        const res = await superOpsClient.rawRequest(GET_ASSET_PATCH_DETAILS, variables);\n258\t        return res.data.getAssetPatchDetails.assetPatches;\n259\t    } catch (err) {\n260\t        console.error(\"Error fetching asset's patch details for asset id \" + assetId);\n261\t        err.statusCode = 500;\n262\t        throw err;\n263\t    }\n264\t}\n265\t\n266\tconst createTicket = async (ticketData) => {\n267\t    try {\n268\t        const variables = {\n269\t            input: {\n270\t                \"subject\": ticketData.machineName + \" - \" + ticketData.subject,\n271\t                \"ticketType\": ticketData.ticketType,\n272\t                \"source\": ticketData.source,\n273\t                \"client\":{\n274\t                    \"accountId\": ticketData.accountId\n275\t                },\n276\t                \"status\": ticketData.status,\n277\t                \"description\": ticketData.description,\n278\t                \"addAssets\": {\n279\t                    \"assetId\": ticketData.assetId\n280\t                }\n281\t            }\n282\t        }\n283\t        console.log(variables);\n284\t        const res = await superOpsClient.rawRequest(CREATE_TICKET, variables);\n285\t        return res.data;\n286\t    } catch (err) {\n287\t        console.error(\"Error creating ticket for account id \");\n288\t        err.statusCode = 500;\n289\t        throw err;\n290\t    }\n291\t}\n292\t\n293\tconst getTicketsByAccount = async (accountId) => {\n294\t    try {\n295\t        const variables = {\n296\t            input: {\n297\t                \"page\": 1,\n298\t                \"pageSize\": 100,\n299\t                \"condition\": {\n300\t                    \"attribute\": \"client.accountId\",\n301\t                    \"operator\": \"includes\",\n302\t                    \"value\": accountId\n303\t                }\n304\t            }\n305\t        }\n306\t        const res = await superOpsClient.rawRequest(GET_TICKETS_BY_ACCOUNT_ID, variables);\n307\t        return res.data.getTicketList;\n308\t    } catch (err) {\n309\t        console.error(\"Error fetching tickets\");\n310\t        err.statusCode = 500;\n311\t        throw err;\n312\t    }\n313\t}\n314\t\n315\tmodule.exports = {\n316\t  getClientList,\n317\t  getClientByAccountId,\n318\t  createClient,\n319\t  createClientContact,\n320\t  updateClientPrimaryContact,\n321\t  getClientSite,\n322\t  sendBitDefenderInstallLinksToSuperOps,\n323\t  getAssetListById,\n324\t  getAssetSummary,\n325\t  getAsset,\n326\t  getAssetPatchDetails,\n327\t  createTicket,\n328\t  getTicketsByAccount,\n329\t  updateSuperOpsCustomFields\n330\t};"}]},"parent_tool_use_id":"toolu_01NRFcJY7tURBywvjYYGTJ8f","session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"955c5687-5ee5-421e-963d-ebb6fa50ea8c","timestamp":"2026-06-13T00:09:29.835Z"}
