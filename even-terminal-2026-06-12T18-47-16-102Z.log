[2026-06-12 18:58:46] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JJHtAJJCp9AnRKzJDq7zf","type":"tool_result","content":"1\t// app/_layout.jsx — root layout: providers + auth-driven redirects.\n2\timport { useEffect } from 'react';\n3\timport { Stack, useRouter, useSegments } from 'expo-router';\n4\timport { GestureHandlerRootView } from 'react-native-gesture-handler';\n5\timport { SafeAreaProvider } from 'react-native-safe-area-context';\n6\timport { StatusBar } from 'expo-status-bar';\n7\timport { AuthProvider, useAuth } from '../src/features/auth/AuthProvider';\n8\timport { Loader } from '../src/components/ui';\n9\timport { colors } from '../src/theme/theme';\n10\t\n11\t// Decides where the user belongs based on auth + account status. There is no\n12\t// signup/registration in the app: not authed -> login; authed but not active ->\n13\t// an inactive notice; active -> the (app) tab group.\n14\tfunction AuthGate() {\n15\t  const { isAuthenticated, status, loadingAuth, loadingMembership } = useAuth();\n16\t  const segments = useSegments();\n17\t  const router = useRouter();\n18\t\n19\t  useEffect(() => {\n20\t    if (loadingAuth) return;\n21\t\n22\t    const group = segments[0]; // '(auth)' | '(app)' | 'asset' | 'inactive' | undefined\n23\t    const inAuthGroup = group === '(auth)';\n24\t    const onInactive = group === 'inactive';\n25\t    const isActive = status === 'active';\n26\t\n27\t    if (!isAuthenticated) {\n28\t      if (!inAuthGroup) router.replace('/(auth)/login');\n29\t      return;\n30\t    }\n31\t\n32\t    // Authenticated but account not active -> inactive notice (no in-app onboarding).\n33\t    if (!isActive) {\n34\t      if (!onInactive) router.replace('/inactive');\n35\t      return;\n36\t    }\n37\t\n38\t    // Active user landing on an auth/inactive screen -> push into the app.\n39\t    // (Other authenticated routes like asset/[assetId] are allowed to stay.)\n40\t    if (inAuthGroup || onInactive) {\n41\t      router.replace('/(app)/dashboard');\n42\t    }\n43\t  }, [isAuthenticated, status, loadingAuth, segments, router]);\n44\t\n45\t  if (loadingAuth) return <Loader label=\"Loading Senturi…\" />;\n46\t\n47\t  return (\n48\t    <Stack screenOptions={{ headerShown: false, contentStyle: { backgroundColor: colors.background } }}>\n49\t      <Stack.Screen name=\"(auth)\" />\n50\t      <Stack.Screen name=\"inactive\" />\n51\t      <Stack.Screen name=\"(app)\" />\n52\t      <Stack.Screen name=\"asset/[assetId]\" options={{ presentation: 'card' }} />\n53\t    </Stack>\n54\t  );\n55\t}\n56\t\n57\texport default function RootLayout() {\n58\t  return (\n59\t    <GestureHandlerRootView style={{ flex: 1 }}>\n60\t      <SafeAreaProvider>\n61\t        <AuthProvider>\n62\t          <StatusBar style=\"light\" />\n63\t          <AuthGate />\n64\t        </AuthProvider>\n65\t      </SafeAreaProvider>\n66\t    </GestureHandlerRootView>\n67\t  );\n68\t}\n69\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"0ae7d3a2-3000-4e83-a83d-6fb65896f806","timestamp":"2026-06-12T23:58:46.046Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/_layout.jsx","content":"// app/_layout.jsx — root layout: providers + auth-driven redirects.\nimport { useEffect } from 'react';\nimport { Stack, useRouter, useSegments } from 'expo-router';\nimport { GestureHandlerRootView } from 'react-native-gesture-handler';\nimport { SafeAreaProvider } from 'react-native-safe-area-context';\nimport { StatusBar } from 'expo-status-bar';\nimport { AuthProvider, useAuth } from '../src/features/auth/AuthProvider';\nimport { Loader } from '../src/components/ui';\nimport { colors } from '../src/theme/theme';\n\n// Decides where the user belongs based on auth + account status. There is no\n// signup/registration in the app: not authed -> login; authed but not active ->\n// an inactive notice; active -> the (app) tab group.\nfunction AuthGate() {\n  const { isAuthenticated, status, loadingAuth, loadingMembership } = useAuth();\n  const segments = useSegments();\n  const router = useRouter();\n\n  useEffect(() => {\n    if (loadingAuth) return;\n\n    const group = segments[0]; // '(auth)' | '(app)' | 'asset' | 'inactive' | undefined\n    const inAuthGroup = group === '(auth)';\n    const onInactive = group === 'inactive';\n    const isActive = status === 'active';\n\n    if (!isAuthenticated) {\n      if (!inAuthGroup) router.replace('/(auth)/login');\n      return;\n    }\n\n    // Authenticated but account not active -> inactive notice (no in-app onboarding).\n    if (!isActive) {\n      if (!onInactive) router.replace('/inactive');\n      return;\n    }\n\n    // Active user landing on an auth/inactive screen -> push into the app.\n    // (Other authenticated routes like asset/[assetId] are allowed to stay.)\n    if (inAuthGroup || onInactive) {\n      router.replace('/(app)/dashboard');\n    }\n  }, [isAuthenticated, status, loadingAuth, segments, router]);\n\n  if (loadingAuth) return <Loader label=\"Loading Senturi…\" />;\n\n  return (\n    <Stack screenOptions={{ headerShown: false, contentStyle: { backgroundColor: colors.background } }}>\n      <Stack.Screen name=\"(auth)\" />\n      <Stack.Screen name=\"inactive\" />\n      <Stack.Screen name=\"(app)\" />\n      <Stack.Screen name=\"asset/[assetId]\" options={{ presentation: 'card' }} />\n    </Stack>\n  );\n}\n\nexport default function RootLayout() {\n  return (\n    <GestureHandlerRootView style={{ flex: 1 }}>\n      <SafeAreaProvider>\n        <AuthProvider>\n          <StatusBar style=\"light\" />\n          <AuthGate />\n        </AuthProvider>\n      </SafeAreaProvider>\n    </GestureHandlerRootView>\n  );\n}\n","numLines":69,"startLine":1,"totalLines":69}}}
