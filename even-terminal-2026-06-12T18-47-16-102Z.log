\"numeric\",\n45\t        });\n46\t\n47\t        const time = d.toLocaleTimeString(undefined, {\n48\t            hour: \"numeric\",\n49\t            minute: \"2-digit\",\n50\t            hour12: true,\n51\t        });\n52\t\n53\t        return `${date} | ${time}`;\n54\t    } catch {\n55\t        return \"—\";\n56\t    }\n57\t}\n58\t\n59\tfunction convertFileSize(bytes, decimals = 2) {\n60\t    if (!bytes || bytes < 0) return \"0 B\";\n61\t\n62\t    const k = 1024;\n63\t    const sizes = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"];\n64\t    const i = Math.floor(Math.log(bytes) / Math.log(k));\n65\t\n66\t    const value = parseFloat((bytes / Math.pow(k, i)).toFixed(decimals));\n67\t    return `${value} ${sizes[i]}`;\n68\t}\n69\t\n70\tfunction cometStatus(status) {\n71\t    let cStatus;\n72\t    if(status === 5000){\n73\t        return cStatus = 'Success';\n74\t    }\n75\t    if(status === 7002){\n76\t        return cStatus = 'Failed';\n77\t    }\n78\t    \n79\t}\n80\t\n81\t\n82\t\n83\texport {\n84\t    formatDateString,\n85\t    formatEpoch,\n86\t    convertFileSize,\n87\t    cometStatus\n88\t};"}}
