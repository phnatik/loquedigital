[2026-06-14 17:02:37] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NyGdgzVwZez2ZZiKc1UMBT","type":"tool_result","content":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"25ab599f-8790-4a9d-8442-457e2993401c","timestamp":"2026-06-14T22:02:37.781Z","tool_use_result":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","oldString":"  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n  logo: { width: 80, height: 80, marginBottom: spacing.md },","newString":"  brandWrap: { alignItems: 'center', marginBottom: spacing.xl, marginTop: spacing.xl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },","originalFile":"// app/(auth)/login.jsx — split login: video hero top + white form bottom.\n// Uses Plus Jakarta Sans (login page font from web portal) + Montserrat for accents.\nimport { useState, useRef, useCallback } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n  Dimensions,\n} from 'react-native';\nimport { Video, ResizeMode } from 'expo-av';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useFonts } from 'expo-font';\nimport {\n  PlusJakartaSans_400Regular,\n  PlusJakartaSans_500Medium,\n  PlusJakartaSans_600SemiBold,\n  PlusJakartaSans_700Bold,\n  PlusJakartaSans_800ExtraBold,\n} from '@expo-google-fonts/plus-jakarta-sans';\nimport {\n  Montserrat_400Regular,\n  Montserrat_900Black,\n} from '@expo-google-fonts/montserrat';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandWhite = require('../../assets/brand-white.png');\nconst bgVideo = require('../../assets/login-bg-3.mp4');\n\nconst { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n  const videoRef = useRef(null);\n\n  const [fontsLoaded] = useFonts({\n    PlusJakartaSans_400Regular,\n    PlusJakartaSans_500Medium,\n    PlusJakartaSans_600SemiBold,\n    PlusJakartaSans_700Bold,\n    PlusJakartaSans_800ExtraBold,\n    Montserrat_400Regular,\n    Montserrat_900Black,\n  });\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  // Font-aware text styles (fallback gracefully if fonts haven't loaded yet)\n  const f = fontsLoaded ? {\n    extraBold: { fontFamily: 'PlusJakartaSans_800ExtraBold' },\n    bold: { fontFamily: 'PlusJakartaSans_700Bold' },\n    semiBold: { fontFamily: 'PlusJakartaSans_600SemiBold' },\n    medium: { fontFamily: 'PlusJakartaSans_500Medium' },\n    regular: { fontFamily: 'PlusJakartaSans_400Regular' },\n    montBold: { fontFamily: 'Montserrat_900Black' },\n  } : {\n    extraBold: { fontWeight: '800' },\n    bold: { fontWeight: '700' },\n    semiBold: { fontWeight: '600' },\n    medium: { fontWeight: '500' },\n    regular: { fontWeight: '400' },\n    montBold: { fontWeight: '900' },\n  };\n\n  return (\n    <View style={styles.root}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n          bounces={false}\n        >\n          {/* ── Top: Video hero ── */}\n          <View style={styles.heroSection}>\n            {/* Video */}\n            <Video\n              ref={videoRef}\n              source={bgVideo}\n              style={styles.bgVideo}\n              resizeMode={ResizeMode.COVER}\n              shouldPlay\n              isLooping\n              isMuted\n              rate={0.8}\n            />\n\n            {/* Dark overlay */}\n            <LinearGradient\n              colors={[\n                'rgba(12, 29, 39, 0.96)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.88)',\n                'rgba(12, 29, 39, 0.92)',\n                'rgba(12, 29, 39, 0.96)',\n              ]}\n              locations={[0, 0.25, 0.5, 0.75, 1]}\n              start={{ x: 0.2, y: 0 }}\n              end={{ x: 0.8, y: 1 }}\n              style={StyleSheet.absoluteFill}\n            />\n\n            {/* Hero content */}\n            <SafeAreaView style={styles.heroContent} edges={['top']}>\n              {/* Brand */}\n              <View style={styles.brandWrap}>\n                <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n                <Text style={[styles.tagline, f.medium]}>\n                  Managed protection, in your pocket.\n                </Text>\n              </View>\n\n              {/* Badge */}\n              <View style={styles.badgeRow}>\n                <View style={styles.badge}>\n                  <View style={styles.badgeDot} />\n                  <Text style={[styles.badgeText, f.bold]}>SECURE LOGIN</Text>\n                </View>\n              </View>\n\n            </SafeAreaView>\n          </View>\n\n          {/* ── Bottom: White form card ── */}\n          <View style={styles.formSection}>\n            <Text style={[styles.title, f.extraBold]}>Welcome Back</Text>\n            <Text style={[styles.subtitle, f.regular]}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            {/* Email field */}\n            <Text style={[styles.label, f.semiBold]}>Email</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={email}\n                onChangeText={setEmail}\n                placeholder=\"you@company.com\"\n                placeholderTextColor=\"#94a3b8\"\n                autoCapitalize=\"none\"\n                keyboardType=\"email-address\"\n                autoComplete=\"email\"\n                textContentType=\"emailAddress\"\n                style={[styles.textInput, f.regular]}\n              />\n            </View>\n\n            {/* Password field */}\n            <Text style={[styles.label, f.semiBold]}>Password</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"lock-closed-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={password}\n                onChangeText={setPassword}\n                placeholder=\"Enter your password\"\n                placeholderTextColor=\"#94a3b8\"\n                secureTextEntry={secureEntry}\n                autoComplete=\"password\"\n                textContentType=\"password\"\n                style={[styles.textInput, f.regular]}\n              />\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"#94a3b8\"\n                />\n              </Pressable>\n            </View>\n\n            {/* Error */}\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n                <Text style={[styles.errorText, f.medium]}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Sign in button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <Text style={[styles.btnText, f.bold]}>Sign in</Text>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            <Text style={[styles.helper, f.regular]}>\n              Accounts are provisioned by Senturi.{'\\n'}Contact your\n              administrator if you can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </View>\n  );\n}\n\nconst FORM_RADIUS = 0;\n\nconst styles = StyleSheet.create({\n  root: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: { flexGrow: 1 },\n\n  /* ── Hero (video) section ── */\n  heroSection: {\n    minHeight: SCREEN_H * 0.48,\n    justifyContent: 'flex-end',\n    overflow: 'hidden',\n  },\n  bgVideo: {\n    ...StyleSheet.absoluteFillObject,\n  },\n  heroContent: {\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxl + FORM_RADIUS,\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },\n  logo: { width: 80, height: 80, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    color: 'rgba(255,255,255,0.6)',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.3)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* ── Form section (white card) ── */\n  formSection: {\n    backgroundColor: '#ffffff',\n    borderTopLeftRadius: FORM_RADIUS,\n    borderTopRightRadius: FORM_RADIUS,\n    marginTop: -FORM_RADIUS,\n    paddingTop: spacing.xxl,\n    paddingHorizontal: spacing.xxl,\n    paddingBottom: spacing.xxxl,\n    flex: 1,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n","structuredPatch":[{"oldStart":274,"oldLines":8,"newStart":274,"newLines":8,"lines":["   },"," ","   /* Brand */","-  brandWrap: { alignItems: 'center', marginBottom: spacing.xl },","-  logo: { width: 80, height: 80, marginBottom: spacing.md },","+  brandWrap: { alignItems: 'center', marginBottom: spacing.xl, marginTop: spacing.xl },","+  logo: { width: 100, height: 100, marginBottom: spacing.md },","   tagline: {","     fontSize: 14,","     color: 'rgba(255,255,255,0.6)',"]}],"userModified":false,"replaceAll":false}}
