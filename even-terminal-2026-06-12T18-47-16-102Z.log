[2026-06-12 19:16:29] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wL8khtFMBWaivcpAhiW6K","type":"tool_result","content":"The file /Users/andrewprice/senturi/core/senturi-mobile/src/utils/format.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"bc4d8c6b-1d64-42d5-9239-c86b2e6c3727","timestamp":"2026-06-13T00:16:29.895Z","tool_use_result":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/src/utils/format.js","oldString":"// Numeric value out of a { value } metric (for progress bars).\nexport function metricValue(obj) {\n  if (obj == null) return null;\n  if (typeof obj === 'object') return typeof obj.value === 'number' ? obj.value : null;\n  return typeof obj === 'number' ? obj : null;\n}","newString":"// Numeric value out of a { value } metric (for progress bars).\n// SuperOps GraphQL can return numbers, string-numbers, or { value, unit } objects\n// where value itself may be a string. Coerce everything to a usable number.\nexport function metricValue(obj) {\n  if (obj == null) return null;\n  if (typeof obj === 'object') {\n    const v = obj.value ?? obj.Value;\n    if (v == null) return null;\n    const n = Number(v);\n    return Number.isNaN(n) ? null : n;\n  }\n  const n = Number(obj);\n  return Number.isNaN(n) ? null : n;\n}","originalFile":"// src/utils/format.js\n// Mirrors core-frontend/src/utils/utils.js so dates/sizes/statuses render\n// identically to the web portal.\n\n// \"MM/DD/YYYY | h:mm A\" from an ISO/string/ms date (used for SuperOps timestamps).\nexport function formatDateString(dateString) {\n  if (!dateString) return '—';\n  const date = new Date(dateString);\n  if (Number.isNaN(date.getTime())) return '—';\n  const month = ('0' + (date.getMonth() + 1)).slice(-2);\n  const day = ('0' + date.getDate()).slice(-2);\n  const year = date.getFullYear();\n  let hours = date.getHours();\n  const minutes = ('0' + date.getMinutes()).slice(-2);\n  const ampm = hours >= 12 ? 'PM' : 'AM';\n  hours = hours % 12 || 12;\n  return `${month}/${day}/${year} | ${hours}:${minutes} ${ampm}`;\n}\n\n// Epoch (seconds or ms) -> \"M/D/YYYY | h:mm AM\". Used for Comet timestamps.\nexport function formatEpoch(value) {\n  if (value == null) return '—';\n  const n = Number(value);\n  if (Number.isNaN(n)) return '—';\n  const ms = n < 1e12 ? n * 1000 : n;\n  try {\n    const d = new Date(ms);\n    const date = d.toLocaleDateString(undefined, { month: 'numeric', day: 'numeric', year: 'numeric' });\n    const time = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', hour12: true });\n    return `${date} | ${time}`;\n  } catch {\n    return '—';\n  }\n}\n\nexport function convertFileSize(bytes, decimals = 2) {\n  if (!bytes || bytes < 0) return '0 B';\n  const k = 1024;\n  const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];\n  const i = Math.floor(Math.log(bytes) / Math.log(k));\n  const value = parseFloat((bytes / Math.pow(k, i)).toFixed(decimals));\n  return `${value} ${sizes[i]}`;\n}\n\n// Comet job status codes (matches the web cometStatus). Extended slightly so we\n// don't render blank for in-progress/other codes.\nexport function cometStatus(status) {\n  const code = Number(status);\n  if (code === 5000) return 'Success';\n  if (code === 7002) return 'Failed';\n  if (code === 5001) return 'Running';\n  if (Number.isNaN(code)) return 'Unknown';\n  return 'Attention';\n}\n\n// A SuperOps summary metric is often { value, unit }. Render it safely.\nexport function metric(obj, suffix = '') {\n  if (obj == null) return '—';\n  if (typeof obj === 'object') {\n    if (obj.value == null) return '—';\n    return `${obj.value}${obj.unit ? ` ${obj.unit}` : suffix}`;\n  }\n  return `${obj}${suffix}`;\n}\n\n// Coerce any SuperOps value into something safe to drop inside <Text>. Several\n// GraphQL fields (platform, deviceCategory, site, client, …) come back as objects\n// like { id, name }, which crash React if rendered directly.\nexport function toText(v) {\n  if (v == null) return '';\n  if (typeof v === 'string' || typeof v === 'number') return String(v);\n  if (typeof v === 'boolean') return v ? 'Yes' : 'No';\n  if (Array.isArray(v)) return v.map(toText).filter(Boolean).join(', ');\n  if (typeof v === 'object') {\n    if (v.name != null) return String(v.name);\n    if (v.label != null) return String(v.label);\n    if (v.displayName != null) return String(v.displayName);\n    if (v.value != null) return `${v.value}${v.unit ? ` ${v.unit}` : ''}`;\n    return '';\n  }\n  return String(v);\n}\n\n// Numeric value out of a { value } metric (for progress bars).\nexport function metricValue(obj) {\n  if (obj == null) return null;\n  if (typeof obj === 'object') return typeof obj.value === 'number' ? obj.value : null;\n  return typeof obj === 'number' ? obj : null;\n}\n","structuredPatch":[{"oldStart":82,"oldLines":8,"newStart":82,"newLines":16,"lines":[" }"," "," // Numeric value out of a { value } metric (for progress bars).","+// SuperOps GraphQL can return numbers, string-numbers, or { value, unit } objects","+// where value itself may be a string. Coerce everything to a usable number."," export function metricValue(obj) {","   if (obj == null) return null;","-  if (typeof obj === 'object') return typeof obj.value === 'number' ? obj.value : null;","-  return typeof obj === 'number' ? obj : null;","+  if (typeof obj === 'object') {","+    const v = obj.value ?? obj.Value;","+    if (v == null) return null;","+    const n = Number(v);","+    return Number.isNaN(n) ? null : n;","+  }","+  const n = Number(obj);","+  return Number.isNaN(n) ? null : n;"," }"]}],"userModified":false,"replaceAll":false}}
