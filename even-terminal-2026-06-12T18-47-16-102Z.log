[2026-06-12 19:02:12] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Heqx58ELS3YfS6adcWyWDe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01344APCj1yXvVZ5JbQppYkV","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/inactive.jsx","content":"// app/inactive.jsx\n// Shown to authenticated users whose account is not `active`. The app has no\n// signup/registration/payment — account provisioning is handled by Senturi, so\n// this screen just informs the user and lets them re-check status or log out.\nimport { useState } from 'react';\nimport { View, Text, StyleSheet } from 'react-native';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../src/features/auth/AuthProvider';\nimport { Card, Button } from '../src/components/ui';\nimport { colors, spacing, typography, radius } from '../src/theme/theme';\n\nexport default function Inactive() {\n  const { senturiUser, status, refreshSenturiUser, logout } = useAuth();\n  const [checking, setChecking] = useState(false);\n\n  const onRefresh = async () => {\n    setChecking(true);\n    try {\n      await refreshSenturiUser();\n    } finally {\n      setChecking(false);\n    }\n  };\n\n  const prettyStatus = (status || 'pending').toUpperCase();\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <View style={styles.content}>\n        <View style={styles.iconWrap}>\n          <Ionicons\n            name=\"lock-closed-outline\"\n            size={32}\n            color={colors.secondary}\n          />\n        </View>\n\n        <Text style={styles.title}>Account not active</Text>\n        <Text style={styles.body}>\n          Hi\n          {senturiUser?.first_name ? ` ${senturiUser.first_name}` : ''}, your\n          account status is{' '}\n          <Text style={styles.status}>{prettyStatus}</Text>.\n        </Text>\n        <Text style={styles.body}>\n          Your Senturi account isn't active yet. Please contact your Senturi\n          administrator to get set up — once your account is active, sign in\n          again to access your devices.\n        </Text>\n\n        <View style={styles.actions}>\n          <Button\n            title=\"Check again\"\n            loading={checking}\n            onPress={onRefresh}\n          />\n          <Button\n            title=\"Log out\"\n            variant=\"ghost\"\n            onPress={logout}\n            style={{ marginTop: spacing.md }}\n          />\n        </View>\n      </View>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: colors.background },\n  content: {\n    flex: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    padding: spacing.xl,\n  },\n  iconWrap: {\n    width: 64,\n    height: 64,\n    borderRadius: 32,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginBottom: spacing.xl,\n  },\n  title: { ...typography.title, textAlign: 'center', marginBottom: spacing.lg },\n  body: {\n    ...typography.body,\n    textAlign: 'center',\n    marginBottom: spacing.md,\n    lineHeight: 22,\n    color: colors.textMuted,\n  },\n  status: { fontWeight: '700', color: colors.secondary },\n  actions: { alignSelf: 'stretch', marginTop: spacing.xl },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1415,"cache_read_input_tokens":75672,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1415},"output_tokens":45,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"45d10c92-38f5-48b1-aa9c-1373101b8202"}
