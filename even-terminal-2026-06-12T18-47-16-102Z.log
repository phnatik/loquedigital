]); setLoading(false); return; }\n44\t    setError(null);\n45\t    try {\n46\t      const list = await getTickets(superopsAccountId);\n47\t      setTickets(Array.isArray(list) ? list : []);\n48\t    } catch (err) {\n49\t      setError(err?.message || 'Could not load tickets.');\n50\t    } finally {\n51\t      setLoading(false);\n52\t      setRefreshing(false);\n53\t    }\n54\t  }, [superopsAccountId]);\n55\t\n56\t  useFocusEffect(useCallback(() => { load(); }, [load]));\n57\t\n58\t  const onRefresh = () => { setRefreshing(true); load(); };\n59\t\n60\t  const submitTicket = async () => {\n61\t    setFormError(null);\n62\t    if (!subject.trim()) { setFormError('A subject is required.'); return; }\n63\t    setSubmitting(true);\n64\t    try {\n65\t      await createTicket({\n66\t        subject: subject.trim(),\n67\t        description: description.trim(),\n68\t        accountId: superopsAccountId,\n69\t        // Account-level ticket — asset specifics are optional here.\n70\t        assetId: null,\n71\t        machineName: null,\n72\t      });\n73\t      setSubject('');\n74\t      setDescription('');\n75\t      setModalOpen(false);\n76\t      onRefresh();\n77\t    } catch (err) {\n78\t      setFormError(err?.message || 'Could not create the ticket.');\n79\t    } finally {\n80\t      setSubmitting(false);\n81\t    }\n82\t  };\n83\t\n84\t  if (loading && !refreshing) return <Loader label=\"Loading tickets…\" />;\n85\t\n86\t  const renderItem = ({ item }) => (\n87\t    <Card style={styles.ticketCard}>\n88\t      <View style={{ flex: 1 }}>\n89\t        <Text style={styles.subject} numberOfLines={2}>\n90\t          {item.subject || item.displayId || 'Ticket'}\n91\t        </Text>\n92\t        {item.displayId ? <Text style={styles.meta}>#{item.displayId}</Text> : null}\n93\t      </View>\n94\t      <View style={[styles.statusBadge, { backgroundColor: statusColor(item.status?.name ?? item.status) }]}>\n95\t        <Text style={styles.statusText}>\n96\t          {(item.status?.name ?? item.status ?? 'Open').toString()}\n97\t        </Text>\n98\t      </View>\n99\t    </Card>\n100\t  );\n101\t\n102\t  return (\n103\t    <View style={styles.container}>\n104\t      <FlatList\n105\t        data={tickets}\n106\t        keyExtractor={(item, idx) => String(item.ticketId ?? item.id ?? item.displayId ?? idx)}\n107\t        renderItem={renderItem}\n108\t        contentContainerStyle={styles.listContent}\n109\t        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n110\t        ListEmptyComponent={\n111\t          error\n112\t            ? <EmptyState title=\"Something went wrong\" subtitle={error} />\n113\t            : <EmptyState title=\"No tickets\" subtitle=\"Tap + to raise a support request.\" />\n114\t        }\n115\t      />\n116\t\n117\t      <Pressable style={styles.fab} onPress={() => setModalOpen(true)}>\n118\t        <Ionicons name=\"add\" size={28} color={colors.textInverse} />\n119\t      </Pressable>\n120\t\n121\t      <Modal visible={modalOpen} animationType=\"slide\" transparent onRequestClose={() => setModalOpen(false)}>\n122\t        <KeyboardAvoidingView\n123\t          style={styles.modalBackdrop}\n124\t          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n125\t        >\n126\t          <View style={styles.modalSheet}>\n127\t            <View style={styles.modalHeader}>\n128\t              <Text style={styles.modalTitle}>New ticket</Text>\n129\t              <Pressable onPress={() => setModalOpen(false)} hitSlop={10}>\n130\t                <Ionicons name=\"close\" size={24} color={colors.textMuted} />\n131\t              </Pressable>\n132\t            </View>\n133\t\n134\t            <Field\n135\t              label=\"Subject\"\n136\t              value={subject}\n137\t              onChangeText={setSubject}\n138\t              placeholder=\"Briefly describe the issue\"\n139\t            />\n140\t            <Field\n141\t              label=\"Descript