> [","-                  styles.btn,","-                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },","-                ]}","-              >","-                {loading ? (","-                  <ActivityIndicator color=\"#fff\" />","-                ) : (","-                  <Text style={styles.btnText}>Sign in</Text>","-                )}","-              </Pressable>","-            </LinearGradient>","+              {loading ? (","+                <ActivityIndicator color=\"#fff\" />","+              ) : (","+                <Text style={styles.btnText}>Sign in</Text>","+              )}","+            </Pressable>","+          </LinearGradient>"," ","-            <Text style={styles.helper}>","-              Accounts are provisioned by Senturi.{'\\n'}Contact your","-              administrator if you can't sign in.","-            </Text>","-          </View>","+          <Text style={styles.helper}>","+            Accounts are provisioned by Senturi.{'\\n'}Contact your","+            administrator if you can't sign in.","+          </Text>","         </ScrollView>","       </KeyboardAvoidingView>","     </SafeAreaView>","   );"," }"," ","-/* Inline text input — avoids pulling in the shared Field component so we can","-   fully control the look inside the icon-wrapped rows. */","-function TextInputField(props) {","-  const { TextInput } = require('react-native');","-  return (","-    <TextInput","-      placeholderTextColor=\"#94a3b8\"","-      style={styles.textInput}","-      {...props}","-    />","-  );","-}","-"," const styles = StyleSheet.create({","   safe: { flex: 1, backgroundColor: '#ffffff' },","   scroll: {","     flexGrow: 1,","     justifyContent: 'center',","     padding: spacing.xl,","+    paddingHorizontal: spacing.xxl,","     backgroundColor: '#ffffff',","   },"," "]},{"oldStart":216,"oldLines":11,"newStart":189,"newLines":6,"lines":["     letterSpacing: 0.3,","   },"," ","-  /* Card */","-  card: {","-    backgroundColor: '#ffffff',","-  },","-","   /* Badge */","   badgeRow: { alignItems: 'center', marginBottom: spacing.xl },","   badge: {"]}],"originalFile":"// app/(auth)/login.jsx\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandLogo = require('../../assets/brand.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n        >\n          {/* Brand */}\n          <View style={styles.brandWrap}>\n            <Image source={brandLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.tagline}>\n              Managed protection, in your pocket.\n            </Text>\n          </View>\n\n          {/* Card */}\n          <View style={styles.card}>\n            {/* Badge */}\n            <View style={styles.badgeRow}>\n              <View style={styles.badge}>\n                <View style={styles.badgeDot} />\n                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n              </View>\n            </View>\n\n            <Text style={styles.title}>Welcome Back</Text>\n            <Text style={styles.subtitle}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            {/* Email */}\n            <Text style={styles.label}>Email</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <View style={styles.inputInner}>\n                <input\n                  style={undefined}\n                  type=\"email\"\n                />\n              </View>\n            </View>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <View style={{ flex: 1 }}>\n                <TextInputField\n                  value={email}\n                  onChangeText={setEmail}\n                  placeholder=\"you@company.com\"\n                  autoCapitalize=\"none\"\n                  keyboardType=\"email-address\"\n                  autoComplete=\"email\"\n                  textContentType=\"emailAddress\"\n                />\n              </View>\n            </View>\n\n            {/* Password */}\n            <Text style={styles.label}>Password</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"lock-closed-outline\"\n                size={18}\n                color=\"#94a3b8\"\n                style={styles.inputIcon}\n              />\n              <View style={{ flex: 1 }}>\n                <TextInputField\n                  value={password}\n                  onChangeText={setPassword}\n                  placeholder=\"Enter your password\"\n                  secureTextEntry={secureEntry}\n                  autoComplete=\"password\"\n                  textContentType=\"password\"\n                />\n              </View>\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"#94a3b8\"\n                />\n              </Pressable>\n            </View>\n\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n                <Text style={styles.errorText}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <Text style={styles.btnText}>Sign in</Text>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            <Text style={styles.helper}>\n              Accounts are provisioned by Senturi.{'\\n'}Contact your\n              administrator if you can't sign in.\n            </Text>\n          </View>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\n/* Inline text input — avoids pulling in the shared Field component so we can\n   fully control the look inside the icon-wrapped rows. */\nfunction TextInputField(props) {\n  const { TextInput } = require('react-native');\n  return (\n    <TextInput\n      placeholderTextColor=\"#94a3b8\"\n      style={styles.textInput}\n      {...props}\n    />\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    padding: spacing.xl,\n    backgroundColor: '#ffffff',\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: '#94a3b8',\n    letterSpacing: 0.3,\n  },\n\n  /* Card */\n  card: {\n    backgroundColor: '#ffffff',\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.18)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n","userModified":false}}
[2026-06-14 16:10:02] [SSE-ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d]: {"type":"tool_end","name":"Write","toolId":"toolu_01WSdEKXBxMzhsWVQk5euSdi","summary":"Write login.jsx (304 lines)","detail":{"input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx — clean white login with dark brand mark.\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandLogo = require('../../assets/brand.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n        >\n          {/* Brand */}\n          <View style={styles.brandWrap}>\n            <Image source={brandLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.tagline}>\n              Managed protection, in your pocket.\n            </Text>\n          </View>\n\n          {/* Badge */}\n          <View style={styles.badgeRow}>\n            <View style={styles.badge}>\n              <View style={styles.badgeDot} />\n              <Text style={styles.badgeText}>SECURE LOGIN</Text>\n            </View>\n          </View>\n\n          <Text style={styles.title}>Welcome Back</Text>\n          <Text style={styles.subtitle}>\n            Sign in to your Senturi dashboard\n          </Text>\n\n          {/* Email field */}\n          <Text style={styles.label}>Email</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"mail-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              placeholderTextColor=\"#94a3b8\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n              style={styles.textInput}\n            />\n          </View>\n\n          {/* Password field */}\n          <Text style={styles.label}>Password</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"lock-closed-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"Enter your password\"\n              placeholderTextColor=\"#94a3b8\"\n              secureTextEntry={secureEntry}\n              autoComplete=\"password\"\n              textContentType=\"password\"\n              style={styles.textInput}\n            />\n            <Pressable\n              onPress={() => setSecureEntry(!secureEntry)}\n              hitSlop={8}\n            >\n              <Ionicons\n                name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                size={20}\n                color=\"#94a3b8\"\n              />\n            </Pressable>\n          </View>\n\n          {/* Error */}\n          {error ? (\n            <View style={styles.errorRow}>\n              <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n              <Text style={styles.errorText}>{error}</Text>\n            </View>\n          ) : null}\n\n          {/* Sign in button */}\n          <LinearGradient\n            colors={gradients.brand}\n            start={{ x: 0, y: 0 }}\n            end={{ x: 1, y: 0 }}\n            style={styles.btnGradient}\n          >\n            <Pressable\n              onPress={onSubmit}\n              disabled={loading}\n              style={({ pressed }) => [\n                styles.btn,\n                { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n              ]}\n            >\n              {loading ? (\n                <ActivityIndicator color=\"#fff\" />\n              ) : (\n                <Text style={styles.btnText}>Sign in</Text>\n              )}\n            </Pressable>\n          </LinearGradient>\n\n          <Text style={styles.helper}>\n            Accounts are provisioned by Senturi.{'\\n'}Contact your\n            administrator if you can't sign in.\n          </Text>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    padding: spacing.xl,\n    paddingHorizontal: spacing.xxl,\n    backgroundColor: '#ffffff',\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: '#94a3b8',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.18)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
