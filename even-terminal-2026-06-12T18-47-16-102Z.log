({ pressed }) => [\n        styles.button,\n        { backgroundColor: bg, opacity: isDisabled ? 0.6 : pressed ? 0.85 : 1 },\n        variant === 'ghost' && styles.buttonGhost,\n        style,\n      ]}\n    >\n      {loading\n        ? <ActivityIndicator color={textColor} />\n        : <Text style={[styles.buttonText, { color: textColor }, textStyle]}>{title}</Text>}\n    </Pressable>\n  );\n}","originalFile":"// src/components/ui.jsx\n// Small set of shared, themed primitives used across screens.\nimport {\n  View,\n  Text,\n  TextInput,\n  Pressable,\n  ActivityIndicator,\n  StyleSheet,\n} from 'react-native';\nimport { colors, radius, spacing, shadow, typography } from '../theme/theme';\n\nexport function Card({ children, style }) {\n  return <View style={[styles.card, style]}>{children}</View>;\n}\n\nexport function ScreenTitle({ children, style }) {\n  return <Text style={[styles.screenTitle, style]}>{children}</Text>;\n}\n\nexport function Button({ title, onPress, loading, disabled, variant = 'primary', style }) {\n  const isDisabled = disabled || loading;\n  const bg =\n    variant === 'secondary' ? colors.secondary :\n    variant === 'ghost' ? 'transparent' :\n    variant === 'danger' ? colors.danger :\n    colors.primary;\n  const textColor = variant === 'ghost' ? colors.primary : colors.textInverse;\n  return (\n    <Pressable\n      onPress={onPress}\n      disabled={isDisabled}\n      style={({ pressed }) => [\n        styles.button,\n        { backgroundColor: bg, opacity: isDisabled ? 0.6 : pressed ? 0.85 : 1 },\n        variant === 'ghost' && styles.buttonGhost,\n        style,\n      ]}\n    >\n      {loading\n        ? <ActivityIndicator color={textColor} />\n        : <Text style={[styles.buttonText, { color: textColor }]}>{title}</Text>}\n    </Pressable>\n  );\n}\n\nexport function Field({ label, error, ...inputProps }) {\n  return (\n    <View style={styles.field}>\n      {label ? <Text style={styles.fieldLabel}>{label}</Text> : null}\n      <TextInput\n        placeholderTextColor={colors.textMuted}\n        style={[styles.input, error && styles.inputError]}\n        {...inputProps}\n      />\n      {error ? <Text style={styles.fieldError}>{error}</Text> : null}\n    </View>\n  );\n}\n\nexport function StatusPill({ online, label }) {\n  const color = online ? colors.online : colors.offline;\n  return (\n    <View style={styles.pill}>\n      <View style={[styles.pillDot, { backgroundColor: color }]} />\n      <Text style={[styles.pillText, { color }]}>{label || (online ? 'ONLINE' : 'OFFLINE')}</Text>\n    </View>\n  );\n}\n\nexport function Loader({ label }) {\n  return (\n    <View style={styles.loader}>\n      <ActivityIndicator size=\"large\" color={colors.primary} />\n      {label ? <Text style={styles.loaderText}>{label}</Text> : null}\n    </View>\n  );\n}\n\nexport function EmptyState({ title, subtitle }) {\n  return (\n    <View style={styles.empty}>\n      <Text style={styles.emptyTitle}>{title}</Text>\n      {subtitle ? <Text style={styles.emptySubtitle}>{subtitle}</Text> : null}\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  card: {\n    backgroundColor: colors.surface,\n    borderRadius: radius.lg,\n    padding: spacing.lg,\n    borderWidth: 1,\n    borderColor: colors.border,\n    ...shadow.card,\n  },\n  screenTitle: { ...typography.title, marginBottom: spacing.lg },\n  button: {\n    height: 50,\n    borderRadius: radius.md,\n    alignItems: 'center',\n    justifyContent: 'center',\n    paddingHorizontal: spacing.lg,\n  },\n  buttonGhost: { borderWidth: 1, borderColor: colors.primary },\n  buttonText: { fontSize: 16, fontWeight: '600' },\n  field: { marginBottom: spacing.lg },\n  fieldLabel: { ...typography.label, marginBottom: spacing.xs },\n  input: {\n    height: 50,\n    borderWidth: 1,\n    borderColor: colors.border,\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.md,\n    fontSize: 16,\n    color: colors.text,\n    backgroundColor: colors.surface,\n  },\n  inputError: { borderColor: colors.danger },\n  fieldError: { color: colors.danger, fontSize: 12, marginTop: spacing.xs },\n  pill: { flexDirection: 'row', alignItems: 'center' },\n  pillDot: { width: 8, height: 8, borderRadius: 4, marginRight: spacing.xs },\n  pillText: { fontSize: 12, fontWeight: '700', letterSpacing: 0.5 },\n  loader: { flex: 1, alignItems: 'center', justifyContent: 'center', padding: spacing.xl },\n  loaderText: { ...typography.label, marginTop: spacing.md },\n  empty: { alignItems: 'center', justifyContent: 'center', padding: spacing.xxl },\n  emptyTitle: { ...typography.heading, marginBottom: spacing.xs },\n  emptySubtitle: { ...typography.caption, textAlign: 'center' },\n});\n","structuredPatch":[{"oldStart":18,"oldLines":7,"newStart":18,"newLines":7,"lines":["   return <Text style={[styles.screenTitle, style]}>{children}</Text>;"," }"," ","-export function Button({ title, onPress, loading, disabled, variant = 'primary', style }) {","+export function Button({ title, onPress, loading, disabled, variant = 'primary', style, textStyle }) {","   const isDisabled = disabled || loading;","   const bg =","     variant === 'secondary' ? colors.secondary :"]},{"oldStart":39,"oldLines":7,"newStart":39,"newLines":7,"lines":["     >","       {loading","         ? <ActivityIndicator color={textColor} />","-        : <Text style={[styles.buttonText, { color: textColor }]}>{title}</Text>}","+        : <Text style={[styles.buttonText, { color: textColor }, textStyle]}>{title}</Text>}","     </Pressable>","   );"," }"]}],"userModified":false,"replaceAll":false}}
