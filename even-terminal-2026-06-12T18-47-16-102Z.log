    }\n45\t    setError(null);\n46\t    try {\n47\t      const res = await getAssetList(superopsAccountId);\n48\t      setAssets(extractAssets(res));\n49\t    } catch (err) {\n50\t      setError(err?.message || 'Could not load your devices.');\n51\t    } finally {\n52\t      setLoading(false);\n53\t      setRefreshing(false);\n54\t    }\n55\t  }, [superopsAccountId]);\n56\t\n57\t  // Reload when the screen gains focus (and once membership resolves).\n58\t  useFocusEffect(\n59\t    useCallback(() => {\n60\t      load();\n61\t    }, [load])\n62\t  );\n63\t\n64\t  const onRefresh = () => {\n65\t    setRefreshing(true);\n66\t    load();\n67\t  };\n68\t\n69\t  if ((loading || loadingMembership) && !refreshing) return <Loader label=\"Loading devices…\" />;\n70\t\n71\t  const renderItem = ({ item }) => {\n72\t    const online = (item.status ?? 'online').toString().toLowerCase() !== 'offline';\n73\t    return (\n74\t      <Pressable onPress={() => router.push(`/asset/${item.assetId ?? item.id}`)}>\n75\t        <Card style={styles.assetCard}>\n76\t          <View style={styles.assetIcon}>\n77\t            <Ionicons name=\"desktop-outline\" size={22} color={colors.secondary} />\n78\t          </View>\n79\t          <View style={{ flex: 1 }}>\n80\t            <Text style={styles.assetName} numberOfLines={1}>{item.name || 'Unnamed device'}</Text>\n81\t            <StatusPill online={online} />\n82\t          </View>\n83\t          <Ionicons name=\"chevron-forward\" size={20} color={colors.textMuted} />\n84\t        </Card>\n85\t      </Pressable>\n86\t    );\n87\t  };\n88\t\n89\t  return (\n90\t    <View style={styles.container}>\n91\t      <FlatList\n92\t        data={assets}\n93\t        keyExtractor={(item, idx) => String(item.assetId ?? item.id ?? idx)}\n94\t        renderItem={renderItem}\n95\t        contentContainerStyle={styles.listContent}\n96\t        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />}\n97\t        ListHeaderComponent={\n98\t          <View style={styles.header}>\n99\t            <Text style={styles.clientName}>{membership?.client_name || 'Your devices'}</Text>\n100\t            <Text style={styles.subtle}>{assets.length} device{assets.length === 1 ? '' : 's'}</Text>\n101\t          </View>\n102\t        }\n103\t        ListEmptyComponent={\n104\t          error\n105\t            ? <EmptyState title=\"Something went wrong\" subtitle={error} />\n106\t            : <EmptyState title=\"No devices yet\" subtitle=\"Installed devices will appear here.\" />\n107\t        }\n108\t      />\n109\t    </View>\n110\t  );\n111\t}\n112\t\n113\tconst styles = StyleSheet.create({\n114\t  container: { flex: 1, backgroundColor: colors.background },\n115\t  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n116\t  header: { marginBottom: spacing.md },\n117\t  clientName: { ...typography.title },\n118\t  subtle: { ...typography.caption, marginTop: 2 },\n119\t  assetCard: { flexDirection: 'row', alignItems: 'center', marginBottom: spacing.md },\n120\t  assetIcon: {\n121\t    width: 44, height: 44, borderRadius: radius.md,\n122\t    backgroundColor: colors.surfaceAlt,\n123\t    alignItems: 'center', justifyContent: 'center',\n124\t    marginRight: spacing.md,\n125\t  },\n126\t  assetName: { ...typography.heading, marginBottom: spacing.xs },\n127\t});\n128\t"}}
