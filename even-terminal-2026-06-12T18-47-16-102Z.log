omes as a structured object or a raw number.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2553,"cache_read_input_tokens":115047,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2553},"output_tokens":29,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"e5a7a49b-b01e-4546-a91c-e0b8d8c60569"}
