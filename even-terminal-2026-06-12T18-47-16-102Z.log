  administrator if you can't sign in.","+            </Text>","+          </ScrollView>","+        </KeyboardAvoidingView>","+      </SafeAreaView>","+    </View>","   );"," }"," "," const styles = StyleSheet.create({","-  safe: { flex: 1, backgroundColor: '#ffffff' },","+  root: { flex: 1, backgroundColor: colors.ink },","+","+  /* Video background */","+  bgVideo: {","+    position: 'absolute',","+    top: 0,","+    left: 0,","+    width: SCREEN_W,","+    height: SCREEN_H,","+  },","+","+  /* Gradient overlay */","+  overlay: {","+    ...StyleSheet.absoluteFillObject,","+  },","+","+  /* Content layer */","+  safe: { flex: 1 },","   scroll: {","     flexGrow: 1,","     justifyContent: 'center',","     padding: spacing.xl,","     paddingHorizontal: spacing.xxl,","-    backgroundColor: '#ffffff',","   },"," ","   /* Brand */","   brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },","-  logo: { width: 100, height: 100, marginBottom: spacing.md },","+  logo: { width: 110, height: 110, marginBottom: spacing.md },","   tagline: {","     fontSize: 14,","     fontWeight: '500',","-    color: '#94a3b8',","+    color: 'rgba(255,255,255,0.6)',","     letterSpacing: 0.3,","   },"," "]},{"oldStart":194,"oldLines":9,"newStart":246,"newLines":9,"lines":["   badge: {","     flexDirection: 'row',","     alignItems: 'center',","-    backgroundColor: 'rgba(55, 170, 122, 0.08)',","+    backgroundColor: 'rgba(55, 170, 122, 0.15)',","     borderWidth: 1,","-    borderColor: 'rgba(55, 170, 122, 0.18)',","+    borderColor: 'rgba(55, 170, 122, 0.3)',","     borderRadius: radius.pill,","     paddingVertical: 5,","     paddingHorizontal: 14,"]},{"oldStart":219,"oldLines":43,"newStart":271,"newLines":43,"lines":["   title: {","     fontSize: 30,","     fontWeight: '800',","-    color: colors.textDark,","+    color: '#ffffff',","     textAlign: 'center',","     letterSpacing: -0.8,","   },","   subtitle: {","     fontSize: 15,","-    color: '#94a3b8',","+    color: 'rgba(255,255,255,0.6)',","     textAlign: 'center',","     marginTop: spacing.xs,","     marginBottom: spacing.xxl,","     lineHeight: 22,","   },"," ","-  /* Inputs */","+  /* Inputs — frosted glass style */","   label: {","     fontSize: 13,","     fontWeight: '600',","-    color: colors.textDark,","+    color: 'rgba(255,255,255,0.8)',","     marginBottom: spacing.sm,","     letterSpacing: 0.2,","   },","   inputWrap: {","     flexDirection: 'row',","     alignItems: 'center',","-    borderWidth: 1.5,","-    borderColor: '#e2e8f0',","+    borderWidth: 1,","+    borderColor: 'rgba(255,255,255,0.18)',","     borderRadius: radius.md,","     paddingHorizontal: spacing.lg,","     height: 52,","-    backgroundColor: '#f8fafc',","+    backgroundColor: 'rgba(255,255,255,0.08)',","     marginBottom: spacing.lg,","   },","   inputIcon: { marginRight: spacing.md },","   textInput: {","     flex: 1,","     fontSize: 15,","-    color: colors.textDark,","+    color: '#ffffff',","     height: '100%',","   },"," "]},{"oldStart":263,"oldLines":14,"newStart":315,"newLines":16,"lines":["   errorRow: {","     flexDirection: 'row',","     alignItems: 'center',","-    backgroundColor: 'rgba(225, 64, 110, 0.06)',","+    backgroundColor: 'rgba(225, 64, 110, 0.15)',","+    borderWidth: 1,","+    borderColor: 'rgba(225, 64, 110, 0.25)',","     borderRadius: radius.sm,","     padding: spacing.md,","     marginBottom: spacing.lg,","   },","   errorText: {","     fontSize: 13,","-    color: colors.danger,","+    color: '#ff6b8a',","     marginLeft: spacing.sm,","     flex: 1,","   },"]},{"oldStart":295,"oldLines":7,"newStart":349,"newLines":7,"lines":["   /* Helper */","   helper: {","     fontSize: 12,","-    color: '#94a3b8',","+    color: 'rgba(255,255,255,0.4)',","     textAlign: 'center',","     marginTop: spacing.xl,","     lineHeight: 18,"]}],"originalFile":"// app/(auth)/login.jsx — clean white login with dark brand mark.\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandLogo = require('../../assets/brand.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n        >\n          {/* Brand */}\n          <View style={styles.brandWrap}>\n            <Image source={brandLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.tagline}>\n              Managed protection, in your pocket.\n            </Text>\n          </View>\n\n          {/* Badge */}\n          <View style={styles.badgeRow}>\n            <View style={styles.badge}>\n              <View style={styles.badgeDot} />\n              <Text style={styles.badgeText}>SECURE LOGIN</Text>\n            </View>\n          </View>\n\n          <Text style={styles.title}>Welcome Back</Text>\n          <Text style={styles.subtitle}>\n            Sign in to your Senturi dashboard\n          </Text>\n\n          {/* Email field */}\n          <Text style={styles.label}>Email</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"mail-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              placeholderTextColor=\"#94a3b8\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n              style={styles.textInput}\n            />\n          </View>\n\n          {/* Password field */}\n          <Text style={styles.label}>Password</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"lock-closed-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"Enter your password\"\n              placeholderTextColor=\"#94a3b8\"\n              secureTextEntry={secureEntry}\n              autoComplete=\"password\"\n              textContentType=\"password\"\n              style={styles.textInput}\n            />\n            <Pressable\n              onPress={() => setSecureEntry(!secureEntry)}\n              hitSlop={8}\n            >\n              <Ionicons\n                name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                size={20}\n                color=\"#94a3b8\"\n              />\n            </Pressable>\n          </View>\n\n          {/* Error */}\n          {error ? (\n            <View style={styles.errorRow}>\n              <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n              <Text style={styles.errorText}>{error}</Text>\n            </View>\n          ) : null}\n\n          {/* Sign in button */}\n          <LinearGradient\n            colors={gradients.brand}\n            start={{ x: 0, y: 0 }}\n            end={{ x: 1, y: 0 }}\n            style={styles.btnGradient}\n          >\n            <Pressable\n              onPress={onSubmit}\n              disabled={loading}\n              style={({ pressed }) => [\n                styles.btn,\n                { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n              ]}\n            >\n              {loading ? (\n                <ActivityIndicator color=\"#fff\" />\n              ) : (\n                <Text style={styles.btnText}>Sign in</Text>\n              )}\n            </Pressable>\n          </LinearGradient>\n\n          <Text style={styles.helper}>\n            Accounts are provisioned by Senturi.{'\\n'}Contact your\n            administrator if you can't sign in.\n          </Text>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    padding: spacing.xl,\n    paddingHorizontal: spacing.xxl,\n    backgroundColor: '#ffffff',\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: '#94a3b8',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.18)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n","userModified":false}}
[2026-06-14 16:42:37] [SSE-ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d]: {"type":"tool_end","name":"Write","toolId":"toolu_01Kd871cJkMxEnatHQQntMtH","summary":"Write login.jsx (358 lines)","detail":{"input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx — cinematic login with looping video background + dark gradient overlay.\nimport { useState, useRef } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n  Dimensions,\n} from 'react-native';\nimport { Video, ResizeMode } from 'expo-av';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandWhite = require('../../assets/brand-white.png');\nconst bgVideo = require('../../assets/login-bg.mp4');\n\nconst { width: SCREEN_W, height: SCREEN_H } = Dimensions.get('window');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n  const videoRef = useRef(null);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <View style={styles.root}>\n      {/* ── Video background ── */}\n      <Video\n        ref={videoRef}\n        source={bgVideo}\n        style={styles.bgVideo}\n        resizeMode={ResizeMode.COVER}\n        shouldPlay\n        isLooping\n        isMuted\n        rate={0.8}\n      />\n\n      {/* ── Dark blue / green gradient overlay ── */}\n      <LinearGradient\n        colors={[\n          'rgba(12, 29, 39, 0.88)',   // ink dark\n          'rgba(22, 51, 68, 0.82)',   // inkSoft\n          'rgba(38, 144, 188, 0.55)', // secondary blue splash\n          'rgba(55, 170, 122, 0.45)', // primary green splash\n          'rgba(12, 29, 39, 0.92)',   // ink dark again\n        ]}\n        locations={[0, 0.25, 0.5, 0.7, 1]}\n        start={{ x: 0.2, y: 0 }}\n        end={{ x: 0.8, y: 1 }}\n        style={styles.overlay}\n      />\n\n      {/* ── Content ── */}\n      <SafeAreaView style={styles.safe}>\n        <KeyboardAvoidingView\n          style={{ flex: 1 }}\n          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n        >\n          <ScrollView\n            contentContainerStyle={styles.scroll}\n            keyboardShouldPersistTaps=\"handled\"\n          >\n            {/* Brand */}\n            <View style={styles.brandWrap}>\n              <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n              <Text style={styles.tagline}>\n                Managed protection, in your pocket.\n              </Text>\n            </View>\n\n            {/* Badge */}\n            <View style={styles.badgeRow}>\n              <View style={styles.badge}>\n                <View style={styles.badgeDot} />\n                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n              </View>\n            </View>\n\n            <Text style={styles.title}>Welcome Back</Text>\n            <Text style={styles.subtitle}>\n              Sign in to your Senturi dashboard\n            </Text>\n\n            {/* Email field */}\n            <Text style={styles.label}>Email</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"mail-outline\"\n                size={18}\n                color=\"rgba(255,255,255,0.5)\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={email}\n                onChangeText={setEmail}\n                placeholder=\"you@company.com\"\n                placeholderTextColor=\"rgba(255,255,255,0.35)\"\n                autoCapitalize=\"none\"\n                keyboardType=\"email-address\"\n                autoComplete=\"email\"\n                textContentType=\"emailAddress\"\n                style={styles.textInput}\n              />\n            </View>\n\n            {/* Password field */}\n            <Text style={styles.label}>Password</Text>\n            <View style={styles.inputWrap}>\n              <Ionicons\n                name=\"lock-closed-outline\"\n                size={18}\n                color=\"rgba(255,255,255,0.5)\"\n                style={styles.inputIcon}\n              />\n              <TextInput\n                value={password}\n                onChangeText={setPassword}\n                placeholder=\"Enter your password\"\n                placeholderTextColor=\"rgba(255,255,255,0.35)\"\n                secureTextEntry={secureEntry}\n                autoComplete=\"password\"\n                textContentType=\"password\"\n                style={styles.textInput}\n              />\n              <Pressable\n                onPress={() => setSecureEntry(!secureEntry)}\n                hitSlop={8}\n              >\n                <Ionicons\n                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                  size={20}\n                  color=\"rgba(255,255,255,0.5)\"\n                />\n              </Pressable>\n            </View>\n\n            {/* Error */}\n            {error ? (\n              <View style={styles.errorRow}>\n                <Ionicons name=\"alert-circle\" size={16} color=\"#ff6b8a\" />\n                <Text style={styles.errorText}>{error}</Text>\n              </View>\n            ) : null}\n\n            {/* Sign in button */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 0 }}\n              style={styles.btnGradient}\n            >\n              <Pressable\n                onPress={onSubmit}\n                disabled={loading}\n                style={({ pressed }) => [\n                  styles.btn,\n                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n                ]}\n              >\n                {loading ? (\n                  <ActivityIndicator color=\"#fff\" />\n                ) : (\n                  <Text style={styles.btnText}>Sign in</Text>\n                )}\n              </Pressable>\n            </LinearGradient>\n\n            <Text style={styles.helper}>\n              Accounts are provisioned by Senturi.{'\\n'}Contact your\n              administrator if you can't sign in.\n            </Text>\n          </ScrollView>\n        </KeyboardAvoidingView>\n      </SafeAreaView>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  root: { flex: 1, backgroundColor: colors.ink },\n\n  /* Video background */\n  bgVideo: {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: SCREEN_W,\n    height: SCREEN_H,\n  },\n\n  /* Gradient overlay */\n  overlay: {\n    ...StyleSheet.absoluteFillObject,\n  },\n\n  /* Content layer */\n  safe: { flex: 1 },\n  scroll: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    padding: spacing.xl,\n    paddingHorizontal: spacing.xxl,\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n  logo: { width: 110, height: 110, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: 'rgba(255,255,255,0.6)',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.3)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: '#ffffff',\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: 'rgba(255,255,255,0.6)',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* Inputs — frosted glass style */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: 'rgba(255,255,255,0.8)',\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1,\n    borderColor: 'rgba(255,255,255,0.18)',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: 'rgba(255,255,255,0.08)',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: '#ffffff',\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.15)',\n    borderWidth: 1,\n    borderColor: 'rgba(225, 64, 110, 0.25)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: '#ff6b8a',\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: 'rgba(255,255,255,0.4)',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
