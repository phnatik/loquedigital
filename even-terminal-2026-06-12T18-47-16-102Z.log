ext style={styles.name}>{fullName || 'Senturi user'}</Text>\n49\t        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n50\t      </View>\n51\t\n52\t      <Card>\n53\t        <Text style={styles.cardTitle}>Account</Text>\n54\t        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n55\t        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n56\t        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n57\t        <Row icon=\"call-outline\" label=\"Phone\" value={senturiUser?.phone} />\n58\t      </Card>\n59\t\n60\t      <Card style={{ marginTop: spacing.lg }}>\n61\t        <Text style={styles.cardTitle}>Technical</Text>\n62\t        <Row\n63\t          icon=\"key-outline\"\n64\t          label=\"SuperOps acct\"\n65\t          value={membership?.superops_account_id}\n66\t        />\n67\t        <Row icon=\"finger-print-outline\" label=\"Appwrite ID\" value={user?.$id} />\n68\t      </Card>\n69\t\n70\t      <Button\n71\t        title=\"Log out\"\n72\t        variant=\"danger\"\n73\t        onPress={logout}\n74\t        style={{ marginTop: spacing.xl }}\n75\t      />\n76\t    </ScrollView>\n77\t  );\n78\t}\n79\t\n80\tconst styles = StyleSheet.create({\n81\t  container: { flex: 1, backgroundColor: colors.background },\n82\t  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n83\t  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n84\t  avatar: {\n85\t    width: 80,\n86\t    height: 80,\n87\t    borderRadius: 40,\n88\t    alignItems: 'center',\n89\t    justifyContent: 'center',\n90\t    marginBottom: spacing.md,\n91\t    ...shadow.button,\n92\t  },\n93\t  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n94\t  name: { ...typography.title },\n95\t  email: { ...typography.caption, marginTop: spacing.xs },\n96\t  cardTitle: {\n97\t    ...typography.label,\n98\t    textTransform: 'uppercase',\n99\t    letterSpa