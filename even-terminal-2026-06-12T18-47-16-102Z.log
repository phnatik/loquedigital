uth/AuthProvider';\nimport { Card, Button } from '../../src/components/ui';\nimport { colors, spacing, typography, radius } from '../../src/theme/theme';\n\nfunction Row({ icon, label, value }) {\n  return (\n    <View style={styles.row}>\n      <Ionicons name={icon} size={18} color={colors.textMuted} style={{ width: 26 }} />\n      <Text style={styles.rowLabel}>{label}</Text>\n      <Text style={styles.rowValue} numberOfLines={1}>{value || '—'}</Text>\n    </View>\n  );\n}\n\nexport default function Profile() {\n  const { user, senturiUser, membership, logout } = useAuth();\n\n  const fullName = [senturiUser?.first_name, senturiUser?.last_name].filter(Boolean).join(' ');\n  const initials = (fullName || senturiUser?.email || 'S')\n    .split(' ').map((p) => p[0]).join('').slice(0, 2).toUpperCase();\n\n  return (\n    <ScrollView style={styles.container} contentContainerStyle={styles.content}>\n      <View style={styles.avatarWrap}>\n        <View style={styles.avatar}><Text style={styles.avatarText}>{initials}</Text></View>\n        <Text style={styles.name}>{fullName || 'Senturi user'}</Text>\n        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n      </View>\n\n      <Card>\n        <Text style={styles.cardTitle}>Account</Text>\n        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n        <Row icon=\"call-outline\" label=\"Phone\" value={senturiUser?.phone} />\n      </Card>\n\n      <Card style={{ marginTop: spacing.lg }}>\n        <Text style={styles.cardTitle}>Technical</Text>\n        <Row icon=\"key-outline\" label=\"SuperOps acct\" value={membership?.superops_account_id} />\n        <Row icon=\"finger-print-outline\" label=\"Appwrite ID\" value={user?.$id} />\n      </Card>\n\n      <Button\n        title=\"Log out\"\n        variant=\"danger\"\n        onPress={logout}\n        style={{ marginTop: spacing.xl }}\n      />\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n  avatar: {\n    width: 80, height: 80, borderRadius: 40,\n    backgroundColor: colors.primary,\n    alignItems: 'center', justifyContent: 'center', marginBottom: spacing.md,\n  },\n  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n  name: { ...typography.title },\n  email: { ...typography.caption, marginTop: 2 },\n  cardTitle: { ...typography.label, textTransform: 'uppercase', marginBottom: spacing.md },\n  row: { flexDirection: 'row', alignItems: 'center', paddingVertical: spacing.sm },\n  rowLabel: { ...typography.body, color: colors.textMuted, width: 110 },\n  rowValue: { ...typography.body, flex: 1, textAlign: 'right', fontWeight: '600' },\n});\n","userModified":false}}
