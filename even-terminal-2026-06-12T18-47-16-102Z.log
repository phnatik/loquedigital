rJobsHistory = catchAsync(async (req, res) => {\n44\t  const { emailAddress } = req.body;\n45\t\n46\t  try {\n47\t    const result = await cometService.getUserJobsHistory(emailAddress);\n48\t\n49\t    if (result._status === 400) {\n50\t      return res.status(400).json({\n51\t        error: result.error,\n52\t        message: 'Could not fetch Comet Job History.'\n53\t      });\n54\t    }\n55\t\n56\t    if (result._empty) {\n57\t      return res.status(200).json({\n58\t        message: 'No Backup History Found',\n59\t        response: result.history\n60\t      });\n61\t    }\n62\t\n63\t    return res.status(200).json({\n64\t      message: 'Backup History Fetched Successfully',\n65\t      response: result.enrichedHistory\n66\t    });\n67\t  } catch (error) {\n68\t    console.error(error);\n69\t    return res.status(500).json({\n70\t      error,\n71\t      message: 'Internal server error. Could not fetch Comet Job History.'\n72\t    });\n73\t  }\n74\t});\n75\t\n76\t// POST /generate-comet-user-sessions\n77\t// response preserved: 200 { sessionKey }, 400 { error, message }\n78\texports.generateSessionKey = catchAsync(async (req, res) => {\n79\t  const { emailAddress } = req.body;\n80\t  try {\n81\t    const sessionKey = await cometService.generateSessionKey(emailAddress);\n82\t    return res.status(200).json({ sessionKey });\n83\t  } catch (error) {\n84\t    return res.status(400).json({\n85\t      error,\n86\t      message: 'Could not Generate Session Key.'\n87\t    });\n88\t  }\n89\t});\n90\t\n91\t// POST /create-user-token\n92\t// response preserved: 400 if missing fields; 200 { token }; 500 on error\n93\texports.createUserToken = catchAsync(async (req, res) => {\n94\t  const { emailAddress, password } = req.body;\n95\t  if (!emailAddress || !password) {\n96\t    return res.status(400).json({ message: 'Email address or password is missing.' });\n97\t  }\n98\t\n99\t  try {\n100\t    const token = await cometService.createUserToken(emailAddress, password);\n101\t    return res.status(200).json({ token });\n102\t  } catch (error) {\n103\t    console.log('Error in createUserToken:', error);\n104\t    return res.status(500).json({\n105\t      message: 'Failed to create user token.',\n106\t      error: error.toString()\n107\t    });\n108\t  }\n109\t});\n110\t\n111\t// POST /get-jobs-for-user\n112\texports.getJobsForUser = catchAsync(async (req, res) => {\n113\t  const { emailAddress } = req.body;\n114\t  if (!emailAddress ) {\n115\t    return res.status(400).json({ message: 'Email address is missing.' });\n116\t  }\n117\t\n118\t  try {\n119\t    const token = await cometService.getJobsForUser(emailAddress);\n120\t    return res.status(200).json({ token });\n121\t  } catch (error) {\n122\t    console.log('Error in getJobsForUser:', error);\n123\t    return res.status(500).json({\n124\t      message: 'Failed to get the users job history.',\n125\t      error: error.toString()\n126\t    });\n127\t  }\n128\t});"}}
