[2026-06-17 13:16:52] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LLuAEqbRkZAjgKi7yD8y1H","type":"tool_result","content":"The file /Users/andrewprice/DEV/brad/fastsmog/src/pages/class-schedule.astro has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"888fa852-5011-4157-96f7-fbd1c868f7da","uuid":"ad1b9c8b-aaa0-4f74-8650-471bd611fd2a","timestamp":"2026-06-17T18:16:52.842Z","tool_use_result":{"filePath":"/Users/andrewprice/DEV/brad/fastsmog/src/pages/class-schedule.astro","oldString":"      <h1>Next <span class=\"accent\">90 days</span>.<br />Reserve your seat.</h1>","newString":"      <h1>Reserve your seat.</h1>","originalFile":"---\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout\n  title=\"Class Schedule — F.A.S.T. Smog Training\"\n  description=\"Upcoming BAR-certified smog inspector and repair technician training classes at F.A.S.T. in Escondido, CA.\"\n  page=\"schedule\"\n>\n  <section class=\"page-hd\">\n    <div class=\"container inner\">\n      <div class=\"crumbs\"><a href=\"index.html\">Home</a><span>/</span>Class Schedule</div>\n      <h1>Next <span class=\"accent\">90 days</span>.<br />Reserve your seat.</h1>\n      <p class=\"lede\">\n        Live schedule, pulled directly from our booking system. Most sessions run hybrid — online\n        lecture plus optional hands-on labs at Owens Automotive in Escondido. Seats fill fast.\n      </p>\n    </div>\n  </section>\n\n  <div class=\"stripe-band\" aria-hidden=\"true\"></div>\n\n  <section style=\"max-width: 1168px; margin: 0 auto; margin-top: 40px\">\n    <iframe id=\"CS_portal_69cfeccaf1b5380740d77eed\"\n      src=\"https://site.corsizio.com/portal/69cfeccaf1b5380740d77eed?embed=noheader,nosocial,nopadding,calendar,hidestarted,grouping:month,paging:20\"\n      loading=\"lazy\" width=\"100%\" height=\"900px\" frameborder=\"0\"></iframe>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n\n      <div class=\"schedule-wrap\">\n        <div class=\"schedule-head\">\n          <div>\n            <span class=\"label\">`king · powered by your scheduling plugin</span>\n            <h4>All upcoming classes</h4>\n          </div>\n          <div class=\"actions\">\n            <div class=\"schedule-tabs\">\n              <button class=\"schedule-tab active\" data-filter=\"all\">All</button>\n              <button class=\"schedule-tab\" data-filter=\"level1\">Level 1 / 2</button>\n              <button class=\"schedule-tab\" data-filter=\"bsdr\">BAR Repair</button>\n              <button class=\"schedule-tab\" data-filter=\"update\">Update</button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"schedule-list\" id=\"schedule-list\">\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">JUN 14<small>Sat · 8a–4p</small></div>\n            <div class=\"info\"><h5>UT079 · Transmission Diagnosis</h5><div class=\"sub\">Repair Tech Update · 12 hrs over 2 sessions</div></div>\n            <div class=\"mode\">Online + Lab</div>\n            <div class=\"seats low\">3 SEATS LEFT</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">JUN 28<small>Sat · 9a–5p</small></div>\n            <div class=\"info\"><h5>Inspector Update · IS-Q2 2026</h5><div class=\"sub\">8 hrs · EIS firmware + procedural changes</div></div>\n            <div class=\"mode\">Online</div>\n            <div class=\"seats open\">14 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"level1\">\n            <div class=\"date\">JUL 07<small>Mon · 6-week</small></div>\n            <div class=\"info\"><h5>Level 1 Smog Check Inspector</h5><div class=\"sub\">120 hrs · 6-week cohort · Online lecture + in-person lab</div></div>\n            <div class=\"mode\">Hybrid</div>\n            <div class=\"seats open\">12 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"level1\">\n            <div class=\"date\">JUL 21<small>Mon · 4-week</small></div>\n            <div class=\"info\"><h5>Level 2 Smog Check Procedures</h5><div class=\"sub\">40 hrs · Hands-on EIS operation · Owens Automotive</div></div>\n            <div class=\"mode\">In-person</div>\n            <div class=\"seats open\">8 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"bsdr\">\n            <div class=\"date\">AUG 04<small>Mon · 9-week</small></div>\n            <div class=\"info\"><h5>BAR Specified Diagnostic &amp; Repair</h5><div class=\"sub\">72 hrs · Alternative ASE qualifying path</div></div>\n            <div class=\"mode\">Hybrid</div>\n            <div class=\"seats waitlist\">WAITLIST</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Join List</a>\n          </div>\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">AUG 16<small>Sat · 8a–4p</small></div>\n            <div class=\"info\"><h5>Inspector Update · IS-Q3 2026</h5><div class=\"sub\">8 hrs · OBD-II + EIS firmware refresh</div></div>\n            <div class=\"mode\">Online</div>\n            <div class=\"seats open\">20 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"update\">\n            <div class=\"date\">SEP 06<small>Sat · 8a–4p</small></div>\n            <div class=\"info\"><h5>UT080 · Hybrid &amp; EV Drivability</h5><div class=\"sub\">Repair Tech Update · 12 hrs over 2 sessions</div></div>\n            <div class=\"mode\">Online + Lab</div>\n            <div class=\"seats open\">15 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n          <div class=\"session\" data-course=\"level1\">\n            <div class=\"date\">SEP 15<small>Mon · 6-week</small></div>\n            <div class=\"info\"><h5>Level 1 Smog Check Inspector</h5><div class=\"sub\">120 hrs · evening cohort</div></div>\n            <div class=\"mode\">Hybrid</div>\n            <div class=\"seats open\">10 OPEN</div>\n            <a class=\"reg-btn\" href=\"class-registration.html\">Register</a>\n          </div>\n        </div>\n\n        <div class=\"schedule-foot\">\n          <span class=\"note\">📅 &nbsp;This container is the plugin slot — Calendly, Acuity, Bookeo, or custom embed will render here.</span>\n          <a href=\"contact.html\" class=\"btn btn-ghost\" style=\"padding: 10px 16px; font-size:.82rem;\">Email me the calendar</a>\n        </div>\n      </div>\n\n      <div class=\"callout\" style=\"margin-top: 48px;\">\n        <div class=\"lbl\">Don't see what you need?</div>\n        <h4>Custom cohorts for shops with 4+ techs</h4>\n        <p>If you need to train your whole crew, we'll run a private cohort on your timeline. Call (760) 840-7954 or <a href=\"contact.html\" style=\"color:#fff; text-decoration: underline;\">send a request</a>.</p>\n      </div>\n    </div>\n  </section>\n\n  <script is:inline>\n    document.querySelectorAll('.schedule-tab').forEach(tab => {\n      tab.addEventListener('click', () => {\n        document.querySelectorAll('.schedule-tab').forEach(t => t.classList.remove('active'));\n        tab.classList.add('active');\n        const f = tab.dataset.filter;\n        document.querySelectorAll('#schedule-list .session').forEach(s => {\n          s.style.display = (f === 'all' || s.dataset.course === f) ? '' : 'none';\n        });\n      });\n    });\n  </script>\n\n  <script is:inline>/*version:4.0*/window.addEventListener('message', function (e) { var id = \"CS_portal_69cfeccaf1b5380740d77eed\"; var d = e.data; if (!d.corsizio) return; if (d.iframeId && d.iframeId !== id) return; var f = document.getElementById(id); if (!f) return; if (!d.iframeId) { f.contentWindow.postMessage({ iframeId: id }, '*'); return; } d.height >= 0 && (f.height = d.height + 'px'); d.scrollTo >= 0 && window.scrollTo(0, d.scrollTo); d.scrollIntoView && f.scrollIntoView(); });</script>\n</Layout>\n","structuredPatch":[{"oldStart":10,"oldLines":7,"newStart":10,"newLines":7,"lines":["   <section class=\"page-hd\">","     <div class=\"container inner\">","       <div class=\"crumbs\"><a href=\"index.html\">Home</a><span>/</span>Class Schedule</div>","-      <h1>Next <span class=\"accent\">90 days</span>.<br />Reserve your seat.</h1>","+      <h1>Reserve your seat.</h1>","       <p class=\"lede\">","         Live schedule, pulled directly from our booking system. Most sessions run hybrid — online","         lecture plus optional hands-on labs at Owens Automotive in Escondido. Seats fill fast."]}],"userModified":false,"replaceAll":false}}
