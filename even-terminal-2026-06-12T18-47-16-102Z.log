[2026-06-17 13:22:27] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ci7C5kQmhy6XLmAeA9deq","type":"tool_result","content":"The file /Users/andrewprice/DEV/brad/fastsmog/public/styles.css has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"888fa852-5011-4157-96f7-fbd1c868f7da","uuid":"07701c64-79a6-4b2e-9aa2-480772e34fb4","timestamp":"2026-06-17T18:22:26.941Z","tool_use_result":{"filePath":"/Users/andrewprice/DEV/brad/fastsmog/public/styles.css","oldString":"  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n}","newString":"  font-family: var(--font-display); font-size: 1.1rem; letter-spacing: .04em; text-transform: uppercase;\n}","originalFile":"/* ============================================\n   F.A.S.T. SMOG TRAINING — DESIGN SYSTEM\n   ============================================ */\n\n:root {\n  /* Palette */\n  --navy: #0B1B33;\n  --navy-700: #122A4D;\n  --navy-600: #1A3A6B;\n  --steel: #2563C8;\n  --steel-light: #4A86E0;\n  --red: #D8232A;\n  --red-dark: #B01820;\n  --paper: #F4F1EB;\n  --paper-2: #ECE7DC;\n  --ink: #0B1B33;\n  --ink-2: #4B5871;\n  --line: rgba(11,27,51,.12);\n  --line-strong: rgba(11,27,51,.22);\n\n  /* Primary (tweakable) */\n  --primary: var(--navy);\n  --primary-fg: #fff;\n  --accent: var(--red);\n\n  /* Type (tweakable) */\n  --font-display: \"Anton\", \"Oswald\", \"Impact\", sans-serif;\n  --font-body: \"Manrope\", \"Helvetica Neue\", Arial, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", monospace;\n\n  /* Scale */\n  --container: 1280px;\n  --gutter: clamp(20px, 4vw, 56px);\n  --radius: 4px;\n}\n\n/* Font-pairing presets */\n[data-fontset=\"industrial\"] {\n  --font-display: \"Anton\", sans-serif;\n  --font-body: \"Manrope\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n}\n[data-fontset=\"editorial\"] {\n  --font-display: \"Archivo Black\", sans-serif;\n  --font-body: \"IBM Plex Sans\", sans-serif;\n  --font-mono: \"IBM Plex Mono\", monospace;\n}\n[data-fontset=\"utility\"] {\n  --font-display: \"Oswald\", sans-serif;\n  --font-body: \"DM Sans\", sans-serif;\n  --font-mono: \"DM Mono\", monospace;\n}\n\n/* ============================================\n   RESET / BASE\n   ============================================ */\n*, *::before, *::after { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody {\n  margin: 0;\n  font-family: var(--font-body);\n  font-size: 16px;\n  line-height: 1.55;\n  color: var(--ink);\n  background: var(--paper);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\nimg, svg { display: block; max-width: 100%; }\na { color: inherit; text-decoration: none; }\nbutton { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }\nh1, h2, h3, h4, h5 { margin: 0; font-family: var(--font-display); font-weight: 400; letter-spacing: .01em; line-height: 1; text-transform: uppercase; }\np { margin: 0; }\n\n.container {\n  max-width: var(--container);\n  margin: 0 auto;\n  padding-inline: var(--gutter);\n}\n\n/* ============================================\n   UTILITY\n   ============================================ */\n.mono { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }\n.eyebrow {\n  display: inline-flex; align-items: center; gap: 10px;\n  font-family: var(--font-mono);\n  font-size: .72rem;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  color: var(--ink-2);\n}\n.eyebrow::before {\n  content: \"\";\n  width: 28px; height: 2px;\n  background: var(--accent);\n}\n.eyebrow.on-dark { color: rgba(255,255,255,.7); }\n.eyebrow.on-dark::before { background: var(--accent); }\n\n.btn {\n  display: inline-flex; align-items: center; gap: 10px;\n  padding: 16px 24px;\n  font-family: var(--font-display);\n  font-size: 1rem;\n  letter-spacing: .06em;\n  text-transform: uppercase;\n  border-radius: var(--radius);\n  transition: transform .15s ease, background .15s ease, color .15s ease;\n}\n.btn:active { transform: translateY(1px); }\n.btn-primary { background: var(--accent); color: #fff; }\n.btn-primary:hover { background: var(--red-dark); }\n.btn-ghost {\n  background: transparent; color: inherit;\n  box-shadow: inset 0 0 0 1.5px currentColor;\n}\n.btn-ghost:hover { background: currentColor; color: var(--paper); }\n.btn-ghost:hover * { color: var(--paper); }\n.btn .arrow { width: 18px; height: 10px; }\n\n.tag {\n  display: inline-flex; align-items: center;\n  padding: 4px 10px;\n  font-family: var(--font-mono);\n  font-size: .68rem;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  background: var(--paper-2);\n  color: var(--ink-2);\n  border-radius: 2px;\n}\n.tag.red { background: var(--accent); color: #fff; }\n.tag.steel { background: var(--steel); color: #fff; }\n.tag.outline { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }\n\n/* Diagonal stripe motif (automotive caution-tape) */\n.stripe-band {\n  height: 14px;\n  background: repeating-linear-gradient(\n    -45deg,\n    var(--accent) 0 14px,\n    #1a1a1a 14px 28px\n  );\n}\n\n/* ============================================\n   NAV\n   ============================================ */\n.topbar {\n  background: var(--navy);\n  color: #fff;\n  font-size: .82rem;\n  border-bottom: 1px solid rgba(255,255,255,.08);\n}\n.topbar .inner {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 8px 0;\n}\n.topbar .left, .topbar .right { display: flex; gap: 24px; align-items: center; }\n.topbar .right a:hover { color: var(--steel-light); }\n.topbar .dot { width: 6px; height: 6px; background: #3ad778; border-radius: 50%; display: inline-block; margin-right: 8px; box-shadow: 0 0 0 3px rgba(58,215,120,.18); }\n\n.nav {\n  position: sticky; top: 0; z-index: 100;\n  background: var(--paper);\n  border-bottom: 1px solid var(--line);\n  backdrop-filter: blur(8px);\n}\n.nav .inner {\n  display: flex; align-items: center; gap: 32px;\n  padding: 14px 0;\n}\n.logo {\n  display: flex; align-items: center; gap: 12px;\n  font-family: var(--font-display);\n  font-size: 1.4rem;\n  letter-spacing: .02em;\n  text-transform: uppercase;\n  color: var(--navy);\n}\n.logo .logo-img {\n  height: 80px;\n  width: auto;\n  display: block;\n}\n.logo .mark {\n  position: relative;\n  width: 44px; height: 44px;\n  background: var(--accent);\n  border-radius: var(--radius);\n  display: grid; place-items: center;\n  color: #fff;\n  font-family: var(--font-display);\n  font-size: 1.1rem;\n  letter-spacing: 0;\n  overflow: hidden;\n}\n.logo .mark::after {\n  content: \"\";\n  position: absolute; inset: 0;\n  background: repeating-linear-gradient(-45deg, transparent 0 6px, rgba(0,0,0,.12) 6px 7px);\n  pointer-events: none;\n}\n.logo .sub { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; color: var(--ink-2); display: block; margin-top: 2px; text-transform: uppercase;}\n.logo .name { line-height: 1; }\n.nav ul.nav-list {\n  display: flex; gap: 22px;\n  list-style: none; margin: 0; padding: 0;\n  font-family: var(--font-display); font-size: 1.1rem; letter-spacing: .04em; text-transform: uppercase;\n  margin-left: auto;\n  align-items: center;\n}\n.nav ul.nav-list a, .more-btn { color: var(--navy); position: relative; padding: 4px 0; display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: inherit; letter-spacing: inherit; text-transform: inherit; }\n.nav ul.nav-list a:hover, .more-btn:hover { color: var(--accent); }\n.nav ul.nav-list a.active::after, .more-btn.active::after {\n  content: \"\"; position: absolute; left: 0; right: 0; bottom: -6px;\n  height: 2px; background: var(--accent);\n}\n/* More dropdown */\n.more-wrap { position: relative; }\n.more-menu {\n  position: absolute;\n  right: 0; top: calc(100% + 14px);\n  min-width: 200px;\n  background: var(--steel);\n  color: #fff;\n  padding: 14px 0;\n  border-radius: 2px;\n  box-shadow: 0 24px 48px rgba(11,27,51,.25);\n  opacity: 0; transform: translateY(-6px); pointer-events: none;\n  transition: opacity .15s ease, transform .15s ease;\n  z-index: 200;\n}\n.more-menu.open { opacity: 1; transform: translateY(0); pointer-events: auto; }\n.nav ul.nav-list .more-menu a {\n  display: block;\n  width: 100%;\n  padding: 10px 22px;\n  color: #fff;\n  white-space: nowrap;\n  font-family: var(--font-display); font-size: .9rem; letter-spacing: .04em; text-transform: uppercase;\n}\n.nav ul.nav-list .more-menu a:hover { background: rgba(255,255,255,.1); color: #fff; }\n.nav ul.nav-list .more-menu a.active { background: rgba(255,255,255,.15); }\n\n.nav .nav-cta { display: flex; gap: 12px; align-items: center; }\n.nav-call { font-family: var(--font-mono); font-size: .85rem; letter-spacing: .04em; color: var(--navy); }\n.nav-call strong { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .04em; display: block; }\n.mobile-nav-toggle { display: none; padding: 10px; color: var(--navy); }\n\n/* ============================================\n   HERO\n   ============================================ */\n.hero {\n  background: var(--navy);\n  color: #fff;\n  position: relative;\n  overflow: hidden;\n}\n/* Full-bleed hero background image */\n.hero::before {\n  content: \"\";\n  position: absolute; inset: 0;\n  background-image:\n    /* dark overlay so the white/red text stays readable on any photo */\n    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.75) 45%, rgba(11,27,51,.55) 100%),\n    url(\"hero.jpg\");\n  background-size: cover;\n  background-position: center;\n  pointer-events: none;\n}\n.hero-grid {\n  position: relative;\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 64px;\n  align-items: center;\n  padding: 96px 0 104px;\n}\n.hero-text { max-width: 880px; }\n.hero h1 {\n  font-size: clamp(56px, 8.5vw, 128px);\n  line-height: .9;\n  letter-spacing: -.005em;\n}\n.hero h1 .accent { color: var(--accent); }\n.hero h1 .outline {\n  -webkit-text-stroke: 2px #fff;\n  color: transparent;\n}\n.hero .lede {\n  margin-top: 28px;\n  font-size: clamp(1.05rem, 1.4vw, 1.2rem);\n  line-height: 1.5;\n  color: rgba(255,255,255,.78);\n  max-width: 52ch;\n}\n.hero .cta-row { margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }\n.hero .quick-fact { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.55); padding-left: 16px; border-left: 2px solid var(--accent); }\n\n.hero-card {\n  position: relative;\n  border-radius: var(--radius);\n  background: #fff;\n  color: var(--navy);\n  overflow: hidden;\n  box-shadow: 0 30px 80px rgba(0,0,0,.45);\n}\n.hero-card .photo {\n  aspect-ratio: 4/3;\n  background:\n    repeating-linear-gradient(135deg, rgba(11,27,51,.04) 0 14px, rgba(11,27,51,.08) 14px 28px),\n    var(--paper-2);\n  position: relative;\n  display: grid; place-items: center;\n}\n.hero-card .photo .ph-label {\n  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .15em;\n  background: rgba(255,255,255,.85); padding: 6px 10px; border-radius: 2px;\n  color: var(--ink-2);\n}\n.hero-card .meta { padding: 22px 24px; border-top: 1px solid var(--line); }\n.hero-card .meta .row { display: flex; justify-content: space-between; align-items: baseline; }\n.hero-card .meta .row + .row { margin-top: 8px; }\n.hero-card .meta .label { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n.hero-card .meta .val { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .02em; text-transform: uppercase; }\n\n/* Hero stats strip */\n.stats {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 0;\n  border-top: 1px solid rgba(255,255,255,.12);\n}\n.stat {\n  padding: 28px 24px;\n  border-right: 1px solid rgba(255,255,255,.12);\n}\n.stat:last-child { border-right: 0; }\n.stat .num { font-family: var(--font-display); font-size: clamp(2.2rem, 3.6vw, 3.4rem); line-height: 1; color: #fff; }\n.stat .num small { font-size: .6em; color: var(--accent); margin-left: 4px; }\n.stat .lbl { margin-top: 8px; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }\n\n/* Hero variant: FULL-BLEED */\n.hero[data-variant=\"bleed\"] .hero-grid {\n  grid-template-columns: 1fr;\n  min-height: 640px;\n  padding: 0;\n  align-items: stretch;\n}\n.hero[data-variant=\"bleed\"] .hero-grid .hero-card { display: none; }\n.hero[data-variant=\"bleed\"] .hero-text {\n  padding: 120px 0 100px;\n  position: relative;\n  z-index: 2;\n}\n.hero[data-variant=\"bleed\"]::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(90deg, rgba(11,27,51,.92) 0%, rgba(11,27,51,.7) 50%, rgba(11,27,51,.4) 100%),\n    repeating-linear-gradient(135deg, rgba(255,255,255,.04) 0 18px, rgba(255,255,255,.07) 18px 36px),\n    var(--navy-700);\n  pointer-events: none;\n}\n.hero[data-variant=\"bleed\"] .hero-text { padding-block: 120px; }\n\n/* Hero variant: TYPE — massive type, no card */\n.hero[data-variant=\"type\"] .hero-grid {\n  grid-template-columns: 1fr;\n  padding: 100px 0 60px;\n}\n.hero[data-variant=\"type\"] h1 {\n  font-size: clamp(72px, 14vw, 240px);\n  line-height: .85;\n}\n.hero[data-variant=\"type\"] .hero-card { display: none; }\n.hero[data-variant=\"type\"] .hero-text { max-width: none; }\n.hero[data-variant=\"type\"] .lede { max-width: 44ch; }\n.hero[data-variant=\"type\"] .marquee-row {\n  display: grid; grid-template-columns: 2fr 1fr; gap: 64px; align-items: end;\n  margin-top: 24px;\n}\n\n/* ============================================\n   CREDENTIALS STRIP\n   ============================================ */\n.creds {\n  background: #fff;\n  border-bottom: 1px solid var(--line);\n}\n.creds .inner {\n  display: grid;\n  grid-template-columns: 1.4fr repeat(4, 1fr);\n  gap: 32px;\n  padding: 28px 0;\n  align-items: center;\n}\n.creds-label {\n  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2);\n}\n.creds-label strong { display: block; font-family: var(--font-display); font-size: 1rem; color: var(--navy); margin-top: 4px; letter-spacing: .03em; }\n.cred-item {\n  display: flex; flex-direction: column; gap: 4px;\n  padding-left: 16px;\n  border-left: 2px solid var(--line);\n}\n.cred-item .k { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.cred-item .v { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: .02em; text-transform: uppercase; }\n\n/* ============================================\n   SECTION\n   ============================================ */\n.section { padding: 96px 0; position: relative; }\n.section.dark { background: var(--navy); color: #fff; }\n.section.alt { background: var(--paper-2); }\n\n.section-head {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n  align-items: end;\n  margin-bottom: 56px;\n}\n.section-head h2 {\n  font-size: clamp(40px, 6vw, 84px);\n  line-height: .92;\n}\n.section-head .lead { color: var(--ink-2); font-size: 1.05rem; max-width: 50ch; }\n.section.dark .section-head .lead { color: rgba(255,255,255,.7); }\n\n/* ============================================\n   COURSES — spec sheet cards\n   ============================================ */\n.course-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 24px;\n}\n.course {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 28px;\n  display: flex; flex-direction: column;\n  gap: 20px;\n  position: relative;\n  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n}\n.course:hover { transform: translateY(-3px); box-shadow: 0 24px 50px -20px rgba(11,27,51,.25); border-color: var(--line-strong); }\n.course.featured { grid-column: 1 / -1; background: var(--navy); color: #fff; border-color: var(--navy); }\n.course.featured .course-foot a { color: #fff; }\n.course.featured .course-spec { border-color: rgba(255,255,255,.18); }\n.course.featured .course-spec .k { color: rgba(255,255,255,.6); }\n.course .course-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }\n.course .code { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.course.featured .code { color: rgba(255,255,255,.65); }\n.course h3 {\n  font-size: clamp(1.6rem, 2.4vw, 2rem);\n  line-height: 1.02;\n  letter-spacing: .01em;\n}\n.course p { color: var(--ink-2); font-size: .95rem; line-height: 1.55; }\n.course.featured p { color: rgba(255,255,255,.75); }\n.course-specs {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 0;\n  margin-top: auto;\n}\n.course-spec {\n  padding: 14px 14px 14px 0;\n  border-left: 1px solid var(--line);\n  padding-left: 14px;\n}\n.course-spec:first-child { border-left: 0; padding-left: 0; }\n.course-spec .k { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.course-spec .v { font-family: var(--font-display); font-size: 1rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 4px; }\n.course-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 1px solid var(--line); }\n.course.featured .course-foot { border-color: rgba(255,255,255,.16); }\n.course-foot a { font-family: var(--font-display); letter-spacing: .04em; text-transform: uppercase; font-size: .95rem; display: inline-flex; align-items: center; gap: 8px; color: var(--navy); }\n.course-foot a:hover { color: var(--accent); }\n.course-foot a .arrow { width: 18px; height: 10px; }\n.course-foot .price { font-family: var(--font-display); font-size: 1.4rem; color: var(--accent); letter-spacing: .02em; }\n.course-foot .price .from { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; color: var(--ink-2); display: block; line-height: 1; }\n\n/* ============================================\n   SCHEDULE\n   ============================================ */\n.schedule-wrap {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.schedule-head {\n  padding: 24px 28px;\n  display: flex; justify-content: space-between; align-items: center;\n  border-bottom: 1px solid var(--line);\n  background: var(--paper);\n}\n.schedule-head .label { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.schedule-head h4 { font-size: 1.4rem; margin-top: 4px; }\n.schedule-head .actions { display: flex; gap: 12px; align-items: center; }\n.schedule-tabs { display: flex; gap: 4px; }\n.schedule-tab {\n  padding: 8px 14px;\n  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n  border-radius: 2px;\n  color: var(--ink-2);\n}\n.schedule-tab.active { background: var(--navy); color: #fff; }\n\n.schedule-list {\n  display: grid;\n}\n.session {\n  display: grid;\n  grid-template-columns: 110px 1fr auto auto auto;\n  gap: 24px;\n  padding: 22px 28px;\n  align-items: center;\n  border-top: 1px solid var(--line);\n  transition: background .15s;\n}\n.session:first-child { border-top: 0; }\n.session:hover { background: var(--paper); }\n.session .date { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; line-height: 1; }\n.session .date small { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; color: var(--ink-2); margin-top: 6px; }\n.session .info h5 { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: .03em; text-transform: uppercase; margin: 0; }\n.session .info .sub { font-family: var(--font-mono); font-size: .72rem; color: var(--ink-2); letter-spacing: .08em; margin-top: 4px; }\n.session .mode { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n.session .seats {\n  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n  padding: 4px 10px; border-radius: 2px; background: var(--paper-2);\n}\n.session .seats.low { background: #FFE5D6; color: #B53E00; }\n.session .seats.open { background: #E5F4EA; color: #1F6B36; }\n.session .seats.waitlist { background: #F0EAFF; color: #5530A8; }\n.session .reg-btn {\n  padding: 10px 18px; background: var(--navy); color: #fff;\n  font-family: var(--font-display); letter-spacing: .06em; text-transform: uppercase; font-size: .82rem;\n  border-radius: 2px;\n}\n.session .reg-btn:hover { background: var(--accent); }\n\n.schedule-foot {\n  padding: 20px 28px;\n  border-top: 1px solid var(--line);\n  background: var(--paper);\n  display: flex; justify-content: space-between; align-items: center;\n}\n.schedule-foot .note { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; color: var(--ink-2); }\n\n/* ============================================\n   WHY F.A.S.T.\n   ============================================ */\n.why-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1px;\n  background: rgba(255,255,255,.12);\n  border: 1px solid rgba(255,255,255,.12);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.why {\n  background: var(--navy);\n  padding: 36px 32px;\n  display: flex; flex-direction: column; gap: 14px;\n  min-height: 240px;\n}\n.why .num { font-family: var(--font-display); font-size: 1rem; color: var(--accent); letter-spacing: .04em; }\n.why h4 { font-size: 1.6rem; line-height: 1.05; letter-spacing: .01em; }\n.why p { color: rgba(255,255,255,.7); font-size: .95rem; }\n\n/* ============================================\n   INSTRUCTORS\n   ============================================ */\n.inst-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.inst {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.inst .photo {\n  aspect-ratio: 4/5;\n  background:\n    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n    var(--paper-2);\n  position: relative;\n  display: grid; place-items: end stretch;\n}\n.inst .photo .ph-label {\n  font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink-2); padding: 10px 12px;\n  background: rgba(255,255,255,.85);\n  align-self: end;\n  border-top-right-radius: 4px;\n  width: fit-content;\n}\n.inst .body { padding: 22px 24px; }\n.inst .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.inst h4 { font-size: 1.4rem; letter-spacing: .02em; margin-top: 6px; }\n.inst .bio { color: var(--ink-2); font-size: .92rem; margin-top: 10px; line-height: 1.55; }\n.inst .creds { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }\n\n/* ============================================\n   TESTIMONIALS\n   ============================================ */\n.test-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.test {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 30px 28px;\n  display: flex; flex-direction: column; gap: 18px;\n}\n.test .stars { color: var(--accent); letter-spacing: 2px; font-size: 1.1rem; }\n.test blockquote { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; margin: 0; color: var(--ink); }\n.test .who { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); }\n.test .avatar {\n  width: 40px; height: 40px; border-radius: 50%;\n  background: var(--navy); color: #fff;\n  display: grid; place-items: center;\n  font-family: var(--font-display); font-size: .9rem; letter-spacing: .02em;\n}\n.test .who-text .name { font-family: var(--font-display); letter-spacing: .03em; text-transform: uppercase; font-size: .95rem; }\n.test .who-text .role { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; color: var(--ink-2); margin-top: 2px; text-transform: uppercase; }\n\n/* ============================================\n   FAQ\n   ============================================ */\n.faq-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.4fr;\n  gap: 64px;\n  align-items: flex-start;\n}\n.faq-list {\n  display: grid;\n}\n.faq-item {\n  border-top: 1px solid var(--line-strong);\n  padding: 24px 0;\n}\n.faq-item:last-child { border-bottom: 1px solid var(--line-strong); }\n.faq-q {\n  display: flex; justify-content: space-between; align-items: center;\n  width: 100%; text-align: left;\n  font-family: var(--font-display);\n  font-size: 1.3rem;\n  letter-spacing: .01em;\n  text-transform: uppercase;\n  color: var(--navy);\n  padding: 0;\n}\n.faq-q .plus {\n  width: 28px; height: 28px;\n  border: 1.5px solid var(--navy);\n  border-radius: 50%;\n  display: grid; place-items: center;\n  transition: transform .2s, background .2s, color .2s;\n  flex-shrink: 0;\n}\n.faq-item[open] .faq-q .plus { background: var(--accent); border-color: var(--accent); color: #fff; transform: rotate(45deg); }\n.faq-a { padding-top: 14px; color: var(--ink-2); max-width: 64ch; font-size: 1rem; line-height: 1.55; }\n\n/* ============================================\n   CONTACT / CTA\n   ============================================ */\n.cta-band {\n  background: var(--accent);\n  color: #fff;\n  padding: 80px 0;\n  position: relative;\n  overflow: hidden;\n}\n.cta-band::before {\n  content: \"\";\n  position: absolute; inset: 0;\n  background: repeating-linear-gradient(-45deg, transparent 0 40px, rgba(0,0,0,.04) 40px 41px);\n  pointer-events: none;\n}\n.cta-band .inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; position: relative; }\n.cta-band h2 { font-size: clamp(40px, 6vw, 88px); line-height: .9; }\n.cta-band .btn-primary { background: #fff; color: var(--accent); }\n.cta-band .btn-primary:hover { background: var(--navy); color: #fff; }\n.cta-band .btn-ghost { color: #fff; }\n\n.contact-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n}\n.contact-info > * + * { margin-top: 28px; }\n.contact-block .label { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.contact-block .val { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .02em; text-transform: uppercase; margin-top: 6px; }\n.contact-block .sub { font-family: var(--font-body); color: var(--ink-2); margin-top: 4px; }\n\n.form { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }\n.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.form label { display: block; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 6px; }\n.form input, .form select, .form textarea {\n  width: 100%; padding: 12px 14px;\n  font-family: var(--font-body); font-size: .95rem;\n  background: var(--paper); border: 1px solid var(--line); border-radius: 2px;\n  color: var(--ink);\n  transition: border-color .15s, background .15s;\n}\n.form input:focus, .form select:focus, .form textarea:focus { outline: 0; border-color: var(--navy); background: #fff; }\n.form .field + .field { margin-top: 14px; }\n.form textarea { min-height: 110px; resize: vertical; }\n.form .submit { margin-top: 20px; width: 100%; justify-content: center; }\n\n/* ============================================\n   FOOTER\n   ============================================ */\n.foot {\n  background: #060F1F;\n  color: rgba(255,255,255,.7);\n  padding: 64px 0 28px;\n  font-size: .9rem;\n}\n.foot-grid {\n  display: grid;\n  grid-template-columns: 1.4fr 1fr 1fr 1fr;\n  gap: 48px;\n  padding-bottom: 48px;\n  border-bottom: 1px solid rgba(255,255,255,.08);\n}\n.foot h5 { font-family: var(--font-display); color: #fff; letter-spacing: .06em; font-size: .95rem; text-transform: uppercase; margin-bottom: 16px; }\n.foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }\n.foot ul a:hover { color: var(--accent); }\n.foot .blurb { color: rgba(255,255,255,.55); max-width: 36ch; margin-top: 14px; }\n.foot-bottom {\n  padding-top: 24px;\n  display: flex; justify-content: space-between; align-items: center;\n  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.45);\n}\n.foot-bottom a:hover { color: var(--accent); }\n\n/* ============================================\n   MARQUEE\n   ============================================ */\n.marquee {\n  background: #0A1525;\n  color: #fff;\n  overflow: hidden;\n  border-block: 1px solid rgba(255,255,255,.08);\n  position: relative;\n}\n.marquee::before, .marquee::after {\n  content: \"\";\n  position: absolute; top: 0; bottom: 0; width: 80px;\n  z-index: 2; pointer-events: none;\n}\n.marquee::before { left: 0; background: linear-gradient(90deg, #0A1525, transparent); }\n.marquee::after { right: 0; background: linear-gradient(-90deg, #0A1525, transparent); }\n.marquee-track {\n  display: flex; gap: 56px; padding: 18px 0;\n  animation: marquee 38s linear infinite;\n  width: max-content;\n}\n.marquee-item {\n  display: inline-flex; align-items: center; gap: 14px;\n  font-family: var(--font-display);\n  font-size: 1.2rem; letter-spacing: .04em; text-transform: uppercase;\n  white-space: nowrap;\n}\n.marquee-item .bullet {\n  width: 8px; height: 8px; background: var(--accent); border-radius: 50%;\n}\n@keyframes marquee {\n  to { transform: translateX(-50%); }\n}\n\n/* ============================================\n   BLOG / RESOURCES\n   ============================================ */\n.posts-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.post {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  overflow: hidden;\n  display: flex; flex-direction: column;\n  transition: transform .2s, box-shadow .2s;\n}\n.post:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -20px rgba(11,27,51,.2); }\n.post .ph {\n  aspect-ratio: 16/9;\n  background:\n    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n    var(--paper-2);\n  position: relative;\n}\n.post .ph .ph-label {\n  position: absolute; inset: auto auto 12px 12px;\n  font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase;\n  background: rgba(255,255,255,.9); padding: 6px 10px; border-radius: 2px;\n  color: var(--ink-2);\n}\n.post .ph .tag { position: absolute; top: 12px; left: 12px; }\n.post .body { padding: 22px 24px; display: flex; flex-direction: column; flex: 1; }\n.post .date { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }\n.post h4 { font-size: 1.3rem; letter-spacing: .02em; margin-top: 8px; line-height: 1.05; }\n.post .excerpt { color: var(--ink-2); font-size: .92rem; margin-top: 10px; line-height: 1.5; }\n.post .read { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); font-family: var(--font-display); letter-spacing: .04em; text-transform: uppercase; font-size: .85rem; color: var(--navy); display: inline-flex; align-items: center; gap: 8px; }\n\n/* ============================================\n   PAGE HEADER BANNER (inner pages)\n   ============================================ */\n.page-hd {\n  background: var(--navy);\n  color: #fff;\n  padding: 72px 0 64px;\n  position: relative;\n  overflow: hidden;\n}\n.page-hd::before {\n  content: \"\";\n  position: absolute; inset: 0;\n  background:\n    radial-gradient(50% 80% at 90% 20%, rgba(37,99,200,.28), transparent 60%),\n    radial-gradient(40% 60% at 10% 90%, rgba(216,35,42,.18), transparent 60%);\n  pointer-events: none;\n}\n.page-hd .inner { position: relative; }\n.page-hd .crumbs {\n  font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;\n  color: rgba(255,255,255,.55);\n  margin-bottom: 22px;\n}\n.page-hd .crumbs a:hover { color: var(--accent); }\n.page-hd .crumbs span { margin: 0 8px; color: rgba(255,255,255,.3); }\n.page-hd h1 {\n  font-size: clamp(48px, 7vw, 96px);\n  line-height: .92;\n  max-width: 18ch;\n}\n.page-hd h1 .accent { color: var(--accent); }\n.page-hd .lede {\n  margin-top: 22px;\n  font-size: clamp(1rem, 1.3vw, 1.15rem);\n  line-height: 1.5;\n  color: rgba(255,255,255,.75);\n  max-width: 58ch;\n}\n\n/* ============================================\n   PROSE — long-form copy on inner pages\n   ============================================ */\n.prose {\n  max-width: 70ch;\n  font-size: 1.02rem;\n  line-height: 1.65;\n  color: var(--ink);\n}\n.prose h2 {\n  font-size: clamp(28px, 3.4vw, 44px);\n  margin-top: 56px; margin-bottom: 20px;\n  letter-spacing: .01em;\n  line-height: 1.05;\n}\n.prose h2:first-child { margin-top: 0; }\n.prose h3 {\n  font-size: clamp(22px, 2.4vw, 28px);\n  margin-top: 36px; margin-bottom: 14px;\n  letter-spacing: .02em;\n  line-height: 1.1;\n}\n.prose p { margin-bottom: 16px; color: var(--ink-2); }\n.prose strong { color: var(--ink); }\n.prose ul, .prose ol { color: var(--ink-2); padding-left: 22px; margin: 0 0 18px; }\n.prose ul li, .prose ol li { margin-bottom: 8px; }\n.prose ul li::marker { color: var(--accent); }\n.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }\n.prose a:hover { color: var(--red-dark); }\n\n.prose-grid {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 80px;\n  align-items: start;\n}\n.prose-aside {\n  position: sticky; top: 96px;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--paper);\n}\n.prose-aside h5 {\n  font-family: var(--font-display);\n  font-size: .85rem; letter-spacing: .08em; text-transform: uppercase;\n  margin-bottom: 14px;\n  color: var(--navy);\n}\n.prose-aside ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .9rem; }\n.prose-aside a { color: var(--ink-2); }\n.prose-aside a:hover { color: var(--accent); }\n.prose-aside a.active { color: var(--accent); font-weight: 600; }\n\n/* Callout / inline highlight box */\n.callout {\n  background: var(--navy);\n  color: #fff;\n  border-radius: var(--radius);\n  padding: 28px 32px;\n  margin: 32px 0;\n}\n.callout .lbl { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.6); }\n.callout h4 { font-size: 1.5rem; letter-spacing: .02em; margin-top: 8px; line-height: 1.1; }\n.callout p { color: rgba(255,255,255,.75); margin-top: 10px; }\n\n/* Spec table — used for state requirements + class details */\n.spec-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin: 24px 0;\n  font-size: .95rem;\n}\n.spec-table th, .spec-table td {\n  text-align: left;\n  padding: 14px 16px;\n  border-bottom: 1px solid var(--line);\n  vertical-align: top;\n}\n.spec-table th {\n  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink-2); background: var(--paper-2);\n  border-bottom: 1px solid var(--line-strong);\n}\n.spec-table tr:hover td { background: var(--paper); }\n.spec-table td .courseref { font-family: var(--font-display); letter-spacing: .02em; text-transform: uppercase; font-size: 1.05rem; color: var(--navy); }\n\n/* Pricing table */\n.pricing-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n  margin-bottom: 32px;\n}\n.price-card {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 32px 28px;\n  display: flex; flex-direction: column; gap: 16px;\n}\n.price-card.feat { background: var(--navy); color: #fff; border-color: var(--navy); }\n.price-card .pname { font-family: var(--font-display); font-size: 1.3rem; letter-spacing: .02em; text-transform: uppercase; line-height: 1.1; }\n.price-card .pcode { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }\n.price-card.feat .pcode { color: rgba(255,255,255,.6); }\n.price-card .pprice { font-family: var(--font-display); font-size: 3rem; letter-spacing: .01em; line-height: 1; color: var(--accent); }\n.price-card .pprice small { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .12em; color: var(--ink-2); display: block; margin-top: 6px; }\n.price-card.feat .pprice small { color: rgba(255,255,255,.6); }\n.price-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: .9rem; color: var(--ink-2); }\n.price-card.feat ul { color: rgba(255,255,255,.8); }\n.price-card ul li { padding-left: 22px; position: relative; }\n.price-card ul li::before {\n  content: \"\"; position: absolute; left: 0; top: 9px;\n  width: 12px; height: 2px; background: var(--accent);\n}\n.price-card .btn { margin-top: auto; justify-content: center; }\n\n/* Numbered policy / requirement list */\n.req-list { display: grid; gap: 20px; counter-reset: req; }\n.req-item {\n  display: grid;\n  grid-template-columns: 56px 1fr;\n  gap: 24px;\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n}\n.req-item::before {\n  counter-increment: req;\n  content: counter(req, decimal-leading-zero);\n  font-family: var(--font-display);\n  font-size: 1.6rem;\n  color: var(--accent);\n  letter-spacing: .02em;\n}\n.req-item h4 { font-size: 1.15rem; letter-spacing: .02em; line-height: 1.1; margin-bottom: 8px; }\n.req-item p { color: var(--ink-2); font-size: .95rem; line-height: 1.55; }\n\n/* Map placeholder */\n.map-ph {\n  aspect-ratio: 16/9;\n  background:\n    repeating-linear-gradient(135deg, rgba(11,27,51,.05) 0 12px, rgba(11,27,51,.09) 12px 24px),\n    var(--paper-2);\n  position: relative;\n  border-radius: var(--radius);\n  overflow: hidden;\n  display: grid; place-items: center;\n}\n.map-ph .ph-label {\n  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink-2);\n  background: rgba(255,255,255,.85);\n  padding: 8px 14px; border-radius: 2px;\n}\n.map-ph .pin {\n  position: absolute;\n  width: 22px; height: 22px;\n  background: var(--accent);\n  border-radius: 50% 50% 50% 0;\n  transform: rotate(-45deg);\n  top: 40%; left: 55%;\n  box-shadow: 0 4px 14px rgba(216,35,42,.4);\n}\n.map-ph .pin::before {\n  content: \"\"; position: absolute; inset: 5px;\n  background: #fff; border-radius: 50%;\n}\n\n/* ============================================\n   RESPONSIVE\n   ============================================ */\n@media (max-width: 1180px) {\n  .nav ul.nav-list {\n    position: absolute;\n    top: 100%;\n    left: 0; right: 0;\n    flex-direction: column;\n    gap: 0;\n    background: var(--paper);\n    border-bottom: 1px solid var(--line);\n    box-shadow: 0 24px 40px rgba(11,27,51,.12);\n    padding: 14px 0;\n    align-items: stretch;\n    transform: translateY(-8px);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity .15s ease, transform .15s ease;\n    margin-left: 0;\n  }\n  .nav ul.nav-list.mobile-open { opacity: 1; transform: translateY(0); pointer-events: auto; }\n  .nav ul.nav-list a, .more-btn { padding: 12px 32px; width: 100%; }\n  .nav ul.nav-list a.active::after, .more-btn.active::after { display: none; }\n  .nav ul.nav-list a.active, .more-btn.active { color: var(--accent); border-left: 3px solid var(--accent); padding-left: 29px; }\n  .more-wrap { width: 100%; }\n  .more-menu { position: static; opacity: 1; transform: none; pointer-events: auto; background: transparent; color: var(--navy); box-shadow: none; padding: 0; }\n  .nav ul.nav-list .more-menu a { color: var(--navy); padding: 10px 48px; }\n  .nav ul.nav-list .more-menu a:hover { background: var(--paper-2); }\n  .mobile-nav-toggle { display: inline-grid; place-items: center; margin-left: auto; }\n  .nav-cta { margin-left: auto; }\n  .prose-grid { grid-template-columns: 1fr; gap: 40px; }\n  .prose-aside { position: static; }\n  .pricing-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 1000px) {\n  .hero-grid { grid-template-columns: 1fr; gap: 40px; padding: 64px 0; }\n  .stats { grid-template-columns: repeat(2, 1fr); }\n  .stat:nth-child(2) { border-right: 0; }\n  .creds .inner { grid-template-columns: 1fr 1fr; }\n  .course-grid, .why-grid, .inst-grid, .test-grid, .posts-grid { grid-template-columns: 1fr; }\n  .course.featured { grid-column: auto; }\n  .section-head { grid-template-columns: 1fr; }\n  .faq-grid { grid-template-columns: 1fr; gap: 32px; }\n  .contact-grid { grid-template-columns: 1fr; }\n  .cta-band .inner { grid-template-columns: 1fr; }\n  .foot-grid { grid-template-columns: 1fr 1fr; }\n  .topbar .left, .topbar .right { gap: 12px; flex-wrap: wrap; }\n  .session { grid-template-columns: 1fr; gap: 8px; }\n}\n@media (max-width: 600px) {\n  .creds .inner { grid-template-columns: 1fr; }\n  .foot-grid { grid-template-columns: 1fr; }\n  .form-row { grid-template-columns: 1fr; }\n  .nav .inner { gap: 12px; }\n  .nav-call { display: none; }\n}\n","structuredPatch":[{"oldStart":239,"oldLines":7,"newStart":239,"newLines":7,"lines":["   padding: 10px 22px;","   color: #fff;","   white-space: nowrap;","-  font-family: var(--font-