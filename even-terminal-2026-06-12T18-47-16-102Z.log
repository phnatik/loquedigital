kups\"\n        options={{\n          title: 'Backups',\n          tabBarIcon: ({ color, size }) => (\n            <Ionicons name=\"cloud-upload-outline\" size={size} color={color} />\n          ),\n        }}\n      />\n      <Tabs.Screen\n        name=\"profile\"\n        options={{\n          title: 'Profile',\n          tabBarIcon: ({ color, size }) => (\n            <Ionicons name=\"person-circle-outline\" size={size} color={color} />\n          ),\n        }}\n      />\n    </Tabs>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1703,"cache_read_input_tokens":67176,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1703},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"86d961f7-684e-4863-a78f-fe12f1103304"}
