[2026-06-14 16:29:42] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011dXeCvy21ovqa1nZvFJpDL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WPecvxcvrKSmdEjLAum4ng","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/profile.jsx","content":"// app/(app)/profile.jsx — polished profile with avatar, account info, support link, version.\nimport { View, Text, Image, ScrollView, StyleSheet, Pressable, Linking } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { Ionicons } from '@expo/vector-icons';\nimport Constants from 'expo-constants';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Card, Button } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nconst brandLogo = require('../../assets/brand.png');\n\nfunction Row({ icon, label, value, onPress }) {\n  const Wrap = onPress ? Pressable : View;\n  return (\n    <Wrap onPress={onPress} style={styles.row}>\n      <View style={styles.rowIconWrap}>\n        <Ionicons name={icon} size={16} color={colors.secondary} />\n      </View>\n      <Text style={styles.rowLabel}>{label}</Text>\n      {value ? (\n        <Text style={styles.rowValue} numberOfLines={1}>{value}</Text>\n      ) : null}\n      {onPress ? (\n        <Ionicons name=\"chevron-forward\" size={16} color={colors.textMuted} />\n      ) : null}\n    </Wrap>\n  );\n}\n\nexport default function Profile() {\n  const { user, senturiUser, membership, logout } = useAuth();\n\n  const fullName = [senturiUser?.first_name, senturiUser?.last_name]\n    .filter(Boolean)\n    .join(' ');\n  const initials = (fullName || senturiUser?.email || 'S')\n    .split(' ')\n    .map((p) => p[0])\n    .join('')\n    .slice(0, 2)\n    .toUpperCase();\n\n  const version = Constants.expoConfig?.version ?? '1.0.0';\n\n  return (\n    <ScrollView style={styles.container} contentContainerStyle={styles.content}>\n      {/* Avatar header */}\n      <View style={styles.avatarWrap}>\n        <LinearGradient\n          colors={gradients.brand}\n          start={{ x: 0, y: 0 }}\n          end={{ x: 1, y: 1 }}\n          style={styles.avatar}\n        >\n          <Text style={styles.avatarText}>{initials}</Text>\n        </LinearGradient>\n        <Text style={styles.name}>{fullName || 'Senturi user'}</Text>\n        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n      </View>\n\n      {/* Account card */}\n      <Card>\n        <Text style={styles.cardTitle}>Account</Text>\n        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n      </Card>\n\n      {/* Support card */}\n      <Card style={{ marginTop: spacing.lg }}>\n        <Text style={styles.cardTitle}>Support</Text>\n        <Row\n          icon=\"chatbubble-ellipses-outline\"\n          label=\"Contact support\"\n          onPress={() => Linking.openURL('mailto:support@senturi.io')}\n        />\n        <Row\n          icon=\"globe-outline\"\n          label=\"Visit senturi.io\"\n          onPress={() => Linking.openURL('https://senturi.io')}\n        />\n      </Card>\n\n      <Button\n        title=\"Log out\"\n        variant=\"danger\"\n        onPress={logout}\n        style={{ marginTop: spacing.xl }}\n      />\n\n      {/* Footer */}\n      <View style={styles.footer}>\n        <Image source={brandLogo} style={styles.footerLogo} resizeMode=\"contain\" />\n        <Text style={styles.footerText}>\n          Senturi v{version}\n        </Text>\n        <Text style={styles.footerSub}>\n          Simple. Safe. Secure.\n        </Text>\n      </View>\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxxl },\n\n  /* Avatar */\n  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n  avatar: {\n    width: 88,\n    height: 88,\n    borderRadius: 44,\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginBottom: spacing.md,\n    ...shadow.button,\n  },\n  avatarText: { color: colors.textInverse, fontSize: 30, fontWeight: '800' },\n  name: { ...typography.title, fontSize: 22 },\n  email: { ...typography.caption, marginTop: spacing.xs },\n\n  /* Card */\n  cardTitle: {\n    ...typography.label,\n    textTransform: 'uppercase',\n    letterSpacing: 0.5,\n    marginBottom: spacing.lg,\n  },\n  row: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    paddingVertical: spacing.md,\n    borderBottomWidth: 1,\n    borderBottomColor: colors.border,\n  },\n  rowIconWrap: {\n    width: 32,\n    height: 32,\n    borderRadius: radius.sm,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  rowLabel: { ...typography.body, color: colors.textMuted, flex: 1 },\n  rowValue: { ...typography.body, fontWeight: '600', textAlign: 'right' },\n\n  /* Footer */\n  footer: {\n    alignItems: 'center',\n    marginTop: spacing.xxxl,\n    paddingTop: spacing.xl,\n  },\n  footerLogo: { width: 36, height: 36, marginBottom: spacing.sm, opacity: 0.15 },\n  footerText: { fontSize: 12, fontWeight: '600', color: '#c0c8d0', letterSpacing: 0.3 },\n  footerSub: { fontSize: 11, color: '#d0d6dc', marginTop: 2, letterSpacing: 0.5 },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2605,"cache_read_input_tokens":160506,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2605},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"