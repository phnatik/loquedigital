[2026-06-12 19:01:39] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01VVPnaLhzVR2QiQVq8tNy5x","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014PMA2Eftx7BMqLR9HY1zy8","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/backups.jsx","content":"// app/(app)/backups.jsx — Comet backup job history for the signed-in user.\n// Mirrors core-frontend Backups.jsx (keyed by email; rows of date/size/files/status).\nimport { useCallback, useMemo, useState } from 'react';\nimport { View, Text, FlatList, RefreshControl, StyleSheet } from 'react-native';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getJobsForUser } from '../../src/services/cometService';\nimport { Card, Loader, EmptyState } from '../../src/components/ui';\nimport { formatEpoch, convertFileSize, cometStatus } from '../../src/utils/format';\nimport { colors, spacing, typography, radius } from '../../src/theme/theme';\n\nfunction statusStyle(status) {\n  const label = cometStatus(status);\n  if (label === 'Success') return { color: colors.success, icon: 'checkmark-circle' };\n  if (label === 'Failed') return { color: colors.danger, icon: 'close-circle' };\n  if (label === 'Running') return { color: colors.secondary, icon: 'sync' };\n  return { color: colors.warning, icon: 'alert-circle' };\n}\n\nexport default function Backups() {\n  const { senturiUser } = useAuth();\n  const email = senturiUser?.email;\n\n  const [jobs, setJobs] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n\n  const load = useCallback(async () => {\n    if (!email) {\n      setJobs([]);\n      setLoading(false);\n      return;\n    }\n    setError(null);\n    try {\n      const list = await getJobsForUser(email);\n      const sorted = [...list].sort(\n        (a, b) => (b?.StartTime ?? 0) - (a?.StartTime ?? 0),\n      );\n      setJobs(sorted);\n    } catch (err) {\n      setError(err?.message || 'Could not load backup history.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [email]);\n\n  useFocusEffect(\n    useCallback(() => {\n      load();\n    }, [load]),\n  );\n\n  const onRefresh = () => {\n    setRefreshing(true);\n    load();\n  };\n\n  const latest = useMemo(() => jobs[0], [jobs]);\n\n  if (loading && !refreshing) return <Loader label=\"Loading backups…\" />;\n\n  const renderItem = ({ item }) => {\n    const s = statusStyle(item.Status);\n    return (\n      <Card style={styles.jobCard}>\n        <View style={[styles.statusIcon, { backgroundColor: `${s.color}14` }]}>\n          <Ionicons name={s.icon} size={22} color={s.color} />\n        </View>\n        <View style={{ flex: 1 }}>\n          <Text style={styles.jobTitle} numberOfLines={1}>\n            {item.FriendlyName || 'Backup'}\n          </Text>\n          <Text style={styles.jobMeta}>{formatEpoch(item.StartTime)}</Text>\n          <Text style={styles.jobMeta}>\n            {convertFileSize(item.TotalSize)} · {item.TotalFiles ?? '—'} files\n          </Text>\n        </View>\n        <View style={[styles.statusBadge, { backgroundColor: `${s.color}18` }]}>\n          <Text style={[styles.jobStatus, { color: s.color }]}>\n            {cometStatus(item.Status)}\n          </Text>\n        </View>\n      </Card>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={jobs}\n        keyExtractor={(item, idx) =>\n          String(item.GUID ?? item.SnapshotID ?? item.JobID ?? idx)\n        }\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={colors.primary}\n          />\n        }\n        ListHeaderComponent={\n          jobs.length ? (\n            <View style={styles.header}>\n              <Text style={styles.headerTitle}>Backup History</Text>\n              <Text style={styles.headerSub}>\n                {jobs.length} backup{jobs.length === 1 ? '' : 's'} · last{' '}\n                {formatEpoch(latest?.StartTime)}\n              </Text>\n            </View>\n          ) : null\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState\n              title=\"No backups found\"\n              subtitle=\"Backup activity will show up here.\"\n            />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  header: { marginBottom: spacing.lg },\n  headerTitle: { ...typography.title },\n  headerSub: { ...typography.caption, marginTop: spacing.xs },\n  jobCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  statusIcon: {\n    width: 44,\n    height: 44,\n    borderRadius: radius.md,\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  jobTitle: { ...typography.heading, fontSize: 15, marginBottom: 2 },\n  jobMeta: { ...typography.caption },\n  statusBadge: {\n    paddingHorizontal: spacing.md,\n    paddingVertical: spacing.xs,\n    borderRadius: radius.pill,\n    marginLeft: spacing.md,\n  },\n  jobStatus: { fontSize: 12, fontWeight: '700' },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2560,"cache_read_input_tokens":71315,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2560},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"c7c190f8-6afb-4fad-a0c6-5fbf482f1d87"}
