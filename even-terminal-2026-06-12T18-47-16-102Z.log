rTextColor={colors.textMuted}\n53\t        style={[styles.input, error && styles.inputError]}\n54\t        {...inputProps}\n55\t      />\n56\t      {error ? <Text style={styles.fieldError}>{error}</Text> : null}\n57\t    </View>\n58\t  );\n59\t}\n60\t\n61\texport function StatusPill({ online, label }) {\n62\t  const color = online ? colors.online : colors.offline;\n63\t  return (\n64\t    <View style={styles.pill}>\n65\t      <View style={[styles.pillDot, { backgroundColor: color }]} />\n66\t      <Text style={[styles.pillText, { color }]}>{label || (online ? 'ONLINE' : 'OFFLINE')}</Text>\n67\t    </View>\n68\t  );\n69\t}\n70\t\n71\texport function Loader({ label }) {\n72\t  return (\n73\t    <View style={styles.loader}>\n74\t      <ActivityIndicator size=\"large\" color={colors.primary} />\n75\t      {label ? <Text style={styles.loaderText}>{label}</Text> : null}\n76\t    </View>\n77\t  );\n78\t}\n79\t\n80\texport function EmptyState({ title, subtitle }) {\n81\t  return (\n82\t    <View style={styles.empty}>\n83\t      <Text style={styles.emptyTitle}>{title}</Text>\n84\t      {subtitle ? <Text style={styles.emptySubtitle}>{subtitle}</Text> : null}\n85\t    </View>\n86\t  );\n87\t}\n88\t\n89\tconst styles = StyleSheet.create({\n90\t  card: {\n91\t    backgroundColor: colors.surface,\n92\t    borderRadius: radius.lg,\n93\t    padding: spacing.lg,\n94\t    borderWidth: 1,\n95\t    borderColor: colors.border,\n96\t    ...shadow.card,\n97\t  },\n98\t  screenTitle: { ...typography.title, marginBottom: spacing.lg },\n99\t  button: {\n100\t    height: 50,\n101\t    borderRadius: radius.md,\n102\t    alignItems: 'center',\n103\t    justifyContent: 'center',\n104\t    paddingHorizontal: spacing.lg,\n105\t  },\n106\t  buttonGhost: { borderWidth: 1, borderColor: colors.primary },\n107\t  buttonText: { fontSize: 16, fontWeight: '600' },\n108\t  field: { marginBottom: spacing.lg },\n109\t  fieldLabel: { ...typography.label, marginBottom: spacing.xs },\n110\t  input: {\n111\t    