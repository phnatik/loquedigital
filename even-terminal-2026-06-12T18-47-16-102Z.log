\n    } catch (err) {\n      setError(err?.message || 'Could not load your devices.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [superopsAccountId]);\n\n  useFocusEffect(\n    useCallback(() => {\n      load();\n    }, [load]),\n  );\n\n  const onRefresh = () => {\n    setRefreshing(true);\n    load();\n  };\n\n  if ((loading || loadingMembership) && !refreshing)\n    return <Loader label=\"Loading devices…\" />;\n\n  const renderItem = ({ item }) => {\n    const online =\n      (item.status ?? 'online').toString().toLowerCase() !== 'offline';\n    return (\n      <Pressable\n        onPress={() => router.push(`/asset/${item.assetId ?? item.id}`)}\n        style={({ pressed }) => [{ opacity: pressed ? 0.7 : 1 }]}\n      >\n        <Card style={styles.assetCard}>\n          <View style={styles.assetIcon}>\n            <Ionicons name=\"desktop-outline\" size={20} color={colors.secondary} />\n          </View>\n          <View style={{ flex: 1 }}>\n            <Text style={styles.assetName} numberOfLines={1}>\n              {item.name || 'Unnamed device'}\n            </Text>\n            <StatusPill online={online} />\n          </View>\n          <Ionicons name=\"chevron-forward\" size={18} color={colors.textMuted} />\n        </Card>\n      </Pressable>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={assets}\n        keyExtractor={(item, idx) => String(item.assetId ?? item.id ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={colors.primary}\n          />\n        }\n        ListHeaderComponent={\n          <View style={styles.header}>\n            <Text style={styles.clientName}>\n              {membership?.client_name || 'Your devices'}\n            </Text>\n            <Text style={styles.subtle}>\n              {assets.length} device{assets.length === 1 ? '' : 's'}\n            </Text>\n          </View>\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : (\n            <EmptyState\n              title=\"No devices yet\"\n              subtitle=\"Installed devices will appear here.\"\n            />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  header: { marginBottom: spacing.lg },\n  clientName: { ...typography.title },\n  subtle: { ...typography.caption, marginTop: spacing.xs },\n  assetCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  assetIcon: {\n    width: 44,\n    height: 44,\n    borderRadius: radius.md,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  assetName: { ...typography.heading, fontSize: 16, marginBottom: spacing.xs },\n});\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/app/(app)/dashboard.jsx has been updated successfully. (file state is current in your context — no need to Read it back)"}}
