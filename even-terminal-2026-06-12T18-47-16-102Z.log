    keyboardShouldPersistTaps=\"handled\"\n56\t        >\n57\t          {/* Brand */}\n58\t          <View style={styles.brandWrap}>\n59\t            <Image source={brandLogo} style={styles.logo} resizeMode=\"contain\" />\n60\t            <Text style={styles.tagline}>\n61\t              Managed protection, in your pocket.\n62\t            </Text>\n63\t          </View>\n64\t\n65\t          {/* Badge */}\n66\t          <View style={styles.badgeRow}>\n67\t            <View style={styles.badge}>\n68\t              <View style={styles.badgeDot} />\n69\t              <Text style={styles.badgeText}>SECURE LOGIN</Text>\n70\t            </View>\n71\t          </View>\n72\t\n73\t          <Text style={styles.title}>Welcome Back</Text>\n74\t          <Text style={styles.subtitle}>\n75\t            Sign in to your Senturi dashboard\n76\t          </Text>\n77\t\n78\t          {/* Email field */}\n79\t          <Text style={styles.label}>Email</Text>\n80\t          <View style={styles.inputWrap}>\n81\t            <Ionicons\n82\t              name=\"mail-outline\"\n83\t              size={18}\n84\t              color=\"#94a3b8\"\n85\t              style={styles.inputIcon}\n86\t            />\n87\t            <TextInput\n88\t              value={email}\n89\t              onChangeText={setEmail}\n90\t              placeholder=\"you@company.com\"\n91\t              placeholderTextColor=\"#94a3b8\"\n92\t              autoCapitalize=\"none\"\n93\t              keyboardType=\"email-address\"\n94\t              autoComplete=\"email\"\n95\t              textContentType=\"emailAddress\"\n96\t              style={styles.textInput}\n97\t            />\n98\t          </View>\n99\t\n100\t          {/* Password field */}\n101\t          <Text style={styles.label}>Password</Text>\n102\t          <View style={styles.inputWrap}>\n103\t            <Ionicons\n104\t              name=\"lock-closed-outline\"\n105\t              size={18}\n106\t              color=\"#94a3b8\"\n107\t              style={styles.inputIcon}\n108\t            />\n109\t            <TextInput\n110\t              value={password}\n111\t              onChangeText={setPassword}\n112\t              placeholder=\"Enter your password\"\n113\t              placeholderTextColor=\"#94a3b8\"\n114\t              secureTextEntry={secureEntry}\n115\t              autoComplete=\"password\"\n116\t              textContentType=\"password\"\n117\t              style={styles.textInput}\n118\t            />\n119\t            <Pressable\n120\t              onPress={() => setSecureEntry(!secureEntry)}\n121\t              hitSlop={8}\n122\t            >\n123\t              <Ionicons\n124\t                name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n125\t                size={20}\n126\t                color=\"#94a3b8\"\n127\t              />\n128\t            </Pressable>\n129\t          </View>\n130\t\n131\t          {/* Error */}\n132\t          {error ? (\n133\t            <View style={styles.errorRow}>\n134\t              <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n135\t              <Text style={styles.errorText}>{error}</Text>\n136\t            </View>\n137\t          ) : null}\n138\t\n139\t          {/* Sign in button */}\n140\t          <LinearGradient\n141\t            colors={gradients.brand}\n142\t            start={{ x: 0, y: 0 }}\n143\t            end={{ x: 1, y: 0 }}\n144\t            style={styles.btnGradient}\n145\t          >\n146\t            <Pressable\n147\t              onPress={onSubmit}\n148\t              disabled={loading}\n149\t              style={({ pressed }) => [\n150\t                styles.btn,\n151\t                { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n152\t              ]}\n153\t            >\n154\t              {loading ? (\n155\t                <ActivityIndicator color=\"#fff\" />\n156\t              ) : (\n157\t                <Text style={styles.btnText}>Sign in</Text>\n158\t              )}\n159\t            </Pressable>\n160\t          </LinearGradient>\n161\t\n162\t          <Text style={styles.helper}>\n163\t            Accounts are provisioned by Senturi.{'\\n'}Contact your\n164\t            administrator if you can't sign in.\n165\t          </Text>\n166\t        </ScrollView>\n167\t      </KeyboardAvoidingView>\n168\t    </SafeAreaView>\n169\t  );\n170\t}\n171\t\n172\tconst styles = StyleSheet.create({\n173\t  safe: { flex: 1, backgroundColor: '#ffffff' },\n174\t  scroll: {\n175\t    flexGrow: 1,\n176\t    justifyContent: 'center',\n177\t    padding: spacing.xl,\n178\t    paddingHorizontal: spacing.xxl,\n179\t    backgroundColor: '#ffffff',\n180\t  },\n181\t\n182\t  /* Brand */\n183\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n184\t  logo: { width: 100, height: 100, marginBottom: spacing.md },\n185\t  tagline: {\n186\t    fontSize: 14,\n187\t    fontWeight: '500',\n188\t    color: '#94a3b8',\n189\t    letterSpacing: 0.3,\n190\t  },\n191\t\n192\t  /* Badge */\n193\t  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n194\t  badge: {\n195\t    flexDirection: 'row',\n196\t    alignItems: 'center',\n197\t    backgroundColor: 'rgba(55, 170, 122, 0.08)',\n198\t    borderWidth: 1,\n199\t    borderColor: 'rgba(55, 170, 122, 0.18)',\n200\t    borderRadius: radius.pill,\n201\t    paddingVertical: 5,\n202\t    paddingHorizontal: 14,\n203\t  },\n204\t  badgeDot: {\n205\t    width: 6,\n206\t    height: 6,\n207\t    borderRadius: 3,\n208\t    backgroundColor: colors.primary,\n209\t    marginRight: spacing.sm,\n210\t  },\n211\t  badgeText: {\n212\t    fontSize: 11,\n213\t    fontWeight: '700',\n214\t    color: colors.primary,\n215\t    letterSpacing: 1.2,\n216\t  },\n217\t\n218\t  /* Headings */\n219\t  title: {\n220\t    fontSize: 30,\n221\t    fontWeight: '800',\n222\t    color: colors.textDark,\n223\t    textAlign: 'center',\n224\t    letterSpacing: -0.8,\n225\t  },\n226\t  subtitle: {\n227\t    fontSize: 15,\n228\t    color: '#94a3b8',\n229\t    textAlign: 'center',\n230\t    marginTop: spacing.xs,\n231\t    marginBottom: spacing.xxl,\n232\t    lineHeight: 22,\n233\t  },\n234\t\n235\t  /* Inputs */\n236\t  label: {\n237\t    fontSize: 13,\n238\t    fontWeight: '600',\n239\t    color: colors.textDark,\n240\t    marginBottom: spacing.sm,\n241\t    letterSpacing: 0.2,\n242\t  },\n243\t  inputWrap: {\n244\t    flexDirection: 'row',\n245\t    alignItems: 'center',\n246\t    borderWidth: 1.5,\n247\t    borderColor: '#e2e8f0',\n248\t    borderRadius: radius.md,\n249\t    paddingHorizontal: spacing.lg,\n250\t    height: 52,\n251\t    backgroundColor: '#f8fafc',\n252\t    marginBottom: spacing.lg,\n253\t  },\n254\t  inputIcon: { marginRight: spacing.md },\n255\t  textInput: {\n256\t    flex: 1,\n257\t    fontSize: 15,\n258\t    color: colors.textDark,\n259\t    height: '100%',\n260\t  },\n261\t\n262\t  /* Error */\n263\t  errorRow: {\n264\t    flexDirection: 'row',\n265\t    alignItems: 'center',\n266\t    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n267\t    borderRadius: radius.sm,\n268\t    padding: spacing.md,\n269\t    marginBottom: spacing.lg,\n270\t  },\n271\t  errorText: {\n272\t    fontSize: 13,\n273\t    color: colors.danger,\n274\t    marginLeft: spacing.sm,\n275\t    flex: 1,\n276\t  },\n277\t\n278\t  /* Button */\n279\t  btnGradient: {\n280\t    borderRadius: radius.md,\n281\t    ...shadow.button,\n282\t  },\n283\t  btn: {\n284\t    height: 54,\n285\t    alignItems: 'center',\n286\t    justifyContent: 'center',\n287\t  },\n288\t  btnText: {\n289\t    fontSize: 16,\n290\t    fontWeight: '700',\n291\t    color: '#ffffff',\n292\t    letterSpacing: 0.3,\n293\t  },\n294\t\n295\t  /* Helper */\n296\t  helper: {\n297\t    fontSize: 12,\n298\t    color: '#94a3b8',\n299\t    textAlign: 'center',\n300\t    marginTop: spacing.xl,\n301\t    lineHeight: 18,\n302\t  },\n303\t});\n304\t"}]},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"e3d89e28-39fa-4458-aaf8-b47786039278","timestamp":"2026-06-14T21:33:56.775Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/senturi/core/senturi-mobile/app/(auth)/login.jsx","content":"// app/(auth)/login.jsx — clean white login with dark brand mark.\nimport { useState } from 'react';\nimport {\n  View,\n  Text,\n  Image,\n  TextInput,\n  StyleSheet,\n  KeyboardAvoidingView,\n  Platform,\n  ScrollView,\n  Pressable,\n  ActivityIndicator,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { colors, gradients, spacing, radius, shadow } from '../../src/theme/theme';\n\nconst brandLogo = require('../../assets/brand.png');\n\nexport default function Login() {\n  const { login } = useAuth();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [error, setError] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [secureEntry, setSecureEntry] = useState(true);\n\n  const onSubmit = async () => {\n    setError(null);\n    if (!email || !password) {\n      setError('Enter your email and password.');\n      return;\n    }\n    setLoading(true);\n    try {\n      await login(email.trim(), password);\n    } catch (err) {\n      setError(err?.message || 'Login failed. Check your credentials.');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <SafeAreaView style={styles.safe}>\n      <KeyboardAvoidingView\n        style={{ flex: 1 }}\n        behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n      >\n        <ScrollView\n          contentContainerStyle={styles.scroll}\n          keyboardShouldPersistTaps=\"handled\"\n        >\n          {/* Brand */}\n          <View style={styles.brandWrap}>\n            <Image source={brandLogo} style={styles.logo} resizeMode=\"contain\" />\n            <Text style={styles.tagline}>\n              Managed protection, in your pocket.\n            </Text>\n          </View>\n\n          {/* Badge */}\n          <View style={styles.badgeRow}>\n            <View style={styles.badge}>\n              <View style={styles.badgeDot} />\n              <Text style={styles.badgeText}>SECURE LOGIN</Text>\n            </View>\n          </View>\n\n          <Text style={styles.title}>Welcome Back</Text>\n          <Text style={styles.subtitle}>\n            Sign in to your Senturi dashboard\n          </Text>\n\n          {/* Email field */}\n          <Text style={styles.label}>Email</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"mail-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={email}\n              onChangeText={setEmail}\n              placeholder=\"you@company.com\"\n              placeholderTextColor=\"#94a3b8\"\n              autoCapitalize=\"none\"\n              keyboardType=\"email-address\"\n              autoComplete=\"email\"\n              textContentType=\"emailAddress\"\n              style={styles.textInput}\n            />\n          </View>\n\n          {/* Password field */}\n          <Text style={styles.label}>Password</Text>\n          <View style={styles.inputWrap}>\n            <Ionicons\n              name=\"lock-closed-outline\"\n              size={18}\n              color=\"#94a3b8\"\n              style={styles.inputIcon}\n            />\n            <TextInput\n              value={password}\n              onChangeText={setPassword}\n              placeholder=\"Enter your password\"\n              placeholderTextColor=\"#94a3b8\"\n              secureTextEntry={secureEntry}\n              autoComplete=\"password\"\n              textContentType=\"password\"\n              style={styles.textInput}\n            />\n            <Pressable\n              onPress={() => setSecureEntry(!secureEntry)}\n              hitSlop={8}\n            >\n              <Ionicons\n                name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n                size={20}\n                color=\"#94a3b8\"\n              />\n            </Pressable>\n          </View>\n\n          {/* Error */}\n          {error ? (\n            <View style={styles.errorRow}>\n              <Ionicons name=\"alert-circle\" size={16} color={colors.danger} />\n              <Text style={styles.errorText}>{error}</Text>\n            </View>\n          ) : null}\n\n          {/* Sign in button */}\n          <LinearGradient\n            colors={gradients.brand}\n            start={{ x: 0, y: 0 }}\n            end={{ x: 1, y: 0 }}\n            style={styles.btnGradient}\n          >\n            <Pressable\n              onPress={onSubmit}\n              disabled={loading}\n              style={({ pressed }) => [\n                styles.btn,\n                { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n              ]}\n            >\n              {loading ? (\n                <ActivityIndicator color=\"#fff\" />\n              ) : (\n                <Text style={styles.btnText}>Sign in</Text>\n              )}\n            </Pressable>\n          </LinearGradient>\n\n          <Text style={styles.helper}>\n            Accounts are provisioned by Senturi.{'\\n'}Contact your\n            administrator if you can't sign in.\n          </Text>\n        </ScrollView>\n      </KeyboardAvoidingView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  safe: { flex: 1, backgroundColor: '#ffffff' },\n  scroll: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    padding: spacing.xl,\n    paddingHorizontal: spacing.xxl,\n    backgroundColor: '#ffffff',\n  },\n\n  /* Brand */\n  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n  logo: { width: 100, height: 100, marginBottom: spacing.md },\n  tagline: {\n    fontSize: 14,\n    fontWeight: '500',\n    color: '#94a3b8',\n    letterSpacing: 0.3,\n  },\n\n  /* Badge */\n  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n  badge: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(55, 170, 122, 0.08)',\n    borderWidth: 1,\n    borderColor: 'rgba(55, 170, 122, 0.18)',\n    borderRadius: radius.pill,\n    paddingVertical: 5,\n    paddingHorizontal: 14,\n  },\n  badgeDot: {\n    width: 6,\n    height: 6,\n    borderRadius: 3,\n    backgroundColor: colors.primary,\n    marginRight: spacing.sm,\n  },\n  badgeText: {\n    fontSize: 11,\n    fontWeight: '700',\n    color: colors.primary,\n    letterSpacing: 1.2,\n  },\n\n  /* Headings */\n  title: {\n    fontSize: 30,\n    fontWeight: '800',\n    color: colors.textDark,\n    textAlign: 'center',\n    letterSpacing: -0.8,\n  },\n  subtitle: {\n    fontSize: 15,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xs,\n    marginBottom: spacing.xxl,\n    lineHeight: 22,\n  },\n\n  /* Inputs */\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textDark,\n    marginBottom: spacing.sm,\n    letterSpacing: 0.2,\n  },\n  inputWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 52,\n    backgroundColor: '#f8fafc',\n    marginBottom: spacing.lg,\n  },\n  inputIcon: { marginRight: spacing.md },\n  textInput: {\n    flex: 1,\n    fontSize: 15,\n    color: colors.textDark,\n    height: '100%',\n  },\n\n  /* Error */\n  errorRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: 'rgba(225, 64, 110, 0.06)',\n    borderRadius: radius.sm,\n    padding: spacing.md,\n    marginBottom: spacing.lg,\n  },\n  errorText: {\n    fontSize: 13,\n    color: colors.danger,\n    marginLeft: spacing.sm,\n    flex: 1,\n  },\n\n  /* Button */\n  btnGradient: {\n    borderRadius: radius.md,\n    ...shadow.button,\n  },\n  btn: {\n    height: 54,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  btnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: '#ffffff',\n    letterSpacing: 0.3,\n  },\n\n  /* Helper */\n  helper: {\n    fontSize: 12,\n    color: '#94a3b8',\n    textAlign: 'center',\n    marginTop: spacing.xl,\n    lineHeight: 18,\n  },\n});\n","numLines":304,"startLine":1,"totalLines":304}}}
