53\t  return (\n54\t    <View style={styles.root}>\n55\t      {/* ── Video background ── */}\n56\t      <Video\n57\t        ref={videoRef}\n58\t        source={bgVideo}\n59\t        style={styles.bgVideo}\n60\t        resizeMode={ResizeMode.COVER}\n61\t        shouldPlay\n62\t        isLooping\n63\t        isMuted\n64\t        rate={0.8}\n65\t      />\n66\t\n67\t      {/* ── Dark blue / green gradient overlay ── */}\n68\t      <LinearGradient\n69\t        colors={[\n70\t          'rgba(12, 29, 39, 0.96)',\n71\t          'rgba(12, 29, 39, 0.94)',\n72\t          'rgba(12, 29, 39, 0.92)',\n73\t          'rgba(12, 29, 39, 0.94)',\n74\t          'rgba(12, 29, 39, 0.96)',\n75\t        ]}\n76\t        locations={[0, 0.25, 0.5, 0.75, 1]}\n77\t        start={{ x: 0.2, y: 0 }}\n78\t        end={{ x: 0.8, y: 1 }}\n79\t        style={styles.overlay}\n80\t      />\n81\t\n82\t      {/* ── Content ── */}\n83\t      <SafeAreaView style={styles.safe}>\n84\t        <KeyboardAvoidingView\n85\t          style={{ flex: 1 }}\n86\t          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n87\t        >\n88\t          <ScrollView\n89\t            contentContainerStyle={styles.scroll}\n90\t            keyboardShouldPersistTaps=\"handled\"\n91\t          >\n92\t            {/* Brand */}\n93\t            <View style={styles.brandWrap}>\n94\t              <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n95\t              <Text style={styles.tagline}>\n96\t                Managed protection, in your pocket.\n97\t              </Text>\n98\t            </View>\n99\t\n100\t            {/* Badge */}\n101\t            <View style={styles.badgeRow}>\n102\t              <View style={styles.badge}>\n103\t                <View style={styles.badgeDot} />\n104\t                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n105\t              </View>\n106\t            </View>\n107\t\n108\t            <Text style={styles.title}>Welcome Back</Text>\n109\t            <Te