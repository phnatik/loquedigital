n  sm: 8,\n  md: 12,\n  lg: 16,\n  xl: 24,\n  xxl: 32,\n  xxxl: 40,\n};\n\nexport const radius = {\n  xs: 4,\n  sm: 6,        // --border-radius (portal default)\n  md: 10,       // buttons, inputs\n  lg: 16,\n  xl: 20,       // login card, modals\n  pill: 999,\n};\n\nexport const typography = {\n  title: {\n    fontSize: 24,\n    fontWeight: '700',\n    color: colors.text,\n    letterSpacing: -0.5,\n  },\n  heading: {\n    fontSize: 18,\n    fontWeight: '600',\n    color: colors.text,\n  },\n  body: {\n    fontSize: 15,\n    fontWeight: '400',\n    color: colors.text,\n  },\n  label: {\n    fontSize: 13,\n    fontWeight: '600',\n    color: colors.textMuted,\n  },\n  caption: {\n    fontSize: 12,\n    fontWeight: '400',\n    color: colors.textMuted,\n  },\n};\n\nexport const shadow = {\n  card: {\n    shadowColor: '#000',\n    shadowOpacity: 0.01,\n    shadowRadius: 6,\n    shadowOffset: { width: 0, height: 2 },\n    elevation: 1,\n  },\n  elevated: {\n    shadowColor: '#000',\n    shadowOpacity: 0.08,\n    shadowRadius: 20,\n    shadowOffset: { width: 0, height: 10 },\n    elevation: 4,\n  },\n  button: {\n    shadowColor: 'rgba(38, 144, 188, 0.3)',\n    shadowOpacity: 1,\n    shadowRadius: 11.2,\n    shadowOffset: { width: 0, height: 3.2 },\n    elevation: 3,\n  },\n  fab: {\n    shadowColor: '#000',\n    shadowOpacity: 0.25,\n    shadowRadius: 8,\n    shadowOffset: { width: 0, height: 4 },\n    elevation: 6,\n  },\n};\n\nexport default { colors, gradients, spacing, radius, typography, shadow };\n"},"output":"The file /Users/andrewprice/senturi/core/senturi-mobile/src/theme/theme.js has been updated successfully. (file state is current in your context — no need to Read it back)"}}
