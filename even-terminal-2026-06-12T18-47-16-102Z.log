[2026-06-12 19:01:57] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011LnfG4fe88MpJQGhhEM7X6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WHUDGBTYjQeTZgY1EL8z1Y","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/profile.jsx","content":"// app/(app)/profile.jsx — account details + logout.\n// Styled to match portal's profile / settings page.\nimport { View, Text, ScrollView, StyleSheet } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { Card, Button } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nfunction Row({ icon, label, value }) {\n  return (\n    <View style={styles.row}>\n      <View style={styles.rowIconWrap}>\n        <Ionicons name={icon} size={16} color={colors.secondary} />\n      </View>\n      <Text style={styles.rowLabel}>{label}</Text>\n      <Text style={styles.rowValue} numberOfLines={1}>\n        {value || '—'}\n      </Text>\n    </View>\n  );\n}\n\nexport default function Profile() {\n  const { user, senturiUser, membership, logout } = useAuth();\n\n  const fullName = [senturiUser?.first_name, senturiUser?.last_name]\n    .filter(Boolean)\n    .join(' ');\n  const initials = (fullName || senturiUser?.email || 'S')\n    .split(' ')\n    .map((p) => p[0])\n    .join('')\n    .slice(0, 2)\n    .toUpperCase();\n\n  return (\n    <ScrollView style={styles.container} contentContainerStyle={styles.content}>\n      <View style={styles.avatarWrap}>\n        <LinearGradient\n          colors={gradients.brand}\n          start={{ x: 0, y: 0 }}\n          end={{ x: 1, y: 1 }}\n          style={styles.avatar}\n        >\n          <Text style={styles.avatarText}>{initials}</Text>\n        </LinearGradient>\n        <Text style={styles.name}>{fullName || 'Senturi user'}</Text>\n        <Text style={styles.email}>{senturiUser?.email || user?.email}</Text>\n      </View>\n\n      <Card>\n        <Text style={styles.cardTitle}>Account</Text>\n        <Row icon=\"business-outline\" label=\"Client\" value={membership?.client_name} />\n        <Row icon=\"ribbon-outline\" label=\"Role\" value={membership?.role} />\n        <Row icon=\"pulse-outline\" label=\"Status\" value={senturiUser?.status} />\n        <Row icon=\"call-outline\" label=\"Phone\" value={senturiUser?.phone} />\n      </Card>\n\n      <Card style={{ marginTop: spacing.lg }}>\n        <Text style={styles.cardTitle}>Technical</Text>\n        <Row\n          icon=\"key-outline\"\n          label=\"SuperOps acct\"\n          value={membership?.superops_account_id}\n        />\n        <Row icon=\"finger-print-outline\" label=\"Appwrite ID\" value={user?.$id} />\n      </Card>\n\n      <Button\n        title=\"Log out\"\n        variant=\"danger\"\n        onPress={logout}\n        style={{ marginTop: spacing.xl }}\n      />\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  content: { padding: spacing.lg, paddingBottom: spacing.xxl },\n  avatarWrap: { alignItems: 'center', marginVertical: spacing.xl },\n  avatar: {\n    width: 80,\n    height: 80,\n    borderRadius: 40,\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginBottom: spacing.md,\n    ...shadow.button,\n  },\n  avatarText: { color: colors.textInverse, fontSize: 28, fontWeight: '800' },\n  name: { ...typography.title },\n  email: { ...typography.caption, marginTop: spacing.xs },\n  cardTitle: {\n    ...typography.label,\n    textTransform: 'uppercase',\n    letterSpacing: 0.5,\n    marginBottom: spacing.lg,\n  },\n  row: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    paddingVertical: spacing.md,\n    borderBottomWidth: 1,\n    borderBottomColor: colors.border,\n  },\n  rowIconWrap: {\n    width: 32,\n    height: 32,\n    borderRadius: radius.sm,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  rowLabel: { ...typography.body, color: colors.textMuted, flex: 1 },\n  rowValue: {\n    ...typography.body,\n    fontWeight: '600',\n    flex: 1,\n    textAlign: 'right',\n  },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1797,"cache_read_input_tokens":73875,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1797},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"f9a68f3c-19c3-4967-8e58-a49ebf4bd8f3"}
