failed. Check your credentials.');\n48\t    } finally {\n49\t      setLoading(false);\n50\t    }\n51\t  };\n52\t\n53\t  return (\n54\t    <View style={styles.root}>\n55\t      {/* ── Video background ── */}\n56\t      <Video\n57\t        ref={videoRef}\n58\t        source={bgVideo}\n59\t        style={styles.bgVideo}\n60\t        resizeMode={ResizeMode.COVER}\n61\t        shouldPlay\n62\t        isLooping\n63\t        isMuted\n64\t        rate={0.8}\n65\t      />\n66\t\n67\t      {/* ── Dark blue / green gradient overlay ── */}\n68\t      <LinearGradient\n69\t        colors={[\n70\t          'rgba(12, 29, 39, 0.96)',\n71\t          'rgba(12, 29, 39, 0.94)',\n72\t          'rgba(12, 29, 39, 0.92)',\n73\t          'rgba(12, 29, 39, 0.94)',\n74\t          'rgba(12, 29, 39, 0.96)',\n75\t        ]}\n76\t        locations={[0, 0.25, 0.5, 0.75, 1]}\n77\t        start={{ x: 0.2, y: 0 }}\n78\t        end={{ x: 0.8, y: 1 }}\n79\t        style={styles.overlay}\n80\t      />\n81\t\n82\t      {/* ── Content ── */}\n83\t      <SafeAreaView style={styles.safe}>\n84\t        <KeyboardAvoidingView\n85\t          style={{ flex: 1 }}\n86\t          behavior={Platform.OS === 'ios' ? 'padding' : undefined}\n87\t        >\n88\t          <ScrollView\n89\t            contentContainerStyle={styles.scroll}\n90\t            keyboardShouldPersistTaps=\"handled\"\n91\t          >\n92\t            {/* Brand */}\n93\t            <View style={styles.brandWrap}>\n94\t              <Image source={brandWhite} style={styles.logo} resizeMode=\"contain\" />\n95\t              <Text style={styles.tagline}>\n96\t                Managed protection, in your pocket.\n97\t              </Text>\n98\t            </View>\n99\t\n100\t            {/* Badge */}\n101\t            <View style={styles.badgeRow}>\n102\t              <View style={styles.badge}>\n103\t                <View style={styles.badgeDot} />\n104\t                <Text style={styles.badgeText}>SECURE LOGIN</Text>\n105\t              </View>\n106\t            </View>\n107\t\n108\t            <Text style={styles.title}>Welcome Back</Text>\n109\t            <Text style={styles.subtitle}>\n110\t              Sign in to your Senturi dashboard\n111\t            </Text>\n112\t\n113\t            {/* Email field */}\n114\t            <Text style={styles.label}>Email</Text>\n115\t            <View style={styles.inputWrap}>\n116\t              <Ionicons\n117\t                name=\"mail-outline\"\n118\t                size={18}\n119\t                color=\"rgba(255,255,255,0.5)\"\n120\t                style={styles.inputIcon}\n121\t              />\n122\t              <TextInput\n123\t                value={email}\n124\t                onChangeText={setEmail}\n125\t                placeholder=\"you@company.com\"\n126\t                placeholderTextColor=\"rgba(255,255,255,0.35)\"\n127\t                autoCapitalize=\"none\"\n128\t                keyboardType=\"email-address\"\n129\t                autoComplete=\"email\"\n130\t                textContentType=\"emailAddress\"\n131\t                style={styles.textInput}\n132\t              />\n133\t            </View>\n134\t\n135\t            {/* Password field */}\n136\t            <Text style={styles.label}>Password</Text>\n137\t            <View style={styles.inputWrap}>\n138\t              <Ionicons\n139\t                name=\"lock-closed-outline\"\n140\t                size={18}\n141\t                color=\"rgba(255,255,255,0.5)\"\n142\t                style={styles.inputIcon}\n143\t              />\n144\t              <TextInput\n145\t                value={password}\n146\t                onChangeText={setPassword}\n147\t                placeholder=\"Enter your password\"\n148\t                placeholderTextColor=\"rgba(255,255,255,0.35)\"\n149\t                secureTextEntry={secureEntry}\n150\t                autoComplete=\"password\"\n151\t                textContentType=\"password\"\n152\t                style={styles.textInput}\n153\t              />\n154\t              <Pressable\n155\t                onPress={() => setSecureEntry(!secureEntry)}\n156\t                hitSlop={8}\n157\t              >\n158\t                <Ionicons\n159\t                  name={secureEntry ? 'eye-off-outline' : 'eye-outline'}\n160\t                  size={20}\n161\t                  color=\"rgba(255,255,255,0.5)\"\n162\t                />\n163\t              </Pressable>\n164\t            </View>\n165\t\n166\t            {/* Error */}\n167\t            {error ? (\n168\t              <View style={styles.errorRow}>\n169\t                <Ionicons name=\"alert-circle\" size={16} color=\"#ff6b8a\" />\n170\t                <Text style={styles.errorText}>{error}</Text>\n171\t              </View>\n172\t            ) : null}\n173\t\n174\t            {/* Sign in button */}\n175\t            <LinearGradient\n176\t              colors={gradients.brand}\n177\t              start={{ x: 0, y: 0 }}\n178\t              end={{ x: 1, y: 0 }}\n179\t              style={styles.btnGradient}\n180\t            >\n181\t              <Pressable\n182\t                onPress={onSubmit}\n183\t                disabled={loading}\n184\t                style={({ pressed }) => [\n185\t                  styles.btn,\n186\t                  { opacity: loading ? 0.7 : pressed ? 0.85 : 1 },\n187\t                ]}\n188\t              >\n189\t                {loading ? (\n190\t                  <ActivityIndicator color=\"#fff\" />\n191\t                ) : (\n192\t                  <Text style={styles.btnText}>Sign in</Text>\n193\t                )}\n194\t              </Pressable>\n195\t            </LinearGradient>\n196\t\n197\t            <Text style={styles.helper}>\n198\t              Accounts are provisioned by Senturi.{'\\n'}Contact your\n199\t              administrator if you can't sign in.\n200\t            </Text>\n201\t          </ScrollView>\n202\t        </KeyboardAvoidingView>\n203\t      </SafeAreaView>\n204\t    </View>\n205\t  );\n206\t}\n207\t\n208\tconst styles = StyleSheet.create({\n209\t  root: { flex: 1, backgroundColor: colors.ink },\n210\t\n211\t  /* Video background */\n212\t  bgVideo: {\n213\t    position: 'absolute',\n214\t    top: 0,\n215\t    left: 0,\n216\t    width: SCREEN_W,\n217\t    height: SCREEN_H,\n218\t  },\n219\t\n220\t  /* Gradient overlay */\n221\t  overlay: {\n222\t    ...StyleSheet.absoluteFillObject,\n223\t  },\n224\t\n225\t  /* Content layer */\n226\t  safe: { flex: 1 },\n227\t  scroll: {\n228\t    flexGrow: 1,\n229\t    justifyContent: 'center',\n230\t    padding: spacing.xl,\n231\t    paddingHorizontal: spacing.xxl,\n232\t  },\n233\t\n234\t  /* Brand */\n235\t  brandWrap: { alignItems: 'center', marginBottom: spacing.xxxl },\n236\t  logo: { width: 110, height: 110, marginBottom: spacing.md },\n237\t  tagline: {\n238\t    fontSize: 14,\n239\t    fontWeight: '500',\n240\t    color: 'rgba(255,255,255,0.6)',\n241\t    letterSpacing: 0.3,\n242\t  },\n243\t\n244\t  /* Badge */\n245\t  badgeRow: { alignItems: 'center', marginBottom: spacing.xl },\n246\t  badge: {\n247\t    flexDirection: 'row',\n248\t    alignItems: 'center',\n249\t    backgroundColor: 'rgba(55, 170, 122, 0.15)',\n250\t    borderWidth: 1,\n251\t    borderColor: 'rgba(55, 170, 122, 0.3)',\n252\t    borderRadius: radius.pill,\n253\t    paddingVertical: 5,\n254\t    paddingHorizontal: 14,\n255\t  },\n256\t  badgeDot: {\n257\t    width: 6,\n258\t    height: 6,\n259\t    borderRadius: 3,\n260\t    backgroundColor: colors.primary,\n261\t    marginRight: spacing.sm,\n262\t  },\n263\t  badgeText: {\n264\t    fontSize: 11,\n265\t    fontWeight: '700',\n266\t    color: colors.primary,\n267\t    letterSpacing: 1.2,\n268\t  },\n269\t\n270\t  /* Headings */\n271\t  title: {\n272\t    fontSize: 30,\n273\t    fontWeight: '800',\n274\t    color: '#ffffff',\n275\t    textAlign: 'center',\n276\t    letterSpacing: -0.8,\n277\t  },\n278\t  subtitle: {\n279\t    fontSize: 15,\n280\t    color: 'rgba(255,255,255,0.6)',\n281\t    textAlign