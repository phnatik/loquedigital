[2026-06-14 16:27:50] [claude-sdk] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01BiPGbwStgkHRNVGGaGoEA2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BeFHxZTAANTct8msKcQzc8","name":"Write","input":{"file_path":"/Users/andrewprice/senturi/core/senturi-mobile/app/(app)/dashboard.jsx","content":"// app/(app)/dashboard.jsx — device/asset list with hero card + search.\nimport { useCallback, useMemo, useState } from 'react';\nimport {\n  View,\n  Text,\n  TextInput,\n  FlatList,\n  Pressable,\n  RefreshControl,\n  StyleSheet,\n} from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { useRouter } from 'expo-router';\nimport { useFocusEffect } from '@react-navigation/native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useAuth } from '../../src/features/auth/AuthProvider';\nimport { getAssetList } from '../../src/services/superopsService';\nimport { Card, StatusPill, Loader, EmptyState } from '../../src/components/ui';\nimport { colors, gradients, spacing, typography, radius, shadow } from '../../src/theme/theme';\n\nfunction extractAssets(payload) {\n  return (\n    payload?.data?.getAssetList?.assets ??\n    payload?.getAssetList?.assets ??\n    payload?.assets ??\n    []\n  );\n}\n\nexport default function Dashboard() {\n  const { superopsAccountId, membership, loadingMembership } = useAuth();\n  const router = useRouter();\n\n  const [assets, setAssets] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [refreshing, setRefreshing] = useState(false);\n  const [error, setError] = useState(null);\n  const [search, setSearch] = useState('');\n\n  const load = useCallback(async () => {\n    if (!superopsAccountId) {\n      setAssets([]);\n      setLoading(false);\n      return;\n    }\n    setError(null);\n    try {\n      const res = await getAssetList(superopsAccountId);\n      setAssets(extractAssets(res));\n    } catch (err) {\n      setError(err?.message || 'Could not load your devices.');\n    } finally {\n      setLoading(false);\n      setRefreshing(false);\n    }\n  }, [superopsAccountId]);\n\n  useFocusEffect(useCallback(() => { load(); }, [load]));\n\n  const onRefresh = () => { setRefreshing(true); load(); };\n\n  const filtered = useMemo(() => {\n    if (!search.trim()) return assets;\n    const q = search.toLowerCase();\n    return assets.filter((a) => (a.name || '').toLowerCase().includes(q));\n  }, [assets, search]);\n\n  if ((loading || loadingMembership) && !refreshing)\n    return <Loader label=\"Loading devices…\" />;\n\n  const onlineCount = assets.filter(\n    (a) => (a.status ?? 'online').toString().toLowerCase() !== 'offline',\n  ).length;\n\n  const renderItem = ({ item }) => {\n    const online =\n      (item.status ?? 'online').toString().toLowerCase() !== 'offline';\n    return (\n      <Pressable\n        onPress={() => router.push(`/asset/${item.assetId ?? item.id}`)}\n        style={({ pressed }) => [{ opacity: pressed ? 0.7 : 1 }]}\n      >\n        <Card style={styles.assetCard}>\n          <View style={styles.assetIcon}>\n            <Ionicons name=\"desktop-outline\" size={20} color={colors.secondary} />\n          </View>\n          <View style={{ flex: 1 }}>\n            <Text style={styles.assetName} numberOfLines={1}>\n              {item.name || 'Unnamed device'}\n            </Text>\n            <StatusPill online={online} />\n          </View>\n          <Ionicons name=\"chevron-forward\" size={18} color={colors.textMuted} />\n        </Card>\n      </Pressable>\n    );\n  };\n\n  return (\n    <View style={styles.container}>\n      <FlatList\n        data={filtered}\n        keyExtractor={(item, idx) => String(item.assetId ?? item.id ?? idx)}\n        renderItem={renderItem}\n        contentContainerStyle={styles.listContent}\n        refreshControl={\n          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={colors.primary} />\n        }\n        ListHeaderComponent={\n          <>\n            {/* Hero card */}\n            <LinearGradient\n              colors={gradients.brand}\n              start={{ x: 0, y: 0 }}\n              end={{ x: 1, y: 1 }}\n              style={styles.hero}\n            >\n              <Text style={styles.heroTitle}>\n                {membership?.client_name || 'Your Devices'}\n              </Text>\n              <Text style={styles.heroSubtitle}>Device overview</Text>\n              <View style={styles.statsRow}>\n                <View style={styles.stat}>\n                  <Text style={styles.statNum}>{assets.length}</Text>\n                  <Text style={styles.statLabel}>Total</Text>\n                </View>\n                <View style={styles.statDivider} />\n                <View style={styles.stat}>\n                  <Text style={styles.statNum}>{onlineCount}</Text>\n                  <Text style={styles.statLabel}>Online</Text>\n                </View>\n                <View style={styles.statDivider} />\n                <View style={styles.stat}>\n                  <Text style={styles.statNum}>\n                    {assets.length - onlineCount}\n                  </Text>\n                  <Text style={styles.statLabel}>Offline</Text>\n                </View>\n              </View>\n            </LinearGradient>\n\n            {/* Search */}\n            <View style={styles.searchWrap}>\n              <Ionicons name=\"search\" size={18} color=\"#94a3b8\" style={{ marginRight: spacing.sm }} />\n              <TextInput\n                value={search}\n                onChangeText={setSearch}\n                placeholder=\"Search devices…\"\n                placeholderTextColor=\"#94a3b8\"\n                style={styles.searchInput}\n                returnKeyType=\"search\"\n              />\n              {search ? (\n                <Pressable onPress={() => setSearch('')} hitSlop={8}>\n                  <Ionicons name=\"close-circle\" size={18} color=\"#94a3b8\" />\n                </Pressable>\n              ) : null}\n            </View>\n          </>\n        }\n        ListEmptyComponent={\n          error ? (\n            <EmptyState title=\"Something went wrong\" subtitle={error} />\n          ) : search ? (\n            <EmptyState title=\"No matches\" subtitle={`No devices matching \"${search}\"`} />\n          ) : (\n            <EmptyState title=\"No devices yet\" subtitle=\"Installed devices will appear here.\" />\n          )\n        }\n      />\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: { flex: 1, backgroundColor: colors.background },\n  listContent: { padding: spacing.lg, paddingBottom: spacing.xxl },\n\n  /* Hero */\n  hero: {\n    borderRadius: radius.md,\n    padding: spacing.xl,\n    marginBottom: spacing.lg,\n    ...shadow.button,\n  },\n  heroTitle: {\n    fontSize: 22,\n    fontWeight: '800',\n    color: '#fff',\n    letterSpacing: -0.5,\n  },\n  heroSubtitle: {\n    fontSize: 13,\n    fontWeight: '500',\n    color: 'rgba(255,255,255,0.7)',\n    marginTop: 2,\n  },\n  statsRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginTop: spacing.xl,\n    backgroundColor: 'rgba(255,255,255,0.15)',\n    borderRadius: radius.sm,\n    paddingVertical: spacing.md,\n  },\n  stat: { flex: 1, alignItems: 'center' },\n  statNum: { fontSize: 22, fontWeight: '800', color: '#fff' },\n  statLabel: { fontSize: 11, fontWeight: '600', color: 'rgba(255,255,255,0.8)', marginTop: 2, textTransform: 'uppercase', letterSpacing: 0.5 },\n  statDivider: { width: 1, height: 28, backgroundColor: 'rgba(255,255,255,0.25)' },\n\n  /* Search */\n  searchWrap: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    backgroundColor: '#fff',\n    borderWidth: 1.5,\n    borderColor: '#e2e8f0',\n    borderRadius: radius.md,\n    paddingHorizontal: spacing.lg,\n    height: 46,\n    marginBottom: spacing.lg,\n  },\n  searchInput: { flex: 1, fontSize: 15, color: colors.textDark, height: '100%' },\n\n  /* Cards */\n  assetCard: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: spacing.md,\n    paddingVertical: spacing.lg,\n    paddingHorizontal: spacing.lg,\n  },\n  assetIcon: {\n    width: 44,\n    height: 44,\n    borderRadius: radius.md,\n    backgroundColor: 'rgba(38, 144, 188, 0.08)',\n    alignItems: 'center',\n    justifyContent: 'center',\n    marginRight: spacing.md,\n  },\n  assetName: { ...typography.heading, fontSize: 16, marginBottom: spacing.xs },\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":454,"cache_read_input_tokens":153893,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":454},"output_tokens":27,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ab312fcf-52d9-4bfd-b9f5-2b71e9f3b92d","uuid":"9f300b48-08ff-4867-8114-5a1ee8d3009e"}
