[2026-06-17 13:23:54] [claude-sdk] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VVS8Ud5TPq174efpbt1fXC","type":"tool_result","content":"1\t---\n2\t// Shared site chrome (top bar + nav). Ported from the original partials.js.\n3\tinterface Props {\n4\t  /** Active page id (matches the old `data-page`). */\n5\t  page?: string;\n6\t}\n7\t\n8\tconst { page = '' } = Astro.props;\n9\t\n10\tconst NAV_ITEMS = [\n11\t  { id: 'home', label: 'Home', href: 'index.html' },\n12\t  { id: 'about', label: 'About Us', href: 'about.html' },\n13\t  { id: 'descriptions', label: 'Class Descriptions', href: 'class-descriptions.html' },\n14\t  { id: 'schedule', label: 'Class Schedule', href: 'class-schedule.html' },\n15\t];\n16\t\n17\tconst MORE_ITEMS = [\n18\t  { id: 'requirements', label: 'State Requirements', href: 'state-requirements.html' },\n19\t  { id: 'policies', label: 'Classroom Policies', href: 'classroom-policies.html' },\n20\t  { id: 'resources', label: 'Resources', href: 'resources.html' },\n21\t  { id: 'pricing', label: 'Pricing', href: 'pricing.html' },\n22\t  { id: 'contact', label: 'Contact Us', href: 'contact.html' },\n23\t  { id: 'privacy', label: 'Privacy Policy', href: 'privacy.html' },\n24\t];\n25\t\n26\tconst isMoreActive = MORE_ITEMS.some((i) => i.id === page);\n27\t---\n28\t\n29\t<div class=\"topbar\">\n30\t  <div class=\"container\">\n31\t    <div class=\"inner\">\n32\t      <div class=\"left\">\n33\t        <span><span class=\"dot\"></span>BAR-Certified Provider · BUREAU OF AUTOMOTIVE REPAIR</span>\n34\t      </div>\n35\t      <div class=\"right\">\n36\t        <a href=\"class-schedule.html\">View Schedule</a>\n37\t        <span>·</span>\n38\t        <a href=\"mailto:fastsmogtraining@gmail.com\">fastsmogtraining@gmail.com</a>\n39\t        <span>·</span>\n40\t        <a href=\"tel:7608407954\">(760) 840-7954</a>\n41\t      </div>\n42\t    </div>\n43\t  </div>\n44\t</div>\n45\t\n46\t<header class=\"nav\">\n47\t  <div class=\"container\">\n48\t    <div class=\"inner\">\n49\t      <a href=\"index.html\" class=\"logo\" aria-label=\"F.A.S.T. Smog Training home\">\n50\t        <img class=\"logo-img\" src=\"/fast-smog-logo.png\" width=\"200\" height=\"98\" alt=\"F.A.S.T. Smog Training\" />\n51\t      </a>\n52\t      <ul class=\"nav-list\">\n53\t        {\n54\t          NAV_ITEMS.map((i) => (\n55\t            <li>\n56\t              <a href={i.href} class={i.id === page ? 'active' : undefined}>\n57\t                {i.label}\n58\t              </a>\n59\t            </li>\n60\t          ))\n61\t        }\n62\t        <li class=\"more-wrap\">\n63\t          <button class:list={['more-btn', { active: isMoreActive }]} type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n64\t            More\n65\t            <svg viewBox=\"0 0 10 6\" width=\"10\" height=\"6\" aria-hidden=\"true\"\n66\t              ><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"></path></svg\n67\t            >\n68\t          </button>\n69\t          <div class=\"more-menu\" role=\"menu\">\n70\t            {\n71\t              MORE_ITEMS.map((i) => (\n72\t                <a href={i.href} class={i.id === page ? 'active' : undefined}>\n73\t                  {i.label}\n74\t                </a>\n75\t              ))\n76\t            }\n77\t          </div>\n78\t        </li>\n79\t      </ul>\n80\t      <div class=\"nav-cta\">\n81\t        <div class=\"nav-call\">\n82\t          <span>Call</span>\n83\t          <strong>(760) 840-7954</strong>\n84\t        </div>\n85\t        <a href=\"class-registration.html\" class=\"btn btn-primary\"\n86\t          >Register\n87\t          <svg class=\"arrow\" viewBox=\"0 0 18 10\" fill=\"none\" aria-hidden=\"true\"\n88\t            ><path d=\"M1 5h16m0 0L13 1m4 4l-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg\n89\t          >\n90\t        </a>\n91\t        <button class=\"mobile-nav-toggle\" type=\"button\" aria-label=\"Open menu\">\n92\t          <svg viewBox=\"0 0 22 14\" width=\"22\" height=\"14\" aria-hidden=\"true\">\n93\t            <path d=\"M0 1h22M0 7h22M0 13h22\" stroke=\"currentColor\" stroke-width=\"1.6\"></path>\n94\t          </svg>\n95\t        </button>\n96\t      </div>\n97\t    </div>\n98\t  </div>\n99\t</header>\n100\t\n101\t<script>\n102\t  // More menu (click to toggle, click-away to close, ESC to close)\n103\t  const moreBtn = document.querySelector('.more-btn');\n104\t  const moreMenu = document.querySelector('.more-menu');\n105\t  if (moreBtn && moreMenu) {\n106\t    const close = () => {\n107\t      moreBtn.setAttribute('aria-expanded', 'false');\n108\t      moreMenu.classList.remove('open');\n109\t    };\n110\t    const open = () => {\n111\t      moreBtn.setAttribute('aria-expanded', 'true');\n112\t      moreMenu.classList.add('open');\n113\t    };\n114\t    moreBtn.addEventListener('click', (e) => {\n115\t      e.stopPropagation();\n116\t      moreMenu.classList.contains('open') ? close() : open();\n117\t    });\n118\t    document.addEventListener('click', (e) => {\n119\t      if (!moreMenu.contains(e.target as Node) && e.target !== moreBtn) close();\n120\t    });\n121\t    document.addEventListener('keydown', (e) => {\n122\t      if (e.key === 'Escape') close();\n123\t    });\n124\t  }\n125\t\n126\t  // Mobile nav toggle\n127\t  const mobBtn = document.querySelector('.mobile-nav-toggle');\n128\t  const navList = document.querySelector('.nav-list');\n129\t  if (mobBtn && navList) {\n130\t    mobBtn.addEventListener('click', () => {\n131\t      navList.classList.toggle('mobile-open');\n132\t    });\n133\t  }\n134\t</script>\n135\t"}]},"parent_tool_use_id":null,"session_id":"888fa852-5011-4157-96f7-fbd1c868f7da","uuid":"0c3c6410-c80c-4754-93bf-0772fcb72c78","timestamp":"2026-06-17T18:23:54.665Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/andrewprice/DEV/brad/fastsmog/src/components/Header.astro","content":"---\n// Shared site chrome (top bar + nav). Ported from the original partials.js.\ninterface Props {\n  /** Active page id (matches the old `data-page`). */\n  page?: string;\n}\n\nconst { page = '' } = Astro.props;\n\nconst NAV_ITEMS = [\n  { id: 'home', label: 'Home', href: 'index.html' },\n  { id: 'about', label: 'About Us', href: 'about.html' },\n  { id: 'descriptions', label: 'Class Descriptions', href: 'class-descriptions.html' },\n  { id: 'schedule', label: 'Class Schedule', href: 'class-schedule.html' },\n];\n\nconst MORE_ITEMS = [\n  { id: 'requirements', label: 'State Requirements', href: 'state-requirements.html' },\n  { id: 'policies', label: 'Classroom Policies', href: 'classroom-policies.html' },\n  { id: 'resources', label: 'Resources', href: 'resources.html' },\n  { id: 'pricing', label: 'Pricing', href: 'pricing.html' },\n  { id: 'contact', label: 'Contact Us', href: 'contact.html' },\n  { id: 'privacy', label: 'Privacy Policy', href: 'privacy.html' },\n];\n\nconst isMoreActive = MORE_ITEMS.some((i) => i.id === page);\n---\n\n<div class=\"topbar\">\n  <div class=\"container\">\n    <div class=\"inner\">\n      <div class=\"left\">\n        <span><span class=\"dot\"></span>BAR-Certified Provider · BUREAU OF AUTOMOTIVE REPAIR</span>\n      </div>\n      <div class=\"right\">\n        <a href=\"class-schedule.html\">View Schedule</a>\n        <span>·</span>\n        <a href=\"mailto:fastsmogtraining@gmail.com\">fastsmogtraining@gmail.com</a>\n        <span>·</span>\n        <a href=\"tel:7608407954\">(760) 840-7954</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n<header class=\"nav\">\n  <div class=\"container\">\n    <div class=\"inner\">\n      <a href=\"index.html\" class=\"logo\" aria-label=\"F.A.S.T. Smog Training home\">\n        <img class=\"logo-img\" src=\"/fast-smog-logo.png\" width=\"200\" height=\"98\" alt=\"F.A.S.T. Smog Training\" />\n      </a>\n      <ul class=\"nav-list\">\n        {\n          NAV_ITEMS.map((i) => (\n            <li>\n              <a href={i.href} class={i.id === page ? 'active' : undefined}>\n                {i.label}\n              </a>\n            </li>\n          ))\n        }\n        <li class=\"more-wrap\">\n          <button class:list={['more-btn', { active: isMoreActive }]} type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">\n            More\n            <svg viewBox=\"0 0 10 6\" width=\"10\" height=\"6\" aria-hidden=\"true\"\n              ><path d=\"M1 1l4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"></path></svg\n            >\n          </button>\n          <div class=\"more-menu\" role=\"menu\">\n            {\n              MORE_ITEMS.map((i) => (\n                <a href={i.href} class={i.id === page ? 'active' : undefined}>\n                  {i.label}\n                </a>\n              ))\n            }\n          </div>\n        </li>\n      </ul>\n      <div class=\"nav-cta\">\n        <div class=\"nav-call\">\n          <span>Call</span>\n          <strong>(760) 840-7954</strong>\n        </div>\n        <a href=\"class-registration.html\" class=\"btn btn-primary\"\n          >Register\n          <svg class=\"arrow\" viewBox=\"0 0 18 10\" fill=\"none\" aria-hidden=\"true\"\n            ><path d=\"M1 5h16m0 0L13 1m4 4l-4 4\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg\n          >\n        </a>\n        <button class=\"mobile-nav-toggle\" type=\"button\" aria-label=\"Open menu\">\n          <svg viewBox=\"0 0 22 14\" width=\"22\" height=\"14\" aria-hidden=\"true\">\n            <path d=\"M0 1h22M0 7h22M0 13h22\" stroke=\"currentColor\" stroke-width=\"1.6\"></path>\n          </svg>\n        </button>\n      </div>\n    </div>\n  </div>\n</header>\n\n<script>\n  // More menu (click to toggle, click-away to close, ESC to close)\n  const moreBtn = document.querySelector('.more-btn');\n  const moreMenu = document.querySelector('.more-menu');\n  if (moreBtn && moreMenu) {\n    const close = () => {\n      moreBtn.setAttribute('aria-expanded', 'false');\n      moreMenu.classList.remove('open');\n    };\n    const open = () => {\n      moreBtn.setAttribute('aria-expanded', 'true');\n      moreMenu.classList.add('open');\n    };\n    moreBtn.addEventListener('click', (e) => {\n      e.stopPropagation();\n      moreMenu.classList.contains('open') ? close() : open();\n    });\n    document.addEventListener('click', (e) => {\n      if (!moreMenu.contains(e.target as Node) && e.target !== moreBtn) close();\n    });\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') close();\n    });\n  }\n\n  // Mobile nav toggle\n  const mobBtn = document.querySelector('.mobile-nav-toggle');\n  const navList = document.querySelector('.nav-list');\n  if (mobBtn && navList) {\n    mobBtn.addEventListener('click', () => {\n      navList.classList.toggle('mobile-open');\n    });\n  }\n</script>\n","numLines":135,"startLine":1,"totalLines":135}}}
