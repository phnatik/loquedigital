---
import { verticals } from '../data/verticals.js';
---
<header id="top">
  <div class="wrap">
    <nav>
      <a class="logo" href="/" aria-label="Loque Agent — home">
        <img src="/img/loque-agent-wordmark.png" alt="Loque Agent" width="2575" height="648" />
      </a>
      <div class="nav-right">
        <div class="nav-links">
          <a href="/#how">How it works</a>
          <a href="/plans">Plans</a>
          <div class="has-drop">
            <button class="drop-toggle" aria-expanded="false" aria-haspopup="true" aria-controls="indDrop">
              Who we build for
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 4 6 8.5 10.5 4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <div class="drop" id="indDrop">
              {verticals.map((v) => (
                <a href={v.path}>{v.nav}<small>{v.navSub}</small></a>
              ))}
            </div>
          </div>
          <a href="/pricing">Pricing</a>
          <a href="/book" class="nav-cta">Book a call</a>
        </div>
        <a class="nav-phone" href="tel:+14352435808" aria-label="Call (435) 243-5808">
          <span class="nav-phone-icon" aria-hidden="true">✆</span>(435) 243-5808
        </a>
        <button class="menu-btn" id="menuBtn" aria-label="Menu">≡</button>
      </div>
    </nav>
  </div>
</header>
