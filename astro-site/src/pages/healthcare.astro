---
// Healthcare — the second page on the twelve-block vertical template.
// Blocks 03, 04 and 06 are new; the rest are ported from the previous
// healthcare.html. This vertical runs the template plus one industry-specific
// credibility block (#why), placed ahead of compliance because it is what
// makes the compliance claim believable. See WEBSITE_PROCESS.md.
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { FORM_KEY } from '../data/site.js';
import GetBack from '../components/GetBack.astro';
import ProofPlaceholder from '../components/ProofPlaceholder.astro';

const getBack = [
  `The administrative day stops competing with the clinical one. You come out of clinic to a queue that has already been sorted, chased and filed rather than one that has been piling up.`,
  `Referral intake logged and acknowledged, payer correspondence filed by payer and claim, portal and vendor noise kept out of the inbox entirely, appointments moved and re-confirmed without a thread.`,
  `A daily digest that leads with anything on a clock — an appeal window, an authorisation expiry, a credentialing date — and a short brief before every outside call so nobody walks in cold.`,
  `Referral sources, authorisation numbers and payer commitments written down as they arrive rather than reconstructed from a thread later. On Custom Reserve, a documented map of how the practice actually moves work.`,
  `Prior authorisations tracked to a decision, denials tracked to an appeal, referrals tracked to a scheduled visit. What a payer owes you gets chased on a schedule instead of whenever somebody remembers.`,
  `Referral through insurance verification through pre-visit packet, running as one flow instead of five reminders. Escalation built around what counts as urgent in your practice, not a generic importance score.`
];

// Image tiles interleaved into the six 'what you get back' cards, so the
// grid reads 3x3 with no row entirely made of type (see ImageSlot).
const gainImages = [
  { pos: 1, id: 'healthcare-gain-hands',
    brief: 'A clinician\'s hands at rest on a desk, sleeves and cuff only. Calm, unhurried.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 5, id: 'healthcare-gain-window',
    brief: 'Daylight through a clinic window onto a clear surface. Soft, warm, nothing clinical in frame.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 6, id: 'healthcare-gain-coat',
    brief: 'A white coat on a hook at the end of the day, shot tight. No badge, no name, nothing legible.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
];
---
<Base
  title="Loque Agent for medical practices — PHI, referrals and payers"
  description="An executive assistant built around how a medical practice actually runs. PHI detected and kept inside the compliant path, referrals and prior authorisations tracked to closure, HIPAA-ready with a signed BAA. Nothing goes out under your name without your approval."
  path="/healthcare"
  vertical="Healthcare"
>

{/* 01 */}
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="/img/hero-bg.jpg" alt="">
    <div class="hero-grid"></div>
    <div class="hero-aurora"></div>
    <div class="hero-cursor" id="heroCursor"></div>
  </div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow reveal"><span class="dot"></span>For practice owners and medical operators</span>
        <h1 class="reveal" style="transition-delay:.06s">HIPAA-ready from the <em>first email</em>.</h1>
        <p class="lead reveal" style="transition-delay:.14s">The administrative load is the part of the day nobody scheduled. We build and run an assistant that detects PHI and keeps it inside the compliant path, tracks referrals and prior authorisations to closure, and hands you back the hours the paperwork was taking.</p>
        <div class="hero-actions reveal" style="transition-delay:.22s">
          <a href="#contact" class="btn btn-primary">Book a call</a>
          <a href="#map" class="btn btn-ghost">See the workflow map</a>
        </div>
      </div>

      <div class="demo" id="demo" aria-hidden="true">
        <span class="demo-badge b1"><span class="d"></span>PHI stays in the compliant path</span>
        <span class="demo-badge b2"><span class="d"></span>Nothing sends unapproved</span>
        <div class="demo-card" id="demoCard">
          <div class="demo-bar">
            <span class="demo-dots"><i></i><i></i><i></i></span>
            <span class="demo-live">Your inbox</span>
          </div>

          <div class="demo-mail">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect><path d="m3.5 6.5 8.5 6 8.5-6"></path></svg>
            <div class="demo-mailtxt">
              <div class="demo-from" id="demoFrom">Incoming</div>
              <div class="demo-subj" id="demoSubj"><span class="caret"></span></div>
            </div>
          </div>

          <div class="demo-tags" id="demoTags"></div>

          <div class="demo-draft" id="demoDraft">
            <div class="dh">
              <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75zM20.7 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75z"/></svg>
              <span>Drafted in your voice</span>
            </div>
            <div class="demo-dtext" id="demoDraftText"></div>
            <div class="demo-approve">
              <span class="demo-abtn ok">Approve &amp; send</span>
              <span class="demo-abtn edit">Edit</span>
              <span class="demo-wait">Waiting on you</span>
            </div>
          </div>

          <div class="demo-foot">
            <span class="demo-surface">Handled as <b id="demoRule">protected health information</b></span>
            <span class="demo-progress" id="demoProg"><i class="on"></i><i></i><i></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>PHI detection</span><span>Referral intake</span><span>Prior authorisation tracking</span><span>Payer correspondence</span><span>Credentialing deadlines</span><span>Signed BAA</span>
      <span>PHI detection</span><span>Referral intake</span><span>Prior authorisation tracking</span><span>Payer correspondence</span><span>Credentialing deadlines</span><span>Signed BAA</span>
    </div>
  </div>
</section>

<ImageSlot
  id="healthcare-world"
  variant="band"
  brief="Quiet clinic corridor between appointments — exam room doors, soft daylight, an empty rolling stool. Calm rather than clinical-cold. No patients, no identifiable faces."
  tone="Sets the world of the practice. Desaturated, film grain, lime accent only if it occurs naturally."
/>


{/* 02 — where the hours go */}
<section id="stakes">
  <div class="sec-head">
    <div class="sec-tag reveal">Where the week goes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The clinical day is short. The administrative day never ends.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">Nobody went into practice to chase a payer for the third time about an authorisation that was approved in the first place. <b>But somebody has to</b>, and it is usually the person who can least afford the hour.</p>
        <p class="body">Referrals arrive and stall. Prior authorisations get denied on a technicality with an appeal window nobody is counting. Payer threads go quiet and stay quiet until someone notices. Credentialing turns up as an emergency because it was filed under admin instead of deadline.</p>
        <p class="body">And every one of those threads may carry protected health information, which rules out most of the tools that would otherwise help.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">Where the day actually goes</div>
        <h4>None of it is clinical work.</h4>
        <p>All of it is work that has to happen, on a schedule somebody else set.</p>
        <ul class="alt-rows">
          <li><span class="v">Referrals</span><span class="l">received, chased, scheduled, acknowledged</span></li>
          <li><span class="v">Payers</span><span class="l">authorisations, denials, appeals, aging</span></li>
          <li><span class="v">Deadlines</span><span class="l">credentialing and licensure, quietly approaching</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<ImageSlot
  id="healthcare-drain"
  variant="feature"
  brief="An empty waiting room after hours, chairs in rows, lights half off. The administrative day continuing after the clinical one ended."
  tone="Cool and still. No patients, no identifiable faces, nothing legible on any signage."
/>


{/* 03 — what you get back */}
<section id="gain" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">What changes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What you get back.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">Six things, in the same six categories on every page of this site. What differs by practice is what they look like &mdash; here is what they look like in a medical practice.</p>
  </div>
  <div class="wrap">
    <GetBack items={getBack} images={gainImages} />
  </div>
</section>

{/* 04 — what goes wrong */}
<section id="risk">
  <div class="sec-head">
    <div class="sec-tag reveal">And the part that isn&rsquo;t about time</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The clock nobody is watching is the expensive one.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">Most administrative mail can wait a day. <b>A few pieces of it are running a countdown</b>, and nothing in an inbox tells you which.</p>
        <p class="body">An appeal window that closes sixty days from a denial letter nobody logged. An authorisation that expires before the procedure gets scheduled. A credentialing packet that surfaces as an emergency because it was filed under admin instead of under deadline.</p>
        <p class="body">None of these announce themselves. They are ordinary-looking messages with a date buried somewhere in the body, and by the time one is visible the option to act on it has usually closed.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">What a missed window costs</div>
        <h4>The money was already earned.</h4>
        <p>This is revenue for work the practice has already done, lost to a date rather than to a decision.</p>
        <ul class="alt-rows">
          <li><span class="v">Denials</span><span class="l">written off because the appeal window closed</span></li>
          <li><span class="v">Referrals</span><span class="l">that went to whoever called the patient back first</span></li>
          <li><span class="v">Credentialing</span><span class="l">a lapse that stops billing altogether</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 05 — the workflow map */}
<section id="map">
  <div class="sec-head">
    <div class="sec-tag reveal">Pre-built workflow map</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What we've already built for medical practices.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">This configuration exists before your first onboarding session. Discovery tunes it to your payers, your referral network and your people — it doesn't start from a blank page.</p>
  </div>
  <div class="wrap">
    <div class="map">
      <div class="map-head">
        <div>Column one<b>What arrives</b></div>
        <div>Column two<b>What the system checks</b></div>
        <div>Column three<b>What happens next</b></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">01</span><div><h4>Anything carrying PHI</h4></div></div>
        <div class="map-cell"><div><h4>PHI detection and containment</h4><p>Protected health information is identified on arrival rather than after it has already moved through the stack.</p></div></div>
        <div class="map-cell act"><div><p>Held inside the HIPAA-ready configuration, under documented retention, deletion and encryption rules per data type.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">02</span><div><h4>A new referral</h4></div></div>
        <div class="map-cell"><div><h4>Referral intake and source tracking</h4><p>The referring practice is identified and recorded, and the enclosed records are matched to the referral.</p></div></div>
        <div class="map-cell act"><div><p>Routed to scheduling with the source logged, so referral source performance is something you can actually report on.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">03</span><div><h4>Prior authorisation and denials</h4></div></div>
        <div class="map-cell"><div><h4>Payer correspondence classification</h4><p>Authorisation requests, approvals and denial notices are separated from general payer mail and read for dates.</p></div></div>
        <div class="map-cell act"><div><p>Tracked with the appeal window flagged, routed to billing, and chased if it goes quiet.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">04</span><div><h4>Payer correspondence</h4></div></div>
        <div class="map-cell"><div><h4>Correspondence aging</h4><p>Open threads with each payer are aged rather than forgotten once they drop below the fold.</p></div></div>
        <div class="map-cell act"><div><p>Surfaced when a payer stops responding, with the aging reported in the format you manage by.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">05</span><div><h4>Credentialing and licensure</h4></div></div>
        <div class="map-cell"><div><h4>Deadline detection</h4><p>Renewal dates, CME requirements and credentialing paperwork are treated as hard deadlines, not admin.</p></div></div>
        <div class="map-cell act"><div><p>Escalated well before it lapses, not on the week it expires.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">06</span><div><h4>Patient, vendor and clinical mail</h4></div></div>
        <div class="map-cell"><div><h4>Communication classification</h4><p>Distinct handling rules for patient, payer, vendor and clinical correspondence, because they aren't the same problem.</p></div></div>
        <div class="map-cell act"><div><p>Each category routed under its own rules, with only what genuinely needs you reaching you.</p></div></div>
      </div>
    </div>
    <p class="map-note">PHI detection and routing requires the Regulated Practice Layer — the compliant path is what makes the rest of this safe to run. On Custom Reserve the whole map becomes yours: your payers, your referral sources, your escalation thresholds, documented during discovery.</p>
  </div>
</section>

{/* 06 — the economics */}
<section id="economics">
  <div class="sec-head">
    <div class="sec-tag reveal">The arithmetic</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Run this with your own numbers.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">We are not going to tell you how many hours you will get back. <b>We have not delivered enough engagements to put an honest number on it</b> &mdash; and a vendor who quotes you one hasn&rsquo;t either.</p>
        <p class="body">Use the numbers you already track. What is a referral worth to the practice, and how many of last quarter&rsquo;s never got scheduled? What is sitting in denials that were never appealed? How many days is your AR &mdash; and how much of that is correspondence waiting on a person rather than money waiting on a payer?</p>
        <p class="body">Then the question that decides it: how much of that work needs a clinician or a practice manager to <em>do</em> it, and how much needs one to <em>approve</em> it? The gap between those two is the entire product.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">What it actually competes with</div>
        <h4>Three alternatives, all of which you have considered.</h4>
        <p>Every practice we talk to has already tried at least one of them.</p>
        <ul class="alt-rows">
          <li><span class="v">Another hire</span><span class="l">a real salary, months to train, no coverage at 6am</span></li>
          <li><span class="v">A portal with a login</span><span class="l">half configured, and it never touches the inbox</span></li>
          <li><span class="v">Absorbing it</span><span class="l">into evenings, at the practice owner&rsquo;s rate</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 07 — industry-specific credibility */}
<section id="why">
  <div class="sec-head">
    <div class="sec-tag reveal">The operator's advantage</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Built by someone who has actually run one.</h2>
  </div>
  <div class="wrap">
    <div class="why-grid">
      <div class="why-copy reveal">
        <p class="big">Chris Barbieri ran a national medical supply operation <b>under HIPAA</b>, and personally built the patient intake and records systems it ran on.</p>
        <p>Not advised on them. Built them, inside a regulated operation, with his own money on the line if they went wrong. The intake tooling he built cut that team's workload by 30% and very nearly eliminated the errors that used to slip through.</p>
        <p>Automation projects in healthcare don't fail because the technology doesn't work. They fail because someone built something that didn't match how the practice actually runs, or quietly broke a process that was working fine. That's the failure mode we design against first.</p>
      </div>
      <div class="reveal" style="transition-delay:.06s">
        <div class="why-stat">
          <div class="val">30%</div>
          <div class="label">reduction in intake workload, with errors nearly eliminated, inside a HIPAA-regulated operation</div>
        </div>
        <div class="why-line">Most vendors selling into healthcare <b>claim</b> compliance readiness. We've operated under the standard.</div>
      </div>
    </div>
  </div>
</section>

{/* 08 — compliance */}
<section id="compliance">
  <div class="sec-head">
    <div class="sec-tag reveal">The Regulated Practice Layer</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">PHI doesn't go anywhere you haven't signed for.</h2>
  </div>
  <div class="wrap">
    <div class="anchor reveal">
      <div class="anchor-main">
        <div class="kicker">Path two · for practices handling PHI</div>
        <h3>HIPAA-ready, with a signed Business Associate Agreement.</h3>
        <p>A BAA is executed before anything touches protected health information, and the configuration behind it is documented rather than asserted: retention, deletion and encryption rules written per data type, with audit logging behind them.</p>
        <p>Every vendor in the chain is vetted for how it handles retention before it goes into the stack, and you get a written data flow map showing exactly where information travels and what is kept at each hop.</p>
        <span class="anchor-badge"><svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>Available on Reserve and Custom Reserve</span>
      </div>
      <div class="anchor-side">
        <div class="kicker">What's included</div>
        <ul class="ticks">
          <li>HIPAA-ready configuration</li>
          <li>Signed Business Associate Agreement</li>
          <li>A restricted, vetted tool stack</li>
          <li>Retention and deletion rules by data type</li>
          <li>Audit logging</li>
          <li>A written data flow map</li>
        </ul>
        <div class="anchor-price">$250 / month on Reserve · $400 / month on Custom Reserve
          <span>Covered models under a BAA retain data for a defined window, so the HIPAA-ready path and zero data retention aren't combinable. Practices handling PHI take this one.</span>
        </div>
      </div>
    </div>
  </div>
</section>

{/* 09 — the approval promise */}
<section class="promise">
  <div class="wrap">
    <div class="promise-box reveal">
      <div class="sec-tag">One thing we want to be clear about</div>
      <h2>Nothing goes out under your name without <em>your approval</em>. Ever.</h2>
      <p>The system drafts. You approve. There is no mode where it decides on its own to answer a client, respond to a partner, or send anything at all on your behalf. We don't offer that, and we're not planning to.</p>
      <div class="flow">
        <span class="flow-step">System drafts</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step key">You approve</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step">It sends</span>
      </div>
    </div>
  </div>
</section>

{/* 10 — proof */}
<ProofPlaceholder vertical="healthcare" />

{/* 11 — which plan healthcare takes */}
<section id="plans" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">Where this lives</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Which plan medical practices take.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">The industry configuration described above is part of a Custom Reserve build. Select and Reserve run the same engine without the custom process work.</p>
  </div>
  <div class="wrap">
    <div class="fit-grid">
      <article class="fit reveal">
        <h4>Select</h4>
        <div class="fj">Know what matters</div>
        <p>Your inbox sorted and prioritised, with a daily digest and protected focus blocks. No custom routing.</p>
        <a class="flink" href="/#pricing">See pricing &rarr;</a>
      </article>
      <article class="fit reveal" style="transition-delay:.06s">
        <h4>Reserve</h4>
        <div class="fj">Act on what matters</div>
        <p>Adds replies drafted in your voice, VIP routing, scheduling and meeting capture. The Regulated Practice Layer is available here as an add-on.</p>
        <a class="flink" href="/#pricing">See pricing &rarr;</a>
      </article>
      <article class="fit featured reveal" style="transition-delay:.12s">
        <h4>Custom Reserve</h4>
        <div class="fj">So nothing falls through</div>
        <p>The full industry configuration: custom escalation, routing, process flows and reporting, built from a documented map of your operation.</p>
        <a class="flink" href="/#pricing">See pricing &rarr;</a>
      </article>
    </div>
  </div>
</section>

{/* 12 — the resource */}
<section id="resource">
  <div class="wrap" style="padding-top:110px">
    <div class="magnet reveal">
      <div class="magnet-copy">
        <div class="kicker">Free resource</div>
        <h3>The Referral Response Audit</h3>
        <p>A short worksheet for finding where referrals stall inside your practice — from the moment one arrives to the moment the referring physician hears back. It's the first thing we map during a healthcare discovery, and it's useful whether or not you ever work with us.</p>
        <ul class="ticks" style="margin-top:22px">
          <li>The handoffs where referrals most often go quiet</li>
          <li>What to measure for referral source performance</li>
          <li>Where payer correspondence aging belongs in the process</li>
        </ul>
      </div>
      <div class="magnet-form">
        <!-- LEAD MAGNET PLACEHOLDER -------------------------------------------
             The asset itself is not written yet. This form captures the request
             and emails it through the existing Web3Forms endpoint; fulfilment is
             manual until the PDF exists. When it does, either attach it to the
             autoresponder or swap this form for a direct download link. -->
        <form action="https://api.web3forms.com/submit" method="POST" class="magnet-req" data-ajax
              data-success="Thanks — we'll email it over shortly.">
          <input type="hidden" name="access_key" value={FORM_KEY}>
          <input type="hidden" name="subject" value="Lead magnet request — Healthcare referral audit">
          <input type="hidden" name="from_name" value="Loque Agent Website">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
          <div class="field">
            <label for="lm-name">Name <span class="req">*</span></label>
            <input type="text" id="lm-name" name="name" placeholder="Jane Doe" required>
          </div>
          <div class="field">
            <label for="lm-email">Work email <span class="req">*</span></label>
            <input type="email" id="lm-email" name="email" placeholder="jane@firm.com" required>
          </div>
          <button type="submit" class="btn btn-primary">Send me the audit</button>
          <div class="magnet-fine">One email with the resource. No sequence, no sharing your address.</div>
          <div class="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

{/* 13 — book */}
<section id="contact" class="approach">
  <div class="sec-head">
    <div class="sec-tag reveal">Where to start</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The first conversation is short and free.</h2>
  </div>
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy reveal">
        <p class="big">We'll look at how mail, referrals and follow-ups actually move through your practice right now, and tell you honestly <b>whether this makes sense for you</b> and which plan fits. If it doesn't make sense, we'll say so.</p>
        <ul class="contact-points">
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A straight read on where the administrative hours are going.</li>
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A recommendation on Select, Reserve or a custom build — including &quot;none of these yet&quot;.</li>
