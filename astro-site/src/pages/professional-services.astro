---
// Professional services — finance, consulting and agency firms, on the
// twelve-block vertical template. Blocks 02, 03, 04, 05 and 06 are written
// for this audience; promise, compliance, plans, resource and book are ported
// from the previous legal page and retargeted. See WEBSITE_PROCESS.md.
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { FORM_KEY } from '../data/site.js';
import GetBack from '../components/GetBack.astro';
import ProofPlaceholder from '../components/ProofPlaceholder.astro';

const getBack = [
  `The unbillable day stops eating the billable one. You open the inbox already knowing which engagements need you today and which are simply moving.`,
  `Client mail filed by client and engagement. Scheduling, rescheduling and document requests handled without a thread. Vendor, subscription and platform noise never reaches you at all.`,
  `A daily digest that leads with anything carrying a deadline, and a prep brief before every client call with the engagement history, the last interaction and the open items already assembled.`,
  `Decisions, approvals and scope changes written down as they arrive, so the record of what was agreed exists <em>before</em> anyone needs to argue about it. On Custom Reserve, a documented map of how your firm actually delivers.`,
  `Everything you committed to a client, tracked to closure. Everything a client owes you &mdash; files, approvals, answers, signatures &mdash; chased on a schedule, so delivery isn&rsquo;t waiting on your memory.`,
  `Proposal through engagement letter through kickoff, running as one flow. Recurring reporting and renewal cycles assembled rather than remembered.`
];

// Image tiles interleaved into the six 'what you get back' cards, so the
// grid reads 3x3 with no row entirely made of type (see ImageSlot).
const gainImages = [
  { pos: 1, id: 'professional-services-gain-table',
    brief: 'Two coffee cups on an otherwise empty meeting table, shot close. The billable conversation, not the admin.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 5, id: 'professional-services-gain-glass',
    brief: 'Abstract detail of light through office glass or a partition — geometry and reflection, no people.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 6, id: 'professional-services-gain-notes',
    brief: 'A notebook closed with a pen clipped to it, on a clear desk. Nothing readable.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
];
---
<Base title="Loque Agent for professional services — scope and delivery" description="An executive assistant built around how a finance, consulting or agency firm actually delivers. Client mail routed by engagement, scope changes flagged before anyone says yes, and commitments tracked in both directions. Nothing goes out under your name without your approval." path="/professional-services" vertical="Professional services">

{/* 01 */}
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="/img/hero-bg.jpg" alt="" />
    <div class="hero-grid"></div>
    <div class="hero-aurora"></div>
    <div class="hero-cursor" id="heroCursor"></div>
  </div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow reveal"><span class="dot"></span>For principals at finance, consulting and agency firms</span>
        <h1 class="reveal" style="transition-delay:.06s">The work that isn&rsquo;t billable and <em>isn&rsquo;t optional</em>.</h1>
        <p class="lead reveal" style="transition-delay:.14s">We build and run an assistant around how your firm actually delivers. Client mail routed by engagement, commitments tracked in both directions, and the admin that quietly eats your utilisation handled before it reaches you.</p>
        <div class="hero-actions reveal" style="transition-delay:.22s">
          <a href="#contact" class="btn btn-primary">Book a call</a>
          <a href="#map" class="btn btn-ghost">See the workflow map</a>
        </div>
      </div>
    </div>
  </div>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track"><span>Engagement routing</span><span>Scope-change flagging</span><span>Commitment tracking</span><span>Waiting-on tracking</span><span>Drafts in your voice</span><span>Client prep briefs</span><span>Engagement routing</span><span>Scope-change flagging</span><span>Commitment tracking</span><span>Waiting-on tracking</span><span>Drafts in your voice</span><span>Client prep briefs</span></div>
  </div>
</section>

<ImageSlot
  id="professional-services-world"
  variant="band"
  brief="Glass-walled meeting room seen from the corridor, late in the day. Chairs pushed back, one laptop still open. Wide, cool light, architectural."
  tone="Sets the world of the practice. Desaturated, film grain, lime accent only if it occurs naturally."
/>


{/* 02 — where the hours go */}
<section id="hours">
  <div class="sec-head">
    <div class="sec-tag reveal">Where the week goes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Utilisation is what you manage by. Admin is what you actually do.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">None of the following appears on a timesheet, and all of it decides whether the work that does appear lands on time and at the margin you quoted.</p>
  </div>
  <div class="wrap">
    <div class="drain-grid">
      <article class="drain reveal">
        <h4><span class="k">01</span>Client mail that isn&rsquo;t client work</h4>
        <p>Status requests, scheduling, document chasing, invoice questions. Every one is a real obligation to a real client, and not one of them belongs on an engagement code.</p>
      </article>

      <ImageSlot
        id="professional-services-drain-threads"
        variant="tile"
        delay={0.06}
        brief="A phone screen face-up showing a dense stack of notifications, shot at an angle so nothing is legible."
        tone="Tile inside the card grid — one subject, tight crop, reads at small size."
      />

      <article class="drain reveal" style="transition-delay:.06s">
        <h4><span class="k">02</span>Scope that moves without a conversation</h4>
        <p>Small asks arrive inside threads. Individually they are nothing. Collectively they are the difference between the margin you quoted and the margin you got.</p>
      </article>
      <article class="drain reveal">
        <h4><span class="k">03</span>Chasing your own clients</h4>
        <p>You cannot deliver until they send the file, approve the draft or answer the question. Following up is unbillable, unavoidable, and lands on the person running the engagement.</p>
      </article>

      <ImageSlot
        id="professional-services-drain-desk"
        variant="tile"
        delay={0}
        brief="A desk at the end of a bad day — several devices, several open documents, no order to any of it."
        tone="Tile inside the card grid — one subject, tight crop, reads at small size."
      />

      <article class="drain reveal" style="transition-delay:.06s">
        <h4><span class="k">04</span>Business development in the gaps</h4>
        <p>The relationships that generate next quarter get whatever is left over after delivery, which in a busy quarter is nothing at all.</p>
      </article>
    </div>
    <div class="drain-sum reveal">
      <p>None of this is billable. <b>All of it decides whether the billable work lands</b> on time and at the number you put in the proposal.</p>
    </div>
  </div>
</section>

{/* 03 — what you get back */}
<section id="gain" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">What changes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What you get back.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">Six things, in the same six categories on every page of this site. Here is what they look like in a firm that sells its people&rsquo;s time.</p>
  </div>
  <div class="wrap">
    <GetBack items={getBack} images={gainImages} />
  </div>
</section>

{/* 04 — what goes wrong */}
<section id="risk">
  <div class="sec-head">
    <div class="sec-tag reveal">And the part that isn&rsquo;t about time</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Scope doesn&rsquo;t creep. It arrives one email at a time.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">No client has ever asked for a fifteen per cent scope increase. <b>They ask six small questions across four weeks</b>, inside threads, and nobody writes any of it down.</p>
        <p class="body">By the time the margin looks wrong the conversation is already difficult, because there is no record of what was agreed and what was added. The alternative &mdash; policing every request in the moment &mdash; costs relationship capital you would rather spend somewhere else.</p>
        <p class="body">The same gap runs against you in the other direction. A client who owes you a file or an approval isn&rsquo;t refusing, they have forgotten. Nobody is tracking it, so the delay lands on your delivery date rather than on theirs.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">Where the margin actually goes</div>
        <h4>Not to the work. To the gaps around it.</h4>
        <p>None of these show up as a line item. All of them show up in realisation.</p>
        <ul class="alt-rows">
          <li><span class="v">Scope</span><span class="l">added inside threads, never priced</span></li>
          <li><span class="v">Waiting</span><span class="l">on client files, approvals and answers</span></li>
          <li><span class="v">Rework</span><span class="l">because what was agreed was never written down</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 05 — the workflow map */}
<section id="map">
  <div class="sec-head">
    <div class="sec-tag reveal">Pre-built workflow map</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What we&rsquo;ve already built for professional services firms.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">This configuration exists before your first onboarding session. Discovery tunes it to your clients, your engagements and your thresholds &mdash; it doesn&rsquo;t start from a blank page.</p>
  </div>
  <div class="wrap">
    <div class="map">
      <div class="map-head">
        <div>Column one<b>What arrives</b></div>
        <div>Column two<b>What the system checks</b></div>
        <div>Column three<b>What happens next</b></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">01</span><div><h4>Client correspondence</h4></div></div>
        <div class="map-cell"><div><h4>Engagement identification</h4><p>Client and engagement matched from the thread, the sending address and any reference in the body.</p></div></div>
        <div class="map-cell act"><div><p>Filed to the engagement, with response time by client tracked for your reporting.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">02</span><div><h4>A new request inside an existing thread</h4></div></div>
        <div class="map-cell"><div><h4>Scope-change detection</h4><p>Requests are tested against what the engagement actually covers rather than treated as ordinary client mail.</p></div></div>
        <div class="map-cell act"><div><p>Flagged as a possible addition, with the original terms attached, before anyone replies yes.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">03</span><div><h4>Anything you committed to</h4></div></div>
        <div class="map-cell"><div><h4>Commitment capture</h4><p>Commitments are extracted from mail and from meeting notes as they are made rather than reconstructed later.</p></div></div>
        <div class="map-cell act"><div><p>Logged against the engagement with the date, and tracked until it is closed out.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">04</span><div><h4>Anything a client owes you</h4></div></div>
        <div class="map-cell"><div><h4>Waiting-on tracking</h4><p>Files, approvals, answers and signatures are captured at the moment they are promised, with who owes them and when.</p></div></div>
        <div class="map-cell act"><div><p>Chased on a cadence you set, so delivery stops depending on somebody remembering.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">05</span><div><h4>A prospect or a referral</h4></div></div>
        <div class="map-cell"><div><h4>Business development routing</h4><p>New-business mail is separated from delivery mail rather than sorted by whoever happens to open it.</p></div></div>
        <div class="map-cell act"><div><p>Surfaced on its own, so it doesn&rsquo;t sit behind today&rsquo;s delivery work until it goes cold.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">06</span><div><h4>Invoices, renewals and subscriptions</h4></div></div>
        <div class="map-cell"><div><h4>Vendor and billing classification</h4><p>Billing and vendor mail is identified on multiple signals rather than sender patterns alone.</p></div></div>
        <div class="map-cell act"><div><p>Filed out of the inbox, with anything carrying a date surfaced before it becomes late.</p></div></div>
      </div>
    </div>
    <p class="map-note">On Custom Reserve this becomes your own escalation matrix &mdash; your client tiers, your assignment rules, your scope thresholds &mdash; documented during discovery and built to match.</p>
  </div>
</section>

{/* 06 — the economics */}
<section id="economics">
  <div class="sec-head">
    <div class="sec-tag reveal">The arithmetic</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Run this with your own rate.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">We are not going to tell you how many hours you will get back. <b>We have not delivered enough engagements to put an honest number on it</b> &mdash; and a vendor who quotes you one hasn&rsquo;t either.</p>
        <p class="body">Take your standard rate. Take an honest estimate of the hours a week that go to client admin, chasing, scheduling and writing up &mdash; none of which appear on an engagement code. Multiply. That is the number this competes with, not a monthly fee.</p>
        <p class="body">Then look at realisation. What fraction of what you scoped actually got billed last quarter, and how much of the gap was scope that arrived inside a thread and never got priced? Finally, the question that decides it: how much of that work needs a principal to <em>do</em> it, and how much needs one to <em>approve</em> it?</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">What it actually competes with</div>
        <h4>Three alternatives, all of which you have considered.</h4>
        <p>Every firm we talk to has already tried at least one of them.</p>
        <ul class="alt-rows">
          <li><span class="v">Another admin hire</span><span class="l">a real salary, months to train, no coverage at 6am</span></li>
          <li><span class="v">A practice management tool</span><span class="l">half configured, and it never touches the inbox</span></li>
          <li><span class="v">Absorbing it</span><span class="l">into evenings, at your own rate</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 07 — compliance */}
<section id="compliance">
  <div class="sec-head">
    <div class="sec-tag reveal">The Regulated Practice Layer</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Client information doesn't get stored somewhere you can't see.</h2>
  </div>
  <div class="wrap">
    <div class="anchor reveal">
      <div class="anchor-main">
        <div class="kicker">Path one · for professional services</div>
        <h3>Zero data retention, documented end to end.</h3>
        <p>Prompts and responses are never stored. That claim only means something if it holds all the way down, so every vendor in the chain — model, meeting recorder, CRM, automation platform, mail — is vetted for how it handles retention before it goes in the stack.</p>
        <p>You get a written data flow map showing exactly where information travels and what is kept at each hop. Most firms need one for their own client security questionnaires and can't produce it.</p>
        <span class="anchor-badge"><svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>Available on Reserve and Custom Reserve</span>
      </div>
      <div class="anchor-side">
        <div class="kicker">What's included</div>
        <ul class="ticks">
          <li>Zero-data-retention configuration</li>
          <li>DPA executed as applicable</li>
          <li>A restricted, vetted tool stack</li>
          <li>Retention and deletion rules by data type</li>
          <li>Audit logging</li>
          <li>A written data flow map</li>
        </ul>
        <div class="anchor-price">$250 / month on Reserve · $400 / month on Custom Reserve
          <span>Firms handling protected health information take the HIPAA-ready path instead. The two configurations aren't combinable — you choose one.</span>
        </div>
      </div>
    </div>
  </div>
</section>

{/* 08 — the approval promise */}
<section class="promise">
  <div class="wrap">
    <div class="promise-box reveal">
      <div class="sec-tag">One thing we want to be clear about</div>
      <h2>Nothing goes out under your name without <em>your approval</em>. Ever.</h2>
      <p>The system drafts. You approve. There is no mode where it decides on its own to answer a client, respond to a partner, or send anything at all on your behalf. We don't offer that, and we're not planning to.</p>
      <div class="flow">
        <span class="flow-step">System drafts</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step key">You approve</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step">It sends</span>
      </div>
    </div>
  </div>
</section>

{/* 09 — proof */}
<ProofPlaceholder vertical="professional services" />

{/* 10 — which plan */}
<section id="plans" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">Where this lives</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Which plan professional services firms take.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">Most firms start on Reserve, because drafting and scheduling are where the unbillable hours are. Custom Reserve is the one to look at if you want scope changes and waiting-on tracking wired to how your engagements actually run.</p>
  </div>
  <div class="wrap">
    <div class="fit-grid">
      <article class="fit reveal">
        <h4>Select</h4>
        <div class="fj">Know what matters</div>
        <p>Your inbox sorted and prioritised by client and engagement, with a daily digest and protected focus blocks. No drafting, no custom routing.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
      <article class="fit reveal" style="transition-delay:.06s">
        <h4>Reserve</h4>
        <div class="fj">Act on what matters</div>
        <p>Adds replies drafted in your voice, VIP routing, scheduling and meeting capture. The Regulated Practice Layer is available here as an add-on.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
      <article class="fit featured reveal" style="transition-delay:.12s">
        <h4>Custom Reserve</h4>
        <div class="fj">So nothing falls through</div>
        <p>Scope-change flagging, commitment and waiting-on tracking, engagement routing and reporting, built from a documented map of how your firm delivers.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
    </div>
  </div>
</section>

{/* 11 — the resource */}
<section id="resource">
  <div class="wrap" style="padding-top:110px">
    <div class="magnet reveal">
      <div class="magnet-copy">
        <div class="kicker">Free resource</div>
        <h3>The Waiting-On Audit</h3>
        <p>A one-page exercise for finding everything your firm is currently waiting on and nobody is chasing — client files, approvals, answers, signatures. Most firms who run it are surprised by the total. It's useful whether or not you ever work with us.</p>
        <ul class="ticks" style="margin-top:22px">
          <li>How to surface every outstanding item across live engagements in an afternoon</li>
          <li>Which delays are actually costing you delivery dates, and which are noise</li>
          <li>A chase cadence that keeps a client moving without spending relationship capital</li>
        </ul>
      </div>
      <div class="magnet-form">
        <!-- LEAD MAGNET PLACEHOLDER -------------------------------------------
             The asset itself is not written yet. This form captures the request
             and emails it through the existing Web3Forms endpoint; fulfilment is
             manual until the PDF exists. When it does, either attach it to the
             autoresponder or swap this form for a direct download link. -->
        <form action="https://api.web3forms.com/submit" method="POST" class="magnet-req" data-ajax
              data-success="Thanks — we'll email it over shortly.">
          <input type="hidden" name="access_key" value={FORM_KEY}>
          <input type="hidden" name="subject" value="Lead magnet request — Waiting-On Audit">
          <input type="hidden" name="from_name" value="Loque Agent Website">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
          <div class="field">
            <label for="lm-name">Name <span class="req">*</span></label>
            <input type="text" id="lm-name" name="name" placeholder="Jane Doe" required>
          </div>
          <div class="field">
            <label for="lm-email">Work email <span class="req">*</span></label>
            <input type="email" id="lm-email" name="email" placeholder="jane@firm.com" required>
          </div>
          <button type="submit" class="btn btn-primary">Send me the audit</button>
          <div class="magnet-fine">One email with the resource. No sequence, no sharing your address.</div>
          <div class="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

{/* 12 — book */}
<section id="contact" class="approach">
  <div class="sec-head">
    <div class="sec-tag reveal">Where to start</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The first conversation is short and free.</h2>
  </div>
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy reveal">
        <p class="big">We'll look at how client mail, commitments and follow-ups actually move through your firm right now, and tell you honestly <b>whether this makes sense for you</b> and which plan fits. If it doesn't make sense, we'll say so.</p>
        <ul class="contact-points">
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A straight read on where your unbillable hours are actually going.</li>
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A recommendation on Select, Reserve or a custom build — including &quot;none of these yet&quot;.</li>
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>If you're not saving real hours by month two, we refund your setup fee.</li>
        </ul>
        <div class="contact-direct">
          Prefer email? Reach us directly at <a href="mailto:questions@loquelogic.com">questions@loquelogic.com</a>
        </div>
      </div>

      <div class="form-card reveal" style="transition-delay:.06s">
        <form id="contactForm" action="https://api.web3forms.com/submit" method="POST" data-ajax>
          <input type="hidden" name="access_key" value={FORM_KEY}>
          <input type="hidden" name="subject" value="New enquiry — Loque Agent (Professional services)">
          <input type="hidden" name="from_name" value="Loque Agent Website">
          <input type="hidden" name="vertical" value="Professional services">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">

          <div class="form-grid">
            <div class="field">
              <label for="cf-name">Name <span class="req">*</span></label>
              <input type="text" id="cf-name" name="name" placeholder="Jane Doe" required>
            </div>
            <div class="field">
              <label for="cf-email">Email <span class="req">*</span></label>
              <input type="email" id="cf-email" name="email" placeholder="jane@firm.com" required>
            </div>
            <div class="field">
              <label for="cf-company">Firm name</label>
              <input type="text" id="cf-company" name="company" placeholder="Firm name">
            </div>
            <div class="field">
              <label for="cf-phone">Phone</label>
              <input type="tel" id="cf-phone" name="phone" placeholder="(435) 243-5808">
            </div>
            <div class="field">
              <label for="cf-plan">I'm interested in</label>
              <select id="cf-plan" name="plan">
                <option value="Not sure yet — help me decide">Not sure yet — help me decide</option>
                <option value="Select — know what matters">Select — know what matters</option>
                <option value="Reserve — act on what matters">Reserve — act on what matters</option>
                <option value="Custom Reserve — a custom build">Custom Reserve — a custom build</option>
                <option value="Founding client rates">Founding client rates</option>
              </select>
            </div>
            <div class="field">
              <label for="cf-size">Firm size</label>
              <select id="cf-size" name="size">
                <option value="Not given">Prefer not to say</option>
                <option value="Solo">Solo</option>
                <option value="2-10">2&ndash;10 people</option>
                <option value="11-50">11&ndash;50 people</option>
                <option value="51+">51+ people</option>
              </select>
            </div>
            <div class="field full">
              <label for="cf-message">What's actually eating your time? <span class="req">*</span></label>
              <textarea id="cf-message" name="message" placeholder="Roughly how much email you get, what keeps slipping, and whether anyone helps you with it today." required></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" id="cf-submit">Book the first conversation</button>
          <div class="form-fine">We'll only use your details to follow up about your enquiry. No spam, ever.</div>
          <div class="form-status" id="cf-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

