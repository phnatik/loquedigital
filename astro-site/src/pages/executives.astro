---
// Corporate executives — the role vertical. It runs the same twelve-block
// template as the industry pages, with two deliberate flexes (ADR-W15):
// there is no regulator, so block 07 is the company's IT and security posture
// rather than a compliance layer; and the page leads with the services, noting
// that it works independently or alongside an existing EA rather than framing
// itself as a replacement. See WEBSITE_PROCESS.md.
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { FORM_KEY } from '../data/site.js';
import GetBack from '../components/GetBack.astro';
import ProofPlaceholder from '../components/ProofPlaceholder.astro';

const getBack = [
  `The administrative layer stops being yours. You come out of a block of meetings to a queue that has been sorted, drafted and filed rather than one that has been growing the whole time.`,
  `Mail triaged and routed before you see it, with the senders who matter never left waiting. Scheduling, rescheduling and conflict resolution handled without a thread. Vendor, recruiter and system noise kept out of the inbox entirely.`,
  `A daily digest that leads with what actually needs you, and a prep brief before every meeting with the relationship history, the last interaction and the open items already assembled.`,
  `Meeting notes and action items captured as they happen and attributed to whoever owns them. On Custom Reserve, a documented map of how work actually moves through your organisation.`,
  `Every commitment you made, tracked to closure. Every commitment made to you &mdash; by a report, a peer, a vendor &mdash; chased on a schedule, so you stop being the escalation mechanism.`,
  `The sequences you currently run by hand &mdash; board pack assembly, quarterly reviews, onboarding a new report, renewals &mdash; running as flows instead of as reminders in your own calendar.`
];

// Image tiles interleaved into the six 'what you get back' cards, so the
// grid reads 3x3 with no row entirely made of type (see ImageSlot).
const gainImages = [
  { pos: 1, id: 'executives-gain-pen',
    brief: 'A fountain pen resting on a closed leather folio, shot close. Considered, unhurried.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 5, id: 'executives-gain-city',
    brief: 'City light through glass, thrown out of focus into shape and colour. Pure texture.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
  { pos: 6, id: 'executives-gain-chair',
    brief: 'An empty office chair turned away from the desk toward the window. Reads as thinking time.',
    tone: 'Detail or texture, not a scene. These three sit among text cards, so they should read at tile size — one subject, close in, shallow depth of field.' },
];
---
<Base
  title="Loque Agent for executives — prep, drafting, follow-through"
  description="An executive assistant built around how you actually operate. Mail triaged before you open it, replies drafted in your voice, a prep brief before every call, and every commitment tracked to closure. Runs on its own or alongside your existing assistant. Nothing goes out under your name without your approval."
  path="/executives"
  vertical="Corporate executives"
>

{/* 01 */}
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="/img/hero-bg.jpg" alt="" />
    <div class="hero-grid"></div>
    <div class="hero-aurora"></div>
    <div class="hero-cursor" id="heroCursor"></div>
  </div>
  <div class="wrap">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow reveal"><span class="dot"></span>For C-suite and senior executives</span>
        <h1 class="reveal" style="transition-delay:.06s">Every meeting makes work. <em>Almost none of it gets written down.</em></h1>
        <p class="lead reveal" style="transition-delay:.14s">We build and run an assistant around how you actually operate. Mail triaged before you open it, replies drafted in your voice, a prep brief before every call, and every commitment &mdash; yours and theirs &mdash; tracked to closure. It runs on its own, or alongside the assistant you already have.</p>
        <div class="hero-actions reveal" style="transition-delay:.22s">
          <a href="#contact" class="btn btn-primary">Book a call</a>
          <a href="#map" class="btn btn-ghost">See what it does</a>
        </div>
      </div>
    </div>
  </div>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>Inbox triage</span><span>Drafts in your voice</span><span>Prep briefs</span><span>Commitment tracking</span><span>Waiting-on tracking</span><span>Calendar defended</span>
      <span>Inbox triage</span><span>Drafts in your voice</span><span>Prep briefs</span><span>Commitment tracking</span><span>Waiting-on tracking</span><span>Calendar defended</span>
    </div>
  </div>
</section>

<ImageSlot
  id="executives-world"
  variant="band"
  brief="Corner office at dusk, city beyond the glass, desk mostly clear. Wide and quiet. One figure at the window, small in frame and unidentifiable, or empty."
  tone="Sets the world of the practice. Desaturated, film grain, lime accent only if it occurs naturally."
/>


{/* 02 — where the hours go */}
<section id="hours">
  <div class="sec-head">
    <div class="sec-tag reveal">Where the week goes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The calendar is full. The work happens between the meetings.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">None of the following is on your calendar, and all of it decides whether the things on your calendar actually happen.</p>
  </div>
  <div class="wrap">
    <div class="drain-grid">
      <article class="drain reveal">
        <h4><span class="k">01</span>An inbox you never get ahead of</h4>
        <p>Reports, peers, vendors, the board, external. Sorting it is a judgement call about relative priority, which is exactly why it keeps coming back to you rather than staying delegated.</p>
      </article>

      <ImageSlot
        id="executives-drain-calendar"
        variant="tile"
        delay={0.06}
        brief="A calendar packed wall-to-wall with blocks, photographed on a screen at an angle. Nothing legible."
        tone="Tile inside the card grid — one subject, tight crop, reads at small size."
      />

      <article class="drain reveal" style="transition-delay:.06s">
        <h4><span class="k">02</span>Follow-through that lives in your head</h4>
        <p>Every meeting creates commitments in both directions. Almost none get written down while they are being made, so they get remembered &mdash; or they don&rsquo;t.</p>
      </article>
      <article class="drain reveal">
        <h4><span class="k">03</span>Prep done in the corridor</h4>
        <p>You walk into calls reconstructing the last conversation from a thread, because there was no gap between this meeting and the one before it.</p>
      </article>

      <ImageSlot
        id="executives-drain-late"
        variant="tile"
        delay={0}
        brief="A desk lamp as the only light in a dark office, shot from across the room."
        tone="Tile inside the card grid — one subject, tight crop, reads at small size."
      />

      <article class="drain reveal" style="transition-delay:.06s">
        <h4><span class="k">04</span>A calendar everyone else can book</h4>
        <p>Your availability is visible to the whole company and most of them can take it. Defending time for the work you were actually hired to do is its own standing negotiation.</p>
      </article>
    </div>
    <div class="drain-sum reveal">
      <p>None of this is the job you were hired to do. <b>All of it decides whether the job gets done.</b></p>
    </div>
  </div>
</section>

{/* 03 — what you get back */}
<section id="gain" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">What changes</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What you get back.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">Six things, in the same six categories on every page of this site. Here is what they look like for someone running a function inside a larger company.</p>
  </div>
  <div class="wrap">
    <GetBack items={getBack} images={gainImages} />
  </div>
</section>

{/* 04 — what goes wrong */}
<section id="risk">
  <div class="sec-head">
    <div class="sec-tag reveal">And the part that isn&rsquo;t about time</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The things that slip are the ones nobody escalates.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">The urgent always gets handled. <b>What gets lost is the thing you said you would do</b> in a meeting three weeks ago that nobody is going to remind you about.</p>
        <p class="body">A decision a report is blocked on. A commitment to a peer that never made it onto either calendar. Something you delegated that stalled quietly and resurfaces the week it matters. None of it announces itself, because the person waiting on you is usually too senior to chase you and too junior to escalate.</p>
        <p class="body">The cost is not a missed deadline. It is that people stop routing things through you &mdash; and you stop hearing about problems while they are still small.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">What actually erodes</div>
        <h4>Nothing breaks. It gets routed around you.</h4>
        <p>This is the failure mode that never shows up in a status report.</p>
        <ul class="alt-rows">
          <li><span class="v">Your reports</span><span class="l">stop waiting and decide without you</span></li>
          <li><span class="v">Your peers</span><span class="l">stop putting things on your plate at all</span></li>
          <li><span class="v">You</span><span class="l">hear about problems later than you should</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 05 — the workflow map */}
<section id="map">
  <div class="sec-head">
    <div class="sec-tag reveal">Pre-built workflow map</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">What we&rsquo;ve already built for executives.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">This configuration exists before your first onboarding session. Discovery tunes it to your organisation, your people and your thresholds &mdash; it doesn&rsquo;t start from a blank page.</p>
  </div>
  <div class="wrap">
    <div class="map">
      <div class="map-head">
        <div>Column one<b>What arrives</b></div>
        <div>Column two<b>What the system checks</b></div>
        <div>Column three<b>What happens next</b></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">01</span><div><h4>Anything from the board or an investor</h4></div></div>
        <div class="map-cell"><div><h4>Sender tier and topic</h4><p>Board, investor and external-stakeholder mail is identified by sender and by subject, not left to a generic importance score.</p></div></div>
        <div class="map-cell act"><div><p>Escalated immediately, with the thread history and any open items on that relationship attached.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">02</span><div><h4>A direct report</h4></div></div>
        <div class="map-cell"><div><h4>Reporting-line awareness</h4><p>Your organisation is encoded, so mail from the people who work for you is handled under different rules from general internal traffic.</p></div></div>
        <div class="map-cell act"><div><p>Surfaced with what they are blocked on and what you last told them, so the reply takes a minute rather than a re-read.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">03</span><div><h4>A meeting request</h4></div></div>
        <div class="map-cell"><div><h4>Calendar policy</h4><p>Requests are tested against the blocks you protect, who is asking, and whether the thing needs you or needs a decision from you.</p></div></div>
        <div class="map-cell act"><div><p>Accepted, declined, delegated or countered without a thread. Anything genuinely ambiguous comes to you with a recommendation.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">04</span><div><h4>Something you committed to</h4></div></div>
        <div class="map-cell"><div><h4>Commitment capture</h4><p>Commitments are extracted from meeting notes and from mail as they are made, rather than reconstructed later from memory.</p></div></div>
        <div class="map-cell act"><div><p>Logged against you with the context and the date, and tracked until it is closed out.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">05</span><div><h4>Something owed to you</h4></div></div>
        <div class="map-cell"><div><h4>Waiting-on tracking</h4><p>Anything promised to you is captured at the moment it is promised, with who owes it and when they said it would land.</p></div></div>
        <div class="map-cell act"><div><p>Chased on a cadence you set, so the follow-up happens without you being the one to remember it.</p></div></div>
      </div>
      <div class="map-row reveal">
        <div class="map-cell"><span class="n">06</span><div><h4>Vendors, recruiters and cold outreach</h4></div></div>
        <div class="map-cell"><div><h4>Noise classification</h4><p>Bulk and cold mail is identified on multiple signals rather than on sender patterns alone, so real mail is never miscategorised.</p></div></div>
        <div class="map-cell act"><div><p>Filed out of the inbox entirely. A weekly digest if you want one, and nothing at all if you don&rsquo;t.</p></div></div>
      </div>
    </div>
    <p class="map-note">On Custom Reserve this becomes your own escalation matrix &mdash; your hierarchy of urgency, your assignment rules, your thresholds &mdash; documented during discovery and built to match.</p>
  </div>
</section>

{/* 06 — the economics, and how it fits an existing EA */}
<section id="economics">
  <div class="sec-head">
    <div class="sec-tag reveal">The arithmetic</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Run this with your own week.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">We are not going to tell you how many hours you will get back. <b>We have not delivered enough engagements to put an honest number on it</b> &mdash; and a vendor who quotes you one hasn&rsquo;t either.</p>
        <p class="body">Do it the other way round. Open last week&rsquo;s calendar and count the hours that were meetings. Then count the hours that were the work those meetings created &mdash; reading, replying, prepping, chasing, writing up. The second number is usually larger than people expect, and it is almost entirely invisible, because none of it was ever on the calendar.</p>
        <p class="body">Then the question that decides it: how much of that needs you to <em>do</em> it, and how much needs you to <em>approve</em> it? The gap between those two is the entire product.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">How it fits what you already have</div>
        <h4>On its own, or alongside your assistant.</h4>
        <p>Both work. What changes is who does the approving.</p>
        <ul class="alt-rows">
          <li><span class="v">On your own</span><span class="l">the system drafts, you approve, nothing sends without you</span></li>
          <li><span class="v">With an EA</span><span class="l">they clear the routine drafts, you see what needs you</span></li>
          <li><span class="v">With a chief of staff</span><span class="l">the tracking and prep run underneath what they already do</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 07 — IT and security posture, in place of a compliance layer */}
<section id="security">
  <div class="sec-head">
    <div class="sec-tag reveal">Before IT asks</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The questions your security team will ask, answered up front.</h2>
  </div>
  <div class="wrap">
    <div class="prob-grid">
      <div class="reveal">
        <p class="big">In a company you don&rsquo;t own, you are rarely the only person on this decision. <b>Somebody in IT or security will want to know where the data goes</b> &mdash; so we answer that before you have to ask us.</p>
        <p class="body">Every engagement produces a written data flow map showing exactly where information travels and what is retained at each step. For finance, legal and HR contexts, the Regulated Practice Layer adds a zero-data-retention configuration and a restricted, vetted tool stack, with every vendor in the chain checked for how it handles retention rather than taken on trust.</p>
        <p class="body">How this connects to your company&rsquo;s mail and calendar is scoped during discovery, and we work with your IT team rather than around them. If the answer is that it can&rsquo;t be done cleanly, we will say so.</p>
      </div>
      <div class="alt-card reveal" style="transition-delay:.06s">
        <div class="kicker">The control question</div>
        <h4>Nothing is ever sent under your name.</h4>
        <p>This is usually the answer security actually cares about, and it is a product policy rather than a setting.</p>
        <ul class="alt-rows">
          <li><span class="v">Drafts only</span><span class="l">the system writes, you approve, then it sends</span></li>
          <li><span class="v">Reversible</span><span class="l">filing is label-and-archive; nothing is deleted</span></li>
          <li><span class="v">Documented</span><span class="l">retention and deletion rules by data type, with audit logging</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* 08 — the approval promise */}
<section class="promise">
  <div class="wrap">
    <div class="promise-box reveal">
      <div class="sec-tag">One thing we want to be clear about</div>
      <h2>Nothing goes out under your name without <em>your approval</em>. Ever.</h2>
      <p>The system drafts. You approve. There is no mode where it decides on its own to answer a client, respond to a partner, or send anything at all on your behalf. We don't offer that, and we're not planning to.</p>
      <div class="flow">
        <span class="flow-step">System drafts</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step key">You approve</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-step">It sends</span>
      </div>
    </div>
  </div>
</section>

{/* 09 — proof */}
<ProofPlaceholder vertical="executive" />

{/* 10 — which plan executives take */}
<section id="plans" class="sec-light">
  <div class="sec-head">
    <div class="sec-tag reveal">Where this lives</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">Which plan executives take.</h2>
    <p class="sec-sub reveal" style="transition-delay:.1s">Most executives start on Reserve, because drafting and scheduling are where the hours are. Custom Reserve is the one to look at if you have a team around you and want the routing and reporting built to match how they work.</p>
  </div>
  <div class="wrap">
    <div class="fit-grid">
      <article class="fit reveal">
        <h4>Select</h4>
        <div class="fj">Know what matters</div>
        <p>Your inbox sorted and prioritised, with a daily digest and protected focus blocks. No drafting, no custom routing.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
      <article class="fit reveal" style="transition-delay:.06s">
        <h4>Reserve</h4>
        <div class="fj">Act on what matters</div>
        <p>Adds replies drafted in your voice, VIP routing, scheduling and meeting capture. Where most executives start.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
      <article class="fit featured reveal" style="transition-delay:.12s">
        <h4>Custom Reserve</h4>
        <div class="fj">So nothing falls through</div>
        <p>Commitment and waiting-on tracking, prep briefs, reporting-line routing and a documented map of how work moves through your organisation.</p>
        <a class="flink" href="/pricing">See pricing &rarr;</a>
      </article>
    </div>
  </div>
</section>

{/* 11 — the resource */}
<section id="resource">
  <div class="wrap" style="padding-top:110px">
    <div class="magnet reveal">
      <div class="magnet-copy">
        <div class="kicker">Free resource</div>
        <h3>The Commitment Ledger</h3>
        <p>A one-page method for tracking what you owe other people and what they owe you, without a project tool and without anyone else touching it. It's the paper version of what we build, and it's useful whether or not you ever work with us.</p>
        <ul class="ticks" style="margin-top:22px">
          <li>How to capture a commitment in the meeting rather than after it</li>
          <li>The difference between what you owe and what you are owed, and why they need separate handling</li>
          <li>A chase cadence for things you are waiting on that doesn't read as nagging</li>
        </ul>
      </div>
      <div class="magnet-form">
        <!-- LEAD MAGNET PLACEHOLDER -------------------------------------------
             The asset itself is not written yet. This form captures the request
             and emails it through the existing Web3Forms endpoint; fulfilment is
             manual until the PDF exists. When it does, either attach it to the
             autoresponder or swap this form for a direct download link. -->
        <form action="https://api.web3forms.com/submit" method="POST" class="magnet-req" data-ajax
              data-success="Thanks — we'll email it over shortly.">
          <input type="hidden" name="access_key" value={FORM_KEY}>
          <input type="hidden" name="subject" value="Lead magnet request — Commitment Ledger">
          <input type="hidden" name="from_name" value="Loque Agent Website">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
          <div class="field">
            <label for="lm-name">Name <span class="req">*</span></label>
            <input type="text" id="lm-name" name="name" placeholder="Jane Doe" required>
          </div>
          <div class="field">
            <label for="lm-email">Work email <span class="req">*</span></label>
            <input type="email" id="lm-email" name="email" placeholder="jane@company.com" required>
          </div>
          <button type="submit" class="btn btn-primary">Send me the ledger</button>
          <div class="magnet-fine">One email with the resource. No sequence, no sharing your address.</div>
          <div class="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

{/* 12 — book */}
<section id="contact" class="approach">
  <div class="sec-head">
    <div class="sec-tag reveal">Where to start</div>
    <h2 class="sec-title reveal" style="transition-delay:.06s">The first conversation is short and free.</h2>
  </div>
  <div class="wrap">
    <div class="contact-grid">
      <div class="contact-copy reveal">
        <p class="big">We'll look at how mail, calendar and follow-ups actually move through your week right now, and tell you honestly <b>whether this makes sense for you</b> and which plan fits. If it doesn't make sense, we'll say so.</p>
        <ul class="contact-points">
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A straight read on where your week is actually going.</li>
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>A recommendation on Select, Reserve or a custom build — including &quot;none of these yet&quot;.</li>
          <li><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>If you're not saving real hours by month two, we refund your setup fee.</li>
        </ul>
        <div class="contact-direct">
          Prefer email? Reach us directly at <a href="mailto:questions@loquelogic.com">questions@loquelogic.com</a>
        </div>
      </div>

      <div class="form-card reveal" style="transition-delay:.06s">
        <form id="contactForm" action="https://api.web3forms.com/submit" method="POST" data-ajax>
          <input type="hidden" name="access_key" value={FORM_KEY}>
          <input type="hidden" name="subject" value="New enquiry — Loque Agent (Corporate executives)">
          <input type="hidden" name="from_name" value="Loque Agent Website">
          <input type="hidden" name="vertical" value="Corporate executives">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">

          <div class="form-grid">
            <div class="field">
              <label for="cf-name">Name <span class="req">*</span></label>
              <input type="text" id="cf-name" name="name" placeholder="Jane Doe" required>
            </div>
            <div class="field">
              <label for="cf-email">Email <span class="req">*</span></label>
              <input type="email" id="cf-email" name="email" placeholder="jane@company.com" required>
            </div>
            <div class="field">
              <label for="cf-company">Company</label>
              <input type="text" id="cf-company" name="company" placeholder="Company name">
            </div>
            <div class="field">
              <label for="cf-phone">Phone</label>
              <input type="tel" id="cf-phone" name="phone" placeholder="(435) 243-5808">
            </div>
            <div class="field">
              <label for="cf-plan">I'm interested in</label>
              <select id="cf-plan" name="plan">
                <option value="Not sure yet — help me decide">Not sure yet — help me decide</option>
                <option value="Select — know what matters">Select — know what matters</option>
                <option value="Reserve — act on what matters">Reserve — act on what matters</option>
                <option value="Custom Reserve — a custom build">Custom Reserve — a custom build</option>
                <option value="Founding client rates">Founding client rates</option>
              </select>
            </div>
            <div class="field">
              <label for="cf-size">People reporting to you</label>
              <select id="cf-size" name="size">
                <option value="Not given">Prefer not to say</option>
                <option value="0">None directly</option>
                <option value="1-5">1&ndash;5</option>
                <option value="6-20">6&ndash;20</option>
                <option value="21+">21+</option>
              </select>
            </div>
            <div class="field full">
              <label for="cf-message">What's actually eating your time? <span class="req">*</span></label>
              <textarea id="cf-message" name="message" placeholder="Roughly how much mail you get, what keeps slipping, and whether you have an assistant or chief of staff today." required></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" id="cf-submit">Book the first conversation</button>
          <div class="form-fine">We'll only use your details to follow up about your enquiry. No spam, ever.</div>
          <div class="form-status" id="cf-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

</Base>
